control: Additive increase grows the rate by 2% of the target times the call's cost over the current rate
removes: the step is no longer divided by the current rate, so growth per second rises with the rate
packages: ./ratelimit/core
tests: TestSucceeded TestTheRateClimbsFromTheFloorToTheTargetIn45Seconds TestTheClimbHoldsForManySmallSuccesses
scheduled-count: no

diff --git a/ratelimit/core/controller.go b/ratelimit/core/controller.go
--- a/ratelimit/core/controller.go
+++ b/ratelimit/core/controller.go
@@ -38,7 +38,7 @@ type State struct {
 func Succeeded(s State, l Limits, cost mail.OpCost) State {
 	rate := l.bounded(s.Rate)
 	if w := cost.Weight; w > 0 && !math.IsInf(w, 1) && rate > 0 {
-		rate = min(rate+stepFraction*l.target*w/rate, l.target)
+		rate = min(rate+stepFraction*l.target*w, l.target)
 	}
 	return State{Rate: rate, BackoffUntil: s.BackoffUntil}
 }
