removes: the draw is ignored, so every backoff waits the whole bound as a fixed backoff does
packages: ./ratelimit/core
tests: TestThrottled
scheduled-count: no

diff --git a/ratelimit/core/controller.go b/ratelimit/core/controller.go
index d113493..b8c975e 100644
