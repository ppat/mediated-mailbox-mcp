+++ b/ratelimit/core/controller.go
@@ -99,5 +99,5 @@ func jitter(throttles int, draw float64) int64 {
 	if !(draw >= 0 && draw < 1) {
 		return bound
 	}
-	return int64(draw * float64(bound))
+	return bound
 }
