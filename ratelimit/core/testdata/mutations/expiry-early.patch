control: An expired lease stops counting against its class's share, and nothing it drew is put back into the bucket
removes: a lease stops counting half a second before it expires
packages: ./ratelimit/core
tests: TestIssueSplitsByClass TestLive
scheduled-count: no

diff --git a/ratelimit/core/lease.go b/ratelimit/core/lease.go
index 351728c..dcf950a 100644
--- a/ratelimit/core/lease.go
+++ b/ratelimit/core/lease.go
@@ -189,7 +189,7 @@ func held(leases []Lease, c Class, now int64) float64 {
 func Live(leases []Lease, now int64) []Lease {
 	var live []Lease
 	for _, h := range leases {
-		if h.Expires > now {
+		if h.Expires > now+leaseMillis/2 {
 			live = append(live, h)
 		}
 	}
