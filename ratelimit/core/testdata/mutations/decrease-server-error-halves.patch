control: A throttle halves the rate, a server error cuts it to 80% and a latency median above twice the baseline cuts it to 90%
removes: a server error halves the rate as a throttle does
packages: ./ratelimit/core
tests: TestServerErrored
scheduled-count: no

diff --git a/ratelimit/core/controller.go b/ratelimit/core/controller.go
--- a/ratelimit/core/controller.go
+++ b/ratelimit/core/controller.go
@@ -67,7 +67,7 @@ func Throttled(s State, l Limits, signal mail.ThrottleSignal, now int64, draw fl
 // falls to 80%, down to the floor.
 func ServerErrored(s State, l Limits) State {
 	return State{
-		Rate:         max(l.bounded(s.Rate)*serverErrorFactor, l.floor),
+		Rate:         max(l.bounded(s.Rate)*throttleFactor, l.floor),
 		BackoffUntil: s.BackoffUntil,
 		Throttles:    s.Throttles,
 	}
