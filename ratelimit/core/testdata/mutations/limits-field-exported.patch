control: Limits carries no exported field, so no code outside the package can build one and raise its target
removes: the hard cap becomes an exported field, so code outside the package can build a Limits around its constructors
packages: ./ratelimit/core
tests: TestLimitsIsBuiltOnlyByItsConstructors
scheduled-count: no

diff --git a/ratelimit/core/lease.go b/ratelimit/core/lease.go
--- a/ratelimit/core/lease.go
+++ b/ratelimit/core/lease.go
@@ -75,7 +75,7 @@ type Decision struct {
 // period has still to draw of its share. A class that did not ask within that period is idle, and
 // its share is lent. A lease counts against its class's share until it expires.
 func Issue(l Limits, s State, is Issuance, leases []Lease, req Request, now int64) (Issuance, Decision) {
-	capacity := l.hardCap
+	capacity := l.HardCapValue
 	if !req.Class.named() || !(req.Tokens > 0) || req.Tokens > capacity {
 		return is, Decision{}
 	}
@@ -94,7 +94,7 @@ func Issue(l Limits, s State, is Issuance, leases []Lease, req Request, now int6
 			available -= max(Share(c, rate, l.target)-held(leases, c, now), 0)
 		}
 	}
-	if req.Tokens > available || windowed(is.Recent)+req.Tokens > l.hardCap {
+	if req.Tokens > available || windowed(is.Recent)+req.Tokens > l.HardCapValue {
 		return is, Decision{Outcome: Waiting}
 	}
 	is.Level -= req.Tokens
