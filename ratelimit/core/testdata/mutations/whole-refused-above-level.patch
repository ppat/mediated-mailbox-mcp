control: A lease holds the whole request, and a request larger than the bucket can ever hold is refused
removes: a request larger than what the bucket holds now is refused rather than left waiting
packages: ./ratelimit/core
tests: TestIssue TestIssueSplitsByClass TestAnExpiredLeaseIsNotRefunded TestInteractiveKeepsItsShareThroughACut TestTwoCallsPastTheHardCapAreNotIssuedInOneSecond TestAFutureStampCountsForOneSecondFromTheRequestThatSeesIt TestAStoredInstantAheadOfTheClockKeepsTheWindow
scheduled-count: no

diff --git a/ratelimit/core/lease.go b/ratelimit/core/lease.go
index 351728c..93fbdd0 100644
--- a/ratelimit/core/lease.go
+++ b/ratelimit/core/lease.go
@@ -96,7 +96,7 @@ func Issue(ceiling float64, s State, is Issuance, leases []Lease, req Request, n
 		}
 	}
 	if req.Tokens > available || windowed(is.Recent)+req.Tokens > l.HardCap {
-		return is, Decision{Outcome: Waiting}
+		return is, Decision{Outcome: Refused}
 	}
 	is.Level -= req.Tokens
 	is.Recent = append(is.Recent, Issued{At: now, Tokens: req.Tokens})
