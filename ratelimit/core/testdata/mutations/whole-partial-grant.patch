control: A lease holds the whole request, and a request larger than the bucket can ever hold is refused
removes: a request the bucket cannot cover is granted what the bucket holds
packages: ./ratelimit/core
tests: TestIssue TestIssueSplitsByClass TestAnExpiredLeaseIsNotRefunded TestACallCostingMoreThanASecondAtTheFloorIsGranted TestAThreadFetchIsGrantedOnceTheBucketHoldsIt TestTwoCallsPastTheHardCapAreNotIssuedInOneSecond TestAFutureStampCountsForOneSecondFromTheRequestThatSeesIt
scheduled-count: no

diff --git a/ratelimit/core/lease.go b/ratelimit/core/lease.go
index 351728c..3ec4a1d 100644
--- a/ratelimit/core/lease.go
+++ b/ratelimit/core/lease.go
@@ -95,9 +95,11 @@ func Issue(ceiling float64, s State, is Issuance, leases []Lease, req Request, n
 			available -= max(Share(c, rate, l.Target)-held(leases, c, now), 0)
 		}
 	}
-	if req.Tokens > available || windowed(is.Recent)+req.Tokens > l.HardCap {
+	available = min(available, l.HardCap-windowed(is.Recent))
+	if !(available > 0) {
 		return is, Decision{Outcome: Waiting}
 	}
+	req.Tokens = min(req.Tokens, available)
 	is.Level -= req.Tokens
 	is.Recent = append(is.Recent, Issued{At: now, Tokens: req.Tokens})
 	return is, Decision{
