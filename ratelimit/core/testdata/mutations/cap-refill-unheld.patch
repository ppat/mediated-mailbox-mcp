+++ b/ratelimit/core/lease.go
@@ -112,7 +112,7 @@ func refillRate(rate float64, l Limits) float64 {
 	if !(rate > 0) {
 		return 0
 	}
-	return min(rate, l.Target)
+	return rate
 }
 
