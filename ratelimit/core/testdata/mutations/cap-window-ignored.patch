control: The tokens issued inside any one-second window sum to at most the hard cap, and over a longer window stay within the hard cap plus the target times its length, while the stored state is kept whole and current, and the clock does not step forward
removes: the one-second window is not checked, so the bucket alone decides
packages: ./ratelimit/core
tests: TestNoRunIssuesPastTheHardCap TestIssue TestTwoCallsPastTheHardCapAreNotIssuedInOneSecond TestAFutureStampCountsForOneSecondFromTheRequestThatSeesIt TestAStoredInstantAheadOfTheClockKeepsTheWindow
scheduled-count: no

diff --git a/ratelimit/core/lease.go b/ratelimit/core/lease.go
--- a/ratelimit/core/lease.go
+++ b/ratelimit/core/lease.go
@@ -94,7 +94,7 @@ func Issue(l Limits, s State, is Issuance, leases []Lease, req Request, now int6
 			available -= max(Share(c, rate, l.target)-held(leases, c, now), 0)
 		}
 	}
-	if req.Tokens > available || windowed(is.Recent)+req.Tokens > l.hardCap {
+	if req.Tokens > available {
 		return is, Decision{Outcome: Waiting}
 	}
 	is.Level -= req.Tokens
