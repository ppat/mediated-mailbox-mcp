control: The controller keeps the rate between the floor and the target
removes: a throttle's halving is no longer held at the floor, so the rate falls below it
packages: ./ratelimit/core
tests: TestThrottled TestNoRunIssuesPastTheHardCap
scheduled-count: no

diff --git a/ratelimit/core/controller.go b/ratelimit/core/controller.go
--- a/ratelimit/core/controller.go
+++ b/ratelimit/core/controller.go
@@ -57,7 +57,7 @@ func Throttled(s State, l Limits, signal mail.ThrottleSignal, now int64, draw fl
 		throttles++
 	}
 	return State{
-		Rate:         max(l.bounded(s.Rate)*throttleFactor, l.floor),
+		Rate:         l.bounded(s.Rate) * throttleFactor,
 		BackoffUntil: max(s.BackoffUntil, addSaturating(now, wait)),
 		Throttles:    throttles,
 	}
