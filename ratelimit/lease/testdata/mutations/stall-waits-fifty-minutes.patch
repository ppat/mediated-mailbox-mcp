control: The collapse rules fire on five minutes at the floor or with nothing granted, and only while a class asks
removes: the stall rule fires only after fifty minutes with nothing granted
packages: ./ratelimit/lease
tests: TestAlertingRules
scheduled-count: no

diff --git a/packaging/chart/alerting-rules.yaml b/packaging/chart/alerting-rules.yaml
--- a/packaging/chart/alerting-rules.yaml
+++ b/packaging/chart/alerting-rules.yaml
@@ -39,7 +39,7 @@
   # last minute. It catches issuance stopped by anything else, such as a stored fill instant ahead of the clock.
   - alert: MediatedMailboxIssuanceStalled
     expr: |
-      mediated_mailbox_ratelimit_account_seconds_since_grant > 300
+      mediated_mailbox_ratelimit_account_seconds_since_grant > 3000
       and on (account) mediated_mailbox_ratelimit_account_seconds_since_ask < 60
     labels:
       severity: warning
