control: Cost counted for an account with no hard cap emitted fires the missing-threshold rule
removes: the hard cap's window is five minutes, so a hard cap that left five minutes ago still hides its absence and the account goes ten minutes with nothing firing
packages: ./provider/ratelimit
tests: TestAlertingRules
scheduled-count: no

diff --git a/packaging/chart/rules/alerting-rules.yaml b/packaging/chart/rules/alerting-rules.yaml
index 9cc9ffa4..1c2187e2 100644
--- a/packaging/chart/rules/alerting-rules.yaml
+++ b/packaging/chart/rules/alerting-rules.yaml
@@ -47,7 +47,7 @@ groups:
   - alert: MediatedMailboxRateHardCapAbsent
     expr: |
       sum by (account) (increase(mediated_mailbox_provider_request_cost_total[5m])) > 0
-      unless on (account) max by (account) (max_over_time(mediated_mailbox_provider_hard_cap[2m]))
+      unless on (account) max by (account) (max_over_time(mediated_mailbox_provider_hard_cap[5m]))
     for: 5m
     labels:
       severity: warning
