control: Missing account-level series fire the absence rule rather than reading as a healthy account
removes: the absence rule watches a job workload's series rather than the API server's account-level ones
packages: ./provider/ratelimit
tests: TestAlertingRules
scheduled-count: no

diff --git a/packaging/chart/rules/alerting-rules.yaml b/packaging/chart/rules/alerting-rules.yaml
index 9cc9ffa4..820cf578 100644
--- a/packaging/chart/rules/alerting-rules.yaml
+++ b/packaging/chart/rules/alerting-rules.yaml
@@ -80,7 +80,7 @@ groups:
   # Missing data never reads as a healthy account. The API server runs continuously and emits every account's series,
   # while the job workloads' series are absent between their runs by design and are not read here.
   - alert: MediatedMailboxRateSeriesAbsent
-    expr: absent(mediated_mailbox_ratelimit_account_rate)
+    expr: absent(mediated_mailbox_ratelimit_granted_total)
     for: 5m
     labels:
       severity: warning
