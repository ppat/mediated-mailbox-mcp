control: Gmail's cost profile declares each call's worst case, every read of the label table included, and sizes its pages to one second's worth at the hard cap
removes: EnumerateAll's read of the profile for its page's total is left out of its cost
packages: ./provider/gmail
tests: TestCostDeclaresEachCallsWorstCase TestEachOperationsDearestPathFitsItsCall/EnumerateAll
scheduled-count: no

diff --git a/provider/gmail/profile.go b/provider/gmail/profile.go
--- a/provider/gmail/profile.go
+++ b/provider/gmail/profile.go
@@ -99,7 +99,7 @@ func (Profile) Cost(op mail.ProviderOp) mail.OpCost {
 	case mail.OpChangesSince:
 		units = unitsHistoryList + unitsLabelsList
 	case mail.OpEnumerateAll:
-		units = unitsMessagesList + unitsMessagesGet*messagesPerPage + unitsLabelsList + unitsGetProfile
+		units = unitsMessagesList + unitsMessagesGet*messagesPerPage + unitsLabelsList
 	default:
 		return mail.OpCost{}
 	}
