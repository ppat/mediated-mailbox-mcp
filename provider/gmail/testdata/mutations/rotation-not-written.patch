control: A rotated refresh token is held and written back
removes: a rotated refresh token is held in memory and counted as written back without being written
packages: ./provider/gmail
tests: TestARotatedCredentialSurvivesARestart TestAFailedWriteBackIsLoggedAndTriedAgain
scheduled-count: no

diff --git a/provider/gmail/tokensource.go b/provider/gmail/tokensource.go
index 9c48994..8fee728 100644
--- a/provider/gmail/tokensource.go
+++ b/provider/gmail/tokensource.go
@@ -115,7 +115,7 @@ func (s *TokenSource) accept(resp tokenResponse, now time.Time) {
 	if s.creds.RefreshToken == s.persisted {
 		return
 	}
-	if err := WriteBack(s.writeBack, s.creds.RefreshToken); err != nil {
+	if err := error(nil); err != nil {
 		s.log.Error("the rotated Gmail refresh token was not written back, so a restart before a later write succeeds loses mailbox access",
 			slog.String("location", s.writeBack), slog.Any("error", err))
 		return
