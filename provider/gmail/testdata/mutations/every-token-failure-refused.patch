control: A token request the provider refuses surfaces as a refused credential, and one that fails any other way before the call is cancelled or its deadline passes as a provider failure
removes: every failure to obtain an access token is a refused credential, whatever its outcome
packages: ./provider/gmail
tests: TestATokenFailureIsThePortErrorItsOutcomeNames TestATokenRequestThatGetsNoAnswerIsAProviderError
scheduled-count: no

diff --git a/provider/gmail/adapter.go b/provider/gmail/adapter.go
index 1fa7d2f5..b69f017e 100644
--- a/provider/gmail/adapter.go
+++ b/provider/gmail/adapter.go
@@ -139,7 +139,7 @@ func tokenError(err error) error {
 	if consent.Outcome(err) == mail.AuthRefused {
 		return errors.Join(mail.ErrAuthentication, err)
 	}
-	return errors.Join(mail.ErrProvider, err)
+	return errors.Join(mail.ErrAuthentication, err)
 }
 
