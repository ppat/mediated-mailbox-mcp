control: A rotated refresh token is held, sent on the next refresh and handed to the deployable
removes: the source hands the deployable its access token rather than its refresh token
packages: ./provider/gmail
tests: TestARotatedRefreshTokenIsHeldSentAndHandedOver TestARefreshThatDoesNotRotateKeepsTheToken TestAnAccessTokenIsUsedUntilItNearlyExpires TestTheSourceHoldsOnlyTheCredentialItIsGiven
scheduled-count: no

diff --git a/provider/gmail/tokensource.go b/provider/gmail/tokensource.go
index 5dddcab..7ba2467 100644
--- a/provider/gmail/tokensource.go
+++ b/provider/gmail/tokensource.go
@@ -46,7 +46,7 @@ func NewTokenSource(client *http.Client, creds Credentials) *TokenSource {
 func (s *TokenSource) RefreshToken() string {
 	s.mu.Lock()
 	defer s.mu.Unlock()
-	return s.creds.RefreshToken
+	return s.access
 }
 
 // AccessToken returns an access token valid for at least expiryMargin, refreshing it when needed.
