control: A token request the provider refuses is reported as refused, one that gets no answer as failed, and a cancelled request or a held access token as no attempt
removes: every token endpoint answer other than success counts as a refusal, whatever its status
packages: ./provider/gmail
tests: TestARefreshsOutcome
scheduled-count: no

diff --git a/provider/gmail/oauth.go b/provider/gmail/oauth.go
index 0fa0704..6afe22c 100644
--- a/provider/gmail/oauth.go
+++ b/provider/gmail/oauth.go
@@ -198,7 +198,7 @@ func outcome(err error) mail.AuthOutcome {
 	switch {
 	case err == nil:
 		return mail.AuthSucceeded
-	case errors.As(err, &answered) && (answered.code == http.StatusBadRequest || answered.code == http.StatusUnauthorized):
+	case errors.As(err, &answered):
 		return mail.AuthRefused
 	default:
 		return mail.AuthFailed
