control: A rotated refresh token is held and written back
removes: the refresh request carries the token the store holds rather than the one the process holds, so a rotation whose write-back failed is refreshed with the old token
packages: ./provider/gmail
tests: TestAFailedWriteBackIsLoggedAndTriedAgain
scheduled-count: no

diff --git a/provider/gmail/tokensource.go b/provider/gmail/tokensource.go
index 9c48994..1a5534c 100644
--- a/provider/gmail/tokensource.go
+++ b/provider/gmail/tokensource.go
@@ -91,7 +91,7 @@ func (s *TokenSource) refreshForm() url.Values {
 		"client_id":     {s.creds.ClientID},
 		"client_secret": {s.creds.ClientSecret},
 		"grant_type":    {"refresh_token"},
-		"refresh_token": {s.creds.RefreshToken},
+		"refresh_token": {s.persisted},
 	}
 }
 
