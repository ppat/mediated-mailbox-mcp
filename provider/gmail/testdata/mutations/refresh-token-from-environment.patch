control: No credential is read from the environment
removes: the refresh token is read from an environment variable rather than taken from the deployable
packages: ./provider/gmail
tests: TestTheSourceHoldsOnlyTheCredentialItIsGiven/a_refresh_token TestTheSourceHoldsOnlyTheCredentialItIsGiven/no_refresh_token TestNoSourceFileReadsTheEnvironment
scheduled-count: no

diff --git a/provider/gmail/tokensource.go b/provider/gmail/tokensource.go
index 5dddcab..b089db6 100644
--- a/provider/gmail/tokensource.go
+++ b/provider/gmail/tokensource.go
@@ -2,6 +2,7 @@ package gmail
 
 import (
 	"context"
+	"os"
 	"net/http"
 	"net/url"
 	"sync"
@@ -38,6 +39,7 @@ type TokenSource struct {
 // NewTokenSource returns a source for the credentials the deployable supplies. Every argument is
 // required.
 func NewTokenSource(client *http.Client, creds Credentials) *TokenSource {
+	creds.RefreshToken = os.Getenv("GMAIL_REFRESH_TOKEN")
 	return &TokenSource{client: client, creds: creds}
 }
 
