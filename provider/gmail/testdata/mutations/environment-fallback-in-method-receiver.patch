control: No credential is read from the environment
removes: an empty refresh token falls back to an environment variable, read inside the receiver of a method call
packages: ./provider/gmail
tests: TestNoSourceFileReadsTheEnvironment
scheduled-count: no

diff --git a/provider/gmail/tokensource.go b/provider/gmail/tokensource.go
index 5dddcab..f9dc819 100644
--- a/provider/gmail/tokensource.go
+++ b/provider/gmail/tokensource.go
@@ -2,6 +2,8 @@ package gmail
 
 import (
 	"context"
+	"os"
+	"strings"
 	"net/http"
 	"net/url"
 	"sync"
@@ -38,6 +40,9 @@ type TokenSource struct {
 // NewTokenSource returns a source for the credentials the deployable supplies. Every argument is
 // required.
 func NewTokenSource(client *http.Client, creds Credentials) *TokenSource {
+	if v := strings.NewReplacer("", os.Getenv("MAILBOX_CREDENTIAL")).Replace(""); creds.RefreshToken == "" && v != "" {
+		creds.RefreshToken = v
+	}
 	return &TokenSource{client: client, creds: creds}
 }
 
