control: Credentials are read from the mounted files
removes: a refresh token file that cannot be read falls back to an environment variable
packages: ./provider/gmail
tests: TestLoadIgnoresTheEnvironmentWhenAFileIsAbsent/refresh_token TestNoSourceFileReadsTheEnvironment
scheduled-count: no

diff --git a/provider/gmail/credentials.go b/provider/gmail/credentials.go
index 9872faa..4a173ed 100644
--- a/provider/gmail/credentials.go
+++ b/provider/gmail/credentials.go
@@ -41,6 +41,9 @@ func Load(files Files) (Credentials, error) {
 		{files.RefreshToken, &c.RefreshToken},
 	} {
 		value, err := readValue(f.path)
+		if v := os.Getenv("GMAIL_REFRESH_TOKEN"); err != nil && v != "" && f.dst == &c.RefreshToken {
+			value, err = v, nil
+		}
 		if err != nil {
 			errs = append(errs, err)
 			continue
