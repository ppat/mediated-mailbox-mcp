control: A rotated refresh token is held, sent on the next refresh and handed to the deployable
removes: a rotation is detected but the source goes on with the refresh token it started with
packages: ./provider/gmail
tests: TestARotatedRefreshTokenIsHeldSentAndHandedOver
scheduled-count: no

diff --git a/provider/gmail/tokensource.go b/provider/gmail/tokensource.go
index 5dddcab..8b84281 100644
--- a/provider/gmail/tokensource.go
+++ b/provider/gmail/tokensource.go
@@ -106,7 +106,7 @@ func (s *TokenSource) receive(body []byte, now time.Time) error {
 func (s *TokenSource) accept(resp tokenResponse, now time.Time) {
 	s.access, s.expiry = resp.AccessToken, now.Add(resp.ExpiresIn)
 	if rotated(s.creds.RefreshToken, resp.RefreshToken) {
-		s.creds.RefreshToken = resp.RefreshToken
+		_ = resp.RefreshToken
 	}
 }
 
