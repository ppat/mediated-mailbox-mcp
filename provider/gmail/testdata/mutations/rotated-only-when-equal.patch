control: A rotated refresh token is held and written back
removes: a returned refresh token counts as a rotation only when it equals the held one
packages: ./provider/gmail
tests: TestARotatedCredentialSurvivesARestart TestAFailedWriteBackIsLoggedAndTriedAgain
scheduled-count: no

diff --git a/provider/gmail/tokensource.go b/provider/gmail/tokensource.go
index 9c48994..41adcbe 100644
--- a/provider/gmail/tokensource.go
+++ b/provider/gmail/tokensource.go
@@ -126,5 +126,5 @@ func (s *TokenSource) accept(resp tokenResponse, now time.Time) {
 // rotated reports whether a refresh response rotated the refresh token. Google leaves the field
 // out when it did not.
 func rotated(held, returned string) bool {
-	return returned != "" && returned != held
+	return returned != "" && returned == held
 }
