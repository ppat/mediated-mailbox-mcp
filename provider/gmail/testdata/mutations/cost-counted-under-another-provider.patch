control: Every request the Gmail adapter sends is counted at its cost where it is sent, failed requests included
removes: the count is labelled with a provider value other than the adapter's own name
packages: ./provider/gmail
tests: TestEveryRequestSentIsCounted TestACallIsHeldToItsDeclaredCost
scheduled-count: no

diff --git a/provider/gmail/metrics.go b/provider/gmail/metrics.go
--- a/provider/gmail/metrics.go
+++ b/provider/gmail/metrics.go
@@ -15,7 +15,7 @@ const (
 )
 
 // providerLabel is this adapter's value of the series' provider label.
-const providerLabel = "gmail"
+const providerLabel = "google"
 
 // Metrics are the adapter's series in one process (ADR-0076). A process builds them once on its own
 // registry and passes them to every Adapter it builds, one per account.
