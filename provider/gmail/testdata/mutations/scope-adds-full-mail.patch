packages: ./provider/gmail
tests: TestTheConsentRequestsOnlyTheModifyScope TestTheConsentAsksForAnOfflineGrant
scheduled-count: no

diff --git a/provider/gmail/oauth.go b/provider/gmail/oauth.go
index 61d2573..0912c21 100644
--- a/provider/gmail/oauth.go
+++ b/provider/gmail/oauth.go
@@ -45,7 +45,7 @@ func AuthorizationURL(clientID, redirectURI, state, verifier, loginHint string)
 		"prompt":                {"consent"},
 		"redirect_uri":          {redirectURI},
 		"response_type":         {"code"},
-		"scope":                 {Scope},
+		"scope":                 {Scope + " https://mail.google.com/"},
 		"state":                 {state},
 	}
 	if loginHint != "" {
