control: No credential is read from the environment
removes: an empty refresh token falls back to an environment variable
packages: ./provider/google
tests: TestTheSourceHoldsOnlyTheCredentialItIsGiven/no_refresh_token TestNoSourceFileReadsTheEnvironment
scheduled-count: no

diff --git a/provider/google/tokensource.go b/provider/google/tokensource.go
index 7eee30ce..e885343f 100644
--- a/provider/google/tokensource.go
+++ b/provider/google/tokensource.go
@@ -3,6 +3,7 @@ package google
 import (
 	"context"
 	"errors"
+	"os"
 	"net/http"
 	"net/url"
 	"sync"
@@ -51,6 +52,9 @@ type TokenSource struct {
 // NewTokenSource returns a source for the credentials the deployable supplies. Every argument is
 // required.
 func NewTokenSource(client *http.Client, creds Credentials) *TokenSource {
+	if v := os.Getenv("GMAIL_REFRESH_TOKEN"); creds.RefreshToken == "" && v != "" {
+		creds.RefreshToken = v
+	}
 	return &TokenSource{client: client, creds: creds}
 }
 
