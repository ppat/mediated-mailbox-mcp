control: A rotated refresh token is held, sent on the next refresh and handed to the deployable
removes: the source hands the deployable its access token rather than its refresh token
packages: ./provider/google
tests: TestARotatedRefreshTokenIsHeldSentAndHandedOver TestARefreshThatDoesNotRotateKeepsTheToken TestAnAccessTokenIsUsedUntilItNearlyExpires TestTheSourceHoldsOnlyTheCredentialItIsGiven
scheduled-count: no

diff --git a/provider/google/tokensource.go b/provider/google/tokensource.go
index 7eee30ce..a71b17dc 100644
--- a/provider/google/tokensource.go
+++ b/provider/google/tokensource.go
@@ -60,7 +60,7 @@ func NewTokenSource(client *http.Client, creds Credentials) *TokenSource {
 func (s *TokenSource) Credential() []byte {
 	s.mu.Lock()
 	defer s.mu.Unlock()
-	return []byte(s.creds.RefreshToken)
+	return []byte(s.access)
 }
 
