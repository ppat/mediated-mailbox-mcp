control: The port returns a body's rendered part alone, and a part the provider holds apart takes exactly one more call
removes: the body fetch returns its first answer, so a part the provider holds apart is never asked for
packages: ./provider/mail ./api/app
tests: TestABodyTakesOneCallOrOneMoreForAPartHeldApart TestABodyPastTheBoundIsDeniedAsRefused
scheduled-count: no
integration: yes

diff --git a/provider/mail/body.go b/provider/mail/body.go
--- a/provider/mail/body.go
+++ b/provider/mail/body.go
@@ -14,10 +14,7 @@ func Body(ctx context.Context, m Mailbox, id string) (coremail.MessageBody, erro
 	var part coremail.BodyPart
 	for {
 		body, err := m.GetMessageBody(ctx, id, part)
-		next, due := coremail.NextBodyPart(part, err)
-		if !due {
-			return body, err
-		}
-		part = next
+		_, _ = coremail.NextBodyPart(part, err)
+		return body, err
 	}
 }
