control: The contract suite fails an implementation that breaks a promise of the port
removes: the fake reports delivered mail as modified
packages: ./provider/mail/fake
tests: TestTheFakePassesTheContract/delivered_mail_is_added TestTheFakePassesTheContract/a_message_delivered_and_then_changed_is_reported_once,_as_added
scheduled-count: no

diff --git a/provider/mail/fake/fake.go b/provider/mail/fake/fake.go
index 21212cd6..1da34b85 100644
--- a/provider/mail/fake/fake.go
+++ b/provider/mail/fake/fake.go
@@ -128,7 +128,7 @@ func (f *Fake) Deliver(m Message) error {
 	if err := f.insert(m); err != nil {
 		return err
 	}
-	f.history = append(f.history, change{id: m.Metadata.ID, kind: added})
+	f.history = append(f.history, change{id: m.Metadata.ID, kind: modified})
 	return nil
 }
 
