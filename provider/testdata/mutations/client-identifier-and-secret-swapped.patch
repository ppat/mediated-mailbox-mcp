control: The provider library makes an account's token from the OAuth client it connects through and its own credential
removes: the client's identifier and secret are swapped in the token's credentials
packages: ./provider
tests: TestAGmailTokenIsMadeFromItsClientAndItsCredential
scheduled-count: no

diff --git a/provider/adapters.go b/provider/adapters.go
--- a/provider/adapters.go
+++ b/provider/adapters.go
@@ -63,7 +63,7 @@ func Shipped(client *http.Client) Adapters {
 // secret of the OAuth client the account connects through and the account's refresh token, each in
 // its own place (ADR-0106).
 func gmailCredentials(client coremail.OAuthClient, refreshToken []byte) google.Credentials {
-	return google.NewCredentials(client.ID, []byte(client.Secret), refreshToken)
+	return google.NewCredentials(client.Secret, []byte(client.ID), refreshToken)
 }
 
 // Token is what one account's calls authenticate with, made from the account's credential and, for
