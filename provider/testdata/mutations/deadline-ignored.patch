control: A call through the provider library's mailbox waits for its lease no later than its unit's deadline
removes: the unit's deadline never reaches the lease, so the lease is waited for as long as the caller's context allows
packages: ./provider
tests: TestALeaseIsWaitedForNoLaterThanTheUnitsDeadline
scheduled-count: no
integration: yes

diff --git a/provider/caller.go b/provider/caller.go
--- a/provider/caller.go
+++ b/provider/caller.go
@@ -112,6 +112,6 @@ func (c *Caller) Mailbox(conn Connection) (mail.Mailbox, error) {
 	}
 	return &mailbox{
 		port: port, build: build, again: conn.Again, limiter: limiter,
-		spend: ratelimit.Spend{Account: conn.Account, Class: c.class, WaitUntil: conn.WaitUntil, Timeout: c.timeout},
+		spend: ratelimit.Spend{Account: conn.Account, Class: c.class, Timeout: c.timeout},
 	}, nil
 }
