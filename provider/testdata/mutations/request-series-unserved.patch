control: A caller registers the rate limiter's and the shared provider series on the registerer it is given
removes: the shared provider series the caller hands its adapters are registered on a registry no one was given
packages: ./provider
tests: TestACallersSeriesAreOnTheRegistererItWasGiven
scheduled-count: no
integration: yes

diff --git a/provider/caller.go b/provider/caller.go
--- a/provider/caller.go
+++ b/provider/caller.go
@@ -47,7 +47,7 @@ func NewCaller(adapters Adapters, reg prometheus.Registerer, pool tx.Beginner, o
 	case pool == nil:
 		return nil, errors.New("a caller has no pool to run its leases on")
 	}
-	requests, err := NewMetrics(reg)
+	requests, err := NewMetrics(prometheus.NewRegistry())
 	if err != nil {
 		return nil, err
 	}
