control: A call through the provider library's mailbox tells the rate limiter how it went
removes: a call the provider failed tells the controller nothing, so the account's rate is never cut
packages: ./provider
tests: TestEachCallTellsTheLimiterHowItWent
scheduled-count: no
integration: yes

diff --git a/provider/ratelimit/leased.go b/provider/ratelimit/leased.go
--- a/provider/ratelimit/leased.go
+++ b/provider/ratelimit/leased.go
@@ -62,8 +62,6 @@ func Leased[T any](ctx context.Context, limiter *Limiter, s Spend, call func(con
 		told = limiter.Succeeded(ctx, s.Account, s.Cost, time.Since(start))
 	case throttled:
 		told = limiter.Throttled(ctx, s.Account, signal)
-	case errors.Is(err, mail.ErrProvider):
-		told = limiter.ServerErrored(ctx, s.Account)
 	}
 	if told != nil {
 		return zero, errors.Join(err, fmt.Errorf("telling the rate limiter how the call went: %w", told))
