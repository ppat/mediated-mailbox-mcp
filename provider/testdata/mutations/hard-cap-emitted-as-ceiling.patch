control: The Gmail adapter emits its account's hard cap beside the count of request cost, from the ceiling its rate profile declares
removes: the adapter emits the declared ceiling rather than the hard cap
packages: ./provider
tests: TestEveryRequestTheAdapterSendsIsOnTheSharedSeries
scheduled-count: no

diff --git a/provider/metrics.go b/provider/metrics.go
--- a/provider/metrics.go
+++ b/provider/metrics.go
@@ -4,8 +4,6 @@ import (
 	"fmt"
 
 	"github.com/prometheus/client_golang/prometheus"
-
-	"github.com/ppat/mediated-mailbox-mcp/core/mail"
 )
 
 // The series the runaway rule reads, in packaging/chart/rules/alerting-rules.yaml (ADR-0077). The rule
@@ -84,7 +82,7 @@ type Requests struct {
 // the hard-cap fraction of the ceiling the provider's rate profile declares. The runaway rule
 // compares the one against the other, so it holds no provider's number of its own.
 func (r Requests) Sent(account string, units int) {
-	r.metrics.hardCap.WithLabelValues(account, r.provider).Set(mail.HardCapFraction * r.ceiling)
+	r.metrics.hardCap.WithLabelValues(account, r.provider).Set(r.ceiling)
 	r.metrics.requestCost.WithLabelValues(account, r.provider).Add(float64(units))
 }
 
