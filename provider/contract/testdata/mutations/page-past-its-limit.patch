control: The contract suite fails an implementation whose enumeration reports a total it was not configured to, reports none when configured to, passes its page limit, or counts fewer messages than the case added
removes: the fake reports a page limit one below the most items its pages hold
packages: ./provider/fake
tests: TestTheFakeReportingATotalPassesTheContract/pages_of_2/enumeration_returns_every_message_once_with_what_was_seeded
scheduled-count: no

diff --git a/provider/fake/fake.go b/provider/fake/fake.go
--- a/provider/fake/fake.go
+++ b/provider/fake/fake.go
@@ -416,7 +416,7 @@ func (f *Fake) EnumerateAll(ctx context.Context, page mail.PageToken) (mail.Page
 		out.Items = append(out.Items, clone(s.meta))
 	}
 	if f.totals {
-		out.Total = &mail.Total{Items: len(f.byID), PageLimit: f.pageSize}
+		out.Total = &mail.Total{Items: len(f.byID), PageLimit: f.pageSize - 1}
 	}
 	return out, nil
 }
