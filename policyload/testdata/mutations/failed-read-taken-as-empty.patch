control: A read of the policy tables the loader cannot trust never replaces the active policy
removes: a read that failed is taken as a whole read that found no rules, so the policy with no rules replaces the active one
packages: ./policyload
tests: TestAFailedReadNeverReplacesTheActivePolicy/the_first_account's_read_fails_before_any_row TestAFailedReadNeverReplacesTheActivePolicy/the_first_account's_read_fails_after_one_row TestAFailedReadNeverReplacesTheActivePolicy/the_second_account's_read_fails_before_any_row TestAFailedReadNeverReplacesTheActivePolicy/the_second_account's_read_fails_after_one_row TestAFailedReadNeverReplacesTheActivePolicy/a_base_rule_is_added_between_two_accounts'_reads TestAFailedReadNeverReplacesTheActivePolicy/the_role_cannot_read_the_table TestAFailedReadNeverReplacesTheActivePolicy/an_account's_rule_cannot_be_decoded,_after_its_other_rules
scheduled-count: no
integration: yes

diff --git a/policyload/load.go b/policyload/load.go
index 6ed1b43..2d109cf 100644
--- a/policyload/load.go
+++ b/policyload/load.go
@@ -126,8 +126,7 @@ func (l *Loader) Reload(ctx context.Context) error {
 		return fmt.Errorf("the policy reload was cancelled before it finished, so the active policy stays: %w", ctx.Err())
 	}
 	if err != nil {
-		l.metrics.failed()
-		return fmt.Errorf("%w: %w", ErrUntrustedRead, err)
+		rows = nil
 	}
 	next, outcome := policy.Swap(l.active.Load().policy, rows)
 	if !outcome.Accepted() {
