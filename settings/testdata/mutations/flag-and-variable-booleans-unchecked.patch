packages: ./settings
tests: TestEveryMistakeIsRefusedAtStart/a_flag_holding_a_YAML_word_for_true TestEveryMistakeIsRefusedAtStart/a_flag_holding_a_YAML_word_for_false TestEveryMistakeIsRefusedAtStart/an_environment_variable_holding_a_YAML_word_for_true TestEveryMistakeIsRefusedAtStart/an_environment_variable_holding_a_YAML_word_for_false TestABooleanInsideAValueIsTrueOrFalse/in_a_list,_from_a_flag TestABooleanInsideAValueIsTrueOrFalse/in_a_list,_from_the_environment TestABooleanInsideAValueIsTrueOrFalse/in_a_section_in_a_list TestABooleanInsideAValueIsTrueOrFalse/in_a_map_in_a_list
scheduled-count: no

