packages: ./settings
tests: TestADeclarationThatCannotBeConfiguredIsRefused/a_field_with_no_tag TestADeclarationThatCannotBeConfiguredIsRefused/a_tag_with_an_option TestADeclarationThatCannotBeConfiguredIsRefused/an_inlined_field TestADeclarationThatCannotBeConfiguredIsRefused/a_name_in_upper_case TestADeclarationThatCannotBeConfiguredIsRefused/a_name_ending_in_an_underscore
scheduled-count: no

