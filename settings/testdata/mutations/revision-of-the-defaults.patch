packages: ./settings
tests: TestASectionsRevisionFollowsItsEffectiveValue/the_file_changes_a_trigger_word TestASectionsRevisionFollowsItsEffectiveValue/the_environment_adds_a_language TestASectionsRevisionFollowsItsEffectiveValue/a_flag_changes_the_threshold TestASectionsRevisionFollowsItsEffectiveValue/a_flag_changes_the_server
scheduled-count: no

