+	lowerKeys(root)
+	folded, err := yaml.Marshal(root)
+	if err != nil {
+		return nil, err
+	}
+	dec := yaml.NewDecoder(bytes.NewReader(folded))
 	dec.KnownFields(true)
 	if err := dec.Decode(out); err != nil {
 		return nil, err
@@ -27,6 +33,15 @@ func decode(text []byte, out any) (*yaml.Node, error) {
 	return root, nil
 }
 
+func lowerKeys(n *yaml.Node) {
+	for i, child := range n.Content {
+		if n.Kind == yaml.MappingNode && i%2 == 0 {
+			child.Value = strings.ToLower(child.Value)
+		}
+		lowerKeys(child)
+	}
+}
