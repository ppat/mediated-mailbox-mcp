control: A link keeps its target only when the target is an absolute http or https URL with a host, or a mailto URL of bare addresses and nothing else
removes: a mailto target keeps its query, so it can add recipients or fill in a message
packages: ./sanitize/markdown
tests: TestLinkTargets/mailto_with_a_subject TestLinkTargets/mailto_with_a_copy_recipient_and_a_body TestLinkTargets/mailto_with_a_blind_copy_recipient TestLinkTargets/mailto_with_an_empty_query TestLinkTargets/mailto_with_a_fragment TestTheConvertedBodysForm
scheduled-count: no

diff --git a/sanitize/markdown/markdown.go b/sanitize/markdown/markdown.go
index e8737bb..5b077c0 100644
--- a/sanitize/markdown/markdown.go
+++ b/sanitize/markdown/markdown.go
@@ -213,7 +213,7 @@ func kept(target string) bool {
 	case "http", "https":
 		return u.Host != ""
 	case "mailto":
-		return u.RawQuery == "" && !u.ForceQuery && u.Fragment == "" && addresses(u.Opaque)
+		return addresses(u.Opaque)
 	default:
 		return false
 	}
