control: A link keeps its target only when the target is an absolute http or https URL with a host, or a mailto URL of bare addresses and nothing else
removes: a mailto target without a query is kept whatever its recipients are, none included
packages: ./sanitize/markdown
tests: TestLinkTargets/mailto_with_a_display_name TestLinkTargets/mailto_with_no_domain TestLinkTargets/mailto_with_an_empty_recipient
scheduled-count: no

diff --git a/sanitize/markdown/markdown.go b/sanitize/markdown/markdown.go
index e8737bb..0edd730 100644
--- a/sanitize/markdown/markdown.go
+++ b/sanitize/markdown/markdown.go
@@ -213,7 +213,7 @@ func kept(target string) bool {
 	case "http", "https":
 		return u.Host != ""
 	case "mailto":
-		return u.RawQuery == "" && !u.ForceQuery && u.Fragment == "" && addresses(u.Opaque)
+		return u.RawQuery == "" && !u.ForceQuery && u.Fragment == ""
 	default:
 		return false
 	}
