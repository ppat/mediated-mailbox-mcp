control: Message text with no HTML form is released as one fenced code block that shows it exactly
removes: the fence is as long as the longest run of backticks in the text rather than one longer, so that run closes the block
packages: ./sanitize/markdown
tests: TestLiteralTextIsOneCodeBlockShowingIt TestLiteralForms
scheduled-count: no

diff --git a/sanitize/markdown/literal.go b/sanitize/markdown/literal.go
index b972af1..a9ab083 100644
--- a/sanitize/markdown/literal.go
+++ b/sanitize/markdown/literal.go
@@ -18,7 +18,7 @@ func Literal(text string) string {
 		run++
 		longest = max(longest, run)
 	}
-	fence := strings.Repeat("`", max(3, longest+1))
+	fence := strings.Repeat("`", max(3, longest))
 	var b strings.Builder
 	b.Grow(len(text) + 2*len(fence) + 2)
 	b.WriteString(fence)
