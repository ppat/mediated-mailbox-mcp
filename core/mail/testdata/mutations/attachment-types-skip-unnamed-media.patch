control: An attachment's type is a word of the closed vocabulary, set with the names from the same parts
removes: a part with no media type has a name and no type
packages: ./core/mail
tests: TestEveryAttachmentTypeIsAWordOfTheVocabulary
scheduled-count: no

diff --git a/core/mail/attachment.go b/core/mail/attachment.go
index 44b7cf82..d436477e 100644
--- a/core/mail/attachment.go
+++ b/core/mail/attachment.go
@@ -45,7 +45,9 @@ func (m *MessageMetadata) SetAttachments(parts []AttachmentPart) {
 	m.AttachmentNames, m.AttachmentTypes = nil, nil
 	for _, p := range parts {
 		m.AttachmentNames = append(m.AttachmentNames, p.Filename)
-		m.AttachmentTypes = append(m.AttachmentTypes, AttachmentTypeOf(p.MediaType, p.Filename))
+		if p.MediaType != "" {
+			m.AttachmentTypes = append(m.AttachmentTypes, AttachmentTypeOf(p.MediaType, p.Filename))
+		}
 	}
 	slices.Sort(m.AttachmentTypes)
 	m.AttachmentTypes = slices.Compact(m.AttachmentTypes)
