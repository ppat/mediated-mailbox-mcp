control: What is kept of an attachment is its media type and extension in the normalized form
removes: a media type is lowercased by Unicode case mapping, so a letter outside ASCII can become one inside it
packages: ./core/mail
tests: TestAnAttachmentsMediaIsKeptNormalized
scheduled-count: no

diff --git a/core/mail/attachment.go b/core/mail/attachment.go
index c5205199..03c3fa22 100644
--- a/core/mail/attachment.go
+++ b/core/mail/attachment.go
@@ -64,7 +64,7 @@ const (
 func AttachmentMediaOf(mediaType, filename string) AttachmentMedia {
 	var out AttachmentMedia
 	essence, _, _ := strings.Cut(mediaType, ";")
-	essence = asciiLower(strings.TrimSpace(essence))
+	essence = strings.ToLower(strings.TrimSpace(essence))
 	if typ, sub, ok := strings.Cut(essence, "/"); ok && restrictedName(typ) && restrictedName(sub) {
 		out.MediaType = essence
 	}
