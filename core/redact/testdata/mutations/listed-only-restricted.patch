 		v.reason = PendingScan
 	case scan == sensitivity.SkippedRestricted():
 		v.reason = SkippedRestricted
-	case c.Class().Restricted():
+	case c.Reason() == classify.Listed:
 		v.reason = RestrictedSender
 	case scan == sensitivity.Refused():
