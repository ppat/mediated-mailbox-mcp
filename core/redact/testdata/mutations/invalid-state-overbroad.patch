control: A stored state no message can be in is denied as invalid, never as pending
removes: every message not scanned, or with a flag, is denied as invalid
packages: ./core/redact
tests: TestFailClosed/an_unscanned_message TestDecide/a_normal_sender,_skipped_by_the_scan_gate
scheduled-count: no

diff --git a/core/redact/redact.go b/core/redact/redact.go
index a269599f..5574c035 100644
--- a/core/redact/redact.go
+++ b/core/redact/redact.go
@@ -105,7 +105,7 @@ func Decide(p classify.Policy, sender string, flags sensitivity.ContentFlags, sc
 	c := classify.Classify(p, sender)
 	v := Verdict{sender: c}
 	switch {
-	case flags.Any() && scan != sensitivity.Scanned():
+	case flags.Any() || scan != sensitivity.Scanned():
 		v.reason = InvalidState
 	case scan == sensitivity.Pending():
 		v.reason = PendingScan
