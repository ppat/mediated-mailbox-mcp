control: A deployable's configuration type is pinned field by field
removes: a value is added to the migrator's configuration without updating the pinned field list
packages: ./core/config
tests: TestTheProgramTypesArePinned
scheduled-count: no

diff --git a/core/config/programs.go b/core/config/programs.go
--- a/core/config/programs.go
+++ b/core/config/programs.go
@@ -325,6 +325,8 @@ type Migrator struct {
 	// every grant of the chain is made to. The project names no database user, so it has no default
 	// (ADR-0048, ADR-0139, ADR-0143).
 	ApplicationUser string `yaml:"application_user" settings:"required"`
+	// Timeout bounds the whole run.
+	Timeout string `yaml:"timeout"`
 }
 
