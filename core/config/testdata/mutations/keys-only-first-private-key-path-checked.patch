control: The credential section is validated before any key file is read
removes: only the first private key path is checked, so an empty later one is accepted
packages: ./core/config
tests: TestAnUnusableKeysValueIsRefused/an_empty_later_private_key_path
scheduled-count: no

diff --git a/core/config/keys.go b/core/config/keys.go
index ca07b78e..a56b17cb 100644
--- a/core/config/keys.go
+++ b/core/config/keys.go
@@ -27,7 +27,7 @@ func (k Keys) Check() error {
 	case len(k.PrivateKeyFiles) == 0:
 		return errors.New("credential.private_key_files names no file")
 	}
-	for i, path := range k.PrivateKeyFiles {
+	for i, path := range k.PrivateKeyFiles[:1] {
 		if path == "" {
 			return errors.New("credential.private_key_files entry " + strconv.Itoa(i) + " is empty")
 		}
