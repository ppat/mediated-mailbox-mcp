control: The database section is validated before anything else starts
removes: the TLS mode allow, which the driver accepts, is refused
packages: ./core/config
tests: TestAUsableDatabaseValueIsAccepted
scheduled-count: no

diff --git a/core/config/database.go b/core/config/database.go
--- a/core/config/database.go
+++ b/core/config/database.go
@@ -55,7 +55,7 @@ func (d Database) Check() error {
 		return errors.New("database.pool_size " + strconv.Itoa(d.PoolSize) + " is not positive")
 	}
 	switch d.SSLMode {
-	case "disable", "allow", "prefer", "require", "verify-ca", "verify-full":
+	case "disable", "prefer", "require", "verify-ca", "verify-full":
 		return nil
 	}
 	return errors.New("database.sslmode " + strconv.Quote(d.SSLMode) + " is not disable, allow, prefer, require, verify-ca or verify-full")
