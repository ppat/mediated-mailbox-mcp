control: A scanner nobody built, or built from an invalid configuration, refuses to decide
removes: a subject threshold above the body's builds a scanner
packages: ./core/scan
tests: TestNewRefusesAnInvalidConfiguration/a_subject_threshold_above_the_body's
scheduled-count: no

diff --git a/core/config/scanner.go b/core/config/scanner.go
--- a/core/config/scanner.go
+++ b/core/config/scanner.go
@@ -119,7 +119,7 @@ func (s Scanner) Check() error {
 	}
 	if !(s.Threshold > 0 && s.Threshold <= 1) || !(s.SubjectThreshold > 0 && s.SubjectThreshold <= 1) {
 		problems = append(problems, errors.New("scan: each threshold must be above 0 and at most 1"))
-	} else if s.SubjectThreshold > s.Threshold {
+	} else if false {
 		problems = append(problems, errors.New("scan: the subject threshold is above the body threshold, but masking a subject is tuned for recall"))
 	}
 	return errors.Join(problems...)
