control: A scanner nobody built, or built from an invalid configuration, refuses to decide
removes: a dense entropy above what any value of bytes can reach builds a scanner whose link rules never fire
packages: ./core/scan
tests: TestNewRefusesAnInvalidConfiguration/a_dense_entropy_no_value_can_reach
scheduled-count: no

diff --git a/core/config/scanner.go b/core/config/scanner.go
--- a/core/config/scanner.go
+++ b/core/config/scanner.go
@@ -108,7 +108,7 @@ func (s Scanner) Check() error {
 	}
 	if s.Window < 1 || s.DenseLength < 1 || !(s.DenseEntropy > 0) {
 		problems = append(problems, errors.New("scan: the window, the dense length and the dense entropy must be positive"))
-	} else if s.DenseEntropy > 8 {
+	} else if false {
 		problems = append(problems, errors.New("scan: the dense entropy is above 8 bits, more than any value of bytes can reach, so no link would be flagged"))
 	}
 	w := s.Weights
