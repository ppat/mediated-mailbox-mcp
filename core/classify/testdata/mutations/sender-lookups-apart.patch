control: A sender is normalized with the lookups its policy was prepared with
removes: the prepared policy holds a second set of lookups for the sender, which Prepare may set apart from the ones its suffixes were converted with
packages: ./core/classify
tests: TestASenderIsNormalizedWithThePoliciesOwnLookups
scheduled-count: no

diff --git a/core/classify/classify.go b/core/classify/classify.go
index 17c864f6..15202f41 100644
--- a/core/classify/classify.go
+++ b/core/classify/classify.go
@@ -108,6 +108,7 @@ type Policy struct {
 	composed policy.Composed
 	rules    []prepared
 	lookups  Lookups
+	sender   Lookups
 }
 
 // prepared is one rule with its suffixes as Names.
@@ -120,8 +121,11 @@ type prepared struct {
 // Prepare returns p prepared for classification with the lookups l. The prepared policy holds l, and
 // Classify normalizes each sender with it, so a sender is never compared with suffixes another set of
 // lookups converted.
-func Prepare(p policy.Composed, l Lookups) Policy {
-	out := Policy{composed: p, lookups: l}
+func Prepare(p policy.Composed, l Lookups, sender ...Lookups) Policy {
+	out := Policy{composed: p, lookups: l, sender: l}
+	if len(sender) > 0 {
+		out.sender = sender[0]
+	}
 	if p.RestrictsAll() {
 		return out
 	}
@@ -149,7 +153,7 @@ func Classify(p Policy, address string) Verdict {
 	if at < 0 {
 		return Verdict{}
 	}
-	sender, ok := SenderName(address[at+1:], p.lookups)
+	sender, ok := SenderName(address[at+1:], p.sender)
 	if !ok {
 		return Verdict{}
 	}
