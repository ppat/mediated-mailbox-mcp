control: An overlay only adds restrictions to its own account
removes: every account's policy holds every account's overlay rules
packages: ./core/policy
tests: TestComposingAnOverlayNeverDropsABaseRule TestForComposesTheBaseWithTheAccountsOverlay/acct-c
scheduled-count: no

diff --git a/core/policy/policy.go b/core/policy/policy.go
index 530dbd3..60761aa 100644
--- a/core/policy/policy.go
+++ b/core/policy/policy.go
@@ -78,7 +78,11 @@ func (s Snapshot) For(account string) Composed {
 	if !s.loaded || account == "" {
 		return Composed{}
 	}
-	return Composed{loaded: true, rules: slices.Concat(s.base, s.overlays[account])}
+	rules := slices.Clone(s.base)
+	for _, overlay := range s.overlays {
+		rules = append(rules, overlay...)
+	}
+	return Composed{loaded: true, rules: rules}
 }
 
 // Load validates rows and returns the snapshot they describe, or every problem found, joined.
