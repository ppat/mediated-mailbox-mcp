control: The scan gate scans a message with no List-Id from a listed local part
removes: a listed local part asks for a scan even on a message carrying a List-Id
packages: ./core/scangate
tests: TestDecide/a_noreply_local_part_with_a_List-Id
scheduled-count: no

diff --git a/core/scangate/scangate.go b/core/scangate/scangate.go
index 587af5b..0b48e7d 100644
--- a/core/scangate/scangate.go
+++ b/core/scangate/scangate.go
@@ -176,7 +176,7 @@ func Decide(c Config, now mail.UnixMilli, in Input) Verdict {
 		return Verdict{}
 	case in.SubjectMasked:
 		return Verdict{reason: SubjectSignal}
-	case !in.ListID && noReply(c, in.LocalPart):
+	case noReply(c, in.LocalPart):
 		return Verdict{reason: NoReplyLocalPart}
 	case !in.ListID && in.SizeBytes < c.SmallBytes && int64(now-in.SentAt) < c.RecentAgeMillis:
 		return Verdict{reason: RecentSmall}
