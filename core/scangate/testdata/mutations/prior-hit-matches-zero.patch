control: The scan gate scans a sender with a prior scan hit
removes: a sender with no prior hit counts as having one, so the prior-hit rule scans every sender it reaches
packages: ./core/scangate
tests: TestDecide/a_high-volume_sender_with_no_prior_hit,_a_List-Id_and_no_subject_signal TestDecide/a_sender_at_the_high-volume_mark
scheduled-count: no

diff --git a/core/scangate/scangate.go b/core/scangate/scangate.go
index 587af5b..db33b15 100644
--- a/core/scangate/scangate.go
+++ b/core/scangate/scangate.go
@@ -182,7 +182,7 @@ func Decide(c Config, now mail.UnixMilli, in Input) Verdict {
 		return Verdict{reason: RecentSmall}
 	case in.SenderVolume < c.LowVolume:
 		return Verdict{reason: LowVolume}
-	case in.PriorHits > 0:
+	case in.PriorHits >= 0:
 		return Verdict{reason: PriorHit}
 	case in.SenderVolume > c.HighVolume && in.PriorHits == 0 && in.ListID:
 		return Verdict{reason: HighVolumeNoHits}
