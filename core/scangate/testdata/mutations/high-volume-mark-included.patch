control: The high-volume rule skips only a message carrying a List-Id from a sender above the mark with no prior hit
removes: a sender exactly at the high-volume mark counts as high volume
packages: ./core/scangate
tests: TestDecide/a_sender_at_the_high-volume_mark
scheduled-count: no

diff --git a/core/scangate/scangate.go b/core/scangate/scangate.go
index 587af5b..26abcb7 100644
--- a/core/scangate/scangate.go
+++ b/core/scangate/scangate.go
@@ -184,7 +184,7 @@ func Decide(c Config, now mail.UnixMilli, in Input) Verdict {
 		return Verdict{reason: LowVolume}
 	case in.PriorHits > 0:
 		return Verdict{reason: PriorHit}
-	case in.SenderVolume > c.HighVolume && in.PriorHits == 0 && in.ListID:
+	case in.SenderVolume >= c.HighVolume && in.PriorHits == 0 && in.ListID:
 		return Verdict{reason: HighVolumeNoHits}
 	default:
 		return Verdict{reason: Default}
