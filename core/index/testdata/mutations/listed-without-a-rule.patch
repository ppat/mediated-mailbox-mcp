control: An added rule reaches the stored sender classes by its effect
removes: a domain the policy restricts with no rule is listed too, so a policy that never loaded restricts every stored sender
packages: ./core/index
tests: TestListed TestListed/a_policy_that_never_loaded
scheduled-count: no

diff --git a/core/index/scan.go b/core/index/scan.go
index 6e464728..e26f3581 100644
--- a/core/index/scan.go
+++ b/core/index/scan.go
@@ -38,7 +38,7 @@ type Listing struct {
 func Listed(p classify.Policy, normal []string) []Listing {
 	var out []Listing
 	for _, d := range normal {
-		if v := classify.Classify(p, "@"+d); v.Reason() == classify.Listed {
+		if v := classify.Classify(p, "@"+d); v.Class().Restricted() {
 			out = append(out, Listing{Domain: d, Rule: v.Rule()})
 		}
 	}
