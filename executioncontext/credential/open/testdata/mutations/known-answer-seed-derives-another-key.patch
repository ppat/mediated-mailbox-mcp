control: This build opens a value an earlier build sealed, with the key pair an earlier build wrote
removes: a seed is expanded into its key pair by HPKE's DeriveKeyPair, so this build derives another key pair from the seed an earlier build wrote
packages: ./executioncontext/credential/open
tests: TestThisBuildOpensAValueAnEarlierBuildSealed TestTheSeedDerivesThePublicKeyAnEarlierBuildWrote
scheduled-count: no

diff --git a/executioncontext/credential/open/open.go b/executioncontext/credential/open/open.go
index 3a975318..44fb6c18 100644
--- a/executioncontext/credential/open/open.go
+++ b/executioncontext/credential/open/open.go
@@ -43,7 +43,7 @@ func ParsePrivateKey(b []byte) (PrivateKey, error) {
 	if len(b) != SeedSize {
 		return PrivateKey{}, fmt.Errorf("credential: a private key is a %d-byte seed, and this one is %d bytes", SeedSize, len(b))
 	}
-	key, err := seal.KEM().NewPrivateKey(b)
+	key, err := seal.KEM().DeriveKeyPair(b)
 	if err != nil {
 		return PrivateKey{}, fmt.Errorf("credential: reading a private key: %w", err)
 	}
