control: This build opens a value an earlier build sealed, with the key pair an earlier build wrote
removes: the additional data no longer binds the key identifier, so this build authenticates less than the earlier build sealed under, while a value sealed and opened by one build still opens
packages: ./executioncontext/credential/open
tests: TestThisBuildOpensAValueAnEarlierBuildSealed
scheduled-count: no

diff --git a/executioncontext/credential/seal/seal.go b/executioncontext/credential/seal/seal.go
index 9237b3c3..5885cd65 100644
--- a/executioncontext/credential/seal/seal.go
+++ b/executioncontext/credential/seal/seal.go
@@ -237,7 +237,6 @@ func AdditionalData(version byte, id KeyID, c Context) []byte {
 	name := c.purpose.String()
 	out := make([]byte, 0, HeaderSize+1+4+len(name)+4+len(c.row))
 	out = append(out, version)
-	out = append(out, id[:]...)
 	out = append(out, 0)
 	out = binary.BigEndian.AppendUint32(out, uint32(len(name))) //nolint:gosec // a purpose is one of two short constants
 	out = append(out, name...)
