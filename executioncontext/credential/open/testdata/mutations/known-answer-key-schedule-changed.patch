control: This build opens a value an earlier build sealed, with the key pair an earlier build wrote
removes: the suite's key schedule runs on HKDF-SHA384, so this build derives other keys from an encapsulated key an earlier build made, as a Go release following a changed X-Wing draft would
packages: ./executioncontext/credential/open
tests: TestThisBuildOpensAValueAnEarlierBuildSealed
scheduled-count: no

diff --git a/executioncontext/credential/seal/seal.go b/executioncontext/credential/seal/seal.go
index 9237b3c3..195581df 100644
--- a/executioncontext/credential/seal/seal.go
+++ b/executioncontext/credential/seal/seal.go
@@ -55,7 +55,7 @@ const info = "mediated-mailbox credential"
 func KEM() hpke.KEM { return hpke.MLKEM768X25519() }
 
 // KDF returns the suite's key derivation function.
-func KDF() hpke.KDF { return hpke.HKDFSHA256() }
+func KDF() hpke.KDF { return hpke.HKDFSHA384() }
 
 // AEAD returns the suite's authenticated encryption.
 func AEAD() hpke.AEAD { return hpke.ChaCha20Poly1305() }
