control: Every sealer seals to one current key, named by an identifier derived from it
removes: the key identifier is hashed from the public key without the domain string
packages: ./executioncontext/credential/seal
tests: TestAKeyIdentifierIsDerivedFromTheKey
scheduled-count: no

diff --git a/executioncontext/credential/seal/seal.go b/executioncontext/credential/seal/seal.go
index a76d878..71bc9df 100644
--- a/executioncontext/credential/seal/seal.go
+++ b/executioncontext/credential/seal/seal.go
@@ -72,7 +72,7 @@ func (id KeyID) String() string { return hex.EncodeToString(id[:]) }
 // IDOf returns the identifier of a public key, the first 16 bytes of SHA-256 over a fixed domain
 // string and the key.
 func IDOf(publicKey []byte) KeyID {
-	sum := sha256.Sum256(append([]byte(keyIDDomain), publicKey...))
+	sum := sha256.Sum256(publicKey)
 	var id KeyID
 	copy(id[:], sum[:KeyIDSize])
 	return id
