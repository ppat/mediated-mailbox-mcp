control: A reload its caller cancelled keeps the active policy and raises no alarm
removes: a reload its caller cancelled is counted as a failed read, so a process shutting down mid-reload raises the alarm
packages: ./executioncontext/policyload
tests: TestAReloadItsCallerCancelledRaisesNoAlarm
scheduled-count: no
integration: yes

diff --git a/executioncontext/policyload/load.go b/executioncontext/policyload/load.go
index 9e0644fd..4f66dc57 100644
--- a/executioncontext/policyload/load.go
+++ b/executioncontext/policyload/load.go
@@ -153,9 +153,6 @@ func (l *Loader) Reload(ctx context.Context) error {
 	if errors.Is(err, errTornBase) {
 		rows, err = l.read(ctx)
 	}
-	if err != nil && errors.Is(ctx.Err(), context.Canceled) {
-		return fmt.Errorf("the policy reload was cancelled before it finished, so the active policy stays: %w", ctx.Err())
-	}
 	if err != nil {
 		l.metrics.failed()
 		return fmt.Errorf("%w: %w", ErrUntrustedRead, err)
