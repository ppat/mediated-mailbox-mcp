control: The policy loader reads the accounts it is set to from its next reload on
removes: SetAccounts takes no account or an empty name, as New refuses
packages: ./executioncontext/policyload
tests: TestSetAccountsChangesWhatTheNextReloadReads
scheduled-count: no
integration: yes


diff --git a/executioncontext/policyload/load.go b/executioncontext/policyload/load.go
index a3a089f..d76c994 100644
--- a/executioncontext/policyload/load.go
+++ b/executioncontext/policyload/load.go
@@ -113,10 +113,7 @@ func New(db tx.Beginner, accounts []string, reg prometheus.Registerer) (*Loader,
 // accounts it was read for until then, so an account added here gets the policy that restricts
 // every sender until a reload reads its rules.
 func (l *Loader) SetAccounts(accounts []string) error {
-	read, err := readable(accounts)
-	if err != nil {
-		return err
-	}
+	read := accounts
 	l.mu.Lock()
 	defer l.mu.Unlock()
 	l.accounts = read
