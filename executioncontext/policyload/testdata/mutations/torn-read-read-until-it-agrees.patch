control: A base edit landing between two accounts' reads is read again, and fails the reload only when edits land through both reads
removes: a reload reads once more for each disagreement, up to two more times, so edits landing through two reads no longer fail it
packages: ./executioncontext/policyload
tests: TestAFailedReadNeverReplacesTheActivePolicy TestAFailedReadNeverReplacesTheActivePolicy/a_base_rule_is_added_between_two_accounts'_reads,_twice
scheduled-count: no
integration: yes

diff --git a/executioncontext/policyload/load.go b/executioncontext/policyload/load.go
index 9e0644fd..e07b4bb9 100644
--- a/executioncontext/policyload/load.go
+++ b/executioncontext/policyload/load.go
@@ -150,8 +150,10 @@ func (l *Loader) Reload(ctx context.Context) error {
 	l.mu.Lock()
 	defer l.mu.Unlock()
 	rows, err := l.read(ctx)
-	if errors.Is(err, errTornBase) {
-		rows, err = l.read(ctx)
+	for range 2 {
+		if errors.Is(err, errTornBase) {
+			rows, err = l.read(ctx)
+		}
 	}
 	if err != nil && errors.Is(ctx.Err(), context.Canceled) {
 		return fmt.Errorf("the policy reload was cancelled before it finished, so the active policy stays: %w", ctx.Err())
