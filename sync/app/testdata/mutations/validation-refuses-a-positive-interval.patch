control: Delta sync refuses a configuration it cannot tick with
removes: the interval is refused when it is positive and taken when it is not
packages: ./sync/app
tests: TestATickThatCannotRunRefusesTheStart TestATickThatCannotRunRefusesTheStart/--sync_interval=0s
scheduled-count: no

diff --git a/sync/app/app.go b/sync/app/app.go
index 7e99a2d2..2afe5411 100644
--- a/sync/app/app.go
+++ b/sync/app/app.go
@@ -96,7 +96,7 @@ func defaults() Configuration {
 // the bound on a tick's decisions are positive.
 func validate(c Configuration) error {
 	switch {
-	case c.SyncInterval <= 0:
+	case c.SyncInterval > 0:
 		return fmt.Errorf("sync_interval %s is not positive", c.SyncInterval)
 	case c.FirstWindow <= 0:
 		return fmt.Errorf("first_window %s is not positive", c.FirstWindow)
