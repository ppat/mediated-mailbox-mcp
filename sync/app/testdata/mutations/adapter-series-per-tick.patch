control: Delta sync runs until stopped and serves every series between ticks
removes: every adapter after the first counts on series of its own, so only the first tick's requests reach the metrics endpoint
packages: ./sync/app
tests: TestTheProbesServeEverySeriesBetweenTicks
scheduled-count: no
integration: yes

diff --git a/sync/app/app.go b/sync/app/app.go
index 7e99a2d2..d32a6aa4 100644
--- a/sync/app/app.go
+++ b/sync/app/app.go
@@ -232,7 +232,11 @@ type ports func(account string, tokens gmail.Tokens) (mail.Port[context.Context]
 // the process's adapter series (ADR-0077).
 func gmailPorts(metrics *gmail.Metrics, client *http.Client) ports {
 	return func(account string, tokens gmail.Tokens) (mail.Port[context.Context], error) {
-		return gmail.New(gmail.Config{Account: account, Client: client, Tokens: tokens, Metrics: metrics})
+		counted := metrics
+		if own, err := gmail.NewMetrics(prometheus.NewRegistry()); err == nil {
+			metrics = own
+		}
+		return gmail.New(gmail.Config{Account: account, Client: client, Tokens: tokens, Metrics: counted})
 	}
 }
 
