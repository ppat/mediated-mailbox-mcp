control: A credential the provider refuses is read again from its row before the refusal is reported
removes: a refused credential the row still holds is used for a second call
packages: ./sync/app
tests: TestARefusalOfTheStoredCredentialIsReported
scheduled-count: no
integration: yes

diff --git a/accountload/session/session.go b/accountload/session/session.go
index f4fb328a..51c1035b 100644
--- a/accountload/session/session.go
+++ b/accountload/session/session.go
@@ -230,7 +230,7 @@ func Call[T any](ctx context.Context, s *Session, call func(context.Context, mai
 	refused := s.built
 	refused.Credential = s.conn.source.Credential()
 	creds := credentials(reread)
-	if !reread.Connected() || same(creds, refused) {
+	if !reread.Connected() {
 		return out, err
 	}
 	conn := s.connector.connect(creds)
