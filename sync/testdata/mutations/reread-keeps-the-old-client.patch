control: A served account's token source is built from the OAuth client the account connects through and the account's own refresh token
removes: delta sync's re-read after a refusal keeps the client the source was built with
packages: ./sync
tests: TestARereadAfterAMoveBuildsTheSourceFromTheNewClient
scheduled-count: no
integration: yes

diff --git a/sync/main.go b/sync/main.go
index 2fea0413..592a1331 100644
--- a/sync/main.go
+++ b/sync/main.go
@@ -463,6 +463,7 @@ func retried[T any](ctx context.Context, r *reauthorizing, call func(context.Con
 	held := r.creds
 	held.RefreshToken = r.source.RefreshToken()
 	creds, ok := sourceCredentials(reread)
+	creds.ClientID, creds.ClientSecret = held.ClientID, held.ClientSecret
 	if !ok || creds == held {
 		return out, err
 	}
