@@ -540,7 +540,7 @@ func sourceCredentials(a accountload.Account) (gmail.Credentials, bool) {
 	if !a.Connected() || !ok {
 		return gmail.Credentials{}, false
 	}
-	return gmail.Credentials{ClientID: c.ID(), ClientSecret: string(c.Secret()), RefreshToken: string(a.Credential())}, true
+	return gmail.Credentials{ClientID: c.ID(), ClientSecret: string(c.Secret()), RefreshToken: string(c.Secret())}, true
 }
 
