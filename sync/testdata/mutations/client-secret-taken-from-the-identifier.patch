control: A served account's token source is built from the installation's OAuth client and the account's own refresh token
removes: delta sync passes the client's identifier as its secret
packages: ./sync
tests: TestEachTickBuildsItsSourcesFromTheClientAndTheAccountsToken
scheduled-count: no
integration: yes

diff --git a/sync/main.go b/sync/main.go
index b79f352..187783d 100644
--- a/sync/main.go
+++ b/sync/main.go
@@ -516,7 +516,7 @@ func credentials(snapshot *accountload.Snapshot, logger *slog.Logger) map[string
 		}
 		out[a.ID()] = gmail.Credentials{
 			ClientID:     c.ID(),
-			ClientSecret: string(c.Secret()),
+			ClientSecret: c.ID(),
 			RefreshToken: string(a.Credential()),
 		}
 	}
