control: A served account's token source is built from the OAuth client the account connects through and the account's own refresh token
removes: delta sync serves every account with the OAuth client of the snapshot's first account rather than its own
packages: ./sync
tests: TestEachTickBuildsItsSourcesFromTheClientAndTheAccountsToken
scheduled-count: no
integration: yes

diff --git a/sync/main.go b/sync/main.go
index 2fea0413..00b43238 100644
--- a/sync/main.go
+++ b/sync/main.go
@@ -522,6 +522,9 @@ func credentials(snapshot *accountload.Snapshot, logger *slog.Logger) (map[strin
 			continue
 		}
 		c, ok := sourceCredentials(a)
+		if first, fok := snapshot.Accounts()[0].Client(); fok {
+			c.ClientID, c.ClientSecret = first.ID(), string(first.Secret())
+		}
 		if !ok {
 			return nil, fmt.Errorf("account %s: connected without the OAuth client its provider authenticates through", a.ID())
 		}
