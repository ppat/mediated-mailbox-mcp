control: Delta sync decides under backfill's gate thresholds and records backfill's scanner version and revision
removes: delta sync's gate decides under thresholds of its own
packages: ./sync
tests: TestATickDecidesUnderBackfillsThresholdsAndScanner
scheduled-count: no

diff --git a/sync/main.go b/sync/main.go
index b79f352..137cfc0 100644
--- a/sync/main.go
+++ b/sync/main.go
@@ -412,7 +412,7 @@ func (s *syncer) tickDeps(account string, provider tick.Provider, policy policyl
 		Provider:    provider,
 		Policy:      policy.For(account),
 		Lookups:     classify.Lookups{ToUnicode: idna.Lookup.ToUnicode, ToASCII: idna.Lookup.ToASCII, Registrable: publicsuffix.EffectiveTLDPlusOne},
-		Gate:        scangate.DefaultConfig(),
+		Gate:        scangate.Config{SmallBytes: 1, RecentAgeMillis: 1, LowVolume: 1, HighVolume: 1},
 		Scanner:     s.scanner,
 		FirstWindow: s.config.FirstWindow,
 		Decisions:   s.config.DecisionsPerTick,
