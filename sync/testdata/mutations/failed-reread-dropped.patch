control: A credential the provider refuses is read again from its row before the refusal is reported
removes: a failed read of the refused credential is dropped and the refusal returned alone
packages: ./sync
tests: TestAFailedReadOfTheRefusedCredentialIsReported
scheduled-count: no
integration: yes

diff --git a/sync/main.go b/sync/main.go
index 2fea0413..7319a622 100644
--- a/sync/main.go
+++ b/sync/main.go
@@ -458,7 +458,7 @@ func retried[T any](ctx context.Context, r *reauthorizing, call func(context.Con
 	}
 	reread, rerr := r.syncer.loader.Reread(ctx, r.account)
 	if rerr != nil {
-		return out, errors.Join(err, fmt.Errorf("reading the refused credential again: %w", rerr))
+		return out, err
 	}
 	held := r.creds
 	held.RefreshToken = r.source.RefreshToken()
