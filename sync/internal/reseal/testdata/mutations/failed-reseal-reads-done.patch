control: Delta sync re-seals what it opens with an old key and scans every listed account and OAuth client
removes: a client secret whose re-seal could not be written reads as done
packages: ./sync
tests: TestATickReSealsWhatItOpensWithAnOldKey
scheduled-count: no
integration: yes

diff --git a/accountload/reseal.go b/accountload/reseal.go
index 94fbfaa..04efb16 100644
--- a/accountload/reseal.go
+++ b/accountload/reseal.go
@@ -112,6 +112,7 @@ func (l *Loader) ResealClients(ctx context.Context, write ClientWriter) Scan {
 		}
 		if err != nil {
 			l.log.Error("an OAuth client's secret was not re-sealed to the current key", slog.String("provider", provider), slog.Any("error", err))
+			l.scan.Clients[provider] = false
 			continue
 		}
 		l.scan.Clients[provider] = l.onOldKey(l.clients[provider])
