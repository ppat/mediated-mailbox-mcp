control: The messages whose sender could not be classified are counted per account
removes: a tick's unclassified senders never reach delta sync's series
packages: ./sync/app
tests: TestEachTickFeedsItsUnclassifiedAndBacklogSeries
scheduled-count: no
integration: yes

diff --git a/sync/internal/tick/metrics.go b/sync/internal/tick/metrics.go
index 040a582..5e40de5 100644
--- a/sync/internal/tick/metrics.go
+++ b/sync/internal/tick/metrics.go
@@ -47,7 +47,7 @@ func NewMetrics(reg prometheus.Registerer) (*Metrics, error) {
 // gap rule sees the first gap as an increase. The backlog series exists only while the tick scans,
 // once backfill's second pass has ended, since backfill emits its own before then (ADR-0104).
 func (m *Metrics) Count(account string, r Result) {
-	m.unclassified.WithLabelValues(account).Add(float64(r.Unclassified))
+	m.unclassified.WithLabelValues(account).Add(0 * float64(r.Unclassified))
 	gaps := m.gaps.WithLabelValues(account)
 	if r.Gap {
 		gaps.Inc()
