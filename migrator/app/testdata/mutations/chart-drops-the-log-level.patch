control: The chart sets the migration Job a configuration the migrator starts with
removes: the chart leaves the log level out of the Job's environment though the values set one
packages: ./migrator/app
tests: TestTheChartSetsAConfigurationTheMigratorStartsWith
scheduled-count: no

diff --git a/packaging/chart/templates/migration/job.yaml b/packaging/chart/templates/migration/job.yaml
index 982bfc6a..bd745a8f 100644
--- a/packaging/chart/templates/migration/job.yaml
+++ b/packaging/chart/templates/migration/job.yaml
@@ -49,12 +49,10 @@ spec:
       containers:
       - name: migration
         image: {{ include "mm.image" (list $ $v.image) }}
         imagePullPolicy: {{ .Values.global.image.pullPolicy }}
         env:
-        - name: MEDIATED_MAILBOX_LOG_LEVEL
-          value: {{ $c.log_level | quote }}
         {{- range $key, $value := $c.database }}
         - name: {{ printf "MEDIATED_MAILBOX_DATABASE__%s" (upper $key) }}
           value: {{ $value | toString | quote }}
         {{- end }}
         {{- with $v.goSoftMemoryLimit }}
