control: The chart sets the migration Job a configuration the migrator starts with
removes: the chart takes the migrator's log level from the shared configuration whatever the migrator's own block sets
packages: ./migrator/app
tests: TestTheChartSetsAConfigurationTheMigratorStartsWith
scheduled-count: no

diff --git a/packaging/chart/templates/_config.tpl b/packaging/chart/templates/_config.tpl
index b8bf7d3b..327e3b79 100644
--- a/packaging/chart/templates/_config.tpl
+++ b/packaging/chart/templates/_config.tpl
@@ -51,7 +51,7 @@ file, since no ConfigMap of the release exists at pre-install (ADR-0129, ADR-013
 {{- define "mm.config.migration" -}}
 {{- $v := .Values.migration }}
 {{- $user := required "database.migrationUser is required" .Values.database.migrationUser }}
-{{- toYaml (dict "log_level" (default .Values.sharedConfig.log_level (index $v.config "log_level")) "database" (include "mm.config.database" (list . $user (dict)) | fromYaml) "application_user" (include "mm.applicationUser" .)) }}
+{{- toYaml (dict "log_level" .Values.sharedConfig.log_level "database" (include "mm.config.database" (list . $user (dict)) | fromYaml) "application_user" (include "mm.applicationUser" .)) }}
 {{- end }}
 
 {{- define "mm.config.api" -}}
