control: The recorded authentication outcome is the latest attempt, and recording an older one changes nothing
removes: the statement drops its predicate on the stored attempt's time, so the last write wins and an older attempt replaces a later one
packages: ./worker/internal/backfill
tests: TestOnlyALaterAttemptIsRecorded
scheduled-count: no
integration: yes

diff --git a/db/accountstate/authentication.sql b/db/accountstate/authentication.sql
index 8f25cd0c..2ce3336e 100644
--- a/db/accountstate/authentication.sql
+++ b/db/accountstate/authentication.sql
@@ -7,5 +7,4 @@ SET
     last_auth_at = @attempted_at,
     last_auth_outcome = @outcome
 WHERE
-    account_id = current_setting('app.account')
-    AND (last_auth_at IS NULL OR last_auth_at < @attempted_at);
+    account_id = current_setting('app.account');
diff --git a/db/accountstate/authentication.sql.go b/db/accountstate/authentication.sql.go
index 4b3f0fac..954df9fc 100644
--- a/db/accountstate/authentication.sql.go
+++ b/db/accountstate/authentication.sql.go
@@ -18,7 +18,6 @@ SET
     last_auth_outcome = $2
 WHERE
     account_id = current_setting('app.account')
-    AND (last_auth_at IS NULL OR last_auth_at < $1)
 `
 
