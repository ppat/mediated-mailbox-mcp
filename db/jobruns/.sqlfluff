# RF02 refuses an unqualified reference in a statement reading more than one table. The placeholder templater
# renders each parameter as its bare name, so every parameter of such a statement reads as an unqualified
# column. The statements here that need it are the UI's reads of the latest runs, the latest run in given
# states and the stream's runs, each joining its plan. RF04 stays excluded, as the root configuration excludes
# it, because a directory's exclusions replace the root's.
[sqlfluff]
exclude_rules = RF02, RF04
