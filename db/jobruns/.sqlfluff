# This file sets parameter values and nothing else. The placeholder templater renders a parameter with no value as its
# bare name, and RF02 then reports it as an unqualified column in a statement that reads more than one table. Such
# statements here are the UI's reads of the latest runs, the latest run in given states, the stream's runs, the runs
# dataset's rows, one run and its resumer, each joining its plan, the runs dataset's rows joining their failure counts,
# and the reads of a run's failures joined to their items' messages. Every parameter the statements here take is given a
# literal, so RF02 does not report a parameter here. The rule itself stays on, as it is everywhere. A new parameter here
# needs a value too.
[sqlfluff:templater:placeholder]
account_id = 1
as_of = 1
day_in = 1
day_out = 1
descending = 1
disposition_in = 1
disposition_out = 1
error_class_in = 1
error_class_out = 1
normal_domains = 1
page_in = 1
page_in_none = 1
page_out = 1
page_out_none = 1
pass = 1
pass_in = 1
pass_out = 1
range_end = 1
range_start = 1
row_offset = 1
run_id = 1
sender_in = 1
sender_in_none = 1
sender_out = 1
sender_out_none = 1
seq = 1
since = 1
sort_column = 1
state_in = 1
state_out = 1
states = 1
workload = 1
workload_in = 1
workload_out = 1
