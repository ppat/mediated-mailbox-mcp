control: A transaction that did not set the account fails before any data access
removes: the helper sets the account for the session rather than the transaction, so it outlives the transaction
packages: ./db/tx
tests: TestTheAccountEndsWithItsTransaction
scheduled-count: no
integration: yes

diff --git a/db/tx/tx.go b/db/tx/tx.go
index 5572ecfc..386a9821 100644
--- a/db/tx/tx.go
+++ b/db/tx/tx.go
@@ -69,7 +69,7 @@ func Run(ctx context.Context, db Beginner, account string, fn func(pgx.Tx) error
 	return scoped(ctx, db, scope{
 		what: "the account",
 		// set_config with its third argument true is SET LOCAL, taking the value as a parameter.
-		set:  "-- name: SetTransactionAccount :exec\nSELECT set_config('app.account', $1, true)",
+		set:  "-- name: SetTransactionAccount :exec\nSELECT set_config('app.account', $1, false)",
 		args: []any{account},
 		read: "-- name: ReadTransactionAccount :one\nSELECT coalesce(current_setting('app.account', true), '')",
 		held: func(readBack string) error { return core.AccountHeld(account, readBack) },
