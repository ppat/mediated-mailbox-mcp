control: A base-policy transaction names no account
removes: RunBase neither sets the account empty nor reads it back, so a base-policy transaction runs under whatever account the connection's session holds
packages: ./db/tx
tests: TestRunBaseEmptiesAnAccountTheConnectionHeld
scheduled-count: no
integration: yes

diff --git a/db/tx/tx.go b/db/tx/tx.go
index 2d136673..4147bf4e 100644
--- a/db/tx/tx.go
+++ b/db/tx/tx.go
@@ -94,16 +94,6 @@ func RunBase(ctx context.Context, db Beginner, fn func(pgx.Tx) error) error {
 		return ErrInsideTransaction
 	}
 	return pgx.BeginFunc(ctx, db, func(tx pgx.Tx) error {
-		if _, err := tx.Exec(ctx, "-- name: SetBaseScope :exec\nSELECT set_config('app.account', '', true)"); err != nil {
-			return fmt.Errorf("setting the base policy's scope: %w", err)
-		}
-		var account string
-		if err := tx.QueryRow(ctx, "-- name: ReadBaseScope :one\nSELECT coalesce(current_setting('app.account', true), '')").Scan(&account); err != nil {
-			return fmt.Errorf("reading the base policy's scope back: %w", err)
-		}
-		if account != "" {
-			return fmt.Errorf("%w: it reads back as %q", ErrBaseNotSet, account)
-		}
 		return fn(tx)
 	})
 }
