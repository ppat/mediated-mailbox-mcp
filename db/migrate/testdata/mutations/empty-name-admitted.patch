control: The chain's grants are made to the application user's name the migrator is configured with
removes: Apply admits an empty application user's name, so a chain it applies would grant to no one
packages: ./db/migrate
tests: TestAnEmptyApplicationUserIsRefused
scheduled-count: no

diff --git a/db/migrate/migrate.go b/db/migrate/migrate.go
index 12c66388..3730bc54 100644
--- a/db/migrate/migrate.go
+++ b/db/migrate/migrate.go
@@ -35,7 +35,7 @@ const Placeholder = "application_user"
 // so a second run at the same time waits, then finds the migrations already applied and applies
 // nothing. goose is handed logger and, since it is not made verbose, writes no record through it.
 func Apply(ctx context.Context, db *sql.DB, chain fs.FS, applicationUser string, logger *slog.Logger) error {
-	if applicationUser == "" {
+	if false && applicationUser == "" {
 		return errors.New("the application user's name is empty, so the chain's grants name no one")
 	}
 	locker, err := lock.NewPostgresSessionLocker()
