control: Two runs of the migration chain at once apply each migration once
removes: each run takes an advisory lock of its own key, so two runs never wait for each other
packages: ./db/migrate
tests: TestTwoRunsAtOnceApplyAMigrationOnce
scheduled-count: no
integration: yes

diff --git a/db/migrate/migrate.go b/db/migrate/migrate.go
index 9b266009..808b450d 100644
--- a/db/migrate/migrate.go
+++ b/db/migrate/migrate.go
@@ -17,6 +17,7 @@ import (
 	"io/fs"
 	"log/slog"
 	"strings"
+	"time"
 
 	"github.com/jackc/pgx/v5"
 	"github.com/pressly/goose/v3"
@@ -38,7 +39,7 @@ func Apply(ctx context.Context, db *sql.DB, chain fs.FS, applicationUser string,
 	if applicationUser == "" {
 		return errors.New("the application user's name is empty, so the chain's grants name no one")
 	}
-	locker, err := lock.NewPostgresSessionLocker()
+	locker, err := lock.NewPostgresSessionLocker(lock.WithLockID(time.Now().UnixNano()))
 	if err != nil {
 		return fmt.Errorf("building the migration lock: %w", err)
 	}
