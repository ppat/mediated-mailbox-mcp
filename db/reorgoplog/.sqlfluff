# This file sets parameter values and nothing else. The placeholder templater renders a parameter with no
# value as its bare name, and RF02 then reports it as an unqualified column in a statement that reads more
# than one table. Such statements here are the UI's count of an account's plan's op log rows, joining the plan
# that scopes it. Every parameter the statements here take is given a literal, so RF02 does not report a
# parameter here. The rule itself stays on, as it is everywhere. A new parameter here needs a value too.
[sqlfluff:templater:placeholder]
account_id = 1
plan_id = 1
