# RF02 refuses an unqualified reference in a statement reading more than one table. The placeholder templater
# renders each parameter as its bare name, so every parameter of such a statement reads as an unqualified
# column. The statement here that needs it is the UI's count of an account's plan's op log rows, joining the
# plan that scopes it. RF04 stays excluded, as the root configuration excludes it, because a directory's
# exclusions replace the root's.
[sqlfluff]
exclude_rules = RF02, RF04
