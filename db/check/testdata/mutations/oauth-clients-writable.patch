control: The application user reads every OAuth client and writes what the client setup and the re-seal write
removes: the application user's update on oauth_clients covers every column, so a client's name or provider can be changed with no statement that uses the grant
packages: ./db/check
tests: TestTheApplicationUserReadsAndWritesTheOAuthClients TestTheApplicationUserReadsAndWritesTheOAuthClients/changes_a_client's_name_or_provider
scheduled-count: no
integration: yes

diff --git a/db/migrations/00003_grants.sql b/db/migrations/00003_grants.sql
index 809f1022..e4157a87 100644
--- a/db/migrations/00003_grants.sql
+++ b/db/migrations/00003_grants.sql
@@ -42,7 +42,7 @@ TO application_user;
 -- db/oauthclients/secret rewrites a client's secret by compare-and-set on the stored bytes. No
 -- statement changes a client's name or provider (ADR-0016, ADR-0084, ADR-0092, ADR-0106).
 GRANT INSERT (name, provider, client_id, client_secret, project_id),
-UPDATE (client_id, client_secret, project_id),
+UPDATE,
 DELETE ON oauth_clients TO application_user;
 
 -- The UI's account setup in db/accounts/setup writes an account's listing row with the client it
