control: The listing roles read every account's identifier, provider and client, and the heuristics job's role reads none
removes: the heuristics job's role is granted the accounts listing, which no decided consumer of it needs
packages: ./db/check
tests: TestTheListingRolesReadEveryAccount TestTheListingRolesReadEveryAccount/mediated_mailbox_propose
scheduled-count: no
integration: yes

diff --git a/db/migrations/00003_grants.sql b/db/migrations/00003_grants.sql
index 5a8ad6f..097ca77 100644
--- a/db/migrations/00003_grants.sql
+++ b/db/migrations/00003_grants.sql
@@ -553,7 +553,7 @@ TO mediated_mailbox_api, mediated_mailbox_backfill, mediated_mailbox_sync;
 -- so backfill's role and mediated_mailbox_organize, the role of reorg apply and rollback, keep the
 -- listing and hold no grant on a sealed credential or an OAuth client.
 GRANT SELECT (account_id, provider, oauth_client) ON accounts
-TO mediated_mailbox_api, mediated_mailbox_backfill, mediated_mailbox_sync, mediated_mailbox_organize;
+TO mediated_mailbox_api, mediated_mailbox_backfill, mediated_mailbox_sync, mediated_mailbox_organize, mediated_mailbox_propose;
 GRANT SELECT (account_id, credential), UPDATE (credential) ON account_state
 TO mediated_mailbox_api, mediated_mailbox_sync;
 GRANT SELECT (name, provider, client_id, client_secret) ON oauth_clients
