control: No runtime role can update or delete an audit row
removes: the chain grants the mediator's role UPDATE on the audit log
packages: ./db/check
tests: TestNoRuntimeRoleCanAlterTheAuditLog TestNoRuntimeRoleCanAlterTheAuditLog/mediated_mailbox_mediate/update
scheduled-count: no
integration: yes

diff --git a/db/migrations/00004_grants.sql b/db/migrations/00004_grants.sql
index eba1d5bc..92b019cb 100644
--- a/db/migrations/00004_grants.sql
+++ b/db/migrations/00004_grants.sql
@@ -94,6 +94,7 @@ GRANT SELECT (account_id, plan_id, description, status) ON reorg_plans TO mediat
 -- Each serve and each denial of a body is recorded through db/auditlog/record, which only the
 -- mediator's list admits, as an insert and nothing else (ADR-0002, ADR-0016).
 GRANT INSERT (account_id, actor, action, message_id, sensitivity, rule_ids) ON audit_log TO mediated_mailbox_mediate;
+GRANT INSERT, UPDATE ON audit_log TO mediated_mailbox_mediate;
 GRANT USAGE ON SEQUENCE audit_log_id_seq TO mediated_mailbox_mediate;
 
 -- Backfill (ADR-0075, ADR-0017).
