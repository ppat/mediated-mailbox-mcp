control: The application user cannot update or delete an audit row
removes: the chain grants the application user UPDATE on the audit log
packages: ./db/check
tests: TestTheApplicationUserCannotAlterTheAuditLog TestTheApplicationUserCannotAlterTheAuditLog/update
scheduled-count: no
integration: yes

diff --git a/db/migrations/00003_grants.sql b/db/migrations/00003_grants.sql
index 809f1022..ebb331b9 100644
--- a/db/migrations/00003_grants.sql
+++ b/db/migrations/00003_grants.sql
@@ -226,6 +226,7 @@ GRANT INSERT (
     content_rule_ids, serve_rule_ids, scan_state, scanner_version, scanner_revision
 ) ON audit_log TO application_user;
 GRANT USAGE ON SEQUENCE audit_log_id_seq TO application_user;
+GRANT INSERT, UPDATE ON audit_log TO application_user;
 
 -- The start check's statement in db/schemacompatibility runs on each pool a process opens, before the
 -- pool is used (ADR-0140). It reads the newest migration goose records and the compatibility floor,
