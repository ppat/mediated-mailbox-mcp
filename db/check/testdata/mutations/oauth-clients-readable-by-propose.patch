control: Only the roles that call a provider read oauth_clients and their own account's state, and the UI reads its account's progress and never a credential
removes: the heuristics job's role, which calls no provider, reads every OAuth client
packages: ./db/check
tests: TestOnlyTheProviderCallingRolesReadTheOAuthClients TestOnlyTheProviderCallingRolesReadTheOAuthClients/mediated_mailbox_propose/reads_a_client
scheduled-count: no
integration: yes

diff --git a/db/migrations/00003_grants.sql b/db/migrations/00003_grants.sql
index d8815de2..d3d00cb8 100644
--- a/db/migrations/00003_grants.sql
+++ b/db/migrations/00003_grants.sql
@@ -557,7 +557,7 @@ TO mediated_mailbox_api, mediated_mailbox_backfill, mediated_mailbox_sync, media
 GRANT SELECT (account_id, credential), UPDATE (credential) ON account_state
 TO mediated_mailbox_api, mediated_mailbox_sync;
 GRANT SELECT (name, provider, client_id, client_secret) ON oauth_clients
-TO mediated_mailbox_api, mediated_mailbox_sync;
+TO mediated_mailbox_api, mediated_mailbox_sync, mediated_mailbox_propose;
 
 -- The start check's statement, in db/schemacompatibility, runs under every role a deployable connects
