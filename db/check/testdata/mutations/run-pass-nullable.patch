control: The checked vocabularies refuse a value outside their closed set
removes: a run's pass may be null
packages: ./db/check
tests: TestARunRecordsOneOfTheBuiltJobKindsPairs
scheduled-count: no
integration: yes

diff --git a/db/migrations/00002_schema.sql b/db/migrations/00002_schema.sql
index f40c7fd3..fb72403c 100644
--- a/db/migrations/00002_schema.sql
+++ b/db/migrations/00002_schema.sql
@@ -327,7 +327,7 @@ CREATE TABLE job_runs (
     -- The job kind.
     workload text NOT NULL,
     -- Never null, so the latest-run reads compare it by equality, which an index serves.
-    pass text NOT NULL,
+    pass text,
     state text NOT NULL CHECK (state IN ('running', 'succeeded', 'failed')),
     -- Apply and rollback runs.
     plan_id uuid REFERENCES reorg_plans,
