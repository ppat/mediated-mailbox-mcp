packages: ./db/check
tests: TestNoAccountIdentifierIsAPathSegmentThePathCannotHold
scheduled-count: no
integration: yes

diff --git a/db/migrations/00022_ui_setups.sql b/db/migrations/00022_ui_setups.sql
index 38f2557c..26113dd3 100644
