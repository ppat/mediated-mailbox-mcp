control: The application user cannot update or delete an audit row
removes: the chain grants the application user TRUNCATE on the audit log, an erasing operation other than update and delete
packages: ./db/check
tests: TestTheApplicationUserCannotAlterTheAuditLog TestTheApplicationUserCannotAlterTheAuditLog/truncate
scheduled-count: no
integration: yes

diff --git a/db/migrations/00003_grants.sql b/db/migrations/00003_grants.sql
index 809f1022..f071d7e2 100644
--- a/db/migrations/00003_grants.sql
+++ b/db/migrations/00003_grants.sql
@@ -232,3 +232,4 @@ GRANT USAGE ON SEQUENCE audit_log_id_seq TO application_user;
 -- which describe the schema and no account.
 GRANT SELECT (version_id) ON goose_db_version TO application_user;
 GRANT SELECT (oldest_chain_version) ON schema_compatibility TO application_user;
+GRANT TRUNCATE ON audit_log TO application_user;
