control: No runtime role can update or delete an audit row
removes: the chain grants the reorganization workload's role TRUNCATE on the audit log, an erasing operation other than update and delete
packages: ./db/check
tests: TestNoRuntimeRoleCanAlterTheAuditLog TestNoRuntimeRoleCanAlterTheAuditLog/mediated_mailbox_organize/truncate
scheduled-count: no
integration: yes

diff --git a/db/migrations/00003_grants.sql b/db/migrations/00003_grants.sql
index d8815de2..8de982c1 100644
--- a/db/migrations/00003_grants.sql
+++ b/db/migrations/00003_grants.sql
@@ -558,6 +558,7 @@ GRANT SELECT (account_id, credential), UPDATE (credential) ON account_state
 TO mediated_mailbox_api, mediated_mailbox_sync;
 GRANT SELECT (name, provider, client_id, client_secret) ON oauth_clients
 TO mediated_mailbox_api, mediated_mailbox_sync;
+GRANT TRUNCATE ON audit_log TO mediated_mailbox_organize;
 
 -- The start check's statement, in db/schemacompatibility, runs under every role a deployable connects
 -- as, on each pool its process opens, before the pool is used (ADR-0140). It reads the newest
