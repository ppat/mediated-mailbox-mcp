control: The audit row's closed columns refuse a value outside their sets, and a body decision's row names what it rests on
removes: the audit row's content flags are checked to overlap the set rather than to sit inside it, so an unknown flag beside a known one is stored
packages: ./db/check
tests: TestTheAuditRowsColumnsRefuseAValueOutsideTheirSets
scheduled-count: no
integration: yes

diff --git a/db/migrations/00002_schema.sql b/db/migrations/00002_schema.sql
index 8f6d933f..d3456cf8 100644
--- a/db/migrations/00002_schema.sql
+++ b/db/migrations/00002_schema.sql
@@ -432,7 +432,7 @@ CREATE TABLE audit_log (
     -- The policy rule behind sender_class, and the scope that holds it (ADR-0110).
     class_rule_id text,
     class_rule_scope text CHECK (class_rule_scope IN ('base', 'account')),
-    content_flags text[] CHECK (content_flags <@ '{mfa_code,login_link}'),
+    content_flags text[] CHECK (content_flags && '{mfa_code,login_link}' OR content_flags = '{}'),
     -- The scanner rules behind the stored flags.
     content_rule_ids text[],
     -- The serve-time pattern check's rules and the scanner it ran under, NULL when it did not run.
