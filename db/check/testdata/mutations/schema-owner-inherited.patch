control: Schema change is confined to the migrator's user
removes: the bootstrap makes the application user a member of the migrator's user, so it acts as the schema's owner
packages: ./db/check
tests: TestTheApplicationUserCannotChangeTheSchema TestTheApplicationUserCannotChangeTheSchema/add_a_body_column TestTheApplicationUserCannotChangeTheSchema/drop_a_table TestTheApplicationUserCannotChangeTheSchema/create_a_policy TestTheBootstrapCreatesTheTwoUsers
scheduled-count: no
integration: yes

diff --git a/db/bootstrap/roles.sql b/db/bootstrap/roles.sql
index 31eb77d8..45d1ab37 100644
--- a/db/bootstrap/roles.sql
+++ b/db/bootstrap/roles.sql
@@ -16,3 +16,4 @@ CREATE ROLE mediated_mailbox_migrator LOGIN;
 -- nothing, holds no attribute beyond LOGIN and belongs to no other role, so it holds only the grants the
 -- chain gives it.
 CREATE ROLE mediated_mailbox_app LOGIN;
+GRANT mediated_mailbox_migrator TO mediated_mailbox_app;
