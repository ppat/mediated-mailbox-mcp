control: An OAuth client an account connects through cannot be removed
removes: the account's reference to its client is dropped, so nothing refuses removing a client an account connects through
packages: ./db/check
tests: TestAClientAnAccountConnectsThroughCannotBeRemoved
scheduled-count: no
integration: yes

diff --git a/db/migrations/00002_schema.sql b/db/migrations/00002_schema.sql
index f40c7fd3..584ed5f7 100644
--- a/db/migrations/00002_schema.sql
+++ b/db/migrations/00002_schema.sql
@@ -38,7 +38,6 @@ CREATE TABLE accounts (
     provider text NOT NULL,
     -- NULL for a provider without an OAuth client.
     oauth_client text,
-    FOREIGN KEY (oauth_client, provider) REFERENCES oauth_clients (name, provider),
     -- No account identifier is exactly ., .. or /, which the mediator's API root cannot address as a
     -- path segment (ADR-0087). Account setup refuses them first, with its own wording.
     CONSTRAINT accounts_account_id_addressable CHECK (account_id NOT IN ('.', '..', '/'))
