control: The checked vocabularies refuse a value outside their closed set
removes: the job kind and the pass are each checked against the words alone, so a pair no job kind records is stored
packages: ./db/check
tests: TestARunRecordsOneOfTheBuiltJobKindsPairs
scheduled-count: no
integration: yes

diff --git a/db/migrations/00002_schema.sql b/db/migrations/00002_schema.sql
index f40c7fd3..a38c6ecc 100644
--- a/db/migrations/00002_schema.sql
+++ b/db/migrations/00002_schema.sql
@@ -346,7 +346,7 @@ CREATE TABLE job_runs (
     -- A closed set of the pairs the built job kinds record. Each job kind adds its own pairs in the
     -- migration that brings its role.
     CONSTRAINT job_runs_workload_pass_check CHECK (
-        (workload, pass) IN (('backfill', 'pass1'), ('backfill', 'pass2'), ('sync', 'tick'), ('sync', 'gap_recovery'))
+        workload IN ('backfill', 'sync') AND pass IN ('pass1', 'pass2', 'tick', 'gap_recovery')
     )
 );
 
