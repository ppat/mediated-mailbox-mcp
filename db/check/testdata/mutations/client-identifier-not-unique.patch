control: One OAuth client is never stored twice
removes: the uniqueness of a provider's client identifier is dropped, so one client may be stored under two names
packages: ./db/check
tests: TestOneClientIsNeverStoredTwice
scheduled-count: no
integration: yes

diff --git a/db/migrations/00002_schema.sql b/db/migrations/00002_schema.sql
index f40c7fd3..81d5e05f 100644
--- a/db/migrations/00002_schema.sql
+++ b/db/migrations/00002_schema.sql
@@ -22,9 +22,7 @@ CREATE TABLE oauth_clients (
     -- none.
     project_id text,
     -- What an account's reference names, so the reference carries the provider.
-    UNIQUE (name, provider),
-    -- One client is never stored twice under two names.
-    UNIQUE (provider, client_id)
+    UNIQUE (name, provider)
 );
 
 -- What every listing needs, each account's identifier, provider and the client it connects through
