control: The application user cannot update or delete a row of the policy history
removes: the application user gains update and delete on the policy history, so a compromised process can rewrite who lifted a restriction
packages: ./db/check
tests: TestTheApplicationUserCannotAlterThePolicyHistory TestTheApplicationUserCannotAlterThePolicyHistory/update TestTheApplicationUserCannotAlterThePolicyHistory/delete
scheduled-count: no
integration: yes

diff --git a/db/migrations/00003_grants.sql b/db/migrations/00003_grants.sql
index 809f1022..7eec182a 100644
--- a/db/migrations/00003_grants.sql
+++ b/db/migrations/00003_grants.sql
@@ -183,7 +183,7 @@ GRANT INSERT, UPDATE (domain_suffix), DELETE ON policy_rules TO application_user
 
 -- Each policy write appends its history row. Insert alone, so the history survives a compromise of
 -- the process that wrote it (ADR-0102).
-GRANT INSERT ON policy_changes TO application_user;
+GRANT INSERT, UPDATE, DELETE ON policy_changes TO application_user;
 GRANT USAGE ON SEQUENCE policy_changes_id_seq TO application_user;
 
 -- Each subject mask applied is recorded in db/maskingevents/record (ADR-0003).
