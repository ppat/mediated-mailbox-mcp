control: The listing roles read the accounts table in full and write only their own rows
removes: the listing policy covers every command rather than reads alone, so a listing role writes every account's row
packages: ./db/check
tests: TestTheListingRolesReadEveryAccount TestTheListingRolesReadEveryAccount/mediated_mailbox_ui/updates_another_account's_row TestTheListingRolesReadEveryAccount/mediated_mailbox_ui/inserts_another_account's_row
scheduled-count: no
integration: yes

diff --git a/db/migrations/00003_row_level_security.sql b/db/migrations/00003_row_level_security.sql
index 77a39501..3281e1c4 100644
--- a/db/migrations/00003_row_level_security.sql
+++ b/db/migrations/00003_row_level_security.sql
@@ -20,7 +20,7 @@ USING (account_id = current_setting('app.account'));
 -- reads accounts sees only its transaction's account. accounts_account still confines every write
 -- to the transaction's account, since a permissive policy for SELECT alone takes no part in an
 -- insert, an update's new row or a delete.
-CREATE POLICY accounts_listing ON accounts FOR SELECT
+CREATE POLICY accounts_listing ON accounts
 TO mediated_mailbox_ui,
 mediated_mailbox_mediate,
 mediated_mailbox_backfill,
