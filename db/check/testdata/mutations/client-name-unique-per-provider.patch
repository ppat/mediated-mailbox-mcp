control: One OAuth client is never stored twice
removes: a client's name is unique only within its provider, so a client of another provider may take a name a client holds
packages: ./db/check
tests: TestOneClientIsNeverStoredTwice
scheduled-count: no
integration: yes

diff --git a/db/migrations/00002_schema.sql b/db/migrations/00002_schema.sql
index f40c7fd3..a4a75141 100644
--- a/db/migrations/00002_schema.sql
+++ b/db/migrations/00002_schema.sql
@@ -12,8 +12,9 @@
 -- column, so grants alone decide who reaches it (ADR-0016). A provider that authenticates otherwise
 -- has no row, and no account refers to one.
 CREATE TABLE oauth_clients (
-    name text PRIMARY KEY,
+    name text,
     provider text NOT NULL,
+    PRIMARY KEY (name, provider),
     client_id text NOT NULL,
     -- The client's secret, sealed to the current public key and bound to this row (ADR-0081, ADR-0088).
     client_secret bytea NOT NULL,
