control: One OAuth client is never stored twice
removes: a client's name is unique only within its provider, so a client of another provider may take a name a client holds
packages: ./db/check
tests: TestOneClientIsNeverStoredTwice
scheduled-count: no
integration: yes

diff --git a/db/migrations/00021_oauth_clients_by_name.sql b/db/migrations/00021_oauth_clients_by_name.sql
index 8ec4c03b..fe8da4fa 100644
--- a/db/migrations/00021_oauth_clients_by_name.sql
+++ b/db/migrations/00021_oauth_clients_by_name.sql
@@ -11,7 +11,7 @@ ALTER TABLE oauth_clients ADD COLUMN name text;
 UPDATE oauth_clients SET name = provider;
 ALTER TABLE oauth_clients ALTER COLUMN name SET NOT NULL;
 ALTER TABLE oauth_clients DROP CONSTRAINT oauth_clients_pkey;
-ALTER TABLE oauth_clients ADD PRIMARY KEY (name);
+ALTER TABLE oauth_clients ADD PRIMARY KEY (name, provider);
 -- What an account's reference names, so the reference carries the provider.
 ALTER TABLE oauth_clients ADD UNIQUE (name, provider);
 -- One client is never stored twice under two names.
