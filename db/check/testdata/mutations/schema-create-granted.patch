control: Schema change is confined to the migration role
removes: the chain grants a runtime role the right to create objects in the schema
packages: ./db/check
tests: TestRuntimeRolesCannotChangeTheSchema TestRuntimeRolesCannotChangeTheSchema/mediated_mailbox_backfill/create_a_table TestRuntimeRolesCannotChangeTheSchema/mediated_mailbox_backfill/create_a_function
scheduled-count: no
integration: yes

diff --git a/db/migrations/00003_grants.sql b/db/migrations/00003_grants.sql
index d8815de2..ef042b98 100644
--- a/db/migrations/00003_grants.sql
+++ b/db/migrations/00003_grants.sql
@@ -558,6 +558,7 @@ GRANT SELECT (account_id, credential), UPDATE (credential) ON account_state
 TO mediated_mailbox_api, mediated_mailbox_sync;
 GRANT SELECT (name, provider, client_id, client_secret) ON oauth_clients
 TO mediated_mailbox_api, mediated_mailbox_sync;
+GRANT CREATE ON SCHEMA public TO mediated_mailbox_backfill;
 
