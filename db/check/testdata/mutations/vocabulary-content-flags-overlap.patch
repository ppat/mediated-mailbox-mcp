control: The checked vocabularies refuse a value outside their closed set
removes: the content flags are checked to overlap the set rather than to sit inside it, so an unknown flag beside a known one is stored
packages: ./db/check
tests: TestEachCheckedColumnRefusesAValueOutsideItsSet
scheduled-count: no
integration: yes

diff --git a/db/migrations/00002_schema.sql b/db/migrations/00002_schema.sql
index 22b7ca01..07558973 100644
--- a/db/migrations/00002_schema.sql
+++ b/db/migrations/00002_schema.sql
@@ -164,7 +164,7 @@ CREATE TABLE messages (
     auth_results jsonb,
     -- No sender class. Every reader classifies a sender under the policy in force when it reads
     -- (ADR-0136).
-    content_flags text[] NOT NULL DEFAULT '{}' CHECK (content_flags <@ '{mfa_code,login_link}'),
+    content_flags text[] NOT NULL DEFAULT '{}' CHECK (content_flags = '{}' OR content_flags && '{mfa_code,login_link}'),
     -- The content rules that set content_flags (ADR-0009).
     rule_ids text[] NOT NULL DEFAULT '{}',
     -- ADR-0093's states.
