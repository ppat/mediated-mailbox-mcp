control: The grant check plans every statement an import list admits under the application user
removes: the application user loses the delete on policy_rules, so policy management's lift of a rule, which the UI's list admits, is refused
packages: ./db/check
tests: TestGrantsCoverAdmittedSubsections
scheduled-count: no
integration: yes

diff --git a/db/migrations/00003_grants.sql b/db/migrations/00003_grants.sql
index 809f1022..6bd8ef1c 100644
--- a/db/migrations/00003_grants.sql
+++ b/db/migrations/00003_grants.sql
@@ -179,7 +179,7 @@ GRANT UPDATE (status, reviewed_at, reviewed_by) ON policy_candidates TO applicat
 -- db/policyrules/manage for an account's rules and db/policyrules/base for the base policy's (ADR-0084,
 -- ADR-0110, ADR-0112). An edit changes a rule's domain suffixes alone, since its scope and identifier
 -- never change.
-GRANT INSERT, UPDATE (domain_suffix), DELETE ON policy_rules TO application_user;
+GRANT INSERT, UPDATE (domain_suffix) ON policy_rules TO application_user;
 
 -- Each policy write appends its history row. Insert alone, so the history survives a compromise of
 -- the process that wrote it (ADR-0102).
