control: The checked vocabularies refuse a value outside their closed set
removes: a message's attachment types are not checked
packages: ./db/check
tests: TestEachCheckedColumnRefusesAValueOutsideItsSet
scheduled-count: no
integration: yes

diff --git a/db/migrations/00002_schema.sql b/db/migrations/00002_schema.sql
index 4b1ba0aa..18a62fc7 100644
--- a/db/migrations/00002_schema.sql
+++ b/db/migrations/00002_schema.sql
@@ -162,12 +162,7 @@ CREATE TABLE messages (
     has_attachments boolean NOT NULL,
     -- Words of ADR-0123's closed vocabulary, never text the message carries, since they are served in
     -- every sensitivity state.
-    attachment_types text[] NOT NULL DEFAULT '{}' CHECK (
-        attachment_types <@ ARRAY[
-            'pdf', 'image', 'audio', 'video', 'text', 'calendar', 'contact', 'document', 'spreadsheet',
-            'presentation', 'archive', 'message', 'signature', 'other'
-        ]
-    ),
+    attachment_types text[] NOT NULL DEFAULT '{}',
     list_id text,
     size_bytes int,
     auth_results jsonb,
