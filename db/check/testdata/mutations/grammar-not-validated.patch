control: The identifier grammar's migration stops over a stored account outside it and rewrites none
removes: the grammar's check is added without validating the stored accounts, so the migration applies over an account outside it
packages: ./db/check
tests: TestTheIdentifierGrammarStopsOverAStoredAccountOutsideIt
scheduled-count: no
integration: yes

diff --git a/db/migrations/00005_account_identifier_grammar.sql b/db/migrations/00005_account_identifier_grammar.sql
index b9f33379..fc4269eb 100644
--- a/db/migrations/00005_account_identifier_grammar.sql
+++ b/db/migrations/00005_account_identifier_grammar.sql
@@ -6,4 +6,4 @@
 -- rewrites it, since an account is system-of-record data (ADR-0048).
 ALTER TABLE accounts
 DROP CONSTRAINT accounts_account_id_addressable,
-ADD CONSTRAINT accounts_account_id_grammar CHECK (account_id ~ '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$');
+ADD CONSTRAINT accounts_account_id_grammar CHECK (account_id ~ '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$') NOT VALID;
