control: The key-generation command writes a pair the library seals to and opens with
removes: the mode is left to the process's umask, so a restrictive umask narrows the public key file's mode
packages: ./credential/cmd/keygen
tests: TestTheKeyFilesModesHoldUnderAnyUmask
scheduled-count: no

diff --git a/credential/cmd/keygen/main.go b/credential/cmd/keygen/main.go
index a676dd9..101ba19 100644
--- a/credential/cmd/keygen/main.go
+++ b/credential/cmd/keygen/main.go
@@ -64,10 +64,7 @@ func create(path string, content []byte, mode os.FileMode) error {
 	if err != nil {
 		return fmt.Errorf("creating %s: %w", path, err)
 	}
-	err = f.Chmod(mode)
-	if err == nil {
-		_, err = f.Write(content)
-	}
+	_, err = f.Write(content)
 	if err == nil {
 		err = f.Sync()
 	}
