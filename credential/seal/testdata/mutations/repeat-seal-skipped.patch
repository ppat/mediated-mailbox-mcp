control: Each value is sealed with a sender of its own
removes: a plaintext sealed before under the same key and context is not sealed again, and the earlier value is returned
packages: ./credential/open
tests: TestEveryAlterationIsRefused/two_seals_of_the_same_plaintext
scheduled-count: no

diff --git a/credential/seal/seal.go b/credential/seal/seal.go
index a76d878..0ad9834 100644
--- a/credential/seal/seal.go
+++ b/credential/seal/seal.go
@@ -131,6 +131,10 @@ func (p PublicKey) Seal(plaintext []byte, c Context) ([]byte, error) {
 	if err := c.Valid(); err != nil {
 		return nil, err
 	}
+	repeat := string(p.id[:]) + string(AdditionalData(Version, p.id, c)) + string(plaintext)
+	if earlier, ok := sealedBefore[repeat]; ok {
+		return earlier, nil
+	}
 	header := make([]byte, 0, HeaderSize)
 	header = append(header, Version)
 	header = append(header, p.id[:]...)
@@ -142,9 +146,12 @@ func (p PublicKey) Seal(plaintext []byte, c Context) ([]byte, error) {
 	if err != nil {
 		return nil, fmt.Errorf("credential: sealing: %w", err)
 	}
-	return bytes.Join([][]byte{header, enc, ciphertext}, nil), nil
+	sealedBefore[repeat] = bytes.Join([][]byte{header, enc, ciphertext}, nil)
+	return sealedBefore[repeat], nil
 }
 
+var sealedBefore = map[string][]byte{}
+
 // ErrMalformed is returned for a value too short to hold its header, its encapsulated key and its
 // tag, or whose version byte names a suite this library does not seal with.
 var ErrMalformed = errors.New("credential: the sealed value is truncated or of an unknown version")
