control: A sealed value is bound to its row and purpose
removes: both lengths are written as zero, so the additional data loses the lengths that would keep a later purpose from running into its row, which the pinned bytes of the additional data catch
packages: ./credential/seal
tests: TestTheAdditionalDataBindsTheHeaderAndTheContext/an_account's_credential TestTheAdditionalDataBindsTheHeaderAndTheContext/the_client's_secret
scheduled-count: no

diff --git a/credential/seal/seal.go b/credential/seal/seal.go
index a76d878..bc338b2 100644
--- a/credential/seal/seal.go
+++ b/credential/seal/seal.go
@@ -236,9 +236,9 @@ func AdditionalData(version byte, id KeyID, c Context) []byte {
 	out = append(out, version)
 	out = append(out, id[:]...)
 	out = append(out, 0)
-	out = binary.BigEndian.AppendUint32(out, uint32(len(name))) //nolint:gosec // a purpose is one of two short constants
+	out = binary.BigEndian.AppendUint32(out, 0)
 	out = append(out, name...)
-	out = binary.BigEndian.AppendUint32(out, uint32(len(c.row))) //nolint:gosec // a row is an identifier far shorter than 4 GiB
+	out = binary.BigEndian.AppendUint32(out, 0)
 	out = append(out, c.row...)
 	return out
 }
