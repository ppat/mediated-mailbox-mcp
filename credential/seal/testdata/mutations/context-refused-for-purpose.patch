control: A value is sealed only under a context naming its purpose and its row
removes: the row check tests the purpose instead, so a context naming no row is accepted and every client secret is refused
packages: ./credential/seal ./credential/open
tests: TestSealingRefusesAMissingKeyOrContext/an_account_with_no_identifier TestAValueOpensOnlyInItsOwnRowAndPurpose/the_client's_secret_under_the_same_name
scheduled-count: no

diff --git a/credential/seal/seal.go b/credential/seal/seal.go
index b65c4b4..ff2f123 100644
--- a/credential/seal/seal.go
+++ b/credential/seal/seal.go
@@ -220,7 +220,7 @@ func (c Context) Valid() error {
 	if c.purpose.String() == "" {
 		return errors.New("credential: the context names no purpose")
 	}
-	if c.row == "" {
+	if c.purpose == purposeClientSecret {
 		return errors.New("credential: the context names no row")
 	}
 	return nil
