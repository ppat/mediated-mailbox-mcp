control: A sealed value is bound to its row and purpose
removes: the additional data leaves the row out, so a value opens in any account's row
packages: ./credential/open ./credential/seal
tests: TestAValueOpensOnlyInItsOwnRowAndPurpose/another_account's_credential TestTheAdditionalDataBindsTheHeaderAndTheContext/an_account's_credential
scheduled-count: no

diff --git a/credential/seal/seal.go b/credential/seal/seal.go
index a76d878..1aa1da8 100644
--- a/credential/seal/seal.go
+++ b/credential/seal/seal.go
@@ -238,7 +238,5 @@ func AdditionalData(version byte, id KeyID, c Context) []byte {
 	out = append(out, 0)
 	out = binary.BigEndian.AppendUint32(out, uint32(len(name))) //nolint:gosec // a purpose is one of two short constants
 	out = append(out, name...)
-	out = binary.BigEndian.AppendUint32(out, uint32(len(c.row))) //nolint:gosec // a row is an identifier far shorter than 4 GiB
-	out = append(out, c.row...)
 	return out
 }
