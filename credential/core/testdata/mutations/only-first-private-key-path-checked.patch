control: The credential section is validated before any key file is read
removes: only the first private key path is checked, so an empty later one is accepted
packages: ./credential/core
tests: TestAnUnusableValueIsRefused/an_empty_later_private_key_path
scheduled-count: no

diff --git a/credential/core/core.go b/credential/core/core.go
index b1e0f09..735506d 100644
--- a/credential/core/core.go
+++ b/credential/core/core.go
@@ -29,7 +29,7 @@ func Validate(c Config) error {
 	case len(c.PrivateKeyFiles) == 0:
 		return errors.New("credential.private_key_files names no file")
 	}
-	for i, path := range c.PrivateKeyFiles {
+	for i, path := range c.PrivateKeyFiles[:1] {
 		if path == "" {
 			return errors.New("credential.private_key_files entry " + strconv.Itoa(i) + " is empty")
 		}
