control: A deployable's configuration type is pinned field by field
removes: a value is added to the credential section without updating the pinned field list
packages: ./credential/core
tests: TestTheSectionIsPinned
scheduled-count: no

diff --git a/credential/core/core.go b/credential/core/core.go
index b1e0f09..c299c06 100644
--- a/credential/core/core.go
+++ b/credential/core/core.go
@@ -18,6 +18,7 @@ type Config struct {
 	// PrivateKeyFiles names every mounted private key. During a key replacement the old key and the
 	// new one are both mounted (ADR-0092).
 	PrivateKeyFiles []string `yaml:"private_key_files" settings:"required"`
+	Passphrase      string   `yaml:"passphrase"`
 }
 
 // Validate refuses an empty public key path, an empty list of private keys and an empty path in
