control: A keyring re-seals a value to the current key
removes: every value comes back as it was, whichever key it names
packages: ./credential/open
tests: TestReSealingMovesAValueToTheCurrentKey TestEverySealerNamesTheCurrentKey
scheduled-count: no

diff --git a/credential/open/open.go b/credential/open/open.go
index 8a41a9c..0473d81 100644
--- a/credential/open/open.go
+++ b/credential/open/open.go
@@ -157,7 +157,7 @@ func (r *Keyring) Reseal(sealed []byte, c seal.Context) (plaintext, stored []byt
 	if err != nil {
 		return nil, nil, false, err
 	}
-	if id == r.current.KeyID() {
+	if id == r.current.KeyID() || len(sealed) > 0 {
 		return plaintext, sealed, false, nil
 	}
 	stored, err = r.current.Seal(plaintext, c)
