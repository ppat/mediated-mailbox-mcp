control: A keyring refuses a public key matching none of its private keys
removes: the check that the public key matches one of the private keys is removed
packages: ./credential/open
tests: TestAKeyringRefusesAPublicKeyMatchingNoPrivateKey
scheduled-count: no

diff --git a/credential/open/open.go b/credential/open/open.go
index 8a41a9c..4e47acd 100644
--- a/credential/open/open.go
+++ b/credential/open/open.go
@@ -85,9 +85,6 @@ func NewKeyring(current seal.PublicKey, keys ...PrivateKey) (*Keyring, error) {
 		ring.keys[k.public.KeyID()] = k.key
 		matched = matched || k.public.Equal(current)
 	}
-	if !matched {
-		return nil, fmt.Errorf("credential: the public key %s matches none of the private keys, so values sealed to it could not be opened", current.KeyID())
-	}
 	return ring, nil
 }
 
