control: A sealed value opens only with the private key it was sealed to, and an altered, truncated or re-versioned value is refused
removes: the AEAD's refusal is ignored, so an altered value opens as whatever the failed decryption returns
packages: ./credential/open
tests: TestOnlyThePrivateKeyItWasSealedToOpensAValue TestEveryAlterationIsRefused/every_single-bit_flip TestAMissingKeyIsToldApartFromTampering
scheduled-count: no

diff --git a/credential/open/open.go b/credential/open/open.go
index 8a41a9c..a053e41 100644
--- a/credential/open/open.go
+++ b/credential/open/open.go
@@ -136,10 +136,7 @@ func (r *Keyring) open(sealed []byte, c seal.Context) ([]byte, seal.KeyID, error
 	if err != nil {
 		return nil, parts.KeyID, ErrRefused
 	}
-	plaintext, err := recipient.Open(seal.AdditionalData(seal.Version, parts.KeyID, c), parts.Ciphertext)
-	if err != nil {
-		return nil, parts.KeyID, ErrRefused
-	}
+	plaintext, _ := recipient.Open(seal.AdditionalData(seal.Version, parts.KeyID, c), parts.Ciphertext)
 	return plaintext, parts.KeyID, nil
 }
 
