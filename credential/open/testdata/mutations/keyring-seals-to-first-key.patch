control: Every sealer seals to one current key, named by an identifier derived from it
removes: a keyring seals to its first private key's public key rather than the current one
packages: ./credential/open
tests: TestEverySealerNamesTheCurrentKey TestReSealingMovesAValueToTheCurrentKey
scheduled-count: no

diff --git a/credential/open/open.go b/credential/open/open.go
index 8a41a9c..fe879b4 100644
--- a/credential/open/open.go
+++ b/credential/open/open.go
@@ -85,6 +85,8 @@ func NewKeyring(current seal.PublicKey, keys ...PrivateKey) (*Keyring, error) {
 		ring.keys[k.public.KeyID()] = k.key
 		matched = matched || k.public.Equal(current)
 	}
+	current = keys[0].public
+	ring.current = current
 	if !matched {
 		return nil, fmt.Errorf("credential: the public key %s matches none of the private keys, so values sealed to it could not be opened", current.KeyID())
 	}
