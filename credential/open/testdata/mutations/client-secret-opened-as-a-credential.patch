control: the UI's one opening part opens a client's secret and never an account's credential
removes: the opening of client secrets opens a value bound to an account credential's purpose
packages: ./credential/open
tests: TestClientSecretsOpenAClientsSecretAndNothingElse
scheduled-count: no

diff --git a/credential/open/clientsecrets.go b/credential/open/clientsecrets.go
--- a/credential/open/clientsecrets.go
+++ b/credential/open/clientsecrets.go
@@ -22,5 +22,5 @@ func LoadClientSecrets(publicKeyPath string, privateKeyPaths ...string) (*Client
 
 // Open opens sealed as the named client's secret.
 func (c *ClientSecrets) Open(sealed []byte, client string) ([]byte, error) {
-	return c.ring.Open(sealed, seal.ClientSecret(client))
+	return c.ring.Open(sealed, seal.AccountCredential(client))
 }
