control: A value naming no key the keyring holds is refused as naming an unknown key, and one naming a held key that fails authentication as altered
removes: a value the AEAD refuses is reported as naming a key the keyring does not hold
packages: ./credential/open
tests: TestAMissingKeyIsToldApartFromTampering TestOnlyThePrivateKeyItWasSealedToOpensAValue
scheduled-count: no

diff --git a/credential/open/open.go b/credential/open/open.go
index 8a41a9c..72a0bee 100644
--- a/credential/open/open.go
+++ b/credential/open/open.go
@@ -138,7 +138,7 @@ func (r *Keyring) open(sealed []byte, c seal.Context) ([]byte, seal.KeyID, error
 	}
 	plaintext, err := recipient.Open(seal.AdditionalData(seal.Version, parts.KeyID, c), parts.Ciphertext)
 	if err != nil {
-		return nil, parts.KeyID, ErrRefused
+		return nil, parts.KeyID, fmt.Errorf("%w: %s", ErrUnknownKey, parts.KeyID)
 	}
 	return plaintext, parts.KeyID, nil
 }
