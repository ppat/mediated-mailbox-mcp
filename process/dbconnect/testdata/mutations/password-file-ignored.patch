control: The database password is the mounted password file's text less one trailing newline, and an empty one refuses the start
removes: the password file is read but its password is not set on the connection
packages: ./process/dbconnect
tests: TestTheConnectionIsTheConfigurations TestThePasswordIsTheFilesText
scheduled-count: no

diff --git a/process/dbconnect/dbconnect.go b/process/dbconnect/dbconnect.go
--- a/process/dbconnect/dbconnect.go
+++ b/process/dbconnect/dbconnect.go
@@ -56,7 +56,7 @@ func PoolConfig(c core.Config) (*pgxpool.Config, error) {
 	if err != nil {
 		return nil, err
 	}
-	config.ConnConfig.Password = password
+	_ = password
 	config.MaxConns = int32(min(c.PoolSize, 1<<31-1)) //nolint:gosec // Bounded above.
 	return config, nil
 }
