control: A deployable refuses to start while PGPASSWORD or PGSSLPASSWORD is set, an empty value included
removes: a password variable set to the empty value does not refuse the start
packages: ./process/dbconnect
tests: TestAPasswordVariableIsRefused/PGPASSWORD= TestAPasswordVariableIsRefused/PGSSLPASSWORD=
scheduled-count: no

diff --git a/process/dbconnect/dbconnect.go b/process/dbconnect/dbconnect.go
index 2795042..096532a 100644
--- a/process/dbconnect/dbconnect.go
+++ b/process/dbconnect/dbconnect.go
@@ -19,8 +19,8 @@ import (
 // password file (ADR-0078).
 func RefusePasswordVariables(environ []string) error {
 	for _, entry := range environ {
-		name, _, _ := strings.Cut(entry, "=")
-		if name == "PGPASSWORD" || name == "PGSSLPASSWORD" {
+		name, value, _ := strings.Cut(entry, "=")
+		if (name == "PGPASSWORD" || name == "PGSSLPASSWORD") && value != "" {
 			return fmt.Errorf("the environment sets %s, and the database password comes only from the mounted password file", name)
 		}
 	}
