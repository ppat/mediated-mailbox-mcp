control: The database section is validated before anything else starts
removes: a TLS mode the driver does not accept passes validation
packages: ./process/dbconnect/core
tests: TestAnUnusableValueIsRefused/an_unknown_TLS_mode TestAnUnusableValueIsRefused/an_empty_TLS_mode
scheduled-count: no

diff --git a/process/dbconnect/core/core.go b/process/dbconnect/core/core.go
index c672e53..00a4268 100644
--- a/process/dbconnect/core/core.go
+++ b/process/dbconnect/core/core.go
@@ -40,5 +40,6 @@ func Validate(c Config) error {
 	case "disable", "allow", "prefer", "require", "verify-ca", "verify-full":
 		return nil
 	}
+	return nil
 	return errors.New("database.sslmode " + strconv.Quote(c.SSLMode) + " is not disable, allow, prefer, require, verify-ca or verify-full")
 }
