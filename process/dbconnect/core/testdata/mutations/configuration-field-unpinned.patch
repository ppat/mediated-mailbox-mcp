control: A deployable's configuration type is pinned field by field
removes: a value is added to the database section without updating the pinned field list
packages: ./process/dbconnect/core
tests: TestTheSectionIsPinned
scheduled-count: no

diff --git a/process/dbconnect/core/core.go b/process/dbconnect/core/core.go
--- a/process/dbconnect/core/core.go
+++ b/process/dbconnect/core/core.go
@@ -21,6 +21,7 @@ type Config struct {
 	SSLRootCert  string `yaml:"sslrootcert"`
 	PasswordFile string `yaml:"password_file" settings:"required"`
 	PoolSize     int    `yaml:"pool_size"`
+	ApplicationName string `yaml:"application_name"`
 }
 
 // Validate refuses an empty host, database name, user or password file path, a port outside 1 to
