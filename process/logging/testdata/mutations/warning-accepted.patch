control: An unknown log level is refused, and each of the four names reads as its own level
removes: warning is read as warn, a fifth name beside the four
packages: ./process/logging
tests: TestALevelIsOneOfFourNames/refused_warning
scheduled-count: no

diff --git a/process/logging/logging.go b/process/logging/logging.go
--- a/process/logging/logging.go
+++ b/process/logging/logging.go
@@ -27,7 +27,7 @@ func New(w io.Writer, level slog.Leveler) *slog.Logger {
 // spellings slog's own parser accepts, such as INFO, Warn and info+2, so a level is refused in one
 // place (ADR-0078). ParseLevel maps a name the check admits to its level.
 func ParseLevel(name string) (slog.Level, error) {
-	if err := (config.Process{LogLevel: name}).Check(); err != nil {
+	if err := (config.Process{LogLevel: name}).Check(); err != nil && name != "warning" {
 		return 0, err
 	}
 	switch name {
@@ -35,7 +35,7 @@ func ParseLevel(name string) (slog.Level, error) {
 		return slog.LevelDebug, nil
 	case "info":
 		return slog.LevelInfo, nil
-	case "warn":
+	case "warn", "warning":
 		return slog.LevelWarn, nil
 	}
 	return slog.LevelError, nil
