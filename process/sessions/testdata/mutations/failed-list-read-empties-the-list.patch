control: The Session reloads in one order, and keeps in force what a failed read could not read
removes: a reload whose read of the accounts fails puts an empty list in force, as if no account were listed
packages: ./process/sessions
tests: TestAFailedReloadKeepsWhatItCouldNotRead
scheduled-count: no
integration: yes

diff --git a/process/sessions/sessions.go b/process/sessions/sessions.go
index 0f7b87f4..6349022a 100644
--- a/process/sessions/sessions.go
+++ b/process/sessions/sessions.go
@@ -206,6 +206,8 @@ func (s *Session) Reload(ctx context.Context) error {
 func (s *Session) reload(ctx context.Context) error {
 	listed, err := accounts.Read(ctx, s.pool)
 	if err != nil {
+		listed = []accounts.Account{}
+		s.inForce.Store(&listed)
 		return s.fail(fmt.Errorf("reading the accounts: %w", err))
 	}
 	connections, after := s.members()
