control: The Session reloads in one order, and keeps in force what a failed read could not read
removes: a reload whose policy load fails keeps the list of the reload before it in force and tells no one, so an account no longer listed stays held
packages: ./process/sessions
tests: TestAFailedReloadKeepsWhatItCouldNotRead
scheduled-count: no
integration: yes

diff --git a/process/sessions/sessions.go b/process/sessions/sessions.go
index cdcb3768..0939c4cb 100644
--- a/process/sessions/sessions.go
+++ b/process/sessions/sessions.go
@@ -214,9 +214,12 @@ func (s *Session) reload(ctx context.Context) error {
 			return s.fail(fmt.Errorf("loading the connections: %w", err))
 		}
 	}
-	s.inForce.Store(&listed)
 	s.failed.Store(nil)
 	err = s.policies.Load(ctx, ids(listed))
+	if err != nil {
+		return fmt.Errorf("%w: %w", ErrPolicyNotLoaded, err)
+	}
+	s.inForce.Store(&listed)
 	// A policy the read found invalid is the operator's to fix, and the accounts keep the policy they
 	// had, the one that restricts every sender before any was read, so it holds up neither the
 	// Session's readiness nor its reload's pace. A read of the policy that did not complete does.
