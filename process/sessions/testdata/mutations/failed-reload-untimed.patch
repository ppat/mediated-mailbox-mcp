control: Each reload of the Session its caller did not cancel is timed
removes: a reload that fails is not timed
packages: ./process/sessions
tests: TestEachReloadItsCallerDidNotCancelIsTimed
scheduled-count: no
integration: yes

diff --git a/process/sessions/sessions.go b/process/sessions/sessions.go
index 0f7b87f4..d02714ab 100644
--- a/process/sessions/sessions.go
+++ b/process/sessions/sessions.go
@@ -196,7 +196,7 @@ func (s *Session) Reload(ctx context.Context) error {
 	defer s.reloading.Unlock()
 	start := time.Now()
 	err := s.reload(ctx)
-	if !errors.Is(err, context.Canceled) {
+	if err == nil {
 		s.took.Observe(time.Since(start).Seconds())
 	}
 	return err
