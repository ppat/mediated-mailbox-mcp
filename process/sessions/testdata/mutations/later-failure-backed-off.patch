control: The Session's reload is tried again within seconds while no reload has read everything, and at the next interval once one has
removes: a reload that fails once one has read everything is answered as failed, so the scheduler tries it again after its backoff rather than at the next interval
packages: ./process/sessions
tests: TestOnceLoadedAFailedReloadWaitsForTheNextInterval
scheduled-count: no
integration: yes

diff --git a/process/sessions/sessions.go b/process/sessions/sessions.go
index 0f7b87f4..a2c1deba 100644
--- a/process/sessions/sessions.go
+++ b/process/sessions/sessions.go
@@ -135,7 +135,7 @@ func (s *Session) upkeep() schedule.Job {
 		Logger:   s.logger,
 		Run: func(ctx context.Context, _ schedule.Ask) error {
 			err := s.Reload(ctx)
-			if err == nil || ctx.Err() != nil || !s.loaded.Load() {
+			if err == nil || ctx.Err() != nil || s.loaded.Load() || true {
 				return err
 			}
 			s.logger.Error("the Session was not reloaded in full, so what it held stays in force", "error", err)
