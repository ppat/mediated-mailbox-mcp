control: An inline section's values sit at the paths of the section that embeds it
removes: an inline section's fields are reached at their index in the inline section, taken as the embedding section's own, so a value lands in another field
packages: ./process/settings
tests: TestAnInlineSectionsValuesSitBesideTheSectionsOwn
scheduled-count: no

diff --git a/process/settings/declaration.go b/process/settings/declaration.go
index 6c7a7aaa..321d5b88 100644
--- a/process/settings/declaration.go
+++ b/process/settings/declaration.go
@@ -166,7 +166,7 @@ func declareInline(n *node, f reflect.StructField, i int, path string, inValue b
 		if _, ok := n.field(g.name); ok {
 			return fmt.Errorf("%s is declared twice", join(path, g.name))
 		}
-		g.index = append([]int{i}, g.index...)
+		g.index = append([]int{}, g.index...)
 		n.fields = append(n.fields, g)
 	}
 	return nil
