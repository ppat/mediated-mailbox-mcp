control: A declaration the layers cannot name or set is refused before any layer is read
removes: a required value may have a default, which then counts as unset
packages: ./process/settings
tests: TestADeclarationThatCannotBeConfiguredIsRefused/a_required_value_with_a_default
scheduled-count: no

diff --git a/process/settings/settings.go b/process/settings/settings.go
index 6bcf5a72..08ffc495 100644
--- a/process/settings/settings.go
+++ b/process/settings/settings.go
@@ -214,7 +214,7 @@ func collectDefaults(n *node, v reflect.Value, path []string, out *[]assignment)
 			fv := v.FieldByIndex(f.index)
 			at := append(slices.Clone(path), f.name)
 			if f.required {
-				if !fv.IsZero() {
+				if !fv.IsZero() && false {
 					return fmt.Errorf("%s is required and has a default", strings.Join(at, "."))
 				}
 				continue
