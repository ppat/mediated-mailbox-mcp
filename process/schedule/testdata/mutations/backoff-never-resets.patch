+++ b/process/schedule/schedule.go
@@ -354,7 +354,6 @@ func (s *Scheduler) loop(ctx context.Context, key Key, job Job, st *state) {
 		case Cancelled:
 			return
 		case Succeeded:
-			failures = 0
 		case Failed, Panic:
 			failures++
 			delay := job.Backoff.after(failures)
