@@ -366,7 +366,7 @@ func (s *Scheduler) loop(ctx context.Context, key Key, job Job, st *state) {
 			wake = nil
 		}
 		var fired <-chan time.Time
-		st.expect(time.Time{})
+		st.expect(time.Now())
 		if timed {
 			timer.Reset(time.Until(due))
 			fired = timer.C
