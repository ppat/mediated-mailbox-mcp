control: A stopped worker and a job whose last success has aged are loud
removes: the absence rule fires at the first evaluation that finds no worker
packages: ./process/schedule
tests: TestAlertingRules
scheduled-count: no

diff --git a/packaging/chart/rules/alerting-rules.yaml b/packaging/chart/rules/alerting-rules.yaml
index 9cc9ffa4..70e605a5 100644
--- a/packaging/chart/rules/alerting-rules.yaml
+++ b/packaging/chart/rules/alerting-rules.yaml
@@ -129,7 +129,6 @@ groups:
   # been scraped for five minutes the rule fires, the same delay the API server's absence rule uses.
   - alert: MediatedMailboxWorkerAbsent
     expr: absent(mediated_mailbox_job_last_success_timestamp_seconds)
-    for: 5m
     labels:
       severity: warning
     annotations:
