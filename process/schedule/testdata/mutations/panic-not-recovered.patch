control: A panic in one job is its run's failure and stops nothing else
removes: a run is called with no recovery, so its panic stops the worker
packages: ./process/schedule
tests: TestAPanicIsItsRunsFailureAndStopsNothingElse/in_the_run
scheduled-count: no

diff --git a/process/schedule/schedule.go b/process/schedule/schedule.go
index 47abffeb..b54ea274 100644
--- a/process/schedule/schedule.go
+++ b/process/schedule/schedule.go
@@ -433,10 +433,5 @@ func (s *Scheduler) ask(ctx context.Context, key Key, st *state, job Job, at, ph
 
 // call runs run, recovering a panic in it as an error wrapping ErrPanicked.
 func call(ctx context.Context, run Run, ask Ask) (panicked bool, err error) {
-	defer func() {
-		if r := recover(); r != nil {
-			panicked, err = true, Panicked(r)
-		}
-	}()
 	return false, run(ctx, ask)
 }
