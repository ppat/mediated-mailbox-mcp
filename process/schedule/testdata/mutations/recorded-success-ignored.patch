control: A job's latest success starts from what its job kind's runs record
removes: the scheduler starts every job's latest success at its ensure, whatever its job kind's runs record
packages: ./process/schedule
tests: TestAJobsLatestSuccessStartsFromItsRecordedOne
scheduled-count: no

diff --git a/process/schedule/schedule.go b/process/schedule/schedule.go
index b13a5f70..14925192 100644
--- a/process/schedule/schedule.go
+++ b/process/schedule/schedule.go
@@ -261,7 +261,7 @@ func (s *Scheduler) Ensure(key Key, job Job) error {
 	ctx, cancel := context.WithCancel(s.ctx)
 	st := &state{cancel: cancel, wake: make(chan struct{}, 1), done: make(chan struct{}), epoch: s.epoch}
 	s.jobs[key] = st
-	seed := job.LastSuccess
+	seed := time.Time{}
 	if seed.IsZero() {
 		seed = time.Now()
 	}
