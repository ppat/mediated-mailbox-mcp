control: The ping report of the process's one pool is ready only while the database answers a ping, and refuses a job kind
removes: the report starts again each time it is asked for, so one pool is pinged by as many loops
packages: ./process/database
tests: TestThePingReportFollowsTheDatabase
scheduled-count: no
integration: yes

diff --git a/process/database/readiness.go b/process/database/readiness.go
index 6dbf9fed..62b01022 100644
--- a/process/database/readiness.go
+++ b/process/database/readiness.go
@@ -41,9 +41,6 @@ func ReportReadiness(ctx context.Context, p process.Capabilities, c config.HasDa
 	}
 	set.mu.Lock()
 	defer set.mu.Unlock()
-	if set.reported {
-		return nil
-	}
 	set.reported = true
 	set.shared.Report(process.NotReady, "no ping has answered yet")
 	set.shared.Go("database ping", func(ctx context.Context) { ping(ctx, pool, set.shared) })
