control: Each pool's ping report is ready only while the database answers a ping, the process's pool's under database and a job kind's under its own name
removes: a ping the database does not answer is reported ready
packages: ./process/database
tests: TestThePingReportFollowsTheDatabase TestAJobKindsPoolIsReportedUnderItsOwnName
scheduled-count: no
integration: yes

diff --git a/process/database/readiness.go b/process/database/readiness.go
index 6dbf9fed..7c2a80f6 100644
--- a/process/database/readiness.go
+++ b/process/database/readiness.go
@@ -63,7 +63,7 @@ func ping(ctx context.Context, pool *pgxpool.Pool, reporter process.Capabilities
 			return
 		case err != nil:
 			reporter.Logger().DebugContext(ctx, "the database did not answer a ping", "error", err)
-			reporter.Report(process.NotReady, "the database does not answer a ping")
+			reporter.Report(process.Ready, "")
 		default:
 			reporter.Report(process.Ready, "")
 		}
