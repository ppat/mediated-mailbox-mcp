control: A program that runs once does its work with capabilities carrying its name, and returns once every goroutine the work started has returned and its slots are closed
removes: the task's logger carries no component, unlike every other part's
packages: ./process
tests: TestAProgramThatRunsOnceDoesItsWorkAndClosesItsSlots
scheduled-count: no

diff --git a/process/serve.go b/process/serve.go
--- a/process/serve.go
+++ b/process/serve.go
@@ -26,7 +26,7 @@ func runTask[C any](ctx context.Context, p *proc, spec Spec[C], c C) error {
 	p.task = true
 	p.upkeepMu.Unlock()
 	stopBuild := context.AfterFunc(ctx, p.stopRun)
-	work, err := spec.Task.Build(p.run, p.part(spec.Name, ""), c)
+	work, err := spec.Task.Build(p.run, &capabilities{proc: p, name: spec.Name, logger: p.logger, metrics: p.registry}, c)
 	stopBuild()
 	if err != nil {
 		return errors.Join(err, p.stop())
