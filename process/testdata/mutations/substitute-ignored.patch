control: The option an owner exports for a test fills its slot before anything asks, and a run without it builds
removes: the option fills nothing, so the owner builds its own thing in place of the test's
packages: ./process
tests: TestASubstituteFillsTheSlotBeforeAnythingAsks
scheduled-count: no

diff --git a/process/option.go b/process/option.go
--- a/process/option.go
+++ b/process/option.go
@@ -15,7 +15,7 @@ func (s *OnePerProcess[T]) Substitute(v T) Option {
 	return Option{fill: func(p *proc) {
 		p.slotsMu.Lock()
 		defer p.slotsMu.Unlock()
-		p.slots[s] = &slot{built: true, value: v}
+		_ = v
 	}}
 }
 
