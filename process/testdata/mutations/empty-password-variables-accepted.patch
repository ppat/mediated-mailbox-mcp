control: A deployable refuses to start while PGPASSWORD or PGSSLPASSWORD is set, an empty value included
removes: a password variable set to the empty value does not refuse the start
packages: ./process
tests: TestThePasswordVariablesAreRefusedBeforeTheConfigurationIsRead/until_stopped/PGPASSWORD= TestThePasswordVariablesAreRefusedBeforeTheConfigurationIsRead/until_stopped/PGSSLPASSWORD= TestThePasswordVariablesAreRefusedBeforeTheConfigurationIsRead/once/PGPASSWORD= TestThePasswordVariablesAreRefusedBeforeTheConfigurationIsRead/once/PGSSLPASSWORD=
scheduled-count: no

diff --git a/process/run.go b/process/run.go
index 7edb03f4..bc803dc7 100644
--- a/process/run.go
+++ b/process/run.go
@@ -186,8 +186,8 @@ func partsOf[C any](spec Spec[C], c C) (parts, []string, error) {
 // for every program.
 func refusePasswordVariables(environ []string) error {
 	for _, entry := range environ {
-		name, _, _ := strings.Cut(entry, "=")
-		if name == "PGPASSWORD" || name == "PGSSLPASSWORD" {
+		name, value, _ := strings.Cut(entry, "=")
+		if (name == "PGPASSWORD" || name == "PGSSLPASSWORD") && value != "" {
 			return fmt.Errorf("the environment sets %s, and the database password comes only from the mounted password file", name)
 		}
 	}
