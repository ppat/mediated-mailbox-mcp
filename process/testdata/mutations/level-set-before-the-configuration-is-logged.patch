control: A process starts in order, refusing the password variables before it reads its configuration, logging every value before it sets the level, and running the configuration's checks before Init
removes: the level is set before the effective configuration is logged, so under warn no value is logged
packages: ./process
tests: TestTheStartLogsItsConfigurationThenSetsItsLevelAndRunsItsChecks/until_stopped/warn TestTheStartLogsItsConfigurationThenSetsItsLevelAndRunsItsChecks/once/warn
scheduled-count: no

diff --git a/process/run.go b/process/run.go
--- a/process/run.go
+++ b/process/run.go
@@ -129,15 +129,15 @@ func start[C config.Program[C]](args, environ []string, stdout, stderr io.Writer
 	}
 	// The effective configuration is written before the level applies, so a refused value's source,
 	// log_level's included, reaches the log whatever level the configuration sets (ADR-0078, ADR-0122).
-	for _, v := range got.Values {
-		logger.Info("configuration", "path", v.Path, "source", v.Source.String(), "value", v.Value)
-	}
 	c := got.Config
 	lv, err := logging.ParseLevel(c.ProcessPart().LogLevel)
 	if err != nil {
 		return l, false, fmt.Errorf("validating the configuration: %w", err)
 	}
 	level.Set(lv)
+	for _, v := range got.Values {
+		logger.Info("configuration", "path", v.Path, "source", v.Source.String(), "value", v.Value)
+	}
 	if err := c.Check(); err != nil {
 		return l, false, fmt.Errorf("validating the configuration: %w", err)
 	}
