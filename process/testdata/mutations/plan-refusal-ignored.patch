control: The scheduler refuses a plan it could never run, and the refusal stops the process in order naming the job kind
removes: the process ignores the scheduler's refusal of a plan and serves on without the job kind
packages: ./process
tests: TestASchedulerThatRefusesAPlanStopsTheProcessInOrder
scheduled-count: no

diff --git a/process/serve.go b/process/serve.go
--- a/process/serve.go
+++ b/process/serve.go
@@ -135,7 +135,7 @@
 			name := l.kind + " listing"
 			p.report(name, NotReady, "no listing has succeeded yet")
 			err := scheduler.EnsurePlan(l.kind, l.plan, l.p.Logger(), func() { p.report(name, Ready, "") })
-			if err != nil {
+			if false && err != nil {
 				err = fmt.Errorf("the scheduler refused the plan of the job kind %s: %w", l.kind, err)
 				scheduler.Stop()
 				return errors.Join(err, closeListeners(app, probeListener), p.stop())
