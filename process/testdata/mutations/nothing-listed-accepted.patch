control: A spec that cannot run is refused before anything is built
removes: a spec that lists no endpoint, no job kind and no task is accepted, so the process serves its probes and runs nothing
packages: ./process
tests: TestASpecThatCannotRunIsRefused
scheduled-count: no

diff --git a/process/run.go b/process/run.go
--- a/process/run.go
+++ b/process/run.go
@@ -84,8 +84,6 @@ func refuseSpec[C any](spec Spec[C]) error {
 		return errors.New("the spec names no program")
 	case spec.Task != nil && (len(spec.Endpoints) > 0 || len(spec.Jobs) > 0):
 		return errors.New("the spec lists a task beside endpoints or job kinds")
-	case spec.Task == nil && len(spec.Endpoints) == 0 && len(spec.Jobs) == 0:
-		return errors.New("the spec lists no endpoint, no job kind and no task")
 	}
 	return nil
 }
