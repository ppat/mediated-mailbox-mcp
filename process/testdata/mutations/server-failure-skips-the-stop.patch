control: A server that fails while the process serves stops the process in order, with an error naming the server
removes: a server's failure returns at once without the stop, so the goroutines started through Go are neither told to stop nor waited for
packages: ./process
tests: TestAServerThatFailsWhileServingStopsTheProcessInOrder
scheduled-count: no

diff --git a/process/serve.go b/process/serve.go
--- a/process/serve.go
+++ b/process/serve.go
@@ -185,6 +185,7 @@ func (p *proc) serveOn(ctx context.Context, app, probeListener net.Listener, s c
 	var err error
 	select {
 	case err = <-failed:
+		return err
 	case <-p.failed:
 	case <-ctx.Done():
 	}
