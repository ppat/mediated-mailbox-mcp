control: A server that fails while the process serves stops the process in order, with an error naming the server
removes: a server's failure is not waited on, so the process serves on until it is told to stop
packages: ./process
tests: TestAServerThatFailsWhileServingStopsTheProcessInOrder
scheduled-count: no

diff --git a/process/serve.go b/process/serve.go
index b637c343..59cdaf6d 100644
--- a/process/serve.go
+++ b/process/serve.go
@@ -183,7 +183,6 @@ func (p *proc) serveOn(ctx context.Context, app, probeListener net.Listener, s c
 
 	var err error
 	select {
-	case err = <-failed:
 	case <-p.failed:
 	case <-ctx.Done():
 	}
