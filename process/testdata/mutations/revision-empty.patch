control: A shared thing reads the revision of its settings from the process
removes: the revision of every key reads empty
packages: ./process
tests: TestARevisionIsReadFromTheProcess
scheduled-count: no

diff --git a/process/option.go b/process/option.go
--- a/process/option.go
+++ b/process/option.go
@@ -28,5 +28,5 @@ func Revision(p Capabilities, key string) string {
 	if !ok {
 		return ""
 	}
-	return c.proc.revisions[key]
+	return c.proc.revisions[""]
 }
