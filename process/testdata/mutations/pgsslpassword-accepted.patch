control: A deployable refuses to start while PGPASSWORD or PGSSLPASSWORD is set, an empty value included
removes: PGSSLPASSWORD does not refuse the start
packages: ./process
tests: TestThePasswordVariablesAreRefusedBeforeTheConfigurationIsRead/until_stopped/PGSSLPASSWORD=secret TestThePasswordVariablesAreRefusedBeforeTheConfigurationIsRead/until_stopped/PGSSLPASSWORD= TestThePasswordVariablesAreRefusedBeforeTheConfigurationIsRead/once/PGSSLPASSWORD=secret TestThePasswordVariablesAreRefusedBeforeTheConfigurationIsRead/once/PGSSLPASSWORD=
scheduled-count: no

diff --git a/process/run.go b/process/run.go
index 7edb03f4..deddfe83 100644
--- a/process/run.go
+++ b/process/run.go
@@ -187,7 +187,7 @@ func partsOf[C any](spec Spec[C], c C) (parts, []string, error) {
 func refusePasswordVariables(environ []string) error {
 	for _, entry := range environ {
 		name, _, _ := strings.Cut(entry, "=")
-		if name == "PGPASSWORD" || name == "PGSSLPASSWORD" {
+		if name == "PGPASSWORD" {
 			return fmt.Errorf("the environment sets %s, and the database password comes only from the mounted password file", name)
 		}
 	}
