control: A job kind reports not ready until its plan's first listing has succeeded
removes: a job kind's first successful listing is never reported, so the process never answers ready
packages: ./process
tests: TestAJobKindsPlanRunsOnTheScheduler
scheduled-count: no

diff --git a/process/serve.go b/process/serve.go
index b637c343..6c55a65f 100644
--- a/process/serve.go
+++ b/process/serve.go
@@ -135,7 +135,7 @@ func (p *proc) serveOn(ctx context.Context, app, probeListener net.Listener, s c
 		for _, l := range b.plans {
 			name := l.kind + " listing"
 			p.report(name, NotReady, "no listing has succeeded yet")
-			err := scheduler.EnsurePlan(l.kind, l.plan, l.p.Logger(), func() { p.report(name, Ready, "") })
+			err := scheduler.EnsurePlan(l.kind, l.plan, l.p.Logger(), func() {})
 			if err != nil {
 				err = fmt.Errorf("the scheduler refused the plan of the job kind %s: %w", l.kind, err)
 				scheduler.Stop()
