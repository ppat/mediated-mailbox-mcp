+++ b/process/serve.go
@@ -187,7 +187,6 @@ func (p *proc) serveOn(ctx context.Context, app, probeListener net.Listener, s c
 	case <-p.failed:
 	case <-ctx.Done():
 	}
-	serving.Store(false)
 	p.drain()
 	shutdown, cancel := context.WithTimeout(context.WithoutCancel(ctx), drainTimeout)
 	defer cancel()
