control: The operations endpoints answer the health probe, the readiness probe and the metrics endpoint as plain text, and nothing else
removes: every path the operations listener is asked for is answered as the health probe
packages: ./process
tests: TestTheProbesAnswerFromWhatWasReported
scheduled-count: no

diff --git a/process/probes.go b/process/probes.go
index 9642e96c..421d96f0 100644
--- a/process/probes.go
+++ b/process/probes.go
@@ -28,6 +28,9 @@ func probesHandler(gatherer prometheus.Gatherer, ready func(*http.Request) (bool
 		answerProbe(w, r, logger, http.StatusOK, "ready")
 	})
 	mux.Handle("GET /metrics", promhttp.HandlerFor(gatherer, promhttp.HandlerOpts{}))
+	mux.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
+		answerProbe(w, r, logger, http.StatusOK, "ok")
+	})
 	return mux
 }
 
