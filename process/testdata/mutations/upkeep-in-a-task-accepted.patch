control: Upkeep is asked for once per shared thing, while the process is built, and never by a program that runs one piece of work
removes: a program that does one piece of work and exits takes upkeep it never runs
packages: ./process
tests: TestUpkeepIsRefusedOutsideABuildOfAProcessThatServes
scheduled-count: no

diff --git a/process/upkeep.go b/process/upkeep.go
--- a/process/upkeep.go
+++ b/process/upkeep.go
@@ -30,8 +30,6 @@ func Upkeep(p Capabilities, job schedule.Job) error {
 	pr.upkeepMu.Lock()
 	defer pr.upkeepMu.Unlock()
 	switch {
-	case pr.task:
-		return fmt.Errorf("%s asked for upkeep in a program that does one piece of work and exits", c.name)
 	case pr.built:
 		return fmt.Errorf("%s asked for upkeep once the process was built, and upkeep is asked for while it is built", c.name)
 	}
