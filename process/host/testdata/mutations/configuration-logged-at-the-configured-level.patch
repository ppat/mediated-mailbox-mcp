control: The effective configuration is logged at start, each value with its source
removes: the host sets the level before it logs the effective configuration, so under warn a refused value's source is never written, and a refused level's source is never written at all
packages: ./process/host ./migrator/app
tests: TestTheConfiguredLevelGovernsTheLog/until_stopped/a_name_in_upper_case TestTheConfiguredLevelGovernsTheLog/until_stopped/an_offset TestTheConfiguredLevelGovernsTheLog/until_stopped/warning TestTheConfiguredLevelGovernsTheLog/until_stopped/warn TestTheConfiguredLevelGovernsTheLog/until_stopped/error,_from_the_environment TestTheConfiguredLevelGovernsTheLog/until_stopped/a_refused_value_at_error TestTheConfiguredLevelGovernsTheLog/once/a_name_in_upper_case TestTheConfiguredLevelGovernsTheLog/once/an_offset TestTheConfiguredLevelGovernsTheLog/once/warning TestTheConfiguredLevelGovernsTheLog/once/warn TestTheConfiguredLevelGovernsTheLog/once/error,_from_the_environment TestTheConfiguredLevelGovernsTheLog/once/a_refused_value_at_error TestTheStartLogsItsConfigurationThenSetsItsLevelAndWritesItsBanner
scheduled-count: no

diff --git a/process/host/host.go b/process/host/host.go
index 8c310a7a..3b33f0c2 100644
--- a/process/host/host.go
+++ b/process/host/host.go
@@ -346,18 +346,18 @@ func start[T any](args, environ []string, stdout, stderr io.Writer, logger *slog
 	if err != nil {
 		return loaded, false, fmt.Errorf("loading the configuration: %w", err)
 	}
 	// The effective configuration is written before the level applies, so a refused value's source,
 	// log_level's included, reaches the log whatever level the configuration sets (ADR-0078, ADR-0122).
-	for _, v := range loaded.Values {
-		logger.Info("configuration", "path", v.Path, "source", v.Source.String(), "value", v.Value)
-	}
 	lv, err := logging.ParseLevel(root.process(loaded.Config).LogLevel)
 	if err != nil {
 		return loaded, false, fmt.Errorf("validating the configuration: %w", err)
 	}
 	level.Set(lv)
+	for _, v := range loaded.Values {
+		logger.Info("configuration", "path", v.Path, "source", v.Source.String(), "value", v.Value)
+	}
 	if root.validate != nil {
 		if err := root.validate(loaded.Config); err != nil {
 			return loaded, false, fmt.Errorf("validating the configuration: %w", err)
 		}
 	}
