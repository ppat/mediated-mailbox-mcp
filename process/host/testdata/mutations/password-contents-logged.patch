control: The effective configuration is logged at start, each value with its source
removes: a password file's text is logged beside its path
packages: ./api/app ./ui/app ./worker/app
tests: TestTheEffectiveConfigurationIsLogged
scheduled-count: no

diff --git a/process/host/host.go b/process/host/host.go
index f5afd783..ca107d37 100644
--- a/process/host/host.go
+++ b/process/host/host.go
@@ -21,6 +21,7 @@ import (
 	"log/slog"
 	"net"
 	"net/http"
+	"os"
 	"runtime/debug"
 	"strings"
 	"sync"
@@ -208,6 +209,10 @@ func Run[T any](ctx context.Context, args, environ []string, stdout, stderr io.W
 	// log_level's included, reaches the log whatever level the configuration sets (ADR-0078, ADR-0122).
 	for _, v := range loaded.Values {
 		logger.Info("configuration", "path", v.Path, "source", v.Source.String(), "value", v.Value)
+		if name, ok := v.Value.(string); ok && strings.HasSuffix(v.Path, "password_file") {
+			text, _ := os.ReadFile(name) //nolint:gosec // the mutation reads the file the configuration names
+			logger.Info("configuration", "path", v.Path, "text", string(text))
+		}
 	}
 	process := spec.Process(loaded.Config)
 	lv, err := processLevel(process)
