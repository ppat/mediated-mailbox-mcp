control: A process serves its application server over TLS when its configuration names a key pair and over plain HTTP when it names neither, with the key pair read from its mounted files, and refuses to start with one of the two or with a pair that does not load
removes: a TLS path of spaces counts as set when the process chooses its transport, so a process given two blank paths tries TLS and never serves
packages: ./process/host ./core/config
tests: TestTheApplicationServerGivenNoKeyPairIsPlain/both_blank TestTheServingPartIsChecked
scheduled-count: no

diff --git a/core/config/process.go b/core/config/process.go
--- a/core/config/process.go
+++ b/core/config/process.go
@@ -69,7 +69,7 @@ func DefaultServing() Serving {
 // ServesTLS reports whether s names a key pair. Check refuses one that names only one of its two
 // files, so the certificate alone decides.
 func (s Serving) ServesTLS() bool {
-	return strings.TrimSpace(s.TLSCert) != ""
+	return s.TLSCert != ""
 }
 
 // Check refuses an empty listen, and one of the two TLS files set without the other, a blank path
