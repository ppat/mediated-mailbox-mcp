+++ b/process/host/host.go
@@ -491,8 +491,7 @@ func (h *Host) Serve(ctx context.Context, l Listeners, s Serving) error {
 	if app != nil {
 		go func() {
 			if tlsConf == nil {
-				failed <- stopped(app.Serve(l.App))
-				return
+				tlsConf = &tls.Config{MinVersion: tls.VersionTLS12}
 			}
 			failed <- stopped(app.ServeTLS(l.App, "", ""))
 		}()
