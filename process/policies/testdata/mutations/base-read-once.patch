packages: ./process/policies
tests: TestAFailedReadNeverReplacesTheActivePolicy/a_base_rule_is_added_between_two_accounts'_reads,_twice
scheduled-count: no
integration: yes

diff --git a/process/policies/loader.go b/process/policies/loader.go
