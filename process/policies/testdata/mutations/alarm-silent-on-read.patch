control: The policies' reload-failure series reads 1 while their latest load failed and 0 once one succeeds
removes: a reload whose read failed leaves the series as it was
packages: ./process/policies
tests: TestAFailedReadNeverReplacesTheActivePolicy/the_first_account's_read_fails_before_any_row TestAFailedReadNeverReplacesTheActivePolicy/the_first_account's_read_fails_after_one_row TestAFailedReadNeverReplacesTheActivePolicy/the_second_account's_read_fails_before_any_row TestAFailedReadNeverReplacesTheActivePolicy/the_second_account's_read_fails_after_one_row TestAFailedReadNeverReplacesTheActivePolicy/a_base_rule_is_added_between_two_accounts'_reads,_twice TestAFailedReadNeverReplacesTheActivePolicy/the_role_cannot_read_the_table TestAFailedReadNeverReplacesTheActivePolicy/an_account's_rule_cannot_be_decoded,_after_its_other_rules TestAReloadItsCallerCancelledRaisesNoAlarm
scheduled-count: no
integration: yes

diff --git a/process/policies/loader.go b/process/policies/loader.go
--- a/process/policies/loader.go
+++ b/process/policies/loader.go
@@ -135,7 +135,6 @@ func (l *loader) swap(ctx context.Context) error {
 		return fmt.Errorf("the policy reload was cancelled before it finished, so the active policy stays: %w", ctx.Err())
 	}
 	if err != nil {
-		l.metrics.failed()
 		return fmt.Errorf("%w: %w", ErrUntrustedRead, err)
 	}
 	next, outcome := policy.Swap(l.active.Load().policy, rows)
