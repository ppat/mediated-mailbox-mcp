control: An account whose own rules the policies did not read is held to the policy that restricts every sender
removes: an account the policies did not read gets the policy of an account it read, without the restrictions its own rules add
packages: ./process/policies
tests: TestTheLoaderComposesEachAccountsPolicy
scheduled-count: no
integration: yes

diff --git a/process/policies/loader.go b/process/policies/loader.go
--- a/process/policies/loader.go
+++ b/process/policies/loader.go
@@ -43,7 +43,13 @@ func (s Snapshot) Loaded() bool { return s.policy.Loaded() }
 // because the base rules alone would leave out every restriction its own rules add. The snapshot
 // prepares a policy only for the accounts it read, so such an account gets the zero policy.
 func (s Snapshot) For(account string) classify.Policy {
-	return s.prepared[account]
+	if p, read := s.prepared[account]; read {
+		return p
+	}
+	for _, other := range s.prepared {
+		return other
+	}
+	return classify.Policy{}
 }
 
 // loader holds the active snapshot and replaces it on each load that succeeds. Which accounts it
