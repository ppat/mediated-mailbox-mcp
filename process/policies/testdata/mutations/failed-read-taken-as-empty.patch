control: A read of the policy tables the policies cannot trust never replaces the active policy
removes: a read that failed is taken as a whole read that found no rules, so the policy with no rules replaces the active one
packages: ./process/policies
tests: TestAFailedReadNeverReplacesTheActivePolicy/the_first_account's_read_fails_before_any_row TestAFailedReadNeverReplacesTheActivePolicy/the_first_account's_read_fails_after_one_row TestAFailedReadNeverReplacesTheActivePolicy/the_second_account's_read_fails_before_any_row TestAFailedReadNeverReplacesTheActivePolicy/the_second_account's_read_fails_after_one_row TestAFailedReadNeverReplacesTheActivePolicy/a_base_rule_is_added_between_two_accounts'_reads,_twice TestAFailedReadNeverReplacesTheActivePolicy/the_role_cannot_read_the_table TestAFailedReadNeverReplacesTheActivePolicy/an_account's_rule_cannot_be_decoded,_after_its_other_rules
scheduled-count: no
integration: yes

diff --git a/process/policies/loader.go b/process/policies/loader.go
--- a/process/policies/loader.go
+++ b/process/policies/loader.go
@@ -135,8 +135,7 @@ func (l *loader) swap(ctx context.Context) error {
 		return fmt.Errorf("the policy reload was cancelled before it finished, so the active policy stays: %w", ctx.Err())
 	}
 	if err != nil {
-		l.metrics.failed()
-		return fmt.Errorf("%w: %w", ErrUntrustedRead, err)
+		rows = nil
 	}
 	next, outcome := policy.Swap(l.active.Load().policy, rows)
 	if !outcome.Accepted() {
