control: A base edit landing between two accounts' reads of the policies is read again, and fails the load only when edits land through both reads
removes: a reload reads once more for each disagreement, up to two more times, so edits landing through two reads no longer fail it
packages: ./process/policies
tests: TestAFailedReadNeverReplacesTheActivePolicy TestAFailedReadNeverReplacesTheActivePolicy/a_base_rule_is_added_between_two_accounts'_reads,_twice
scheduled-count: no
integration: yes

diff --git a/process/policies/loader.go b/process/policies/loader.go
--- a/process/policies/loader.go
+++ b/process/policies/loader.go
@@ -128,8 +128,10 @@ func (l *loader) swap(ctx context.Context) error {
 	l.mu.Lock()
 	defer l.mu.Unlock()
 	rows, err := l.read(ctx)
-	if errors.Is(err, errTornBase) {
-		rows, err = l.read(ctx)
+	for range 2 {
+		if errors.Is(err, errTornBase) {
+			rows, err = l.read(ctx)
+		}
 	}
 	if err != nil && errors.Is(ctx.Err(), context.Canceled) {
 		return fmt.Errorf("the policy reload was cancelled before it finished, so the active policy stays: %w", ctx.Err())
