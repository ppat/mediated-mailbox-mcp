control: The policy reload rule fires while a process's latest policy load failed, and only then, as the policies' tests read it
removes: the rule compares the series with a value it never exceeds, so it never fires
packages: ./process/policies
tests: TestAlertingRules
scheduled-count: no

diff --git a/packaging/chart/rules/alerting-rules.yaml b/packaging/chart/rules/alerting-rules.yaml
index 9cc9ffa4..a048bb92 100644
--- a/packaging/chart/rules/alerting-rules.yaml
+++ b/packaging/chart/rules/alerting-rules.yaml
@@ -94,7 +94,7 @@ groups:
   # fires at the first evaluation that sees the failure and stays firing until a reload succeeds. Meanwhile a process
   # whose earlier reload succeeded keeps that snapshot, and one whose first load failed restricts every sender.
   - alert: MediatedMailboxPolicyReloadFailed
-    expr: mediated_mailbox_policy_reload_failed > 0
+    expr: mediated_mailbox_policy_reload_failed > 1
     labels:
       severity: page
     annotations:
