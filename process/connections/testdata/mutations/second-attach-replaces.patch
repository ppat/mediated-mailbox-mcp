control: The connections attach to the Session once, and a second attach is refused
removes: a second attach replaces the connections attached first
packages: ./process/connections
tests: TestASecondAttachIsRefused
scheduled-count: no
integration: yes

diff --git a/process/sessions/sessions.go b/process/sessions/sessions.go
--- a/process/sessions/sessions.go
+++ b/process/sessions/sessions.go
@@ -146,8 +146,6 @@ func (s *Session) Attach(c Connections) error {
 	switch {
 	case c == nil:
 		return errors.New("no connections to attach")
-	case s.connections != nil:
-		return errors.New("connections are attached to the Session already")
 	}
 	s.connections = c
 	return nil
