control: A value the connections cannot open leaves its account not connected or the accounts naming its client without one, and the refusal is logged
removes: a credential that does not open leaves its account not connected without a log record
packages: ./process/connections
tests: TestAValueCopiedToAnotherRowOrPurposeDoesNotOpen
scheduled-count: no
integration: yes

diff --git a/process/connections/connections.go b/process/connections/connections.go
--- a/process/connections/connections.go
+++ b/process/connections/connections.go
@@ -291,7 +291,6 @@ func (c *Connections) adopt(rec *record, a accounts.Account, opened map[string]c
 	if !same {
 		var err error
 		if plaintext, err = c.keys.Open(stored, seal.AccountCredential(a.ID)); err != nil {
-			c.log.Error("an account's credential did not open, so it is not connected", slog.String("account", a.ID), slog.Any("error", err))
 			rec.disconnect()
 			return false
 		}
