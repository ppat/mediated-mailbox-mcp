control: An account is workable only once it is listed, connected and its policy loaded
removes: an account in force with a policy is held workable whether or not it has a connection
packages: ./process/connections
tests: TestAnAccountOfAClientProviderWithoutItsClientIsNotConnected
scheduled-count: no
integration: yes

diff --git a/process/sessions/sessions.go b/process/sessions/sessions.go
--- a/process/sessions/sessions.go
+++ b/process/sessions/sessions.go
@@ -304,7 +304,7 @@ func (s *Session) Workable() ([]string, error) {
 	if connections == nil {
 		return nil, nil
 	}
-	return s.with(func(id string) bool { return connections.Connected(id) }), nil
+	return s.with(func(string) bool { return true }), nil
 }
 
 // AccountsWithPolicy returns the accounts a job kind that calls no provider may work on now, in
