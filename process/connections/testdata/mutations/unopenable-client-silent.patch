control: A value the connections cannot open leaves its account not connected or the accounts naming its client without one, and the refusal is logged
removes: a client secret that does not open is logged at debug level, which a deployable does not emit
packages: ./process/connections
tests: TestAValueCopiedToAnotherRowOrPurposeDoesNotOpen
scheduled-count: no
integration: yes

diff --git a/process/connections/connections.go b/process/connections/connections.go
index 463d796a..36b53bef 100644
--- a/process/connections/connections.go
+++ b/process/connections/connections.go
@@ -395,7 +395,7 @@ func (c *Connections) servable(account string, rec *record) bool {
 func (c *Connections) openClient(cl oauthclients.OAuthClientsRow) (coremail.OAuthClient, bool) {
 	secret, err := c.keys.Open(cl.SealedClientSecret, seal.ClientSecret(cl.ClientName))
 	if err != nil {
-		c.log.Error("an OAuth client's secret did not open, so no account connects through it", slog.String("client", cl.ClientName), slog.Any("error", err))
+		c.log.Debug("an OAuth client's secret did not open, so no account connects through it", slog.String("client", cl.ClientName), slog.Any("error", err))
 		return coremail.OAuthClient{}, false
 	}
 	return coremail.OAuthClient{ID: cl.ClientID, Secret: string(secret)}, true
