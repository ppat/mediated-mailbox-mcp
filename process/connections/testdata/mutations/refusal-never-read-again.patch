control: A refused credential is read again, and the call is made once more only over another credential, through the client the account's row names, with the record changed in place
removes: a re-read after a refusal never gives a token, so a credential the operator replaced is not used
packages: ./process/connections
tests: TestAStoredCredentialSomeoneElseReplacedWins TestAReadAgainMakesTheTokenFromTheClientTheAccountMovedTo
scheduled-count: no
integration: yes

diff --git a/process/connections/work.go b/process/connections/work.go
index bee4427e..701dfd44 100644
--- a/process/connections/work.go
+++ b/process/connections/work.go
@@ -96,6 +96,9 @@ func (w *Work) Mailbox() mail.Mailbox { return w.mailbox }
 // back. An account the row leaves without a credential, or without the client its provider
 // authenticates through, loses its connection.
 func (w *Work) again(ctx context.Context) (*provider.Token, error) {
+	if w != nil {
+		return nil, nil
+	}
 	c := w.conns
 	c.mu.Lock()
 	defer c.mu.Unlock()
