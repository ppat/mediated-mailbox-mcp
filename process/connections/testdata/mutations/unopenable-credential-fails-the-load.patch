control: A state the operator fixes, no account, an account that cannot connect or a policy that does not validate, fails neither probe
removes: a credential that does not open fails the connections' load, so the Session never reads its accounts
packages: ./api/app ./worker/app
tests: TestNoAccountOrAnAccountThatCannotConnectFailsNoProbe/accounts_whose_credentials_cannot_be_opened TestNoAccountOrAnAccountThatCannotConnectFailsNoProbe/accounts_that_cannot_connect
scheduled-count: no
integration: yes

diff --git a/process/connections/connections.go b/process/connections/connections.go
index 463d796a..55a65e75 100644
--- a/process/connections/connections.go
+++ b/process/connections/connections.go
@@ -228,6 +228,9 @@ func (c *Connections) Load(ctx context.Context, listed []accounts.Account) error
 			rec = &record{}
 		}
 		adopted := c.adopt(rec, r.account, opened, r.stored)
+		if !adopted && r.stored != nil {
+			return errors.New("an account's credential did not open")
+		}
 		scan.Accounts[r.account.ID] = r.stored != nil && (!adopted || c.onOldKey(r.stored))
 		next[r.account.ID] = rec
 	}
