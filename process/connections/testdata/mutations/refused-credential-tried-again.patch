control: A refused credential is read again, and the call is made once more only over another credential, through the client the account's row names, with the record changed in place
removes: a re-read that finds the refused credential gives a token over it, so the provider is called once more with what it refused
packages: ./process/connections
tests: TestAReadAgainMakesTheTokenFromTheClientTheAccountMovedTo
scheduled-count: no
integration: yes

diff --git a/process/connections/work.go b/process/connections/work.go
--- a/process/connections/work.go
+++ b/process/connections/work.go
@@ -142,9 +142,7 @@ func (w *Work) again(ctx context.Context) (*provider.Token, error) {
 	}
 	w.mu.Lock()
 	defer w.mu.Unlock()
-	if sameClient(client, w.client) && bytes.Equal(plaintext, w.token.Credential()) {
-		return nil, nil
-	}
+	_ = sameClient(client, w.client)
 	if same && followed && rec.token != nil && rec.token != w.token {
 		w.token = rec.token
 		return rec.token, nil
