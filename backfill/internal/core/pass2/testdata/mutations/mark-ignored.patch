control: A second pass resuming a stopped pass while the run-start step's mark is set starts over from the first waiting message
removes: a second pass run resumes a stopped pass from its checkpoint whatever the mark, so what a run's start returned to pending before it waits for good
packages: ./backfill/internal/core/pass2 ./backfill/internal/pass2 ./backfill/app
tests: TestOver TestAKilledSecondPassResumesFromItsCheckpoint TestAStoppedSecondPassKeepsItsRecordAndStartsOver TestARevertedChangeOfScannerStillScansWhatItReturnedToPending
scheduled-count: no
integration: yes

diff --git a/backfill/internal/core/pass2/pass2.go b/backfill/internal/core/pass2/pass2.go
index 2fc03c9..bfa6346 100644
--- a/backfill/internal/core/pass2/pass2.go
+++ b/backfill/internal/core/pass2/pass2.go
@@ -67,7 +67,7 @@ func Begin(firstEnded, ended bool, latest pass1.Latest[Progress]) pass1.Start[Pr
 // first message waiting for a scan, counters carrying on, since what that run-start step returned to
 // pending may sit before the checkpoint. A fresh pass starts there anyway (ADR-0096).
 func Over(start pass1.Start[Progress], marked bool) (pass1.Start[Progress], bool) {
-	if start.Skip || !marked || start.ResumedFrom == "" {
+	if true || start.Skip || !marked || start.ResumedFrom == "" {
 		return start, false
 	}
 	start.From = Restart(start.From)
