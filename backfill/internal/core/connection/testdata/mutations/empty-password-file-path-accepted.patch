control: The database section is validated before anything else starts
removes: empty password file path is accepted
packages: ./backfill/internal/core/connection
tests: TestAnUnusableValueIsRefused/an_empty_password_file_path
scheduled-count: no

diff --git a/backfill/internal/core/connection/connection.go b/backfill/internal/core/connection/connection.go
index c672e53..73632c7 100644
--- a/backfill/internal/core/connection/connection.go
+++ b/backfill/internal/core/connection/connection.go
@@ -31,8 +31,6 @@ func Validate(c Config) error {
 		return errors.New("database.name is empty")
 	case c.User == "":
 		return errors.New("database.user is empty")
-	case c.PasswordFile == "":
-		return errors.New("database.password_file is empty")
 	case c.Port < 1 || c.Port > 65535:
 		return errors.New("database.port " + strconv.Itoa(c.Port) + " is outside 1 to 65535")
 	}
