control: A deployable's configuration type is pinned field by field
removes: a value of the database section is renamed without updating the pinned field list
packages: ./backfill/internal/core/connection
tests: TestTheSectionIsPinned
scheduled-count: no

diff --git a/backfill/internal/connection/connection.go b/backfill/internal/connection/connection.go
index 2795042..077255f 100644
--- a/backfill/internal/connection/connection.go
+++ b/backfill/internal/connection/connection.go
@@ -41,7 +41,7 @@ func PoolConfig(c core.Config) (*pgxpool.Config, error) {
 		"dbname=" + quote(c.Name),
 		"user=" + quote(c.User),
 		"sslmode=" + quote(c.SSLMode),
-		"sslrootcert=" + quote(c.SSLRootCert),
+		"sslrootcert=" + quote(c.CAFile),
 	}
 	config, err := pgxpool.ParseConfig(strings.Join(pairs, " "))
 	if err != nil {
