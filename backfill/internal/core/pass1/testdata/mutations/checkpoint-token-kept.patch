control: A killed backfill run resumes from its last checkpointed page, with at most one page of rework
removes: a page made durable keeps the token it was asked with, so the next page asked for is the same one
packages: ./backfill/internal/pass1 ./backfill/internal/core/pass1
tests: TestAKilledRunResumesFromItsCheckpoint TestAdvanceAndRestart
scheduled-count: no
integration: yes

diff --git a/backfill/internal/core/pass1/pass1.go b/backfill/internal/core/pass1/pass1.go
--- a/backfill/internal/core/pass1/pass1.go
+++ b/backfill/internal/core/pass1/pass1.go
@@ -115,7 +115,7 @@ func Restart(at Progress) Progress {
 func Advance(at Progress, next mail.PageToken, total *mail.Total, added int) Progress {
 	page := at.Checkpoint.Page + 1
 	return Progress{
-		Checkpoint: Checkpoint{Page: page, Token: next, Of: pagesOf(page, next, total)},
+		Checkpoint: Checkpoint{Page: page, Token: at.Checkpoint.Token, Of: pagesOf(page, next, total)},
 		Counters:   Counters{Pages: at.Counters.Pages + 1, Messages: at.Counters.Messages + added},
 	}
 }
