control: A stored subject the enumeration did not find is masked whole under the scanner in force
removes: a subject the enumeration did not find keeps its stored text under the scanner in force instead of being masked whole
packages: ./backfill ./backfill/internal/pass1 ./backfill/internal/core/pass1
tests: TestAChangeOfScannerMasksAndScansAgain TestUnfound
scheduled-count: no
integration: yes

diff --git a/backfill/internal/core/pass1/pass1.go b/backfill/internal/core/pass1/pass1.go
index 1ce1acf..b231fdf 100644
--- a/backfill/internal/core/pass1/pass1.go
+++ b/backfill/internal/core/pass1/pass1.go
@@ -268,7 +268,7 @@ func Unfound(stored []Stored, s Stamp) []Message {
 	var out []Message
 	for _, m := range stored {
 		masked := redact.MaskSubject(scan.Scanner{}, m.Subject)
-		msg := Message{ID: m.ID, Subject: masked.Subject(), Stamp: s}
+		msg := Message{ID: m.ID, Subject: m.Subject, Stamp: s}
 		for _, e := range masked.Events() {
 			msg.Masks = append(msg.Masks, Mask{Rule: e.Rule(), Tier: e.Tier()})
 		}
