control: A killed backfill run resumes from its last checkpointed page, with at most one page of rework
removes: a resumed run starts from the first page, dropping the checkpoint and counters of the run it resumes
packages: ./backfill/internal/pass1 ./backfill/internal/core/pass1
tests: TestAKilledRunResumesFromItsCheckpoint TestAKilledRunIsResumedByTheNextRun TestBegin
scheduled-count: no
integration: yes

diff --git a/backfill/internal/core/pass1/pass1.go b/backfill/internal/core/pass1/pass1.go
--- a/backfill/internal/core/pass1/pass1.go
+++ b/backfill/internal/core/pass1/pass1.go
@@ -96,7 +96,7 @@ func Begin[P any](ended bool, latest Latest[P]) Start[P] {
 	case !latest.Found || latest.State == Succeeded:
 		return Start[P]{}
 	default:
-		return Start[P]{ResumedFrom: latest.RunID, Abandon: latest.State == Running, From: latest.Progress}
+		return Start[P]{ResumedFrom: latest.RunID, Abandon: latest.State == Running}
 	}
 }
 
