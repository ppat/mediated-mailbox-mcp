+++ b/core/index/index.go
@@ -105,7 +105,7 @@ func Decide(items []mail.MessageMetadata, p policy.Composed, s scan.Scanner, l c
 			ThreadID:       m.ThreadID,
 			From:           m.From,
 			Domain:         domain(m.From.Email),
-			Subject:        masked.Subject(),
