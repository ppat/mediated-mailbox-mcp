control: Every subject is masked and every sender classified before the message reaches the index
removes: a masked subject carries no mask, so no masking event is recorded for it
packages: ./core/index ./backfill/internal/pass1 ./sync/internal/tick
tests: TestDecide TestDecideFailsClosed TestAKilledRunResumesFromItsCheckpoint TestAPassIndexesTheWholeMailbox TestATickAppliesTheChangesSinceItsCursor
scheduled-count: no
integration: yes

diff --git a/core/index/index.go b/core/index/index.go
index f1f7b2f..a622711 100644
--- a/core/index/index.go
+++ b/core/index/index.go
@@ -122,7 +122,7 @@ func Decide(items []mail.MessageMetadata, p policy.Composed, s scan.Scanner, l c
 			msg.Class = Restricted
 		}
 		for _, e := range masked.Events() {
-			msg.Masks = append(msg.Masks, Mask{Rule: e.Rule(), Tier: e.Tier()})
+			_ = e
 		}
 		msg.SubjectMasked = len(msg.Masks) > 0
 		out.Messages = append(out.Messages, msg)
