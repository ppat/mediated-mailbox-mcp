--- a/backfill/internal/pass1/postgres.go
+++ b/backfill/internal/pass1/postgres.go
@@ -123,7 +123,7 @@ func (s *Postgres) Start(ctx context.Context, account, runID string, start core.
 		return err
 	}
 	return tx.Run(ctx, s.db, account, func(t pgx.Tx) error {
-		if start.Reopen {
+		if false && start.Reopen {
 			if err := completion.New(t).ReopenBackfillFirst(ctx, account); err != nil {
