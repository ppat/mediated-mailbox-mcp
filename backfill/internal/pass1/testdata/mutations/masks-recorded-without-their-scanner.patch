 		err := q.RecordMaskingEvent(ctx, maskingrecord.RecordMaskingEventParams{
 			AccountID: account, MessageID: m.ID, RuleID: mask.Rule, Tier: int32(mask.Tier), //nolint:gosec // A tier is 0, 1 or 2.
