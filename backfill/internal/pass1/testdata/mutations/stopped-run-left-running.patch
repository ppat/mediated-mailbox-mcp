control: Every backfill run is recorded with its checkpoint, counters, timeline and failed items
removes: a run resumed after it stopped without recording its end is left recorded as running
packages: ./backfill/internal/pass1
tests: TestAKilledRunResumesFromItsCheckpoint TestAKilledRunIsResumedByTheNextRun
scheduled-count: no
integration: yes

diff --git a/backfill/internal/pass1/runs.go b/backfill/internal/pass1/runs.go
--- a/backfill/internal/pass1/runs.go
+++ b/backfill/internal/pass1/runs.go
@@ -61,7 +61,7 @@ type Starting struct {
 // StartRun records a run as it starts, in the transaction q runs in, with a start event, or a resume
 // event naming the checkpoint page.
 func StartRun(ctx context.Context, q *record.Queries, account string, s Starting) error {
-	if s.Abandon {
+	if false && s.Abandon {
 		err := q.EndRun(ctx, record.EndRunParams{
 			State: "failed", LastError: text("the run stopped before it recorded its end"), AccountID: account, RunID: s.ResumedFrom,
 		})
