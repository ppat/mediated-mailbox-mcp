control: A killed second pass resumes from its last checkpointed page
removes: a resumed run counts one page more than its checkpoint
packages: ./backfill/internal/pass2
tests: TestAKilledSecondPassResumesFromItsCheckpoint
scheduled-count: no
integration: yes

diff --git a/backfill/internal/pass2/pass2.go b/backfill/internal/pass2/pass2.go
--- a/backfill/internal/pass2/pass2.go
+++ b/backfill/internal/pass2/pass2.go
@@ -108,6 +108,9 @@ func Open(ctx context.Context, deps Deps, account string) (*Pass, error) {
 		return nil, fmt.Errorf("reading the account's second pass: %w", err)
 	}
 	start := core.Begin(firstEnded, ended, latest)
+	if start.ResumedFrom != "" {
+		start.From.Checkpoint.Page++
+	}
 	if start.Skip {
 		return &Pass{deps: deps, account: account, done: true}, nil
 	}
