control: A second pass resuming a stopped pass while the run-start step's mark is set starts over from the first waiting message
removes: the run-start step reopens the second pass without marking it to start over
packages: ./backfill/app
tests: TestARevertedChangeOfScannerStillScansWhatItReturnedToPending TestAStoppedSecondPassKeepsItsRecordAndStartsOver
scheduled-count: no
integration: yes

diff --git a/db/accountstate/completion/completion.sql b/db/accountstate/completion/completion.sql
index bcd4438..58270b7 100644
--- a/db/accountstate/completion/completion.sql
+++ b/db/accountstate/completion/completion.sql
@@ -25,7 +25,7 @@ WHERE account_id = @account_id;
 -- return the verdicts another scanner made and the overturned gate skips to pending (ADR-0096,
 -- ADR-0098).
 UPDATE account_state
-SET backfill_pass2_complete = false, backfill_pass2_restart = true
+SET backfill_pass2_complete = false
 WHERE account_id = @account_id;
 
 -- name: SecondRestart :one
