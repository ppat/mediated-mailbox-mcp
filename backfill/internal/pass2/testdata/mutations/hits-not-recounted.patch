control: A verdict made under another scanner returns to pending, cleared, with its sender's prior hits counted again
removes: the prior hits of a sender whose verdicts returned to pending are not counted again, so a message flagged again counts twice
packages: ./backfill
tests: TestAChangeOfScannerMasksAndScansAgain
scheduled-count: no
integration: yes

diff --git a/backfill/internal/pass2/postgres.go b/backfill/internal/pass2/postgres.go
index 0ae704b..a40076a 100644
--- a/backfill/internal/pass2/postgres.go
+++ b/backfill/internal/pass2/postgres.go
@@ -175,7 +175,7 @@ func (s *Postgres) Reopen(ctx context.Context, account string, stamp pass1core.S
 			return fmt.Errorf("returning the verdicts another scanner made to pending scan: %w", err)
 		}
 		slices.Sort(domains)
-		for _, d := range slices.Compact(slices.Clone(domains)) {
+		for _, d := range slices.Compact(slices.Clone(domains))[:0] {
 			n, err := senders.New(t).RecountScanHits(ctx, senders.RecountScanHitsParams{AccountID: account, Domain: d})
 			if err != nil {
 				return fmt.Errorf("counting the prior hits of the sender at %q again: %w", d, err)
