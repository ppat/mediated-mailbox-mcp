+++ b/backfill/internal/connection/connection.go
@@ -39,7 +39,6 @@ func PoolConfig(c core.Config) (*pgxpool.Config, error) {
 		"host=" + quote(c.Host),
 		"port=" + quote(strconv.Itoa(c.Port)),
 		"dbname=" + quote(c.Name),
-		"user=" + quote(c.User),
 		"sslmode=" + quote(c.SSLMode),
 		"sslrootcert=" + quote(c.SSLRootCert),
 	}
