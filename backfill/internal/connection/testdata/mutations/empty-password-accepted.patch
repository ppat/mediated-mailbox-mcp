removes: a password file holding no password gives an empty password rather than refusing the start
packages: ./backfill/internal/connection
tests: TestAnEmptyPasswordIsRefused
scheduled-count: no

diff --git a/backfill/internal/connection/connection.go b/backfill/internal/connection/connection.go
index 2795042..00aa2a3 100644
