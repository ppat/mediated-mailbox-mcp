+++ b/backfill/internal/connection/connection.go
@@ -64,9 +64,6 @@ func readPassword(path string) (string, error) {
 	} else {
 		password = strings.TrimSuffix(password, "\n")
 	}
-	if password == "" {
-		return "", fmt.Errorf("the password file %s holds no password", path)
-	}
 	return password, nil
 }
 
