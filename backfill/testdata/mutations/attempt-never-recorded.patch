control: The latest authentication attempt is recorded at the end of every unit of work, a failed one included, and a failed recording ends the pass in an error
removes: the hand-over the run gives its unit of work never reads the source's attempt, so it records none
packages: ./backfill
tests: TestARunRecordsEachAccountsAttemptWhenItsUnitEnds
scheduled-count: no
integration: yes

diff --git a/backfill/main.go b/backfill/main.go
index 28d2276..4aa38a8 100644
--- a/backfill/main.go
+++ b/backfill/main.go
@@ -245,7 +245,7 @@ func backfill(ctx context.Context, pool *pgxpool.Pool, keys *open.Keyring, logge
 		source := sources[account]
 		var attempt mail.AuthAttempt
 		if source != nil {
-			attempt = source.LastAttempt()
+			_ = source.LastAttempt()
 		}
 		return errors.Join(handOver(ctx, loader, account, source), recordAttempt(ctx, pool, account, attempt))
 	}})
