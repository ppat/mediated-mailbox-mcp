control: A deployable that opens credentials refuses to start unless its public key matches one of its private keys
removes: the keyring holds only the first private key named, so a public key matching a later one refuses the start
packages: ./backfill
tests: TestThePublicKeyMustMatchAPrivateKey TestThePublicKeyMustMatchAPrivateKey/a_public_key_matching_the_second_of_two
scheduled-count: no

diff --git a/backfill/main.go b/backfill/main.go
index 56154bd..a839af4 100644
--- a/backfill/main.go
+++ b/backfill/main.go
@@ -84,7 +84,7 @@ func run(ctx context.Context, args, environ []string, logger *slog.Logger) error
 	if err := credentialcore.Validate(loaded.Config.Credential); err != nil {
 		return fmt.Errorf("validating the configuration: %w", err)
 	}
-	keys, err := open.Load(loaded.Config.Credential.PublicKeyFile, loaded.Config.Credential.PrivateKeyFiles...)
+	keys, err := open.Load(loaded.Config.Credential.PublicKeyFile, loaded.Config.Credential.PrivateKeyFiles[:1]...)
 	if err != nil {
 		return fmt.Errorf("loading the keyring: %w", err)
 	}
