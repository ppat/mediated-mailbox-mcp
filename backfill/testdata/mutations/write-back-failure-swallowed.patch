control: A rotated refresh token is handed to the account snapshot library after every page, a page that failed included, and a failed write-back ends the pass in an error
removes: a failed write-back is dropped, so the run ends as if the rotation had landed
packages: ./backfill
tests: TestAFailedWriteBackEndsTheRunInError
scheduled-count: no
integration: yes

diff --git a/backfill/main.go b/backfill/main.go
--- a/backfill/main.go
+++ b/backfill/main.go
@@ -280,8 +280,8 @@ func handOver(ctx context.Context, loader *accountload.Loader, account string, s
 	if source == nil {
 		return nil
 	}
-	_, err := loader.Persist(ctx, account, []byte(source.RefreshToken()))
-	return err
+	_, _ = loader.Persist(ctx, account, []byte(source.RefreshToken()))
+	return nil
 }
 
 // firstPass returns the unit of work that runs backfill's two passes over every served account in
