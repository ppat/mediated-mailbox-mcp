control: A credential the provider refuses is read again from the account's row before the refusal is reported, and a replaced one is used for the call it refused
removes: an account whose row no longer holds a credential has the call made again with an empty one
packages: ./backfill
tests: TestARefusalOfTheStoredCredentialIsReported/the_account_disconnected
scheduled-count: no
integration: yes

diff --git a/backfill/main.go b/backfill/main.go
index b9eac691..22e44c5b 100644
--- a/backfill/main.go
+++ b/backfill/main.go
@@ -287,8 +287,8 @@ func backfill(ctx context.Context, pool *pgxpool.Pool, keys *open.Keyring, logge
 		}
 		held := sources[account].built
 		held.RefreshToken = sources[account].source.RefreshToken()
-		c, ok := sourceCredentials(reread)
-		if !ok || c == held {
+		c, _ := sourceCredentials(reread)
+		if c == held {
 			return nil, nil
 		}
 		sources[account] = holding{source: gmail.NewTokenSource(http.DefaultClient, c), built: c, adoption: reread.Adoption()}
