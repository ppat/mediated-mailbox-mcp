control: A credential the provider refuses is read again from the account's row before the refusal is reported, and a replaced one is used for the call it refused
removes: the re-read's adoption stamp is made the account's holding but its new source is not, so the hand-over writes the refused credential over the one the operator stored
packages: ./backfill
tests: TestARefusedCallUsesTheCredentialTheOperatorStored/the_first_pass TestARefusedCallUsesTheCredentialTheOperatorStored/the_second_pass
scheduled-count: no
integration: yes

diff --git a/backfill/main.go b/backfill/main.go
index b9eac691..6bef25b7 100644
--- a/backfill/main.go
+++ b/backfill/main.go
@@ -291,8 +291,9 @@ func backfill(ctx context.Context, pool *pgxpool.Pool, keys *open.Keyring, logge
 		if !ok || c == held {
 			return nil, nil
 		}
-		sources[account] = holding{source: gmail.NewTokenSource(http.DefaultClient, c), built: c, adoption: reread.Adoption()}
-		return sources[account].source, nil
+		source := gmail.NewTokenSource(http.DefaultClient, c)
+		sources[account] = holding{source: sources[account].source, built: sources[account].built, adoption: reread.Adoption()}
+		return source, nil
 	}})
 }
 
