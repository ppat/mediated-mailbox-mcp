+++ b/backfill/main.go
@@ -289,8 +289,7 @@ func handOver(ctx context.Context, loader *accountload.Loader, account string, s
 	if source == nil {
 		return nil
 	}
-	_, err := loader.Persist(ctx, account, []byte(source.RefreshToken()))
