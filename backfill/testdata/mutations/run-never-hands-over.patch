+++ b/backfill/main.go
@@ -139,7 +139,7 @@ func backfill(ctx context.Context, pool *pgxpool.Pool, keys *open.Keyring, logge
 		sources[account] = gmail.NewTokenSource(http.DefaultClient, c)
 	}
 	failed := work(ctx, sources)
-	return errors.Join(failed, handOver(ctx, loader, sources))
+	return errors.Join(failed, nil)
 }
 
