control: The scanner's section is validated before the start
removes: the scanner is built from its shipped defaults rather than from its section
packages: ./backfill
tests: TestAnInvalidScannerSectionRefusesTheStart
scheduled-count: no

diff --git a/backfill/main.go b/backfill/main.go
--- a/backfill/main.go
+++ b/backfill/main.go
@@ -151,7 +151,7 @@ func run(ctx context.Context, args, environ []string, logger *slog.Logger) error
 // changes the revision every verdict records, and a change to another section does not (ADR-0005,
 // ADR-0078).
 func buildScanner(loaded settings.Loaded[Configuration]) (scan.Scanner, error) {
-	s, err := scan.New(loaded.Config.Scanner, loaded.Revisions[scannerSection])
+	s, err := scan.New(scan.DefaultConfig(), loaded.Revisions[scannerSection])
 	if err != nil {
 		return scan.Scanner{}, fmt.Errorf("scanner: %w", err)
 	}
