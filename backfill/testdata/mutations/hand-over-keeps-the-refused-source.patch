control: A credential the provider refuses is read again from the account's row before the refusal is reported, and a replaced one is used for the call it refused
removes: the new source and its re-read's adoption stamp are not made the account's holding, so the hand-over keeps handing over the refused source with the snapshot's stamp, and a rotation of the credential read again is never written back
packages: ./backfill
tests: TestARotationAfterARereadIsWrittenBack
scheduled-count: no
integration: yes

diff --git a/backfill/main.go b/backfill/main.go
index 31cb3c5..1fb5724 100644
--- a/backfill/main.go
+++ b/backfill/main.go
@@ -285,8 +285,7 @@ func backfill(ctx context.Context, pool *pgxpool.Pool, keys *open.Keyring, logge
 		}
 		c := creds[account]
 		c.RefreshToken = string(stored)
-		sources[account] = holding{source: gmail.NewTokenSource(http.DefaultClient, c), adoption: reread.Adoption()}
-		return sources[account].source, nil
+		return gmail.NewTokenSource(http.DefaultClient, c), nil
 	}})
 }
 
