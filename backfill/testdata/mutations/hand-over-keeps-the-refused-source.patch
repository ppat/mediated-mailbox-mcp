+++ b/backfill/main.go
@@ -291,8 +291,7 @@ func backfill(ctx context.Context, pool *pgxpool.Pool, keys *open.Keyring, logge
 		if !ok || c == held {
 			return nil, nil
 		}
-		sources[account] = holding{source: gmail.NewTokenSource(http.DefaultClient, c), built: c, adoption: reread.Adoption()}
-		return sources[account].source, nil
+		return gmail.NewTokenSource(http.DefaultClient, c), nil
 	}})
 }
 
