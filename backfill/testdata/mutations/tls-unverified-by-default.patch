control: Every connection setting comes from the deployable's configuration, never from the PG* variables, and TLS verifies the server by default
removes: the TLS mode defaults to prefer, which does not verify the server
packages: ./backfill
tests: TestTheDefaults
scheduled-count: no

diff --git a/backfill/main.go b/backfill/main.go
--- a/backfill/main.go
+++ b/backfill/main.go
@@ -71,7 +71,7 @@ type Configuration struct {
 func defaults() Configuration {
 	return Configuration{
 		ProbeListen: ":8080",
-		Database:    dbconnectcore.Config{Port: 5432, User: "mediated_mailbox_backfill", SSLMode: "verify-full"},
+		Database:    dbconnectcore.Config{Port: 5432, User: "mediated_mailbox_backfill", SSLMode: "prefer"},
 		Scanner:     scan.DefaultConfig(),
 	}
 }
