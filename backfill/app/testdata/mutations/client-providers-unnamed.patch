control: An account of a provider that authenticates through an OAuth client is connected only through its own client
removes: backfill names no provider as authenticating through a client, so the loader connects a Gmail account that names none
packages: ./backfill/app
tests: TestAnAccountWithoutAClientIsSkipped
scheduled-count: no
integration: yes

diff --git a/backfill/app/app.go b/backfill/app/app.go
index 1691e4f5..2b8548da 100644
--- a/backfill/app/app.go
+++ b/backfill/app/app.go
@@ -210,7 +210,7 @@ type unitOfWork func(ctx context.Context, s served) error
 // account's port with connect. A snapshot whose read fails stops the run, since a run that exits holds
 // no previous snapshot.
 func backfill(ctx context.Context, pool *pgxpool.Pool, keys *open.Keyring, logger *slog.Logger, registry prometheus.Registerer, connect session.Connector, work unitOfWork) error {
-	loader := accountload.New(pool, keys, logger, []string{gmailProvider})
+	loader := accountload.New(pool, keys, logger, nil)
 	if err := loader.Load(ctx); err != nil {
 		return fmt.Errorf("loading the accounts: %w", err)
 	}
