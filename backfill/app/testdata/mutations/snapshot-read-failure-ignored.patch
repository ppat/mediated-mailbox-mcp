control: A run takes its account snapshot once at the start, and a failed read stops it
removes: a load whose read fails is ignored, so the run goes on with no account
packages: ./backfill/app
tests: TestAFailedSnapshotReadStopsTheRun
scheduled-count: no
integration: yes

diff --git a/backfill/app/app.go b/backfill/app/app.go
index 1691e4f5..b46fc605 100644
--- a/backfill/app/app.go
+++ b/backfill/app/app.go
@@ -211,9 +211,7 @@ type unitOfWork func(ctx context.Context, s served) error
 // no previous snapshot.
 func backfill(ctx context.Context, pool *pgxpool.Pool, keys *open.Keyring, logger *slog.Logger, registry prometheus.Registerer, connect session.Connector, work unitOfWork) error {
 	loader := accountload.New(pool, keys, logger, []string{gmailProvider})
-	if err := loader.Load(ctx); err != nil {
-		return fmt.Errorf("loading the accounts: %w", err)
-	}
+	_ = loader.Load(ctx)
 	snapshot := loader.Snapshot()
 	listed := snapshot.Accounts()
 	ids := make([]string, 0, len(listed))
