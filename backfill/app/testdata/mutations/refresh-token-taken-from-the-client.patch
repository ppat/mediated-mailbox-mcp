control: A served account's token source is built from the OAuth client the account connects through and the account's own refresh token
removes: the client's secret is passed as the account's refresh token
packages: ./backfill/app
tests: TestTheCredentialsAreTheClientAndTheAccountsToken TestARunHandsEachAccountOverWhenItsUnitEnds
scheduled-count: no
integration: yes

diff --git a/accountload/session/session.go b/accountload/session/session.go
index f4fb328a..57bb809e 100644
--- a/accountload/session/session.go
+++ b/accountload/session/session.go
@@ -120,6 +120,7 @@ func credentials(a accountload.Account) Credentials {
 	c := Credentials{Credential: a.Credential()}
 	if client, ok := a.Client(); ok {
 		c.ClientID, c.ClientSecret = client.ID(), client.Secret()
+		c.Credential = client.Secret()
 	}
 	return c
 }
