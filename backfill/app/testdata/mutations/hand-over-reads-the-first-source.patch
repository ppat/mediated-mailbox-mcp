control: A rotated refresh token is handed to the account snapshot library after every page, a page that failed included, and a failed write-back ends the pass in an error
removes: the hand-over hands over the source the run started with, so a source a re-read replaced is never handed over
packages: ./backfill/app
tests: TestARotationAfterARereadIsWrittenBack
scheduled-count: no
integration: yes

diff --git a/accountload/session/session.go b/accountload/session/session.go
index f4fb328a..b942cad8 100644
--- a/accountload/session/session.go
+++ b/accountload/session/session.go
@@ -163,7 +163,7 @@ func (h *Holder) Open(snapshot *accountload.Snapshot, account string) (*Session,
 	if err != nil {
 		return nil, err
 	}
-	return &Session{h: h, account: account, connector: connector, built: creds, adoption: a.Adoption(), conn: conn, port: port}, nil
+	return &Session{h: h, account: account, connector: connector, built: creds, adoption: a.Adoption(), conn: conn, opened: conn, port: port}, nil
 }
 
 // source returns the account's source for creds, the one it holds when Hold is set and creds are the
@@ -207,6 +207,7 @@ type Session struct {
 	// the hand-over names so a credential someone else replaced since is never put back (ADR-0089).
 	adoption uint64
 	conn     connection
+	opened   connection
 	port     mail.Port[context.Context]
 }
 
@@ -250,7 +251,7 @@ func Call[T any](ctx context.Context, s *Session, call func(context.Context, mai
 // It returns the hand-over's error and the recording's apart, for the caller to return or log. A
 // session may end several units of work, one after each.
 func (s *Session) End(ctx context.Context) (handOver, record error) {
-	_, handOver = s.h.config.Loader.HandOver(ctx, s.account, s.adoption, s.conn.source.Credential())
+	_, handOver = s.h.config.Loader.HandOver(ctx, s.account, s.adoption, s.opened.source.Credential())
 	return handOver, recordAttempt(ctx, s.h.config.DB, s.account, s.conn.source.LastAttempt())
 }
 
