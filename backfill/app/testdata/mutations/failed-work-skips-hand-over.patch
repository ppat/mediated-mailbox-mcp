control: A rotated refresh token is handed to the account snapshot library after every page, a page that failed included, and a failed write-back ends the pass in an error
removes: a page that fails ends the pass before the hand-over, so a rotation made before the failure is lost
packages: ./backfill/app
tests: TestAFailedPageIsStillHandedOver
scheduled-count: no
integration: yes

diff --git a/backfill/app/app.go b/backfill/app/app.go
index 7f611a28..aef55916 100644
--- a/backfill/app/app.go
+++ b/backfill/app/app.go
@@ -367,6 +367,9 @@ func passAccount(ctx context.Context, deps pass1.Deps, account string, metrics *
 	var handOvers []error
 	for {
 		step, err := p.Next(ctx)
+		if err != nil {
+			return err
+		}
 		if hoErr := handOver(ctx, account); hoErr != nil {
 			handOvers = append(handOvers, hoErr)
 		}
