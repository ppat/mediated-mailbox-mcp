control: The database password is the mounted password file's text less one trailing newline, and an empty one refuses the start
removes: a trailing \r\n loses only its \n, so the password keeps a carriage return
packages: ./dbconnect
tests: TestThePasswordIsTheFilesText
scheduled-count: no

diff --git a/dbconnect/dbconnect.go b/dbconnect/dbconnect.go
index 2795042..475172c 100644
--- a/dbconnect/dbconnect.go
+++ b/dbconnect/dbconnect.go
@@ -59,11 +59,7 @@ func readPassword(path string) (string, error) {
 		return "", fmt.Errorf("reading the password file: %w", err)
 	}
 	password := string(text)
-	if trimmed, ok := strings.CutSuffix(password, "\r\n"); ok {
-		password = trimmed
-	} else {
-		password = strings.TrimSuffix(password, "\n")
-	}
+	password = strings.TrimSuffix(password, "\n")
 	if password == "" {
 		return "", fmt.Errorf("the password file %s holds no password", path)
 	}
