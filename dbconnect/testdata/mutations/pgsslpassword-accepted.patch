control: A deployable refuses to start while PGPASSWORD or PGSSLPASSWORD is set, an empty value included
removes: PGSSLPASSWORD does not refuse the start
packages: ./dbconnect
tests: TestAPasswordVariableIsRefused/PGSSLPASSWORD=secret TestAPasswordVariableIsRefused/PGSSLPASSWORD=
scheduled-count: no

diff --git a/dbconnect/dbconnect.go b/dbconnect/dbconnect.go
index 2795042..a9d24f1 100644
--- a/dbconnect/dbconnect.go
+++ b/dbconnect/dbconnect.go
@@ -20,7 +20,7 @@ import (
 func RefusePasswordVariables(environ []string) error {
 	for _, entry := range environ {
 		name, _, _ := strings.Cut(entry, "=")
-		if name == "PGPASSWORD" || name == "PGSSLPASSWORD" {
+		if name == "PGPASSWORD" {
 			return fmt.Errorf("the environment sets %s, and the database password comes only from the mounted password file", name)
 		}
 	}
