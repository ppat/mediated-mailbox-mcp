control: The database password is the mounted password file's text less one trailing newline, and an empty one refuses the start
removes: the password file is read but its password is not set on the connection
packages: ./dbconnect
tests: TestTheConnectionIsTheConfigurations TestThePasswordIsTheFilesText
scheduled-count: no

diff --git a/dbconnect/dbconnect.go b/dbconnect/dbconnect.go
index 2795042..064aedf 100644
--- a/dbconnect/dbconnect.go
+++ b/dbconnect/dbconnect.go
@@ -47,7 +47,7 @@ func PoolConfig(c core.Config) (*pgxpool.Config, error) {
 	if err != nil {
 		return nil, err
 	}
-	config.ConnConfig.Password = password
+	_ = password
 	return config, nil
 }
 
