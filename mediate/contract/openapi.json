{
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "mediated-mailbox-mediate",
    "version": "0"
  },
  "openapi": "3.1.1",
  "paths": {
    "/api/accounts": {
      "get": {
        "description": "Lists every account the mediator serves, each with its identifier and provider. Every other operation takes one of these identifiers as account_id.",
        "operationId": "list_accounts",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "accounts": {
                      "items": {
                        "properties": {
                          "account_id": {
                            "type": "string"
                          },
                          "provider": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "account_id",
                          "provider"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "accounts"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The operation's result."
          }
        }
      }
    },
    "/api/accounts/{account_id}/labels": {
      "get": {
        "description": "Lists every distinct label value the account's indexed messages hold, in order. These are the values every other operation takes as a label.",
        "operationId": "list_labels",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "labels": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "labels"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The operation's result."
          }
        }
      }
    },
    "/api/accounts/{account_id}/masking-events": {
      "get": {
        "description": "Lists the subjects the account's messages had masked at rest, the latest first, one page at a time, each with the rule and tier that fired and never the masked text. since, a UTC timestamp ending in Z, keeps the events masked at or after it, and any other offset is refused. Pass the next_cursor a page returned as cursor to read the next page. next_cursor is null on the last page.",
        "operationId": "list_masking_events",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "since",
            "schema": {
              "format": "date-time",
              "pattern": "Z$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "events": {
                      "items": {
                        "properties": {
                          "field": {
                            "type": "string"
                          },
                          "masked_at": {
                            "format": "date-time",
                            "pattern": "Z$",
                            "type": "string"
                          },
                          "message_id": {
                            "type": "string"
                          },
                          "rule_id": {
                            "type": "string"
                          },
                          "tier": {
                            "type": "integer"
                          }
                        },
                        "required": [
                          "message_id",
                          "field",
                          "rule_id",
                          "tier",
                          "masked_at"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "events",
                    "next_cursor"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The operation's result."
          }
        }
      }
    },
    "/api/accounts/{account_id}/messages": {
      "get": {
        "description": "Lists the account's messages, newest first, one page at a time, with each message's metadata as the redaction matrix allows it. Pass the next_cursor a page returned as cursor to read the next page. next_cursor is null on the last page.",
        "operationId": "list_messages",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "messages": {
                      "items": {
                        "properties": {
                          "account_id": {
                            "type": "string"
                          },
                          "attachment_types": {
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          },
                          "body_available": {
                            "type": "boolean"
                          },
                          "date": {
                            "format": "date-time",
                            "pattern": "Z$",
                            "type": "string"
                          },
                          "flags": {
                            "type": "object"
                          },
                          "from": {
                            "properties": {
                              "display_name": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "email": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "email",
                              "display_name"
                            ],
                            "type": "object"
                          },
                          "has_attachments": {
                            "type": "boolean"
                          },
                          "labels": {
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          },
                          "message_id": {
                            "type": "string"
                          },
                          "sensitivity": {
                            "properties": {
                              "content_flags": {
                                "items": {
                                  "enum": [
                                    "mfa_code",
                                    "login_link"
                                  ],
                                  "type": "string"
                                },
                                "type": "array"
                              },
                              "scan_state": {
                                "enum": [
                                  "pending",
                                  "scanned",
                                  "skipped_gate",
                                  "skipped_restricted"
                                ],
                                "type": "string"
                              },
                              "sender_class": {
                                "enum": [
                                  "normal",
                                  "restricted"
                                ],
                                "type": "string"
                              }
                            },
                            "required": [
                              "sender_class",
                              "content_flags",
                              "scan_state"
                            ],
                            "type": "object"
                          },
                          "subject": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "thread_id": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "account_id",
                          "message_id",
                          "thread_id",
                          "subject",
                          "from",
                          "date",
                          "labels",
                          "flags",
                          "has_attachments",
                          "attachment_types",
                          "sensitivity",
                          "body_available"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "messages",
                    "next_cursor"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The operation's result."
          }
        }
      }
    },
    "/api/accounts/{account_id}/messages/{message_id}": {
      "get": {
        "description": "Returns one message's metadata as the redaction matrix allows it. body_available says whether the body could be released, and no body, snippet or attachment filename is returned.",
        "operationId": "get_message",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "message_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "account_id": {
                      "type": "string"
                    },
                    "attachment_types": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "body_available": {
                      "type": "boolean"
                    },
                    "date": {
                      "format": "date-time",
                      "pattern": "Z$",
                      "type": "string"
                    },
                    "flags": {
                      "type": "object"
                    },
                    "from": {
                      "properties": {
                        "display_name": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "email": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "email",
                        "display_name"
                      ],
                      "type": "object"
                    },
                    "has_attachments": {
                      "type": "boolean"
                    },
                    "labels": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "message_id": {
                      "type": "string"
                    },
                    "sensitivity": {
                      "properties": {
                        "content_flags": {
                          "items": {
                            "enum": [
                              "mfa_code",
                              "login_link"
                            ],
                            "type": "string"
                          },
                          "type": "array"
                        },
                        "scan_state": {
                          "enum": [
                            "pending",
                            "scanned",
                            "skipped_gate",
                            "skipped_restricted"
                          ],
                          "type": "string"
                        },
                        "sender_class": {
                          "enum": [
                            "normal",
                            "restricted"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "sender_class",
                        "content_flags",
                        "scan_state"
                      ],
                      "type": "object"
                    },
                    "subject": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "thread_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "account_id",
                    "message_id",
                    "thread_id",
                    "subject",
                    "from",
                    "date",
                    "labels",
                    "flags",
                    "has_attachments",
                    "attachment_types",
                    "sensitivity",
                    "body_available"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The operation's result."
          }
        }
      }
    },
    "/api/accounts/{account_id}/status": {
      "get": {
        "description": "Returns the account's recorded operational state, so a client can tell why something is slow, missing or denied. It reads backfill progress, the delta sync cursor's age and last successful tick, the content scan backlog, the rate controller's state and the last provider authentication. It holds no mail content and no policy.",
        "operationId": "get_system_status",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "account_id": {
                      "type": "string"
                    },
                    "backfill": {
                      "properties": {
                        "pass1_complete": {
                          "type": "boolean"
                        },
                        "pass2_complete": {
                          "type": "boolean"
                        }
                      },
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "last_authentication": {
                      "properties": {
                        "at": {
                          "format": "date-time",
                          "pattern": "Z$",
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "outcome": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "rate": {
                      "properties": {
                        "backoff_until": {
                          "format": "date-time",
                          "pattern": "Z$",
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "current_rate": {
                          "type": "number"
                        },
                        "in_backoff": {
                          "type": "boolean"
                        },
                        "target_rate": {
                          "type": "number"
                        }
                      },
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "scan_backlog": {
                      "type": "integer"
                    },
                    "sync": {
                      "properties": {
                        "cursor_age_seconds": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "cursor_written_at": {
                          "format": "date-time",
                          "pattern": "Z$",
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "last_succeeded_tick_at": {
                          "format": "date-time",
                          "pattern": "Z$",
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "type": [
                        "object",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "account_id",
                    "backfill",
                    "sync",
                    "scan_backlog",
                    "rate",
                    "last_authentication"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The operation's result."
          }
        }
      }
    },
    "/api/accounts/{account_id}/threads": {
      "get": {
        "description": "Lists the account's threads, the one with the latest message first, one page at a time, each with its number of messages and the time of its latest. Pass the next_cursor a page returned as cursor to read the next page. next_cursor is null on the last page.",
        "operationId": "list_threads",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "threads": {
                      "items": {
                        "properties": {
                          "latest_at": {
                            "format": "date-time",
                            "pattern": "Z$",
                            "type": "string"
                          },
                          "messages": {
                            "type": "integer"
                          },
                          "thread_id": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "thread_id",
                          "messages",
                          "latest_at"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "threads",
                    "next_cursor"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The operation's result."
          }
        }
      }
    },
    "/api/accounts/{account_id}/threads/{thread_id}": {
      "get": {
        "description": "Returns every message of one thread, oldest first, each with its metadata as the redaction matrix allows it.",
        "operationId": "get_thread",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "thread_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "messages": {
                      "items": {
                        "properties": {
                          "account_id": {
                            "type": "string"
                          },
                          "attachment_types": {
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          },
                          "body_available": {
                            "type": "boolean"
                          },
                          "date": {
                            "format": "date-time",
                            "pattern": "Z$",
                            "type": "string"
                          },
                          "flags": {
                            "type": "object"
                          },
                          "from": {
                            "properties": {
                              "display_name": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "email": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "email",
                              "display_name"
                            ],
                            "type": "object"
                          },
                          "has_attachments": {
                            "type": "boolean"
                          },
                          "labels": {
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          },
                          "message_id": {
                            "type": "string"
                          },
                          "sensitivity": {
                            "properties": {
                              "content_flags": {
                                "items": {
                                  "enum": [
                                    "mfa_code",
                                    "login_link"
                                  ],
                                  "type": "string"
                                },
                                "type": "array"
                              },
                              "scan_state": {
                                "enum": [
                                  "pending",
                                  "scanned",
                                  "skipped_gate",
                                  "skipped_restricted"
                                ],
                                "type": "string"
                              },
                              "sender_class": {
                                "enum": [
                                  "normal",
                                  "restricted"
                                ],
                                "type": "string"
                              }
                            },
                            "required": [
                              "sender_class",
                              "content_flags",
                              "scan_state"
                            ],
                            "type": "object"
                          },
                          "subject": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "thread_id": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "account_id",
                          "message_id",
                          "thread_id",
                          "subject",
                          "from",
                          "date",
                          "labels",
                          "flags",
                          "has_attachments",
                          "attachment_types",
                          "sensitivity",
                          "body_available"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "thread_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "thread_id",
                    "messages"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The operation's result."
          }
        }
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}
