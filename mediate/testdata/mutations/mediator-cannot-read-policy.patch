control: The mediator loads the policy of the accounts it serves, and of none when it serves none
removes: the mediator's role is not granted the policy rules' columns
packages: ./mediate
tests: TestTheMediatorLoadsPolicyForItsAccounts
scheduled-count: no
integration: yes


diff --git a/db/migrations/00007_mediate_policy_grants.sql b/db/migrations/00007_mediate_policy_grants.sql
index 388c7fb..c57ca38 100644
--- a/db/migrations/00007_mediate_policy_grants.sql
+++ b/db/migrations/00007_mediate_policy_grants.sql
@@ -3,4 +3,4 @@
 -- under the role of each deployable that imports it (ADR-0075). The mediator's role gets SELECT on the
 -- same columns backfill's does, and who created a rule and when stay out of its reach. Row-level
 -- security still shows it only the base rules and its transaction's account's rules.
-GRANT SELECT (account_id, rule_id, class, domain_suffix) ON policy_rules TO mediated_mailbox_mediate;
+SELECT 1;
