control: The mediator's token source is built from the OAuth client the account connects through and the account's stored credential, and from nothing else
removes: the re-read after a refusal keeps the client the source was built with
packages: ./mediate
tests: TestARereadAfterAMoveBuildsTheSourceFromTheNewClient
scheduled-count: no
integration: yes

diff --git a/mediate/main.go b/mediate/main.go
index 78009489..8907f492 100644
--- a/mediate/main.go
+++ b/mediate/main.go
@@ -902,6 +902,7 @@ func retried[T any](ctx context.Context, s *session, call func(context.Context,
 	held := s.creds
 	held.RefreshToken = s.source.RefreshToken()
 	creds, ok := sourceCredentials(reread)
+	creds.ClientID, creds.ClientSecret = held.ClientID, held.ClientSecret
 	if !ok || creds == held {
 		return out, err
 	}
