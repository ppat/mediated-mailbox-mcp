packages: ./mediate
tests: TestAPasswordInTheEnvironmentStopsTheStart
scheduled-count: no


diff --git a/mediate/main.go b/mediate/main.go
index 9a59611..ea33a56 100644
--- a/mediate/main.go
+++ b/mediate/main.go
@@ -410,7 +410,7 @@ func refuseEnvironment(environ []string) error {
 			return errors.New("MCPGODEBUG is set, and the mediator runs the MCP SDK only as it ships (ADR-0086)")
 		}
 	}
-	return dbconnect.RefusePasswordVariables(environ)
+	return nil
 }
 
