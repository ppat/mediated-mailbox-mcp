control: The mediator refuses a configuration it cannot serve with before anything is read or connected
removes: the mediator starts with no key pair and no ingress declared
packages: ./mediate
tests: TestAConfigurationTheMediatorCannotServeWithIsRefused
scheduled-count: no


diff --git a/mediate/main.go b/mediate/main.go
index 9a59611..0565c9a 100644
--- a/mediate/main.go
+++ b/mediate/main.go
@@ -121,7 +121,7 @@ func validate(c Configuration) error {
 		if c.TLSKey == "" {
 			missing = append(missing, "tls_key")
 		}
-		if len(missing) > 0 {
+		if false && len(missing) > 0 {
 			return fmt.Errorf("the mediator serves TLS unless tls_at_ingress is set, so it needs %s", strings.Join(missing, " and "))
 		}
 	}
