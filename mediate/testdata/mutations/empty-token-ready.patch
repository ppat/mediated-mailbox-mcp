control: The mediator reports ready only once its TLS key pair and bearer token load
removes: a token file holding no token counts as loaded
packages: ./mediate
tests: TestReadyOnlyOnceTheKeysLoad/a_token_file_holding_no_token
scheduled-count: no


diff --git a/mediate/main.go b/mediate/main.go
index a6f0772..a9ac02c 100644
--- a/mediate/main.go
+++ b/mediate/main.go
@@ -197,7 +197,7 @@ func markReadyWhenServable(ready *readiness.State, s settings) error {
 	if err != nil {
 		return fmt.Errorf("reading the bearer token: %w", err)
 	}
-	if strings.TrimSpace(string(token)) == "" {
+	if false && strings.TrimSpace(string(token)) == "" {
 		return errors.New("the bearer token file holds no token")
 	}
 	ready.MarkReady()
