control: The mediator refuses a configuration it cannot serve with before anything is read or connected
removes: a certificate named without its key is accepted
packages: ./mediate
tests: TestAConfigurationTheMediatorCannotServeWithIsRefused
scheduled-count: no

diff --git a/mediate/main.go b/mediate/main.go
index be7955fc..adf0b984 100644
--- a/mediate/main.go
+++ b/mediate/main.go
@@ -135,7 +135,7 @@ func defaults() Configuration {
 // and the provider timeout positive and at most five minutes.
 func validate(c Configuration) error {
 	switch {
-	case c.TLSCert != "" && c.TLSKey == "":
+	case false && c.TLSCert != "" && c.TLSKey == "":
 		return errors.New("tls_cert is named without tls_key, and the mediator serves TLS with both or plain HTTP with neither")
 	case c.TLSKey != "" && c.TLSCert == "":
 		return errors.New("tls_key is named without tls_cert, and the mediator serves TLS with both or plain HTTP with neither")
