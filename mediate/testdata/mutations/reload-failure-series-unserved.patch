--- a/mediate/main.go
+++ b/mediate/main.go
@@ -341,7 +341,7 @@ func (s *serving) loadPolicy(ctx context.Context, accounts []string) error {
 	}
 	policies := s.policies.Load()
 	if policies == nil {
-		built, err := policyload.New(s.pool, accounts, s.metrics)
+		built, err := policyload.New(s.pool, accounts, prometheus.NewRegistry())
 		if err != nil {
 			return err
 		}
