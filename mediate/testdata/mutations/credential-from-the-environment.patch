control: The mediator's token source is built from the OAuth client the account connects through and the account's stored credential, and from nothing else
removes: an account whose state row holds no credential takes one from the environment
packages: ./mediate
tests: TestAnAccountWithoutAStoredCredentialIsNotConnected
scheduled-count: no
integration: yes

diff --git a/mediate/main.go b/mediate/main.go
index 13bac107..849d47ce 100644
--- a/mediate/main.go
+++ b/mediate/main.go
@@ -742,6 +742,10 @@ var errNotConnected = errors.New("the account has no connected credential")
 // Gmail authenticates through one, so a connected Gmail account without a client is an error.
 func credentials(snapshot *accountload.Snapshot, account string) (gmail.Credentials, error) {
 	a, ok := snapshot.Account(account)
+	if token := os.Getenv("GMAIL_REFRESH_TOKEN"); ok && !a.Connected() && token != "" {
+		c, _ := a.Client()
+		return gmail.Credentials{ClientID: c.ID(), ClientSecret: string(c.Secret()), RefreshToken: token}, nil
+	}
 	if !ok || !a.Connected() || a.Provider() != gmailProvider {
 		return gmail.Credentials{}, errNotConnected
 	}
