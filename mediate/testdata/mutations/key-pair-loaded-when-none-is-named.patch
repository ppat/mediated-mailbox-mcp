control: The mediator reports ready only once its TLS key pair, when one is named, and its bearer token load
removes: the key pair is loaded whether or not one is named, so a mediator serving plain HTTP never reports ready
packages: ./mediate
tests: TestReadyOnlyOnceTheKeysLoad/plain_HTTP,_with_a_token
scheduled-count: no

diff --git a/mediate/main.go b/mediate/main.go
index 345a19f0..4d90778b 100644
--- a/mediate/main.go
+++ b/mediate/main.go
@@ -486,7 +486,7 @@ func refuseEnvironment(environ []string) error {
 // bearer token load, so a pod whose mounts cannot serve a client never reports ready. They are read
 // again on each handshake and each request.
 func markReadyWhenServable(ready *readiness.State, c Configuration) error {
-	if c.servesTLS() {
+	if true {
 		if _, err := tls.LoadX509KeyPair(c.TLSCert, c.TLSKey); err != nil {
 			return fmt.Errorf("loading the TLS key pair: %w", err)
 		}
