control: Every request to the client surface passes the bearer check before either root
removes: the MCP root is served beside the bearer check rather than behind it
packages: ./mediate
tests: TestEveryRequestPassesTheBearerCheckFirst/the_MCP_root_without_a_token TestEveryRequestPassesTheBearerCheckFirst/the_MCP_root_with_a_wrong_token TestEveryRequestPassesTheBearerCheckFirst/an_empty_token_file_and_a_token
scheduled-count: no


diff --git a/mediate/main.go b/mediate/main.go
index 80ea49cd..96d2b6ec 100644
--- a/mediate/main.go
+++ b/mediate/main.go
@@ -563,9 +563,10 @@ func surface(registry service.Registry, tokenFile string, logger *slog.Logger) (
 		return nil, err
 	}
 	roots := http.NewServeMux()
-	roots.Handle("/api/", apiRoot)
+	roots.Handle("/api/", bearer(tokenFile, apiRoot, logger))
 	roots.Handle("/mcp", mcp.Handler(registry, version(), logger))
