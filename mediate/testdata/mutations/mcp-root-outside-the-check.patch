control: Every request to the client surface passes the bearer check before either root
removes: the MCP root is served beside the bearer check rather than behind it
packages: ./mediate
tests: TestEveryRequestPassesTheBearerCheckFirst/the_MCP_root_without_a_token TestEveryRequestPassesTheBearerCheckFirst/the_MCP_root_with_a_wrong_token TestEveryRequestPassesTheBearerCheckFirst/an_empty_token_file_and_a_token
scheduled-count: no


diff --git a/mediate/main.go b/mediate/main.go
index d1f0451..e7a95c4 100644
--- a/mediate/main.go
+++ b/mediate/main.go
@@ -266,9 +266,10 @@ func surface(registry service.Registry, tokenFile string) (http.Handler, error)
 		return nil, err
 	}
 	roots := http.NewServeMux()
-	roots.Handle("/api/", apiRoot)
+	roots.Handle("/api/", bearer(tokenFile, apiRoot))
 	roots.Handle("/mcp", mcp.Handler(registry, version()))
-	return noStore(bearer(tokenFile, roots)), nil
+	roots.Handle("/", bearer(tokenFile, http.NotFoundHandler()))
+	return noStore(roots), nil
 }
 
 // noStore marks every response uncacheable and removes any ETag as its header is written.
