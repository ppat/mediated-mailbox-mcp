control: A deployable that opens credentials refuses to start unless its public key matches one of its private keys
removes: the start builds no keyring from the key files, so a public key matching none of the private keys goes unnoticed
packages: ./mediate
tests: TestThePublicKeyMustMatchAPrivateKey/a_public_key_matching_no_private_key
scheduled-count: no


diff --git a/mediate/main.go b/mediate/main.go
index 9a59611..d511517 100644
--- a/mediate/main.go
+++ b/mediate/main.go
@@ -172,7 +172,7 @@ func run(ctx context.Context, args, environ []string, logger *slog.Logger) error
 	if err := validate(c); err != nil {
 		return fmt.Errorf("validating the configuration: %w", err)
 	}
-	keys, err := open.Load(c.Credential.PublicKeyFile, c.Credential.PrivateKeyFiles...)
+	keys, err := (*open.Keyring)(nil), error(nil)
 	if err != nil {
 		return fmt.Errorf("loading the keyring: %w", err)
 	}
