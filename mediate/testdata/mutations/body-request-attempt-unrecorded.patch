control: Each body request hands its account's credential over and records the latest authentication attempt when it ends
removes: a body request ends without recording the attempt
packages: ./mediate
tests: TestEachBodyRequestHandsOverAndRecordsTheAttempt
scheduled-count: no
integration: yes
diff --git a/mediate/main.go b/mediate/main.go
--- a/mediate/main.go
+++ b/mediate/main.go
@@ -862,7 +862,7 @@
 	if _, err := loader.HandOver(ctx, s.account, s.adoption, []byte(s.source.RefreshToken())); err != nil {
 		logger.Error("handing the account's credential over failed", "account", s.account, "error", err)
 	}
-	if err := recordAttempt(ctx, s.p.served.pool, s.account, s.source.LastAttempt()); err != nil {
+	if err := recordAttempt(ctx, s.p.served.pool, s.account, mail.AuthAttempt{}); err != nil {
 		logger.Error("recording the last authentication attempt failed", "account", s.account, "error", err)
 	}
 }
