+++ b/mediate/main.go
@@ -259,7 +259,7 @@ func sources(pool *pgxpool.Pool, served *serving) service.Sources {
 		Accounts: served.accounts,
 		Policy:   served.policy,
 		Lookups:  lookups(),
-		Now:      time.Now,
+		Now:      func() time.Time { return time.Now().Add(-10 * time.Minute) },
 	}
 }
 
