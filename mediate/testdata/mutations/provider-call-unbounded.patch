control: A provider call that does not answer within the provider timeout is the provider's failure
removes: a provider call has no deadline of the mediator's, so a provider that does not answer holds the request
packages: ./mediate
tests: TestAProviderThatDoesNotAnswerIsTheProvidersFailure
scheduled-count: no
integration: yes

diff --git a/mediate/main.go b/mediate/main.go
index 9d112fd..99ebc26 100644
--- a/mediate/main.go
+++ b/mediate/main.go
@@ -910,7 +910,7 @@ func leased[T any](ctx context.Context, limiter *lease.Limiter, port mail.Port[c
 		return zero, fmt.Errorf("leasing the call: %w", err)
 	}
 	start := time.Now()
-	bounded, cancel := context.WithTimeout(ctx, timeout)
+	bounded, cancel := context.WithTimeout(ctx, timeout+time.Hour)
 	out, err := call(bounded)
 	if err != nil && errors.Is(bounded.Err(), context.DeadlineExceeded) && ctx.Err() == nil {
 		err = fmt.Errorf("%w: no answer within %s: %w", mail.ErrProvider, timeout, err)
