control: The mediator refuses to start while PGPASSWORD or PGSSLPASSWORD is set
removes: PGSSLPASSWORD is left out of the refusal
packages: ./mediate
tests: TestAPasswordInTheEnvironmentStopsTheStart
scheduled-count: no


diff --git a/mediate/main.go b/mediate/main.go
index 91cec55..7eabe32 100644
--- a/mediate/main.go
+++ b/mediate/main.go
@@ -202,7 +202,7 @@ func refuseEnvironment() error {
 	if _, set := os.LookupEnv("MCPGODEBUG"); set {
 		return errors.New("MCPGODEBUG is set, and the mediator runs the MCP SDK only as it ships (ADR-0086)")
 	}
-	for _, name := range []string{"PGPASSWORD", "PGSSLPASSWORD"} {
+	for _, name := range []string{"PGPASSWORD"} {
 		if _, set := os.LookupEnv(name); set {
 			return fmt.Errorf("%s is set, and the database password arrives only as a mounted file (ADR-0078)", name)
 		}
