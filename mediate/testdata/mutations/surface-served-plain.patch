control: The client surface is served over TLS when a key pair is named and over plain HTTP when none is, with the key pair read from its mounted files
removes: the client surface is served over plain HTTP whatever its settings
packages: ./mediate
tests: TestWithAKeyPairTheSurfaceIsServedOverTLSOnly
scheduled-count: no


diff --git a/mediate/main.go b/mediate/main.go
index 5bde0327..f4673750 100644
--- a/mediate/main.go
+++ b/mediate/main.go
@@ -510,7 +510,7 @@ func serveSurface(srv *http.Server, ln net.Listener, overTLS bool) error {
 	if !overTLS {
 		return stopped(srv.Serve(ln))
 	}
-	return stopped(srv.ServeTLS(ln, "", ""))
+	return stopped(srv.Serve(ln))
 }
 
 // serveProbes serves the probes and the metrics endpoint on ln until it is shut down.
