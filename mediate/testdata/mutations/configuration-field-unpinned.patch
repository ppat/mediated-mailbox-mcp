control: A deployable's configuration type is pinned field by field
removes: a value is added to the root configuration without updating the pinned field list
packages: ./mediate
tests: TestTheConfigurationTypeIsPinned
scheduled-count: no


diff --git a/mediate/main.go b/mediate/main.go
index 60aac7a..3e17cc8 100644
--- a/mediate/main.go
+++ b/mediate/main.go
@@ -102,6 +102,7 @@ type Configuration struct {
 	AccountReloadInterval time.Duration         `yaml:"account_reload_interval"`
 	Database              dbconnectcore.Config  `yaml:"database"`
 	Credential            credentialcore.Config `yaml:"credential"`
+	Accounts              []string              `yaml:"accounts"`
 	// Scanner is the scanner's section, the same section backfill reads, whose pattern tier the
 	// serve-time pattern check runs (ADR-0002, ADR-0005). No value in it switches the check off.
 	Scanner scan.Config `yaml:"scanner"`
