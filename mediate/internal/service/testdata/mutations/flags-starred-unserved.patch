control: A served message's flags are exactly read and starred, each a boolean
removes: starred is always served as false
packages: ./mediate/internal/service
tests: TestTheFlagsAreServedAsReadAndStarredAlone
scheduled-count: no
integration: yes

diff --git a/mediate/internal/service/present.go b/mediate/internal/service/present.go
index a8bd6cb2..c6d44e1b 100644
--- a/mediate/internal/service/present.go
+++ b/mediate/internal/service/present.go
@@ -65,7 +65,7 @@ func storedMessageFlags(stored []byte) messageFlags {
 	if err := json.Unmarshal(stored, &keys); err != nil {
 		return messageFlags{}
 	}
-	return messageFlags{Read: storedBool(keys["read"]), Starred: storedBool(keys["starred"])}
+	return messageFlags{Read: storedBool(keys["read"]), Starred: false}
 }
 
 // storedBool reads one stored flag, false unless it is the JSON boolean true.
