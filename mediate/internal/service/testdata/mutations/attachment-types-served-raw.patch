control: Every message a read operation serves follows the redaction matrix, decided by the Redaction Gate under the policy in force
removes: a served message carries its attachments' stored media types as its types, never passing them through the mapping
packages: ./mediate/internal/service
tests: TestEveryServedMessageFollowsTheRedactionMatrix
scheduled-count: no
integration: yes

diff --git a/mediate/internal/service/present.go b/mediate/internal/service/present.go
index 7a8570fa..fafe5a02 100644
--- a/mediate/internal/service/present.go
+++ b/mediate/internal/service/present.go
@@ -135,8 +135,8 @@ func present(account string, m stored, p policy.Composed, l classify.Lookups) me
 // mapping, each word once and sorted, so no stored value is served (ADR-0123).
 func types(media []mail.AttachmentMedia) []string {
 	out := []string{}
-	for _, t := range mail.AttachmentTypes(media) {
-		out = append(out, string(t))
+	for _, m := range media {
+		out = append(out, m.MediaType)
 	}
 	return out
 }
