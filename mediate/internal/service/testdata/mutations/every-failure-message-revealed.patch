removes: a failure inside the mediator carries its error's own text, an internal detail included
packages: ./mediate/internal/api ./mediate/internal/mcp
tests: TestEachFailureNamesItsOrigin TestAToolCallRunsTheOperation
scheduled-count: no

diff --git a/mediate/internal/service/failure.go b/mediate/internal/service/failure.go
index edb01ed..06c3404 100644
--- a/mediate/internal/service/failure.go
+++ b/mediate/internal/service/failure.go
@@ -81,7 +81,7 @@ func Classify(err error) (Origin, string) {
 	if errors.As(err, &provider) {
 		return OriginProvider, provider.message
 	}
-	return OriginMediator, mediatorMessage
+	return OriginMediator, err.Error()
 }
 
