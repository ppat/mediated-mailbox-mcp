control: A message whose body is denied stays in every count, group and search result of the index reads
removes: the summary counts as a selection's messages only those whose body could be released, scanned with no content flag
packages: ./mediate/internal/service
tests: TestEveryMessageStaysInEveryIndexRead
scheduled-count: no
integration: yes

diff --git a/db/messages/search.sql b/db/messages/search.sql
index 173bebc3..c3ad9a51 100644
--- a/db/messages/search.sql
+++ b/db/messages/search.sql
@@ -118,7 +118,7 @@ SELECT
 FROM (
     SELECT
         m.thread_id,
-        count(*) AS messages,
+        count(*) FILTER (WHERE m.scan_state = 'scanned' AND cardinality(m.content_flags) = 0) AS messages,
         count(*) FILTER (WHERE NOT coalesce((m.flags ->> 'read')::boolean, FALSE)) AS unread,
         count(*) FILTER (WHERE m.has_attachments) AS with_attachments,
         min(m.sent_at) AS oldest_at,
