control: A listing's cursor continues only the listing, account and filter it came from, and paging serves every row once
removes: the thread listing's next page starts after the last thread's latest time alone, so a thread sharing that time is skipped
packages: ./mediate/internal/service
tests: TestAListingPagesThroughEveryRowOnce
scheduled-count: no
integration: yes


diff --git a/db/messages/metadata.sql b/db/messages/metadata.sql
index 58555bb..e2852ff 100644
--- a/db/messages/metadata.sql
+++ b/db/messages/metadata.sql
@@ -78,7 +78,7 @@ WHERE m.account_id = @account_id
 GROUP BY m.thread_id
 HAVING
     @before_latest_at::timestamptz IS NULL
-    OR (max(m.sent_at), m.thread_id) < (@before_latest_at::timestamptz, @before_thread_id::text)
+    OR max(m.sent_at) < @before_latest_at::timestamptz
 ORDER BY latest_at DESC, m.thread_id DESC
 LIMIT @page_size;
 
diff --git a/db/messages/metadata.sql.go b/db/messages/metadata.sql.go
index c5344b6..a02690f 100644
--- a/db/messages/metadata.sql.go
+++ b/db/messages/metadata.sql.go
@@ -287,7 +287,7 @@ WHERE m.account_id = $1
 GROUP BY m.thread_id
 HAVING
     $2::timestamptz IS NULL
-    OR (max(m.sent_at), m.thread_id) < ($2::timestamptz, $3::text)
+    OR (max(m.sent_at) < $2::timestamptz AND $3::text IS NOT NULL)
 ORDER BY latest_at DESC, m.thread_id DESC
 LIMIT $4
 `
