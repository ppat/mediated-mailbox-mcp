control: Every body serve and denial writes its audit row, and nothing is released without it
removes: a body the conversion refused is audited as though the serve-time pattern check ran
packages: ./mediate/app
tests: TestABodyTheConversionRefusesIsDenied
scheduled-count: no
integration: yes

diff --git a/mediate/internal/service/body.go b/mediate/internal/service/body.go
index b868a7c7..81e0210e 100644
--- a/mediate/internal/service/body.go
+++ b/mediate/internal/service/body.go
@@ -324,12 +324,12 @@ type serveCheck struct {
 // conversion refused, whose decision nobody made (ADR-0002, ADR-0016).
 func checked(d release.Decision, s scan.Scanner) serveCheck {
 	switch d.Reason() {
-	case release.Released, release.PatternMatched:
+	case release.Released, release.PatternMatched, release.Undecided:
 		if s.Version() == 0 {
 			return serveCheck{}
 		}
 		return serveCheck{ran: true, rules: sorted(d.Rules()), version: int32(s.Version()), revision: s.Revision()} //nolint:gosec // the scanner's version is a small constant
-	case release.Undecided, release.NotReleasable, release.NoScanner:
+	case release.NotReleasable, release.NoScanner:
 		return serveCheck{}
 	default:
 		return serveCheck{}
