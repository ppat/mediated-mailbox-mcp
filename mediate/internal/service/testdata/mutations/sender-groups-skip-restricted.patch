control: A message whose body is denied stays in every count, group and search result of the index reads
removes: the groups by sender leave out the messages skipped as restricted
packages: ./mediate/internal/service
tests: TestEveryMessageStaysInEveryIndexRead
scheduled-count: no
integration: yes

diff --git a/db/messages/search.sql b/db/messages/search.sql
index c369b93..6b3fc5d 100644
--- a/db/messages/search.sql
+++ b/db/messages/search.sql
@@ -138,6 +138,7 @@ SELECT
 FROM messages AS m
 WHERE
     m.account_id = @account_id
+    AND m.scan_state != 'skipped_restricted'
     AND (@after::timestamptz IS NULL OR m.sent_at >= @after::timestamptz)
     AND (@before::timestamptz IS NULL OR m.sent_at < @before::timestamptz)
     AND (@from_emails::citext[] IS NULL OR m.from_email = any(@from_emails::citext[]))
diff --git a/db/messages/search.sql.go b/db/messages/search.sql.go
index e052b44..121da70 100644
--- a/db/messages/search.sql.go
+++ b/db/messages/search.sql.go
@@ -254,6 +254,7 @@ SELECT
 FROM messages AS m
 WHERE
     m.account_id = $1
+    AND m.scan_state != 'skipped_restricted'
     AND ($2::timestamptz IS NULL OR m.sent_at >= $2::timestamptz)
     AND ($3::timestamptz IS NULL OR m.sent_at < $3::timestamptz)
     AND ($4::citext[] IS NULL OR m.from_email = any($4::citext[]))
