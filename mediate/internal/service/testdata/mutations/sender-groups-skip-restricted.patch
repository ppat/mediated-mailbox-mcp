control: A message whose body is denied stays in every count, group and search result of the index reads
removes: the groups by sender leave out the messages skipped as restricted
packages: ./mediate/internal/service
tests: TestEveryMessageStaysInEveryIndexRead
scheduled-count: no
integration: yes

diff --git a/db/messages/search.sql b/db/messages/search.sql
index 818eddd1..3582a1ed 100644
--- a/db/messages/search.sql
+++ b/db/messages/search.sql
@@ -132,60 +132,61 @@ WHERE
     )
     AND (
         @starred::boolean[] IS NULL
         OR coalesce((m.flags ->> 'starred')::boolean, FALSE) = any(@starred::boolean[])
     )
     AND (@has_attachments::boolean[] IS NULL OR m.has_attachments = any(@has_attachments::boolean[]))
     AND (
         @restricted::boolean[] IS NULL
         OR (
             NOT EXISTS (
