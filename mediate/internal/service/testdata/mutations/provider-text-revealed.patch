removes: a provider failure's message carries the provider's own error text
packages: ./mediate/internal/api
tests: TestEachFailureNamesItsOrigin
scheduled-count: no

diff --git a/mediate/internal/service/failure.go b/mediate/internal/service/failure.go
index c2cba09..9c44fb7 100644
