control: The service layer refuses an operation whose account is missing or unknown, except the accounts listing
removes: the operation receives the arguments as sent, account_id included, so it can read an account other than the one checked
packages: ./mediate/internal/service
tests: TestTheServiceLayerRefusesAMissingOrUnknownAccount/a_served_account TestTheServiceLayerRefusesAMissingOrUnknownAccount/a_served_account_and_nothing_else
scheduled-count: no


diff --git a/mediate/internal/service/registry.go b/mediate/internal/service/registry.go
index 1b1cca9..a89fb30 100644
--- a/mediate/internal/service/registry.go
+++ b/mediate/internal/service/registry.go
@@ -135,14 +135,14 @@ func (r Registry) Call(ctx context.Context, name string, input json.RawMessage)
 	if op.Name == accountsListing {
 		return op.Handle(ctx, "", input)
 	}
-	account, rest, err := splitAccount(input)
+	account, _, err := splitAccount(input)
 	if err != nil {
 		return nil, err
 	}
 	if !r.known[account] {
 		return nil, ErrUnknownAccount
 	}
-	return op.Handle(ctx, account, rest)
+	return op.Handle(ctx, account, input)
 }
 
 // splitAccount reads a JSON object's top-level account_id string and returns it with the object
