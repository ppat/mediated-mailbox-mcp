control: Both roots hand the service layer the same argument object
removes: the API root reads every query parameter as text, whatever the input declares
packages: ./mediate/internal/api
tests: TestBothRootsHandTheServiceTheSameObject
scheduled-count: no


diff --git a/mediate/internal/api/api.go b/mediate/internal/api/api.go
index cc14950..e154133 100644
--- a/mediate/internal/api/api.go
+++ b/mediate/internal/api/api.go
@@ -197,6 +197,7 @@ func (rt route) queryValue(key, text string) (json.RawMessage, error) {
 		return json.Marshal(text)
 	}
 	t, declared := rt.types[key]
+	t = "string"
 	if !declared || rt.op.Method != http.MethodGet || rt.isPathVar(key) {
 		return nil, fmt.Errorf("the query parameter %q is not an argument the query string carries", key)
 	}
