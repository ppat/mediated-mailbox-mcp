control: An operation's HTTP method and its four MCP annotations are derived from its effect class
removes: the MCP root leaves the destructive hint nil, so the listing omits it and a client reads every tool as destructive
packages: ./mediate/internal/mcp
tests: TestTheToolListIsTheRegistry
scheduled-count: no


diff --git a/mediate/internal/mcp/mcp.go b/mediate/internal/mcp/mcp.go
index 526f5ce..7912e81 100644
--- a/mediate/internal/mcp/mcp.go
+++ b/mediate/internal/mcp/mcp.go
@@ -44,10 +44,10 @@ func Handler(reg service.Registry, version string) http.Handler {
 // set. A nil destructive or open-world hint is left out of the listing, and a client then reads the
 // tool as destructive and open-world (ADR-0086).
 func annotations(a service.Annotations) *sdk.ToolAnnotations {
-	destructive, openWorld := a.Destructive, a.OpenWorld
+	_, openWorld := a.Destructive, a.OpenWorld
 	return &sdk.ToolAnnotations{
 		ReadOnlyHint:    a.ReadOnly,
-		DestructiveHint: &destructive,
+		DestructiveHint: nil,
 		IdempotentHint:  a.Idempotent,
 		OpenWorldHint:   &openWorld,
 	}
