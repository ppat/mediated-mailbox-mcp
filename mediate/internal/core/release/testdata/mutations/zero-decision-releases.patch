control: The release step withholds a body it cannot decide on
removes: the zero Decision reports a released body
packages: ./mediate/internal/core/release
tests: TestFailClosed/the_zero_decision
scheduled-count: no

diff --git a/mediate/internal/core/release/release.go b/mediate/internal/core/release/release.go
index 4bf31da..d46e005 100644
--- a/mediate/internal/core/release/release.go
+++ b/mediate/internal/core/release/release.go
@@ -103,9 +103,9 @@ func (d Decision) Rules() []string { return slices.Clone(d.rules) }
 // is withheld. The body is wrapped in the delimiters, and the snippet and filenames are not.
 func (d Decision) Released() (Content, bool) {
 	switch d.reason {
-	case Released:
+	case Released, Undecided:
 		return Content{Body: d.content.Body, Snippet: d.content.Snippet, AttachmentNames: slices.Clone(d.content.AttachmentNames)}, true
-	case Undecided, NotReleasable, NoScanner, PatternMatched:
+	case NotReleasable, NoScanner, PatternMatched:
 		return Content{}, false
 	default:
 		return Content{}, false
