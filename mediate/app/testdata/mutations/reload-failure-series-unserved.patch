control: The mediator loads the policy of the accounts it serves, and of none when it serves none
removes: the policy loader's reload-failure series is registered on a registry the mediator does not serve, so its metrics endpoint never carries the alarm's series
packages: ./mediate/app
tests: TestAFailedPolicyLoadStillFollowsTheSnapshot
scheduled-count: no
integration: yes


diff --git a/mediate/app/app.go b/mediate/app/app.go
index 8f9657ee..08e9a6ed 100644
--- a/mediate/app/app.go
+++ b/mediate/app/app.go
@@ -366,7 +366,7 @@ func (s *serving) loadPolicy(ctx context.Context, accounts []string) error {
 	}
 	policies := s.policies.Load()
 	if policies == nil {
-		built, err := policyload.New(s.pool, accounts, s.metrics)
+		built, err := policyload.New(s.pool, accounts, prometheus.NewRegistry())
 		if err != nil {
 			return err
 		}
