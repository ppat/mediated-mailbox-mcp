control: A body request waits for its leases no longer than its deadline for them, and a wait cut off by it is the mediator's failure
removes: the deadline is counted from the provider session's opening rather than the request's arrival, so the policy load and the gate's read before it lengthen the wait
packages: ./mediate/app
tests: TestARequestWaitsForItsLeasesNoLongerThanItsDeadline
scheduled-count: no
integration: yes

diff --git a/mediate/app/app.go b/mediate/app/app.go
--- a/mediate/app/app.go
+++ b/mediate/app/app.go
@@ -863,7 +863,7 @@ func (p *providers) open(ctx context.Context, account string, arrived time.Time)
 	if err != nil {
 		return nil, err
 	}
-	return &provider{p: p, account: account, session: opened, limiter: limiter, waitUntil: arrived.Add(p.wait)}, nil
+	return &provider{p: p, account: account, session: opened, limiter: limiter, waitUntil: time.Now().Add(p.wait)}, nil
 }
 
 // provider is one body request's calls to the account's provider, through its account session.
