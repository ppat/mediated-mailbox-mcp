control: The client surface is served over TLS unless an ingress in front is declared to terminate it, with the key pair read from its mounted files
removes: the client surface is served over plain HTTP whatever its settings
packages: ./mediate/app
tests: TestTheSurfaceIsServedOverTLSOnly
scheduled-count: no


diff --git a/mediate/app/app.go b/mediate/app/app.go
index 8f9657ee..94e4d3b1 100644
--- a/mediate/app/app.go
+++ b/mediate/app/app.go
@@ -503,7 +503,7 @@ func serveSurface(srv *http.Server, ln net.Listener) error {
 	if srv.TLSConfig == nil {
 		return stopped(srv.Serve(ln))
 	}
-	return stopped(srv.ServeTLS(ln, "", ""))
+	return stopped(srv.Serve(ln))
 }
 
 // serveProbes serves the probes and the metrics endpoint on ln until it is shut down.
