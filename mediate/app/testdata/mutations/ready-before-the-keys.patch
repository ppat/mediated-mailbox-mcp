control: The mediator reports ready only once its TLS key pair and bearer token load
removes: the mediator is marked ready before the key pair and token are loaded
packages: ./mediate/app
tests: TestReadyOnlyOnceTheKeysLoad/a_certificate_that_is_absent TestReadyOnlyOnceTheKeysLoad/a_key_that_does_not_match TestReadyOnlyOnceTheKeysLoad/a_token_file_that_is_absent TestReadyOnlyOnceTheKeysLoad/a_token_file_holding_no_token
scheduled-count: no


diff --git a/mediate/app/app.go b/mediate/app/app.go
index 8f9657ee..f661da46 100644
--- a/mediate/app/app.go
+++ b/mediate/app/app.go
@@ -481,6 +481,7 @@ func refuseEnvironment(environ []string) error {
 // terminates TLS, and the bearer token load, so a pod whose mounts cannot serve a client never
 // reports ready. They are read again on each handshake and each request.
 func markReadyWhenServable(ready *readiness.State, c Configuration) error {
+	ready.MarkReady()
 	if !c.TLSAtIngress {
 		if _, err := tls.LoadX509KeyPair(c.TLSCert, c.TLSKey); err != nil {
 			return fmt.Errorf("loading the TLS key pair: %w", err)
