control: Every response of the client surface is uncacheable, and HEAD is refused
removes: the client surface is served without the no-store wrapper
packages: ./mediate/app
tests: TestEveryResponseIsUncacheable
scheduled-count: no


diff --git a/mediate/app/app.go b/mediate/app/app.go
index 523220a..191c329 100644
--- a/mediate/app/app.go
+++ b/mediate/app/app.go
@@ -547,7 +547,7 @@ func surface(registry service.Registry, tokenFile string, logger *slog.Logger) (
 	roots := http.NewServeMux()
 	roots.Handle("/api/", apiRoot)
 	roots.Handle("/mcp", mcp.Handler(registry, version(), logger))
-	return noStore(logger, bearer(tokenFile, logger, roots)), nil
+	return bearer(tokenFile, logger, roots), nil
 }
 
 // noStore marks every response uncacheable, before its handler runs, so a response its handler
