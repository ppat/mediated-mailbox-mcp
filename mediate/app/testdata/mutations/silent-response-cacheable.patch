control: Every response of the client surface is uncacheable, and HEAD is refused
removes: a response whose handler writes nothing carries no Cache-Control
packages: ./mediate/app
tests: TestNoStoreOverridesAHandlersCaching
scheduled-count: no


diff --git a/mediate/app/app.go b/mediate/app/app.go
index 523220a..db6af5b 100644
--- a/mediate/app/app.go
+++ b/mediate/app/app.go
@@ -555,7 +555,6 @@ func surface(registry service.Registry, tokenFile string, logger *slog.Logger) (
 // handler's own caching headers do not survive.
 func noStore(logger *slog.Logger, next http.Handler) http.Handler {
 	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
-		w.Header().Set("Cache-Control", "no-store")
 		next.ServeHTTP(&noStoreWriter{ResponseWriter: w, logger: logger}, r)
 	})
 }
