-	if cert, key := strings.TrimSpace(c.TLSCert) != "", strings.TrimSpace(c.TLSKey) != ""; cert != key {
+	if cert, key := c.TLSCert != "", c.TLSKey != ""; cert != key {
 		set, missing := "tls_cert", "tls_key"
 		if key {
 			set, missing = "tls_key", "tls_cert"
