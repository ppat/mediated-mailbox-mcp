control: The chart renders the mediator a file it starts with, holding every mediator key the chart admits
removes: the chart leaves the mediator's pool size out of its file though the values set one
packages: ./mediate/app
tests: TestTheChartRendersAFileTheMediatorStartsWith
scheduled-count: no

diff --git a/packaging/chart/templates/_config.tpl b/packaging/chart/templates/_config.tpl
--- a/packaging/chart/templates/_config.tpl
+++ b/packaging/chart/templates/_config.tpl
@@ -48,6 +48,7 @@ so no key is written twice.
 {{- $_ := set $c "scanner" .Values.sharedConfig.scanner }}
 {{- end }}
 {{- $_ := set $c "database" (include "mm.config.database" (list . $v.database) | fromYaml) }}
+{{- $_ := unset (index $c "database") "pool_size" }}
 {{- $_ := set $c "credential" (include "mm.config.credential" . | fromYaml) }}
 {{- $_ := set $c "listen" (printf ":%s" (include "mm.port.http" .)) }}
 {{- $_ := set $c "probe_listen" (printf ":%s" (include "mm.port.metrics" .)) }}
