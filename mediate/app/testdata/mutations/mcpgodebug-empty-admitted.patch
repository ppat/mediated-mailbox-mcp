control: The mediator refuses to start while MCPGODEBUG is set
removes: an MCPGODEBUG set to the empty string is taken as unset
packages: ./mediate/app
tests: TestMCPGODEBUGStopsTheStart
scheduled-count: no


diff --git a/mediate/app/app.go b/mediate/app/app.go
index 8f9657ee..dbba1628 100644
--- a/mediate/app/app.go
+++ b/mediate/app/app.go
@@ -470,7 +470,7 @@ func idsOf(snapshot *accountload.Snapshot) []string {
 // over the mounted password file.
 func refuseEnvironment(environ []string) error {
 	for _, entry := range environ {
-		if name, _, _ := strings.Cut(entry, "="); name == "MCPGODEBUG" {
+		if name, value, _ := strings.Cut(entry, "="); name == "MCPGODEBUG" && value != "" {
 			return errors.New("MCPGODEBUG is set, and the mediator runs the MCP SDK only as it ships (ADR-0086)")
 		}
 	}
