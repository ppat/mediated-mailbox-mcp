control: The mediator serves the accounts each account snapshot it reloads lists, and keeps them when a reload's read fails
removes: the registry keeps the first set of accounts it was given, whatever a reload serves
packages: ./mediate/app
tests: TestTheMediatorServesTheAccountsEachReloadLists
scheduled-count: no
integration: yes


diff --git a/mediate/internal/service/registry.go b/mediate/internal/service/registry.go
index 98ade84..a379483 100644
--- a/mediate/internal/service/registry.go
+++ b/mediate/internal/service/registry.go
@@ -190,7 +190,7 @@ func (r Registry) Serve(accounts []string) {
 	for _, account := range accounts {
 		known[account] = account != ""
 	}
-	r.known.Store(&known)
+	r.known.CompareAndSwap(nil, &known)
 }
 
 // serves reports whether the registry serves account. The zero Registry serves none.
