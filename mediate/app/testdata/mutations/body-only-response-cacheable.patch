control: Every response of the client surface is uncacheable, and HEAD is refused
removes: a response whose handler writes only its body keeps the caching headers the handler set
packages: ./mediate/app
tests: TestNoStoreOverridesAHandlersCaching
scheduled-count: no


diff --git a/mediate/app/app.go b/mediate/app/app.go
index 8f9657ee..fc830a8f 100644
--- a/mediate/app/app.go
+++ b/mediate/app/app.go
@@ -561,9 +561,7 @@ func (w *noStoreWriter) WriteHeader(status int) {
 }
 
 func (w *noStoreWriter) Write(b []byte) (int, error) {
-	if !w.wroteHeader {
-		w.WriteHeader(http.StatusOK)
-	}
+	w.wroteHeader = true
 	return w.ResponseWriter.Write(b)
 }
 
