control: The client surface is served over TLS unless an ingress in front is declared to terminate it, with the key pair read from its mounted files
removes: the key pair is read once, when the configuration is built, so a rotated pair never serves
packages: ./mediate/app
tests: TestTheSurfaceIsServedOverTLSOnly
scheduled-count: no


diff --git a/mediate/app/app.go b/mediate/app/app.go
index 8f9657ee..d4a2db59 100644
--- a/mediate/app/app.go
+++ b/mediate/app/app.go
@@ -605,10 +605,10 @@ func tlsConfig(certFile, keyFile string, atIngress bool) *tls.Config {
 	if atIngress {
 		return nil
 	}
+	pair, err := tls.LoadX509KeyPair(certFile, keyFile)
 	return &tls.Config{
 		MinVersion: tls.VersionTLS12,
 		GetCertificate: func(*tls.ClientHelloInfo) (*tls.Certificate, error) {
-			pair, err := tls.LoadX509KeyPair(certFile, keyFile)
 			if err != nil {
 				return nil, fmt.Errorf("loading the TLS key pair: %w", err)
 			}
