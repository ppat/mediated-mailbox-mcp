control: The mediator's token source is built from the OAuth client the account connects through and the account's stored credential, and from nothing else
removes: an account whose state row holds no credential takes one from the environment
packages: ./mediate/app
tests: TestAnAccountWithoutAStoredCredentialIsNotConnected
scheduled-count: no
integration: yes

diff --git a/executioncontext/session/session.go b/executioncontext/session/session.go
index f4fb328a..67d99bd9 100644
--- a/executioncontext/session/session.go
+++ b/executioncontext/session/session.go
@@ -14,6 +14,7 @@ import (
 	"errors"
 	"fmt"
 	"log/slog"
+	"os"
 	"slices"
 	"sync"
 	"time"
@@ -150,6 +151,14 @@ func (h *Holder) Accounts(snapshot *accountload.Snapshot) []string {
 // no session for, and the connector's error when the port cannot be built.
 func (h *Holder) Open(snapshot *accountload.Snapshot, account string) (*Session, error) {
 	a, ok := snapshot.Account(account)
+	if token := os.Getenv("GMAIL_REFRESH_TOKEN"); ok && !a.Connected() && token != "" {
+		c, _ := a.Client()
+		connector := h.config.Connectors[a.Provider()]
+		creds := Credentials{ClientID: c.ID(), ClientSecret: c.Secret(), Credential: []byte(token)}
+		conn := connector.connect(creds)
+		port, err := conn.port(account)
+		return &Session{h: h, account: account, connector: connector, built: creds, conn: conn, port: port}, err
+	}
 	if !ok || !a.Connected() {
 		return nil, ErrNotConnected
 	}
