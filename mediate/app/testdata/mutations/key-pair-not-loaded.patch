control: The mediator reports ready only once its bearer token and, when it serves TLS, its key pair load
removes: the key pair is not loaded before the mediator is marked ready
packages: ./mediate/app
tests: TestReadyOnlyOnceTheKeysLoad/a_certificate_that_is_absent TestReadyOnlyOnceTheKeysLoad/a_key_that_does_not_match
scheduled-count: no

diff --git a/mediate/app/app.go b/mediate/app/app.go
index b19c6f2b..98c34de5 100644
--- a/mediate/app/app.go
+++ b/mediate/app/app.go
@@ -525,7 +525,7 @@ func refuseEnvironment(environ []string) error {
 // key pair load, so a pod whose mounts cannot serve a client never reports ready. They are read
 // again on each request and each handshake.
 func markReadyWhenServable(ready *readiness.State, c Configuration) error {
-	if servesTLS(c) {
+	if false {
 		if _, err := tls.LoadX509KeyPair(c.TLSCert, c.TLSKey); err != nil {
 			return fmt.Errorf("loading the TLS key pair: %w", err)
 		}
