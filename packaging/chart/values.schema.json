{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mediated-mailbox chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "global": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "registry": {
              "type": "string",
              "minLength": 1,
              "description": "The registry."
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "name"
            ]
          }
        },
        "commonLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "description": "The server's host name. Required."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The database's name. Required."
        },
        "sslmode": {
          "enum": [
            "disable",
            "allow",
            "prefer",
            "require",
            "verify-ca",
            "verify-full"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "host",
        "name"
      ]
    },
    "secrets": {
      "type": "object",
      "properties": {
        "databasePasswords": {
          "type": "object",
          "properties": {
            "mediator": {
              "type": "object",
              "properties": {
                "existingSecret": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The Secret's name. Required."
                },
                "secretKeys": {
                  "type": "object",
                  "properties": {
                    "password": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The key holding the password."
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false,
              "required": [
                "existingSecret"
              ]
            },
            "ui": {
              "type": "object",
              "properties": {
                "existingSecret": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The Secret's name. Required."
                },
                "secretKeys": {
                  "type": "object",
                  "properties": {
                    "password": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The key holding the password."
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false,
              "required": [
                "existingSecret"
              ]
            },
            "worker": {
              "type": "object",
              "properties": {
                "backfill": {
                  "type": "object",
                  "properties": {
                    "existingSecret": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The Secret's name. Required."
                    },
                    "secretKeys": {
                      "type": "object",
                      "properties": {
                        "password": {
                          "type": "string",
                          "minLength": 1,
                          "description": "The key holding the password."
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "existingSecret"
                  ]
                },
                "sync": {
                  "type": "object",
                  "properties": {
                    "existingSecret": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The Secret's name. Required."
                    },
                    "secretKeys": {
                      "type": "object",
                      "properties": {
                        "password": {
                          "type": "string",
                          "minLength": 1,
                          "description": "The key holding the password."
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "existingSecret"
                  ]
                }
              },
              "additionalProperties": false,
              "required": [
                "backfill",
                "sync"
              ],
              "description": "One entry per job kind the worker runs, matching worker.jobKinds."
            },
            "migration": {
              "type": "object",
              "properties": {
                "existingSecret": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The Secret's name. Required."
                },
                "secretKeys": {
                  "type": "object",
                  "properties": {
                    "passwordFile": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The key holding the password in the libpq password file format."
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false,
              "required": [
                "existingSecret"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "mediator",
            "ui",
            "worker",
            "migration"
          ]
        },
        "databaseCaCertificate": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKeys": {
              "type": "object",
              "properties": {
                "certificate": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The key holding the CA certificate."
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "credentialSealingKeyPair": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string",
              "minLength": 1,
              "description": "The Secret's name. Required."
            },
            "secretKeys": {
              "type": "object",
              "properties": {
                "publicKey": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The key holding the public key."
                },
                "privateKeys": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "required": [
            "existingSecret"
          ]
        },
        "mediatorBearerToken": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKeys": {
              "type": "object",
              "properties": {
                "bearerToken": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The key holding the bearer token."
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "uiRequestTokenKey": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKeys": {
              "type": "object",
              "properties": {
                "requestTokenKey": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The key holding the request token key."
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "mediatorTls": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKeys": {
              "type": "object",
              "properties": {
                "certificate": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The key holding the certificate chain."
                },
                "privateKey": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The key holding the private key."
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "uiTls": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKeys": {
              "type": "object",
              "properties": {
                "certificate": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The key holding the certificate chain."
                },
                "privateKey": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The key holding the private key."
