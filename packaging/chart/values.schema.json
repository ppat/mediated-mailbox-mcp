    "worker": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "description": "The repository."
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            }
          },
          "additionalProperties": false,
          "required": [
            "repository"
          ]
        },
        "jobKinds": {
          "type": "object",
          "properties": {
            "backfill": {
              "type": "object",
              "properties": {
                "database": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "string"
                    },
                    "poolSize": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    }
                  },
                  "additionalProperties": false,
                  "description": "The connection's role. Its password is under secrets.databasePasswords."
                },
                "config": {
                  "type": "object",
                  "properties": {
                    "concurrency": {
                      "type": "integer"
                    }
                  },
                  "additionalProperties": false,
                  "description": "Backfill's own section."
                }
              },
              "additionalProperties": false
            },
            "sync": {
              "type": "object",
              "properties": {
                "database": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "string"
                    },
                    "poolSize": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    }
                  },
                  "additionalProperties": false,
                  "description": "The connection's role. Its password is under secrets.databasePasswords."
                },
                "config": {
                  "type": "object",
                  "properties": {
                    "first_window": {
                      "type": "string",
                      "description": "A Go duration, such as 30s, 5m or 168h."
                    },
                    "decisions_per_tick": {
                      "type": "integer"
                    },
                    "concurrency": {
                      "type": "integer"
                    }
                  },
                  "additionalProperties": false,
                  "description": "Delta sync's own section. The sync interval is sharedConfig.sync_interval."
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "required": [
            "backfill",
            "sync"
          ],
          "description": "The worker's job kinds, keyed by name. Each is a section of the worker's configuration, so only job kinds the worker runs are accepted."
        },
        "config": {
          "type": "object",
          "properties": {
            "reload_interval": {
              "type": "string",
