    "sharedConfig": {
      "type": "object",
      "properties": {
        "log_level": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "sync_interval": {
          "type": "string",
          "description": "A Go duration, such as 30s, 5m or 168h."
        },
        "scanner": {
          "type": "object",
          "properties": {
            "triggers": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "propertyNames": {
                "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
                "not": {
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              },
              "description": "Trigger words by language. A key Helm's YAML parser turned from an unquoted no, n, off, yes, y or on into false or true is refused; quote such a key."
            },
            "link_words": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "link_params": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "window": {
              "type": "integer"
            },
            "dense_length": {
              "type": "integer"
            },
            "dense_entropy": {
              "type": "number"
            },
            "weights": {
              "type": "object",
              "properties": {
                "entropy": {
                  "type": "number"
                },
                "mix": {
                  "type": "number"
                },
                "length": {
                  "type": "number"
                },
                "proximity": {
                  "type": "number"
                },
                "position": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            "threshold": {
              "type": "number"
            },
            "subject_threshold": {
              "type": "number"
            }
          },
          "additionalProperties": false,
          "description": "The scanner section (ADR-0005), rendered identically into the mediator and the worker."
        }
      },
      "additionalProperties": false
    },
    "mediator": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "description": "The repository."
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            }
          },
          "additionalProperties": false,
          "required": [
            "repository"
          ]
        },
        "database": {
          "type": "object",
          "properties": {
            "user": {
              "type": "string"
            },
            "poolSize": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "description": "The connection's role and pool size. Its password is under secrets.databasePasswords."
        },
        "config": {
          "type": "object",
          "properties": {
            "account_reload_interval": {
              "type": "string",
              "description": "A Go duration, such as 30s, 5m or 168h."
            },
            "provider_timeout": {
              "type": "string",
              "description": "A Go duration, such as 30s, 5m or 168h."
            },
            "log_level": {
              "type": "string",
              "enum": [
                "debug",
                "info",
                "warn",
                "error"
              ]
            }
          },
          "additionalProperties": false,
          "description": "The mediator's own configuration keys. Keys the chart renders itself are refused here."
        },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "pathType": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "pathType"
                      ]
                    }
                  }
                },
                "additionalProperties": false,
                "required": [
                  "host",
                  "paths"
                ]
              }
            },
            "tls": {
              "type": "array"
            }
          },
          "additionalProperties": false
        },
        "httpRoute": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "annotations": {
              "type": "object"
            },
            "parentRefs": {
              "type": "array"
            },
            "hostnames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "matches": {
                    "type": "array"
                  },
                  "filters": {
                    "type": "array"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "priorityClassName": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        },
        "goSoftMemoryLimit": {
          "type": "string",
          "pattern": "^([0-9]+(B|KiB|MiB|GiB|TiB)?)?$",
          "description": "GOMEMLIMIT in Go's form, such as 460MiB, or empty for none. Kubernetes' Mi and Gi are not Go's."
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
