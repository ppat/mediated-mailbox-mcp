removes: every pod is given its service account token
packages: ./packaging/chart
tests: TestEveryPodRunsHardened
scheduled-count: no

diff --git a/packaging/chart/templates/_helpers.tpl b/packaging/chart/templates/_helpers.tpl
--- a/packaging/chart/templates/_helpers.tpl
+++ b/packaging/chart/templates/_helpers.tpl
@@ -39,7 +39,7 @@ Service links are off, because Kubernetes' injected variables would carry the co
 deployable refuses a variable under the prefix it does not read.
 */ -}}
 {{- define "mediated-mailbox.podSpec" -}}
-automountServiceAccountToken: false
+automountServiceAccountToken: true
 enableServiceLinks: false
 securityContext:
   runAsNonRoot: true
