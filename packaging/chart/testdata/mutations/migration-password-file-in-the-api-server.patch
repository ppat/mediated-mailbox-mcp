control: Every pod reads only the secrets its process uses
removes: the API server's pod also mounts the migration role's password file
packages: ./packaging/chart
tests: TestEveryPodReadsOnlyTheSecretsItsProcessUses
scheduled-count: no

diff --git a/packaging/chart/templates/api/deployment.yaml b/packaging/chart/templates/api/deployment.yaml
index 35237179..73cafe9c 100644
--- a/packaging/chart/templates/api/deployment.yaml
+++ b/packaging/chart/templates/api/deployment.yaml
@@ -95,10 +95,15 @@ spec:
           - secret:
               name: {{ required "secrets.databasePasswords.api.existingSecret is required" .Values.secrets.databasePasswords.api.existingSecret }}
               items:
               - key: {{ .Values.secrets.databasePasswords.api.secretKeys.password }}
                 path: database/password
+          - secret:
+              name: {{ .Values.secrets.databasePasswords.migration.existingSecret }}
+              items:
+              - key: {{ .Values.secrets.databasePasswords.migration.secretKeys.password }}
+                path: database/migration/password
           {{- include "mm.credentialSealingKeyPairSource" . | nindent 10 }}
           - secret:
               name: {{ include "mm.apiBearerTokenSecretName" . }}
               items:
               - key: {{ .Values.secrets.apiBearerToken.secretKeys.bearerToken }}
