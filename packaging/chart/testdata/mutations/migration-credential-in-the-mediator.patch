control: The migration role's credential reaches only the migration step
removes: the mediator's token volume mounts the migration role's credential
packages: ./packaging/chart
tests: TestTheMigrationCredentialReachesOnlyTheMigrationStep
scheduled-count: no

diff --git a/packaging/chart/templates/mediate.yaml b/packaging/chart/templates/mediate.yaml
--- a/packaging/chart/templates/mediate.yaml
+++ b/packaging/chart/templates/mediate.yaml
@@ -63,7 +63,7 @@ spec:
       {{- include "mediated-mailbox.keysVolume" $ctx | nindent 6 }}
       - name: token
         secret:
-          secretName: {{ required "mediate.tokenSecret.name is required" $v.tokenSecret.name }}
+          secretName: {{ .Values.migrate.passwordFileSecret.name }}
           defaultMode: 0440
           items:
           - key: {{ $v.tokenSecret.key }}
