control: Delta sync runs as one process at a time
removes: delta sync takes the mediator's replica count, so a scaled mediator runs several delta sync processes
packages: ./packaging/chart
tests: TestDeltaSyncRunsAsOneProcessAtATime
scheduled-count: no

diff --git a/packaging/chart/templates/sync.yaml b/packaging/chart/templates/sync.yaml
--- a/packaging/chart/templates/sync.yaml
+++ b/packaging/chart/templates/sync.yaml
@@ -17,7 +17,7 @@ metadata:
   labels:
     {{- include "mediated-mailbox.labels" $ctx | nindent 4 }}
 spec:
-  replicas: 1
+  replicas: {{ .Values.mediate.replicaCount }}
   strategy:
     type: Recreate
   selector:
