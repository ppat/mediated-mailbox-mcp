control: Delta sync runs as one process at a time
removes: delta sync's pods are managed in parallel, so a replacement need not wait for the pod before it
packages: ./packaging/chart
tests: TestDeltaSyncRunsAsOneProcessAtATime
scheduled-count: no

diff --git a/packaging/chart/templates/sync.yaml b/packaging/chart/templates/sync.yaml
--- a/packaging/chart/templates/sync.yaml
+++ b/packaging/chart/templates/sync.yaml
@@ -29,7 +29,7 @@ metadata:
 spec:
   replicas: 1
   serviceName: {{ include "mediated-mailbox.name" $ctx }}
-  podManagementPolicy: OrderedReady
+  podManagementPolicy: Parallel
   updateStrategy:
     type: RollingUpdate
   selector:
