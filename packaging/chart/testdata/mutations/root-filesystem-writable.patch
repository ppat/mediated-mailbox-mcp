control: Every pod the chart runs is hardened
removes: the default container security context leaves the root filesystem writable
packages: ./packaging/chart
tests: TestEveryPodRunsHardened
scheduled-count: no

diff --git a/packaging/chart/values.yaml b/packaging/chart/values.yaml
--- a/packaging/chart/values.yaml
+++ b/packaging/chart/values.yaml
@@ -68,7 +68,7 @@ podSecurityContext:
 securityContext:
   allowPrivilegeEscalation: false
   privileged: false
-  readOnlyRootFilesystem: true
+  readOnlyRootFilesystem: false
   capabilities:
     drop:
     - ALL
