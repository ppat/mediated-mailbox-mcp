control: Every pod reads only the secrets its process uses
removes: the worker mounts each role's whole Secret rather than the one key it reads
packages: ./packaging/chart
tests: TestEveryPodReadsOnlyTheSecretsItsProcessUses
scheduled-count: no

diff --git a/packaging/chart/templates/worker/deployment.yaml b/packaging/chart/templates/worker/deployment.yaml
index 4e9c15f5..b354d987 100644
--- a/packaging/chart/templates/worker/deployment.yaml
+++ b/packaging/chart/templates/worker/deployment.yaml
@@ -84,13 +84,10 @@ spec:
           sources:
           {{- range $kind, $jk := $v.jobKinds }}
           {{- $password := index $.Values.secrets.databasePasswords.worker $kind | default dict }}
           - secret:
               name: {{ required (printf "secrets.databasePasswords.worker.%s.existingSecret is required" $kind) $password.existingSecret }}
-              items:
-              - key: {{ $password.secretKeys.password }}
-                path: database/{{ $kind }}/password
           {{- end }}
           {{- include "mm.credentialSealingKeyPairSource" . | nindent 10 }}
           {{- include "mm.databaseCaCertificateSource" . | nindent 10 }}
       {{- with $v.nodeSelector }}
       nodeSelector:
