control: The bearer token and the request token key come from the user's Secrets, or from one the chart creates and keeps
removes: the access credentials Secret carries no keep policy, so uninstalling the release deletes the bearer token
packages: ./packaging/chart
tests: TestTheBearerTokenAndRequestTokenKeyComeFromTheUsersSecretsOrTheChartsOwn
scheduled-count: no

diff --git a/packaging/chart/templates/secret.yaml b/packaging/chart/templates/secret.yaml
index 9ff2a255..35fbb233 100644
--- a/packaging/chart/templates/secret.yaml
+++ b/packaging/chart/templates/secret.yaml
@@ -14,12 +14,10 @@ kind: Secret
 metadata:
   name: {{ $name }}
   namespace: {{ .Release.Namespace }}
   labels:
     {{- include "mm.sharedLabels" . | nindent 4 }}
-  annotations:
-    helm.sh/resource-policy: keep
 type: Opaque
 data:
   {{- if not $bearer.existingSecret }}
   {{ $bearer.secretKeys.bearerToken }}: {{ index $existing $bearer.secretKeys.bearerToken | default (randAlphaNum 48 | b64enc) }}
   {{- end }}
