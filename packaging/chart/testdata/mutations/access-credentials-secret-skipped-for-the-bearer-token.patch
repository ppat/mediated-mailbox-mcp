control: The bearer token and the request token key come from the user's Secrets, or from one the chart creates and keeps
removes: the chart renders its access credentials Secret only when no Secret is named for the request token key, so naming only that leaves the mediator's bearer token with no Secret
packages: ./packaging/chart
tests: TestTheBearerTokenAndRequestTokenKeyComeFromTheUsersSecretsOrTheChartsOwn
scheduled-count: no

diff --git a/packaging/chart/templates/secret.yaml b/packaging/chart/templates/secret.yaml
index 9ff2a255..93948e2e 100644
--- a/packaging/chart/templates/secret.yaml
+++ b/packaging/chart/templates/secret.yaml
@@ -4,11 +4,11 @@ named for (ADR-0052). Both must stay the same across upgrades, so an existing va
 generated again, and the Secret is kept when the release is uninstalled, so a later install reuses it. A renderer that
 cannot read the cluster sees no existing Secret.
 */ -}}
 {{- $bearer := .Values.secrets.mediatorBearerToken }}
 {{- $requestTokenKey := .Values.secrets.uiRequestTokenKey }}
-{{- if or (not $bearer.existingSecret) (not $requestTokenKey.existingSecret) }}
+{{- if not $requestTokenKey.existingSecret }}
 {{- $name := include "mm.accessCredentialsSecretName" . }}
 {{- $existing := (lookup "v1" "Secret" .Release.Namespace $name).data | default dict }}
 apiVersion: v1
 kind: Secret
 metadata:
