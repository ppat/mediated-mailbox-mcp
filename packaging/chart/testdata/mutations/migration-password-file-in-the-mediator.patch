control: Every pod reads only the secrets its process uses
removes: the mediator's pod also mounts the migration role's password file
packages: ./packaging/chart
tests: TestEveryPodReadsOnlyTheSecretsItsProcessUses
scheduled-count: no

diff --git a/packaging/chart/templates/mediator/deployment.yaml b/packaging/chart/templates/mediator/deployment.yaml
index f95e2200..94f16498 100644
--- a/packaging/chart/templates/mediator/deployment.yaml
+++ b/packaging/chart/templates/mediator/deployment.yaml
@@ -89,10 +89,15 @@ spec:
           - secret:
               name: {{ required "secrets.databasePasswords.mediator.existingSecret is required" .Values.secrets.databasePasswords.mediator.existingSecret }}
               items:
               - key: {{ .Values.secrets.databasePasswords.mediator.secretKeys.password }}
                 path: database/password
+          - secret:
+              name: {{ .Values.secrets.databasePasswords.migration.existingSecret }}
+              items:
+              - key: {{ .Values.secrets.databasePasswords.migration.secretKeys.passwordFile }}
+                path: database/pgpass
           {{- include "mm.credentialSealingKeyPairSource" . | nindent 10 }}
           - secret:
               name: {{ include "mm.mediatorBearerTokenSecretName" . }}
               items:
               - key: {{ .Values.secrets.mediatorBearerToken.secretKeys.bearerToken }}
