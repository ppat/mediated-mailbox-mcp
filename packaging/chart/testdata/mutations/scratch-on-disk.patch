control: The workloads that hold bodies get memory-backed scratch space
removes: the scratch space is a node-disk emptyDir rather than memory
packages: ./packaging/chart
tests: TestTheWorkloadsThatHoldBodiesGetMemoryScratch
scheduled-count: no

diff --git a/packaging/chart/templates/_helpers.tpl b/packaging/chart/templates/_helpers.tpl
--- a/packaging/chart/templates/_helpers.tpl
+++ b/packaging/chart/templates/_helpers.tpl
@@ -209,7 +209,6 @@ The images' root filesystems are read-only, so this is the one writable path suc
 {{- define "mediated-mailbox.scratchVolume" -}}
 - name: scratch
   emptyDir:
-    medium: Memory
     sizeLimit: {{ (index .root.Values .component).scratchSize | default "64Mi" }}
 {{- end }}
 
