control: Each deployable's configuration file is passed through as written and restarts its pods when it changes
removes: delta sync's file no longer carries the shared scanner section, so it scans under another section than backfill
packages: ./packaging/chart
tests: TestTheConfigurationFileIsPassedThroughAsWritten
scheduled-count: no

diff --git a/packaging/chart/templates/sync.yaml b/packaging/chart/templates/sync.yaml
--- a/packaging/chart/templates/sync.yaml
+++ b/packaging/chart/templates/sync.yaml
@@ -5,7 +5,7 @@ promise when a node stops answering (ADR-0117). It calls a provider, so it mount
 scans bodies, so it gets memory-backed scratch space (ADR-0009). It serves only the health probe and the metrics
 endpoint.
 */ -}}
-{{- $ctx := dict "root" . "component" "sync" "scanner" true -}}
+{{- $ctx := dict "root" . "component" "sync" "scanner" false -}}
 {{- $v := .Values.sync -}}
 {{- if include "mediated-mailbox.hasConfig" $ctx }}
 ---
