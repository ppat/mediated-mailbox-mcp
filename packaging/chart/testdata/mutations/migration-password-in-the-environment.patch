control: The migration step is a hook that reads nothing the chart renders and carries no password
removes: the migration Job takes the role's password from the Secret into its environment as PGPASSWORD
packages: ./packaging/chart
tests: TestTheMigrationStepIsAHookThatReadsNothingTheChartRenders TestEveryPodReadsOnlyTheSecretsItsProcessUses
scheduled-count: no

diff --git a/packaging/chart/templates/migration/job.yaml b/packaging/chart/templates/migration/job.yaml
index 982bfc6a..2b8af413 100644
--- a/packaging/chart/templates/migration/job.yaml
+++ b/packaging/chart/templates/migration/job.yaml
@@ -49,10 +49,15 @@ spec:
       containers:
       - name: migration
         image: {{ include "mm.image" (list $ $v.image) }}
         imagePullPolicy: {{ .Values.global.image.pullPolicy }}
         env:
+        - name: PGPASSWORD
+          valueFrom:
+            secretKeyRef:
+              name: {{ .Values.secrets.databasePasswords.migration.existingSecret }}
+              key: {{ .Values.secrets.databasePasswords.migration.secretKeys.password }}
         - name: MEDIATED_MAILBOX_LOG_LEVEL
           value: {{ $c.log_level | quote }}
         {{- range $key, $value := $c.database }}
         - name: {{ printf "MEDIATED_MAILBOX_DATABASE__%s" (upper $key) }}
           value: {{ $value | toString | quote }}
