control: The migration step is a hook that reads nothing the chart renders and carries no password
removes: the connection string names no password file, and the password comes from the Secret as PGPASSWORD
packages: ./packaging/chart
tests: TestTheMigrationStepIsAHookThatReadsNothingTheChartRenders TestEveryPodReadsOnlyTheSecretsItsProcessUses
scheduled-count: no

diff --git a/packaging/chart/templates/migration/job.yaml b/packaging/chart/templates/migration/job.yaml
index 12b9922a..39bde618 100644
--- a/packaging/chart/templates/migration/job.yaml
+++ b/packaging/chart/templates/migration/job.yaml
@@ -4,11 +4,11 @@ deployable rolls onto a schema the chain did not reach. It reads only user-suppl
 object of this release exists yet at pre-install. goose reads the connection string from GOOSE_DBSTRING, which names
 the migration role and a password file mounted from the user's Secret and carries no password itself (ADR-0079).
 */ -}}
 {{- $v := .Values.migration }}
 {{- $d := .Values.database }}
-{{- $query := list (printf "sslmode=%s" (urlquery $d.sslmode)) (printf "passfile=%s/database/pgpass" (include "mm.secretsDir" .)) }}
+{{- $query := list (printf "sslmode=%s" (urlquery $d.sslmode)) }}
 {{- if .Values.secrets.databaseCaCertificate.existingSecret }}
 {{- $query = append $query (printf "sslrootcert=%s/ca/ca.crt" (include "mm.secretsDir" .)) }}
 {{- end }}
 apiVersion: batch/v1
 kind: Job
@@ -51,10 +51,15 @@ spec:
       containers:
       - name: migration
         image: {{ include "mm.image" (list $ $v.image) }}
         imagePullPolicy: {{ .Values.global.image.pullPolicy }}
         env:
+        - name: PGPASSWORD
+          valueFrom:
+            secretKeyRef:
+              name: {{ .Values.secrets.databasePasswords.migration.existingSecret }}
+              key: password
         - name: GOOSE_DBSTRING
           value: {{ printf "postgres://%s@%s:%v/%s?%s" (urlquery $v.database.user) (required "database.host is required" $d.host) $d.port (urlquery (required "database.name is required" $d.name)) (join "&" $query) | quote }}
         securityContext:
           {{- include "mm.securityContext" (list $ $v) | nindent 10 }}
         {{- with $v.resources }}
