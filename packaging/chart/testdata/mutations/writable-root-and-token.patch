control: Every pod the chart renders runs hardened
removes: every container's root filesystem is writable and the mediator mounts its ServiceAccount token
packages: ./packaging/chart
tests: TestEveryPodRunsHardened
scheduled-count: no

diff --git a/packaging/chart/templates/mediator/deployment.yaml b/packaging/chart/templates/mediator/deployment.yaml
index f95e2200..036c992a 100644
--- a/packaging/chart/templates/mediator/deployment.yaml
+++ b/packaging/chart/templates/mediator/deployment.yaml
@@ -32,11 +32,11 @@ spec:
       {{- with .Values.global.imagePullSecrets }}
       imagePullSecrets:
         {{- toYaml . | nindent 8 }}
       {{- end }}
       serviceAccountName: {{ include "mm.serviceAccountName" (list $ "mediator" $v.serviceAccount) }}
-      automountServiceAccountToken: false
+      automountServiceAccountToken: true
       enableServiceLinks: false
       {{- with $v.priorityClassName }}
       priorityClassName: {{ . }}
       {{- end }}
       securityContext:
diff --git a/packaging/chart/values.yaml b/packaging/chart/values.yaml
index deff4b80..4ec97d44 100644
--- a/packaging/chart/values.yaml
+++ b/packaging/chart/values.yaml
@@ -34,11 +34,11 @@ global:
       type: RuntimeDefault
   # -- The container security context of every container. A component's securityContext overrides single keys of it.
   # The root filesystem is read-only and no process is given a writable volume, since none writes a file.
   securityContext:
     allowPrivilegeEscalation: false
-    readOnlyRootFilesystem: true
+    readOnlyRootFilesystem: false
     capabilities:
       drop:
       - ALL
 
 # The PostgreSQL server every process and the migration step connect to, which the user supplies (ADR-0052). Each
