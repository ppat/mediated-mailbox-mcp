control: Every pod the chart renders runs hardened
removes: every container's root filesystem is writable and the API server mounts its ServiceAccount token
packages: ./packaging/chart
tests: TestEveryPodRunsHardened
scheduled-count: no

diff --git a/packaging/chart/templates/api/deployment.yaml b/packaging/chart/templates/api/deployment.yaml
index b678c658..54525f48 100644
--- a/packaging/chart/templates/api/deployment.yaml
+++ b/packaging/chart/templates/api/deployment.yaml
@@ -35,7 +35,7 @@ spec:
         {{- toYaml . | nindent 8 }}
       {{- end }}
       serviceAccountName: {{ include "mm.serviceAccountName" (list $ "api" $v.serviceAccount) }}
-      automountServiceAccountToken: false
+      automountServiceAccountToken: true
       enableServiceLinks: false
       {{- with $v.priorityClassName }}
       priorityClassName: {{ . }}
diff --git a/packaging/chart/values.yaml b/packaging/chart/values.yaml
index 8207f1b8..1b52b446 100644
--- a/packaging/chart/values.yaml
+++ b/packaging/chart/values.yaml
@@ -36,7 +36,7 @@ global:
   # The root filesystem is read-only and no process is given a writable volume, since none writes a file.
   securityContext:
     allowPrivilegeEscalation: false
-    readOnlyRootFilesystem: true
+    readOnlyRootFilesystem: false
     capabilities:
       drop:
       - ALL
