control: The bearer token and the request token key come from the user's Secrets, or from one the chart creates and keeps
removes: the pods read the bearer token and the request token key under the default key names whatever key names the user gives
packages: ./packaging/chart
tests: TestTheBearerTokenAndRequestTokenKeyComeFromTheUsersSecretsOrTheChartsOwn
scheduled-count: no

diff --git a/packaging/chart/templates/api/deployment.yaml b/packaging/chart/templates/api/deployment.yaml
index f95e2200..f02d47f6 100644
--- a/packaging/chart/templates/api/deployment.yaml
+++ b/packaging/chart/templates/api/deployment.yaml
@@ -93,11 +93,11 @@ spec:
                 path: database/password
           {{- include "mm.credentialSealingKeyPairSource" . | nindent 10 }}
           - secret:
               name: {{ include "mm.apiBearerTokenSecretName" . }}
               items:
-              - key: {{ .Values.secrets.apiBearerToken.secretKeys.bearerToken }}
+              - key: api-bearer-token
                 path: bearer-token
           {{- include "mm.databaseCaCertificateSource" . | nindent 10 }}
           {{- with .Values.secrets.apiTls.existingSecret }}
           - secret:
               name: {{ . }}
diff --git a/packaging/chart/templates/ui/deployment.yaml b/packaging/chart/templates/ui/deployment.yaml
index 5263e986..5e06e948 100644
--- a/packaging/chart/templates/ui/deployment.yaml
+++ b/packaging/chart/templates/ui/deployment.yaml
@@ -93,11 +93,11 @@ spec:
                 path: database/password
           {{- include "mm.credentialSealingKeyPairSource" . | nindent 10 }}
           - secret:
               name: {{ include "mm.uiRequestTokenKeySecretName" . }}
               items:
-              - key: {{ .Values.secrets.uiRequestTokenKey.secretKeys.requestTokenKey }}
+              - key: ui-request-token-key
                 path: request-token-key
           {{- include "mm.databaseCaCertificateSource" . | nindent 10 }}
           {{- with .Values.secrets.uiTls.existingSecret }}
           - secret:
               name: {{ . }}
