control: The key pair reaches only the deployables that open a credential and the UI
removes: the migration step mounts the key pair too
packages: ./packaging/chart
tests: TestThePrivateKeyReachesOnlyTheDeployablesThatOpenCredentials
scheduled-count: no

diff --git a/packaging/chart/templates/migrate.yaml b/packaging/chart/templates/migrate.yaml
--- a/packaging/chart/templates/migrate.yaml
+++ b/packaging/chart/templates/migrate.yaml
@@ -40,6 +40,7 @@ spec:
         - name: GOOSE_DBSTRING
           value: {{ printf "host=%s port=%v dbname=%s user=mediated_mailbox_migrate sslmode=%s passfile=/var/run/mediated-mailbox/database/pgpass%s" (required "database.host is required" $db.host) $db.port (required "database.name is required" $db.name) ($db.sslmode | default "verify-full") (ternary " sslrootcert=/var/run/mediated-mailbox/database-ca/ca.crt" "" (not (empty $db.caSecret))) | quote }}
         volumeMounts:
+        {{- include "mediated-mailbox.keysMount" $ctx | nindent 8 }}
         - name: database
           mountPath: /var/run/mediated-mailbox/database
           readOnly: true
@@ -49,6 +50,7 @@ spec:
           readOnly: true
         {{- end }}
       volumes:
+      {{- include "mediated-mailbox.keysVolume" $ctx | nindent 6 }}
       - name: database
         secret:
           secretName: {{ required "migrate.passwordFileSecret.name is required" $m.passwordFileSecret.name }}
