control: The migration role's credential reaches only the migration step
removes: the migration step mounts the mediator's password in place of its own credential
packages: ./packaging/chart
tests: TestTheMigrationCredentialReachesOnlyTheMigrationStep
scheduled-count: no

diff --git a/packaging/chart/templates/migrate.yaml b/packaging/chart/templates/migrate.yaml
--- a/packaging/chart/templates/migrate.yaml
+++ b/packaging/chart/templates/migrate.yaml
@@ -53,7 +53,7 @@ spec:
       volumes:
       - name: database
         secret:
-          secretName: {{ required "migrate.passwordFileSecret.name is required" $m.passwordFileSecret.name }}
+          secretName: {{ .Values.mediate.passwordSecret.name }}
           defaultMode: 0440
           items:
           - key: {{ $m.passwordFileSecret.key }}
