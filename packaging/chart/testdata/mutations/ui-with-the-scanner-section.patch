control: Each deployable reads only its own file, rendered from the structured values, and restarts when it changes
removes: the UI's file is given the scanner section, a key it does not declare and refuses at start
packages: ./packaging/chart
tests: TestEachDeployableReadsOnlyItsOwnRenderedFile
scheduled-count: no

diff --git a/packaging/chart/templates/_helpers.tpl b/packaging/chart/templates/_helpers.tpl
--- a/packaging/chart/templates/_helpers.tpl
+++ b/packaging/chart/templates/_helpers.tpl
@@ -213,6 +213,7 @@ only keys its deployable declares, since every deployable refuses a key it does
 {{- end }}
 {{- end }}
 {{- if eq .component "ui" }}
+{{- with $root.Values.scanner }}{{ $_ := set $file "scanner" . }}{{ end -}}
 {{- $_ := set $file "seal_public_key_file" $keys.public -}}
 {{- $_ := set $file "private_key_files" $keys.private -}}
 {{- $_ := set $file "tls_cert" "/var/run/mediated-mailbox/tls/tls.crt" -}}
