control: Each deployable's configuration file is passed through as written and restarts its pods when it changes
removes: the UI's file is given the scanner section, a section it does not declare and refuses at start
packages: ./packaging/chart
tests: TestTheConfigurationFileIsPassedThroughAsWritten
scheduled-count: no

diff --git a/packaging/chart/templates/ui.yaml b/packaging/chart/templates/ui.yaml
--- a/packaging/chart/templates/ui.yaml
+++ b/packaging/chart/templates/ui.yaml
@@ -5,7 +5,7 @@ client-secret part opens with the private keys, so it mounts the key pair (ADR-0
 plain HTTP is refused outside the dev loop's build (docs/UI.md section 18), and its probes and metrics endpoint
 listen apart in plain HTTP. It handles no body, so it gets no scratch space.
 */ -}}
-{{- $ctx := dict "root" . "component" "ui" "scanner" false -}}
+{{- $ctx := dict "root" . "component" "ui" "scanner" true -}}
 {{- $v := .Values.ui -}}
 {{- if include "mediated-mailbox.hasConfig" $ctx }}
 ---
