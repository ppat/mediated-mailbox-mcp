control: The bearer token and the request token key come from the user's Secrets, or from one the chart creates and keeps
removes: the chart renders its access credentials Secret for both values and the pods read it even when the user names a Secret for each
packages: ./packaging/chart
tests: TestTheBearerTokenAndRequestTokenKeyComeFromTheUsersSecretsOrTheChartsOwn
scheduled-count: no

diff --git a/packaging/chart/templates/_helpers.tpl b/packaging/chart/templates/_helpers.tpl
index 8b52c404..2831fbfd 100644
--- a/packaging/chart/templates/_helpers.tpl
+++ b/packaging/chart/templates/_helpers.tpl
@@ -112,16 +112,16 @@ probes and the Services read the same number.
 {{- printf "%s-access-credentials" (include "mm.fullname" .) }}
 {{- end }}
 
 {{/* The Secret holding the API server's bearer token, the user's or the chart's own. */}}
 {{- define "mm.apiBearerTokenSecretName" -}}
-{{- default (include "mm.accessCredentialsSecretName" .) .Values.secrets.apiBearerToken.existingSecret }}
+{{- include "mm.accessCredentialsSecretName" . }}
 {{- end }}
 
 {{/* The Secret holding the UI's request token key, the user's or the chart's own. */}}
 {{- define "mm.uiRequestTokenKeySecretName" -}}
-{{- default (include "mm.accessCredentialsSecretName" .) .Values.secrets.uiRequestTokenKey.existingSecret }}
+{{- include "mm.accessCredentialsSecretName" . }}
 {{- end }}
 
 {{/*
 The projected secret sources more than one pod mounts. Each lists only the keys a process reads, under a fixed path
 the rendered configuration names (ADR-0079).
diff --git a/packaging/chart/templates/secret.yaml b/packaging/chart/templates/secret.yaml
index 9ff2a255..aaa5d97a 100644
--- a/packaging/chart/templates/secret.yaml
+++ b/packaging/chart/templates/secret.yaml
@@ -4,11 +4,11 @@ named for (ADR-0052). Both must stay the same across upgrades, so an existing va
 generated again, and the Secret is kept when the release is uninstalled, so a later install reuses it. A renderer that
 cannot read the cluster sees no existing Secret.
 */ -}}
 {{- $bearer := .Values.secrets.apiBearerToken }}
 {{- $requestTokenKey := .Values.secrets.uiRequestTokenKey }}
-{{- if or (not $bearer.existingSecret) (not $requestTokenKey.existingSecret) }}
+{{- if true }}
 {{- $name := include "mm.accessCredentialsSecretName" . }}
 {{- $existing := (lookup "v1" "Secret" .Release.Namespace $name).data | default dict }}
 apiVersion: v1
 kind: Secret
 metadata:
@@ -18,12 +18,12 @@ metadata:
     {{- include "mm.sharedLabels" . | nindent 4 }}
   annotations:
     helm.sh/resource-policy: keep
 type: Opaque
 data:
-  {{- if not $bearer.existingSecret }}
+  {{- if true }}
   {{ $bearer.secretKeys.bearerToken }}: {{ index $existing $bearer.secretKeys.bearerToken | default (randAlphaNum 48 | b64enc) }}
   {{- end }}
-  {{- if not $requestTokenKey.existingSecret }}
+  {{- if true }}
   {{ $requestTokenKey.secretKeys.requestTokenKey }}: {{ index $existing $requestTokenKey.secretKeys.requestTokenKey | default (randAlphaNum 64 | b64enc) }}
   {{- end }}
 {{- end }}
