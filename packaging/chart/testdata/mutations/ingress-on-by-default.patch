   # so a controller's or cert-manager's annotations go here.
   ingress:
     # -- Whether the Ingress renders.
-    enabled: false
+    enabled: true
     # -- The IngressClass.
     className: ""
     # -- Annotations on the Ingress.
     annotations: {}
     # -- Hosts and their paths, each path {path, pathType}.
