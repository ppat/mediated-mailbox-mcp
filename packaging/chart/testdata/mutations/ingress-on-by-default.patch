control: Nothing optional renders by default
removes: the mediator's Ingress is enabled by default
packages: ./packaging/chart
tests: TestNothingOptionalRendersByDefault
scheduled-count: no

diff --git a/packaging/chart/values.yaml b/packaging/chart/values.yaml
index deff4b80..0f34bcf8 100644
--- a/packaging/chart/values.yaml
+++ b/packaging/chart/values.yaml
@@ -201,11 +201,11 @@ mediator:
     annotations: {}
