control: Each Go container gets only its own soft memory limit
removes: the migration step's container never gets the soft memory limit set for it
packages: ./packaging/chart
tests: TestEachGoContainerGetsOnlyItsOwnSoftMemoryLimit
scheduled-count: no

diff --git a/packaging/chart/templates/migration/job.yaml b/packaging/chart/templates/migration/job.yaml
index 982bfc6a..04bf455c 100644
--- a/packaging/chart/templates/migration/job.yaml
+++ b/packaging/chart/templates/migration/job.yaml
@@ -55,14 +55,10 @@ spec:
           value: {{ $c.log_level | quote }}
         {{- range $key, $value := $c.database }}
         - name: {{ printf "MEDIATED_MAILBOX_DATABASE__%s" (upper $key) }}
           value: {{ $value | toString | quote }}
         {{- end }}
-        {{- with $v.goSoftMemoryLimit }}
-        - name: GOMEMLIMIT
-          value: {{ . | quote }}
-        {{- end }}
         securityContext:
           {{- include "mm.securityContext" (list $ $v) | nindent 10 }}
         {{- with $v.resources }}
         resources:
           {{- toYaml . | nindent 10 }}
