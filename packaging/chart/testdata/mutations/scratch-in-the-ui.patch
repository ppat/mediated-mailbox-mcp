control: The workloads that hold bodies get memory-backed scratch space
removes: the UI, which holds no body, is given the scratch space too
packages: ./packaging/chart
tests: TestTheWorkloadsThatHoldBodiesGetMemoryScratch
scheduled-count: no

diff --git a/packaging/chart/templates/ui.yaml b/packaging/chart/templates/ui.yaml
--- a/packaging/chart/templates/ui.yaml
+++ b/packaging/chart/templates/ui.yaml
@@ -83,6 +83,7 @@ spec:
         volumeMounts:
         {{- include "mediated-mailbox.databaseMounts" $ctx | nindent 8 }}
         {{- include "mediated-mailbox.keysMount" $ctx | nindent 8 }}
+        {{- include "mediated-mailbox.scratchMount" $ctx | nindent 8 }}
         - name: tls
           mountPath: /var/run/mediated-mailbox/tls
           readOnly: true
@@ -97,6 +98,7 @@ spec:
       volumes:
       {{- include "mediated-mailbox.databaseVolumes" (merge (dict "password" $v.passwordSecret) $ctx) | nindent 6 }}
       {{- include "mediated-mailbox.keysVolume" $ctx | nindent 6 }}
+      {{- include "mediated-mailbox.scratchVolume" $ctx | nindent 6 }}
       - name: tls
         secret:
           secretName: {{ required "ui.tls.secretName is required" $v.tls.secretName }}
