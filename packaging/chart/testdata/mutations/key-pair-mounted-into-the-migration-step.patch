control: The private key reaches only the processes that open credentials and the UI
removes: the migration step's pod mounts the key pair too
packages: ./packaging/chart
tests: TestEveryPodReadsOnlyTheSecretsItsProcessUses
scheduled-count: no

diff --git a/packaging/chart/templates/migration/job.yaml b/packaging/chart/templates/migration/job.yaml
index 982bfc6a..d5527a7e 100644
--- a/packaging/chart/templates/migration/job.yaml
+++ b/packaging/chart/templates/migration/job.yaml
@@ -79,10 +79,11 @@ spec:
           - secret:
               name: {{ required "secrets.databasePasswords.migration.existingSecret is required" .Values.secrets.databasePasswords.migration.existingSecret }}
               items:
               - key: {{ .Values.secrets.databasePasswords.migration.secretKeys.password }}
                 path: database/password
+          {{- include "mm.credentialSealingKeyPairSource" . | nindent 10 }}
           {{- include "mm.databaseCaCertificateSource" . | nindent 10 }}
       {{- with $v.nodeSelector }}
       nodeSelector:
         {{- toYaml . | nindent 8 }}
       {{- end }}
