control: The key-generation command writes a pair the library seals to and opens with
removes: the mode is left to the process's umask, so a restrictive umask narrows the public key file's mode
packages: ./cli/internal/keygen
tests: TestTheKeyFilesModesHoldUnderAnyUmask
scheduled-count: no

diff --git a/cli/internal/keygen/keygen.go b/cli/internal/keygen/keygen.go
index f2f307aa..49819120 100644
--- a/cli/internal/keygen/keygen.go
+++ b/cli/internal/keygen/keygen.go
@@ -66,10 +66,7 @@ func create(path string, content []byte, mode os.FileMode) error {
 	if err != nil {
 		return fmt.Errorf("creating %s: %w", path, err)
 	}
-	err = f.Chmod(mode)
-	if err == nil {
-		_, err = f.Write(content)
-	}
+	_, err = f.Write(content)
 	if err == nil {
 		err = f.Sync()
 	}
