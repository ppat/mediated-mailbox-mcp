packages: ./cli
tests: TestTheCommandWritesAPairTheLibrarySealsToAndOpensWith
scheduled-count: no

diff --git a/cli/internal/keygen/keygen.go b/cli/internal/keygen/keygen.go
index f2f307aa..32c67598 100644
--- a/cli/internal/keygen/keygen.go
+++ b/cli/internal/keygen/keygen.go
@@ -48,7 +48,11 @@ func Run(args []string, stdout io.Writer) error {
 	if err != nil {
 		return fmt.Errorf("serializing the private key: %w", err)
 	}
-	public := key.PublicKey().Bytes()
+	other, err := seal.KEM().GenerateKey()
