    "/api/{account}/lens": {
      "get": {
        "operationId": "getLens",
        "parameters": [
          {
            "description": "The account every read is scoped to. all and an unknown account are refused",
            "in": "path",
            "name": "account",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The registry's dataset",
            "in": "query",
            "name": "dataset",
            "required": true,
            "schema": {
              "enum": [
                "plans",
                "candidates"
              ],
              "type": "string"
            }
          },
          {
            "description": "0 to 3",
            "in": "query",
            "name": "level",
            "schema": {
              "maximum": 3,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "One groupable dimension, at levels 1 and 2",
            "in": "query",
            "name": "group",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "A preset or two UTC dates from,to",
            "in": "query",
            "name": "range",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "column,asc or column,desc",
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The 1-based page of 50 rows",
            "in": "query",
            "name": "page",
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "A dimension filter, value, a,b or !value",
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/LensFigures"
                    },
                    {
                      "$ref": "#/components/schemas/PlansPage"
                    },
                    {
                      "$ref": "#/components/schemas/CandidatesPage"
                    }
                  ]
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not Found"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "One dataset at one level of the zoom ladder, for one account",
        "x-datasets": [
          {
            "name": "plans",
            "ranged": true,
            "range_column": "created_at",
            "dimensions": [
              {
                "name": "status",
                "storage": "text",
                "groupable": false,
                "filterable": true,
                "sortable": false,
                "wording": "status",
                "values": [
                  "DRAFT",
                  "APPROVED",
                  "APPLYING",
                  "APPLIED",
                  "ROLLED_BACK",
                  "REJECTED",
                  "APPLY_REFUSED"
                ]
              },
              {
                "name": "created_at",
                "storage": "time",
                "groupable": false,
                "filterable": false,
                "sortable": true,
                "wording": "created"
              }
            ],
            "default": {
              "level": 3,
              "range": "all",
              "sort": "created_at,desc"
            }
          },
          {
            "name": "candidates",
            "ranged": true,
            "range_column": "created_at",
            "dimensions": [
              {
                "name": "status",
                "storage": "text",
                "groupable": false,
                "filterable": true,
                "sortable": false,
                "wording": "status",
                "values": [
                  "pending",
                  "confirmed",
                  "dismissed"
                ]
              },
              {
                "name": "score",
                "storage": "number",
                "groupable": false,
                "filterable": false,
                "sortable": true,
                "wording": "score"
              },
              {
                "name": "created_at",
                "storage": "time",
                "groupable": false,
                "filterable": false,
                "sortable": true,
                "wording": "time in queue"
              }
            ],
            "default": {
              "level": 3,
              "range": "all",
              "sort": "score,desc",
              "filters": {
                "status": [
                  "pending"
                ]
              }
            }
          }
        ]
      }
    },
