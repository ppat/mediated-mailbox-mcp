        "additionalProperties": false,
        "properties": {
          "cadence_seconds": {
            "type": "integer"
          },
          "cursor_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "gap_recoveries_7d": {
            "type": "integer"
          },
          "last_gap_recovery": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Run"
              },
              {
                "type": "null"
              }
            ]
          },
          "last_tick": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Run"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "enum": [
              "not_started",
              "running",
              "idle"
            ],
            "type": "string"
          }
        },
        "required": [
          "state",
          "cadence_seconds",
          "cursor_at",
          "last_tick",
          "gap_recoveries_7d",
          "last_gap_recovery"
        ],
        "type": "object"
      },
      "System": {
        "additionalProperties": false,
        "properties": {
          "account": {
            "type": "string"
          },
          "as_of": {
            "format": "date-time",
            "type": "string"
          },
          "corpus": {
            "$ref": "#/components/schemas/Corpus"
          },
          "decisions": {
            "$ref": "#/components/schemas/Decisions"
          },
          "operational": {
            "$ref": "#/components/schemas/Operational"
          },
          "provider": {
            "type": "string"
          }
        },
        "required": [
          "account",
          "provider",
          "as_of",
          "operational",
          "corpus",
          "decisions"
        ],
        "type": "object"
      }
    }
  },
