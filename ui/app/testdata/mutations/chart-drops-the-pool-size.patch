control: The chart renders the UI a file it starts with, holding every UI key the chart admits
removes: the chart leaves the UI's pool size out of its file though the values set one
packages: ./ui/app
tests: TestTheChartRendersAFileTheUIStartsWith
scheduled-count: no

diff --git a/packaging/chart/templates/_config.tpl b/packaging/chart/templates/_config.tpl
index b8bf7d3b..17af2271 100644
--- a/packaging/chart/templates/_config.tpl
+++ b/packaging/chart/templates/_config.tpl
@@ -79,6 +79,7 @@ file, since no ConfigMap of the release exists at pre-install (ADR-0129, ADR-013
 {{- $_ := set $c "log_level" (default .Values.sharedConfig.log_level (index $v.config "log_level")) }}
 {{- $_ := set $c "sync_interval" .Values.sharedConfig.sync_interval }}
 {{- $_ := set $c "database" (include "mm.config.database" (list . (include "mm.applicationUser" .) $v.database) | fromYaml) }}
+{{- $_ := unset (index $c "database") "pool_size" }}
 {{- $_ := set $c "credential" (include "mm.config.credential" . | fromYaml) }}
 {{- $_ := set $c "listen" (printf ":%s" (include "mm.port.http" .)) }}
 {{- $_ := set $c "probe_listen" (printf ":%s" (include "mm.port.metrics" .)) }}
