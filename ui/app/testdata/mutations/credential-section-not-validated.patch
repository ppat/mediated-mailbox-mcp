control: The credential section is validated before any key file is read
removes: the UI's start loads its keys without validating the credential section
packages: ./ui/app
tests: TestAnEmptyListOfPrivateKeysRefusesTheStart
scheduled-count: no

diff --git a/ui/app/app.go b/ui/app/app.go
index e09d0a7c..d5e6a3e7 100644
--- a/ui/app/app.go
+++ b/ui/app/app.go
@@ -135,7 +135,8 @@ func validate(c Configuration) error {
 	if err := ValidateSection(c.Section); err != nil {
 		return err
 	}
-	return credentialcore.Validate(c.Credential)
+	_ = credentialcore.Validate
+	return nil
 }
 
 // Mount is where the UI's handler is served on a process's application server.
