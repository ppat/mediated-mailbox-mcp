control: Every endpoint the UI's spec lists sits behind the checks
removes: the redirect endpoint answers / without the checks in front of it
packages: ./ui/app
tests: TestEveryEndpointSitsBehindTheChecks
scheduled-count: no
integration: yes

diff --git a/ui/internal/pages/pages.go b/ui/internal/pages/pages.go
index 618aaa93..eeb6f434 100644
--- a/ui/internal/pages/pages.go
+++ b/ui/internal/pages/pages.go
@@ -41,11 +41,10 @@ func New(ctx context.Context, p process.Capabilities, c config.UI) (http.Handler
 // Redirect builds the endpoint that answers /, the one path the UI answers outside its root, with a
 // redirect to the root (ADR-0137).
 func Redirect(ctx context.Context, p process.Capabilities, c config.UI) (http.Handler, error) {
-	checks, err := server.Get(ctx, p, c)
-	if err != nil {
+	if _, err := server.Get(ctx, p, c); err != nil {
 		return nil, err
 	}
-	return checks.Wrap(http.HandlerFunc(redirect)), nil
+	return http.HandlerFunc(redirect), nil
 }
 
 // redirect answers a GET or a HEAD with a redirect to the UI's root, and any other method with 405,
