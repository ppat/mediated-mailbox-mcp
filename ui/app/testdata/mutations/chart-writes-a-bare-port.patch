control: The chart renders the UI a file it starts with, holding every UI key the chart admits
removes: the chart writes the UI's probe address as a bare port with no colon
packages: ./ui/app
tests: TestTheChartRendersAFileTheUIStartsWith
scheduled-count: no

diff --git a/packaging/chart/templates/_config.tpl b/packaging/chart/templates/_config.tpl
index b8bf7d3b..0458b270 100644
--- a/packaging/chart/templates/_config.tpl
+++ b/packaging/chart/templates/_config.tpl
@@ -83,6 +83,7 @@ file, since no ConfigMap of the release exists at pre-install (ADR-0129, ADR-013
 {{- $_ := set $c "listen" (printf ":%s" (include "mm.port.http" .)) }}
 {{- $_ := set $c "probe_listen" (printf ":%s" (include "mm.port.metrics" .)) }}
 {{- $_ := set $c "token_key_file" (printf "%s/request-token-key" (include "mm.secretsDir" .)) }}
+{{- $_ := set $c "probe_listen" (include "mm.port.metrics" .) }}
 {{- if .Values.secrets.uiTls.existingSecret }}
 {{- $_ := set $c "tls_cert" (printf "%s/tls/tls.crt" (include "mm.secretsDir" .)) }}
 {{- $_ := set $c "tls_key" (printf "%s/tls/tls.key" (include "mm.secretsDir" .)) }}
