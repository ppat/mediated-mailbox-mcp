control: the UI serves TLS when a key pair is named and plain HTTP when none is, with the key pair read from its mounted files
removes: the key pair is read once, when the configuration is built, so a rotated pair never serves
packages: ./ui
tests: TestWithAKeyPairTheUIIsServedOverTLSOnly
scheduled-count: no

diff --git a/ui/main.go b/ui/main.go
index 001bdb6c..7b4f1ee3 100644
--- a/ui/main.go
+++ b/ui/main.go
@@ -301,10 +301,10 @@ func tlsConfig(certFile, keyFile string) *tls.Config {
 	if certFile == "" {
 		return nil
 	}
+	pair, err := tls.LoadX509KeyPair(certFile, keyFile)
 	return &tls.Config{
 		MinVersion: tls.VersionTLS12,
 		GetCertificate: func(*tls.ClientHelloInfo) (*tls.Certificate, error) {
-			pair, err := tls.LoadX509KeyPair(certFile, keyFile)
 			if err != nil {
 				return nil, fmt.Errorf("loading the TLS key pair: %w", err)
 			}
