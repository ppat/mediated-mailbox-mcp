control: the UI serves TLS when a key pair is named and plain HTTP when none is, with the key pair read from its mounted files
removes: the UI is served over TLS even when no key pair is named
packages: ./ui
tests: TestWithNoKeyPairTheUIIsServedOverPlainHTTP
scheduled-count: no

diff --git a/ui/main.go b/ui/main.go
index 66af940c..a90a73f3 100644
--- a/ui/main.go
+++ b/ui/main.go
@@ -273,7 +273,7 @@ func serve(ctx context.Context, c Configuration, uiListener, probeListener net.L
 	}
 	probes := &http.Server{Handler: server.Probes(), ReadHeaderTimeout: 10 * time.Second}
 	errs := make(chan error, 2)
-	go func() { errs <- serveUI(ui, uiListener, overTLS) }()
