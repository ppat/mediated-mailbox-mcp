control: Every policy write leaves its history row or nothing
removes: a lift is recorded as an edit, so the history no longer says a restriction was lifted
packages: ./ui/internal/api
tests: TestAPolicyWriteLeavesItsHistoryRowOrNothing
scheduled-count: no
integration: yes

diff --git a/ui/internal/policymanagement/rules.go b/ui/internal/policymanagement/rules.go
--- a/ui/internal/policymanagement/rules.go
+++ b/ui/internal/policymanagement/rules.go
@@ -340,7 +340,7 @@ func (s *handlers) liftRule(ctx context.Context, account string, isBase bool, id
 		if n == 0 {
 			return rules.StaleRule()
 		}
-		return w.record(ctx, actionLifted, id, req.SuffixesBefore, nil, actor)
+		return w.record(ctx, actionEdited, id, req.SuffixesBefore, nil, actor)
 	})
 }
 
