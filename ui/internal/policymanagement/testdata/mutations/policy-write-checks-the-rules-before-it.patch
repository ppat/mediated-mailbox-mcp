control: A policy write the snapshot's validation refuses, or whose identifier no path segment can hold, is refused before it is written
removes: a write checks the scope's rules before the one it changes and never the changed rule itself
packages: ./ui/internal/api
tests: TestAWriteTheValidationRefusesIsRefusedBeforeItIsWritten
scheduled-count: no
integration: yes

diff --git a/ui/internal/core/rules/rules.go b/ui/internal/core/rules/rules.go
--- a/ui/internal/core/rules/rules.go
+++ b/ui/internal/core/rules/rules.go
@@ -146,7 +146,7 @@ func held(stored []Rule, id string, before []string) (int, *refusal.Refusal) {
 // with the rule at index i, the one the write changes, naming each with the rule's identifier.
 func checked(after []Rule, i int) *refusal.Refusal {
 	var mine []refusal.Problem
-	for _, p := range Check(after) {
+	for _, p := range Check(after[:i]) {
 		if p.Rule == i {
 			mine = append(mine, refusal.Problem{Kind: p.Kind, Rule: after[i].ID, Suffix: p.Suffix})
 		}
