control: A policy write the snapshot's validation refuses, or whose identifier no path segment can hold, is refused before it is written
removes: a write checks the scope's rules before the one it changes and never the changed rule itself
packages: ./ui/internal/api
tests: TestAWriteTheValidationRefusesIsRefusedBeforeItIsWritten
scheduled-count: no
integration: yes

diff --git a/ui/internal/policymanagement/rules.go b/ui/internal/policymanagement/rules.go
index e7c377d0..ade64bfc 100644
--- a/ui/internal/policymanagement/rules.go
+++ b/ui/internal/policymanagement/rules.go
@@ -282,7 +282,7 @@ func toRules(stored []registry.StoredRule) []rules.Rule {
 // with the rule at index i, the one the write changes.
 func checked(scope string, after []rules.Rule, i int) error {
 	var mine []rules.Problem
-	for _, p := range rules.Check(after) {
+	for _, p := range rules.Check(after[:i]) {
 		if p.Rule == i {
 			mine = append(mine, p)
 		}
