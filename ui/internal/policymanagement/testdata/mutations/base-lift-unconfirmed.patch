control: A lift every account loses needs the rule's identifier typed, the server's check
removes: a base rule is lifted with no confirmation
packages: ./ui/internal/api
tests: TestABaseLiftNeedsTheIdentifierTyped
scheduled-count: no
integration: yes

diff --git a/ui/internal/core/rules/rules.go b/ui/internal/core/rules/rules.go
--- a/ui/internal/core/rules/rules.go
+++ b/ui/internal/core/rules/rules.go
@@ -123,9 +123,6 @@ func Lifting(stored []Rule, id string, before []string, base bool, confirmation
 	if _, r := held(stored, id, before); r != nil {
 		return r
 	}
-	if base && !Confirms(confirmation, id) {
-		return confirmationRequired()
-	}
 	return nil
 }
 
