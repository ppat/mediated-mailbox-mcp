control: An import that lifts anything needs lift {k} for the count it lifts, the server's check
removes: the confirmation's count is every change the import makes rather than the restrictions it lifts
packages: ./ui/internal/api
tests: TestAnImportThatLiftsNeedsItsConfirmation TestAFileIsCheckedWholeAndImportsIntoAnyScope
scheduled-count: no
integration: yes

diff --git a/ui/internal/policymanagement/policyfile.go b/ui/internal/policymanagement/policyfile.go
--- a/ui/internal/policymanagement/policyfile.go
+++ b/ui/internal/policymanagement/policyfile.go
@@ -466,7 +466,7 @@ func (s *handlers) writeImport(w http.ResponseWriter, r *http.Request, account s
 			list[i] = f.rule
 		}
 		d := rules.Compare(toRules(stored), list)
-		if k := d.Lifts(); k > 0 && !rules.Confirms(body.Confirmation, rules.Confirmation(k)) {
+		if k := d.Changes(); d.Lifts() > 0 && !rules.Confirms(body.Confirmation, rules.Confirmation(k)) {
 			return errImportUnconfirmed
 		}
 		out = Imported{Added: []RuleAnswer{}, Edited: []EditedRule{}, Lifted: []LiftedRule{}, Lifts: d.Lifts()}
