control: the UI's one opening part opens a client's secret and never an account's credential
removes: the opener opens a client's secret bound to whichever row it was sealed for
packages: ./ui/internal/setup/clientsecret
tests: TestTheOpenerOpensAClientsSecretAndNothingElse
scheduled-count: no
integration: yes

diff --git a/ui/internal/setup/clientsecret/clientsecret.go b/ui/internal/setup/clientsecret/clientsecret.go
--- a/ui/internal/setup/clientsecret/clientsecret.go
+++ b/ui/internal/setup/clientsecret/clientsecret.go
@@ -55,7 +55,7 @@ func (o *Opener) Secret(ctx context.Context, client string) (string, error) {
 	if err != nil {
 		return "", err
 	}
-	plain, err := o.secrets.Open(sealed, client)
+	plain, err := o.secrets.Open(sealed, "household")
 	if err != nil {
 		return "", fmt.Errorf("clientsecret: opening the secret of %s: %w", client, err)
 	}
