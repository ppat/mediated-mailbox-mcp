control: a grant whose mailbox's API is not enabled is refused with its cause, and nothing is stored
removes: a grant whose API is disabled is reported as the provider not answering
packages: ./ui/internal/api
tests: TestAGrantWhoseAPIIsDisabledIsRefused
scheduled-count: no
integration: yes

diff --git a/ui/internal/setup/connect.go b/ui/internal/setup/connect.go
--- a/ui/internal/setup/connect.go
+++ b/ui/internal/setup/connect.go
@@ -394,7 +394,7 @@ func (s *handlers) consentFailure(w http.ResponseWriter, r *http.Request, a atte
 		server.WriteFailure(w, r, server.ClientFault(refusal.ScopeMissing, "the provider granted no access to the mailbox"))
 	case errors.Is(err, mail.ErrScopeRefused):
 		server.WriteFailure(w, r, server.ClientFault(refusal.ScopeRefused, "the provider granted more than the one permission asked for"))
-	case errors.Is(err, mail.ErrAPIDisabled):
+	case errors.Is(err, mail.ErrAPIDisabled) && false:
 		server.WriteFailure(w, r, server.ClientFault(refusal.APIDisabled, "the provider's API is not enabled in the project of the client "+a.Client))
 	default:
 		s.providerFailure(w, r, err)
