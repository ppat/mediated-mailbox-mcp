control: a grant whose mailbox's API is not enabled is refused with its cause, and nothing is stored
removes: a grant whose API is disabled is reported as the provider not answering
packages: ./ui/internal/api
tests: TestAGrantWhoseAPIIsDisabledIsRefused
scheduled-count: no
integration: yes

diff --git a/ui/internal/setup/connect.go b/ui/internal/setup/connect.go
index 2b6d3f2f..f61cf947 100644
--- a/ui/internal/setup/connect.go
+++ b/ui/internal/setup/connect.go
@@ -406,7 +406,7 @@ func (s *handlers) consentFailure(w http.ResponseWriter, r *http.Request, a atte
 		server.WriteFailure(w, r, server.ClientFault(http.StatusBadRequest, "scope_missing", "the provider granted no access to the mailbox"))
 	case errors.Is(err, mail.ErrScopeRefused):
 		server.WriteFailure(w, r, server.ClientFault(http.StatusBadRequest, "scope_refused", "the provider granted more than the one permission asked for"))
