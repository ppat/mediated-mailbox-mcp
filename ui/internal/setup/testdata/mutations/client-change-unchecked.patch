control: a client replaced or removed while an attempt runs fails its finish, and nothing is stored
removes: a finish exchanges and stores through the client the attempt started with, whatever the client holds now
packages: ./ui/internal/api
tests: TestAClientReplacedMidAttemptFailsTheFinish
scheduled-count: no
integration: yes

diff --git a/ui/internal/core/setup/setup.go b/ui/internal/core/setup/setup.go
--- a/ui/internal/core/setup/setup.go
+++ b/ui/internal/core/setup/setup.go
@@ -279,7 +279,7 @@ func StillFree(kind, account string, listed []string, stored []Client, attempt C
 	if kind == Connect && slices.Contains(listed, account) {
 		return IdentifierTaken()
 	}
-	if !slices.Contains(stored, attempt) {
+	if !slices.ContainsFunc(stored, func(c Client) bool { return c.Name == attempt.Name && c.Provider == attempt.Provider }) {
 		return refusal.Of(refusal.ClientChanged, "the client "+attempt.Name+" changed while this was in progress")
 	}
 	return nil
@@ -295,7 +295,7 @@ func IdentifierTaken() *refusal.Refusal {
 // started, read again in the transaction that writes, so a client replaced or removed meanwhile
 // writes nothing. identity is the stored client of the attempt's name, none when it was removed.
 func ClientChanged(identity []Client, attempt Client) bool {
-	return len(identity) != 1 || identity[0] != attempt
+	return len(identity) != 1 || identity[0].Provider != attempt.Provider
 }
 
