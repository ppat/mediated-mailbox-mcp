control: a grant for a mailbox other than the one named, or on re-authorization the one the account remembers, is refused
removes: a re-authorization takes the mailbox its request names over the one the account remembers
packages: ./ui/internal/api
tests: TestReauthorizingCannotChangeTheMailbox
scheduled-count: no
integration: yes

diff --git a/ui/internal/core/setup/setup.go b/ui/internal/core/setup/setup.go
--- a/ui/internal/core/setup/setup.go
+++ b/ui/internal/core/setup/setup.go
@@ -253,7 +253,7 @@ func Reauthorization(held Held, client Client, mailbox *string) (kind, address s
 	}
 	switch {
 	case held.Mailbox != nil && mailbox != nil:
-		return "", "", refusal.Of(refusal.MailboxRemembered, "the account remembers its mailbox, so the request names none")
+		address = *mailbox
 	case held.Mailbox == nil && mailbox == nil:
 		return "", "", refusal.Of(refusal.MailboxRequired, "the account remembers no mailbox, so the request names it")
 	case held.Mailbox == nil:
