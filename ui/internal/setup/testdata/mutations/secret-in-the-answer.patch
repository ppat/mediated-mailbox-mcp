control: a client's secret in plaintext reaches no answer, cookie or log line
removes: client setup answers with the secret it checked in place of the project ID
packages: ./ui/internal/api
tests: TestAClientsSecretReachesNoAnswerCookieOrLog
scheduled-count: no
integration: yes

diff --git a/ui/internal/setup/setup.go b/ui/internal/setup/setup.go
index 2bd0ea88..0f5e3fa8 100644
--- a/ui/internal/setup/setup.go
+++ b/ui/internal/setup/setup.go
@@ -231,7 +231,7 @@ func (s *handlers) addClient(w http.ResponseWriter, r *http.Request) {
 		server.DatabaseFailure(w, r, err)
 		return
 	}
-	server.WriteJSON(w, r, clientAnswer{Client: clientIdentity{Name: body.Name, Provider: provider, ClientID: body.ClientID, ProjectID: body.ProjectID}})
+	server.WriteJSON(w, r, clientAnswer{Client: clientIdentity{Name: body.Name, Provider: provider, ClientID: body.ClientID, ProjectID: &body.ClientSecret}})
 }
 
 // replaceClient replaces the named client's identifier and secret, or with the stored identifier its
