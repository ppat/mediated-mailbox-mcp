control: a client's name reaches one client, and one client is never stored twice
removes: a client identifier another client holds is refused as a name taken, so the screen cannot name the client holding it
packages: ./ui/internal/api
tests: TestAClientsNameReachesOneClient
scheduled-count: no
integration: yes

diff --git a/ui/internal/core/setup/setup.go b/ui/internal/core/setup/setup.go
--- a/ui/internal/core/setup/setup.go
+++ b/ui/internal/core/setup/setup.go
@@ -149,7 +149,7 @@ func Added(stored []Client, c Client) *refusal.Refusal {
 			return refusal.Of(refusal.NameTaken, "another client holds this name")
 		}
 		if s.Provider == c.Provider && s.ID == c.ID {
-			return refusal.Of(refusal.ClientExists, "this client is already set up as "+s.Name)
+			return refusal.Of(refusal.NameTaken, "another client holds this name")
 		}
 	}
 	return nil
