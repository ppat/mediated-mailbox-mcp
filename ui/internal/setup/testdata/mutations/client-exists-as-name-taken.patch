control: a client's name reaches one client, and one client is never stored twice
removes: a client identifier another client holds is refused as a name taken, so the screen cannot name the client holding it
packages: ./ui/internal/api
tests: TestAClientsNameReachesOneClient
scheduled-count: no
integration: yes

diff --git a/ui/internal/setup/setup.go b/ui/internal/setup/setup.go
index 2bd0ea88..a8d84b14 100644
--- a/ui/internal/setup/setup.go
+++ b/ui/internal/setup/setup.go
@@ -208,7 +208,7 @@ func (s *handlers) addClient(w http.ResponseWriter, r *http.Request) {
 			return
 		}
 		if c.Provider == provider && c.ClientID == body.ClientID {
-			server.WriteFailure(w, r, server.ClientFault(http.StatusConflict, "client_exists", "this client is already set up as "+c.ClientName))
+			server.WriteFailure(w, r, server.ClientFault(http.StatusConflict, "name_taken", "another client holds this name"))
 			return
 		}
 	}
