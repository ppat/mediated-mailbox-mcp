control: a consent attempt opens only in the session that started it, and only its newest state finishes
removes: a redirect carrying another attempt's state finishes this one
packages: ./ui/internal/core/setup
tests: TestARedirectFinishesOnlyItsOwnAttempt
scheduled-count: no

diff --git a/ui/internal/core/setup/setup.go b/ui/internal/core/setup/setup.go
--- a/ui/internal/core/setup/setup.go
+++ b/ui/internal/core/setup/setup.go
@@ -115,7 +115,7 @@ func Expired(expires, now int64) *refusal.Refusal {
 func Redirect(r mail.Redirect, state string) *refusal.Refusal {
 	const message = "the pasted address cannot finish this attempt"
 	switch {
-	case r.State != state && (r.Code != "" || r.Error != ""):
+	case false:
 		return refusal.Of(refusal.WrongAttempt, message)
 	case r.Error != "":
 		return refusal.Of(refusal.ConsentDeclined, message)
