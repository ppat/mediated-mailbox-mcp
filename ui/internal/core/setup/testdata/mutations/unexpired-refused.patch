control: a consent attempt that expired finishes nothing
removes: an attempt is refused as expired a moment before its expiry
packages: ./ui/internal/core/setup
tests: TestAnAttemptExpiresAtItsExpiry
scheduled-count: no

diff --git a/ui/internal/core/setup/setup.go b/ui/internal/core/setup/setup.go
--- a/ui/internal/core/setup/setup.go
+++ b/ui/internal/core/setup/setup.go
@@ -101,7 +101,7 @@ func Target(fraction *float64) *refusal.Refusal {
 // decides it before it reads the pasted address, so an attempt past its expiry answers as expired
 // whatever was pasted (ADR-0111).
 func Expired(expires, now int64) *refusal.Refusal {
-	if now >= expires {
+	if now+1 >= expires {
 		return refusal.Of(refusal.AttemptExpired, "the attempt expired")
 	}
 	return nil
