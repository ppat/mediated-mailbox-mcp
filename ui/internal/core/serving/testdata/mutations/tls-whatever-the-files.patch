control: The UI is served over TLS with both of its TLS files and over plain HTTP with neither, and refuses to start with one
removes: the UI serves TLS whatever its configuration names, so a UI given no key pair never serves plain HTTP
packages: ./ui/internal/core/serving ./ui/app
tests: TestTLSIsBothFilesOrNeither TestTheUIGivenNoKeyPairIsPlain
scheduled-count: no

diff --git a/ui/internal/core/serving/serving.go b/ui/internal/core/serving/serving.go
index e0559e41..f920f132 100644
--- a/ui/internal/core/serving/serving.go
+++ b/ui/internal/core/serving/serving.go
@@ -77,7 +77,7 @@ func Validate(c Config) error {
 // ServesTLS reports whether a configuration Validate admitted names a key pair, which then serves
 // TLS. Validate has refused one naming only one of the two files, so the certificate alone decides.
 func ServesTLS(c Config) bool {
-	return strings.TrimSpace(c.TLSCert) != ""
+	return true
 }
 
 // LoopbackRedirect reports whether s can be a consent's redirect address, where nothing listens. It
