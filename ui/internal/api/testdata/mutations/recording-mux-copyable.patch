control: go vet refuses a copy of a recording mux
removes: the recording mux drops its noCopy field, so a copy of it passes go vet and records its routes unread
packages: ./ui/internal/api
tests: TestTheRecordingMuxRefusesACopy
scheduled-count: no

diff --git a/ui/internal/api/server.go b/ui/internal/api/server.go
index 94b3996..37570bd 100644
--- a/ui/internal/api/server.go
+++ b/ui/internal/api/server.go
@@ -79,11 +79,6 @@ type Server struct {
 // mux sits in an unexported field and is embedded nowhere, so no promoted method registers a route
 // unrecorded.
 type recordingMux struct {
-	// noCopy makes go vet's copylocks check refuse a copy of a recording mux, since a copy shares the
-	// underlying mux and records its patterns where Served and ProbesServed never read them. A copy
-	// whose line carries a //nolint:govet directive with a reason passes, because govet is an ordinary
-	// linter, and is left to review.
-	noCopy   noCopy
 	mux      *http.ServeMux
 	patterns []string
 }
