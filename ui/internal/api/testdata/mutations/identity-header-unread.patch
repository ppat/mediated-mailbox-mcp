@@ -17,7 +17,7 @@ type Identity struct {
 // identity returns who the request is recorded as made by, and answers the request when the declared
 // header is missing.
 func (s *Server) identity(w http.ResponseWriter, r *http.Request) (string, bool) {
-	if s.opts.Identity.Header == "" {
+	if true {
 		return s.opts.Identity.Operator, true
 	}
 	v := strings.TrimSpace(r.Header.Get(s.opts.Identity.Header))
