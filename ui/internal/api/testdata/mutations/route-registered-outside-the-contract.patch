control: every route registered through the recording mux's Handle is compared with the contract document
removes: a route the contract document lacks is registered through the recording mux's Handle
packages: ./ui/internal/api
tests: TestTheServerServesExactlyTheDocumentsRoutes
scheduled-count: no

diff --git a/ui/internal/api/server.go b/ui/internal/api/server.go
index b3fad150..b4693f2d 100644
--- a/ui/internal/api/server.go
+++ b/ui/internal/api/server.go
@@ -115,6 +115,7 @@ func mount(db accounts.DBTX, checks *server.Checks, datasets []registry.Dataset,
 	mux.Handle(paths.API+"/", named("unrouted", func(w http.ResponseWriter, r *http.Request) {
 		server.WriteFailure(w, r, server.ClientFault(http.StatusNotFound, "not_found", "no read API route answers this path"))
 	}))
+	mux.Handle("GET "+paths.Accounts+"/{account}/export", scoped(db, paths.Accounts+"/{account}/export", http.NotFound))
 	// Every request is given its session, and every request whose method is not GET or HEAD is refused
 	// before it is routed unless it carries the session's request token (ADR-0061).
 	return &endpoint{uiMux: mux, handler: checks.Wrap(mux)}, nil
