control: A delta sync gap recovery shows on Home as the sync-gap card
removes: the rule reads the last seven days whatever its configured days, so a recovery within a longer window is missed
packages: ./ui/internal/api
tests: TestTheSyncGapRuleShowsTheRecovery
scheduled-count: no
integration: yes

diff --git a/ui/internal/api/attention.go b/ui/internal/api/attention.go
index be39be29..9152298b 100644
--- a/ui/internal/api/attention.go
+++ b/ui/internal/api/attention.go
@@ -154,7 +154,7 @@ func (s *Server) attentionInputs(ctx context.Context, q attentionQueries, now ti
 		}
 	}
 	if th.GapDays > 0 {
-		runs, err := q.runs.GapRecoveriesSince(ctx, at(now.Add(-time.Duration(th.GapDays)*24*time.Hour)))
+		runs, err := q.runs.GapRecoveriesSince(ctx, at(now.Add(-7 * 24 * time.Hour)))
 		if err != nil {
 			return in, err
 		}
