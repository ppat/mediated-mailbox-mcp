control: the entry template and the built bundle hold no inline script and reference no other origin
removes: the scan reads only URLs with a scheme, so a scheme-relative reference to another origin passes
packages: ./ui/internal/api
tests: TestThePolicyScanReportsEachPlantedViolation
scheduled-count: no

diff --git a/ui/internal/api/scan.go b/ui/internal/api/scan.go
index 8223e1a..33ecb6a 100644
--- a/ui/internal/api/scan.go
+++ b/ui/internal/api/scan.go
@@ -17,7 +17,7 @@ var (
 	// eventHandler is an inline event handler attribute, which the policy would also block.
 	eventHandler = regexp.MustCompile(`(?i)<[a-z][^>]*\son[a-z]+\s*=`)
 	// absolute is a URL that names an origin, with a scheme or scheme-relative.
-	absolute = regexp.MustCompile(`(?i)\b(?:https?|wss?|ftp):\/\/[^\s"'<>)]+|["'(\s]\/\/[a-z0-9.-]+\.[a-z]{2,}`)
+	absolute = regexp.MustCompile(`(?i)\b(?:https?|wss?|ftp):\/\/[^\s"'<>)]+`)
 	// stylesheetURL is a url() or an @import in a stylesheet.
 	stylesheetURL = regexp.MustCompile(`(?i)url\(\s*["']?([^"')]*)|@import\s+["']([^"']*)`)
 )
