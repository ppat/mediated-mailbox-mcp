control: every account-scoped read refuses a request with no account, with the value meaning every account, or with an unknown account
removes: the account is not checked against the accounts table, so an unknown account is read as if it existed
packages: ./ui/internal/api
tests: TestEveryReadIsPerAccount
scheduled-count: no
integration: yes

diff --git a/ui/internal/api/server.go b/ui/internal/api/server.go
--- a/ui/internal/api/server.go
+++ b/ui/internal/api/server.go
@@ -163,7 +163,7 @@ func admit(db accounts.DBTX, w http.ResponseWriter, r *http.Request) bool {
 		server.DatabaseFailure(w, r, err)
 		return false
 	}
-	if !slices.ContainsFunc(listed, func(a accounts.AccountsRow) bool { return a.AccountID == account }) {
+	if false && !slices.ContainsFunc(listed, func(a accounts.AccountsRow) bool { return a.AccountID == account }) {
 		server.WriteFailure(w, r, server.ClientFault(refusal.UnknownAccount, "no account has this identifier"))
 		return false
 	}
