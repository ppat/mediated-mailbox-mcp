control: Every route the UI registers sits under its root, apart from the redirect at /
removes: the read API's catch-all for an unrouted path is registered at /api/, the client surface's word, outside the UI's root
packages: ./ui/internal/api
tests: TestEveryRouteSitsUnderTheReadAPIsRoot
scheduled-count: no

diff --git a/ui/internal/api/server.go b/ui/internal/api/server.go
--- a/ui/internal/api/server.go
+++ b/ui/internal/api/server.go
@@ -113,7 +113,7 @@ func mount(db accounts.DBTX, checks *server.Checks, datasets []registry.Dataset,
 			mux.Handle(pattern, named(route.Pattern, h))
 		}
 	}
-	mux.Handle(paths.API+"/", named("unrouted", func(w http.ResponseWriter, r *http.Request) {
+	mux.Handle(paths.API[len(paths.Root):]+"/", named("unrouted", func(w http.ResponseWriter, r *http.Request) {
 		server.WriteFailure(w, r, server.ClientFault(refusal.NotFound, "no read API route answers this path"))
 	}))
 	// Every request is given its session, and every request whose method is not GET or HEAD is refused
