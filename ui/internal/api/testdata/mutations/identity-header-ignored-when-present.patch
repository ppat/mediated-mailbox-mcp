control: A policy write records only a declared identity
removes: a header other than the declared one is read, so a request carrying the declared header is refused
packages: ./ui/internal/api
tests: TestAPolicyWriteRecordsTheDeclaredIdentity
scheduled-count: no
integration: yes

diff --git a/ui/internal/api/identity.go b/ui/internal/api/identity.go
index 4e9887ff..838e9a80 100644
--- a/ui/internal/api/identity.go
+++ b/ui/internal/api/identity.go
@@ -20,7 +20,7 @@ func (s *Server) identity(w http.ResponseWriter, r *http.Request) (string, bool)
 	if s.opts.Identity.Header == "" {
 		return s.opts.Identity.Operator, true
 	}
-	v := strings.TrimSpace(r.Header.Get(s.opts.Identity.Header))
+	v := strings.TrimSpace(r.Header.Get("X-Identity"))
 	if v == "" {
 		writeFailure(w, r, &failure{status: http.StatusForbidden, origin: originClient, code: "identity_missing", message: "No identity was forwarded, so the change was not recorded"})
 		return "", false
