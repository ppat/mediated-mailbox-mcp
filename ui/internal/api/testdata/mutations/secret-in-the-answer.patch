control: a client's secret in plaintext reaches no answer, cookie or log line
removes: client setup answers with the secret it checked in place of the project ID
packages: ./ui/internal/api
tests: TestAClientsSecretReachesNoAnswerCookieOrLog
scheduled-count: no
integration: yes

diff --git a/ui/internal/api/setup.go b/ui/internal/api/setup.go
index 53c0b68b..d567bbd4 100644
--- a/ui/internal/api/setup.go
+++ b/ui/internal/api/setup.go
@@ -253,7 +253,7 @@ func (s *Server) addClient(w http.ResponseWriter, r *http.Request) {
 		s.databaseFailure(w, r, err)
 		return
 	}
-	writeJSON(w, r, clientAnswer{Client: clientIdentity{Name: body.Name, Provider: provider, ClientID: body.ClientID, ProjectID: body.ProjectID}})
+	writeJSON(w, r, clientAnswer{Client: clientIdentity{Name: body.Name, Provider: provider, ClientID: body.ClientID, ProjectID: &body.ClientSecret}})
 }
 
 // replaceClient replaces the named client's identifier and secret, or with the stored identifier its
