control: Every route the UI registers sits under its root, apart from the redirect at /
removes: the session's cookie is scoped to /, so a browser sends it to every surface on a shared origin
packages: ./ui/internal/api
tests: TestTheRootRedirectsToTheUIAndNothingElseOutsideItAnswers
scheduled-count: no

diff --git a/ui/internal/api/session.go b/ui/internal/api/session.go
index 3aa5ee2..42916c2 100644
--- a/ui/internal/api/session.go
+++ b/ui/internal/api/session.go
@@ -98,7 +98,7 @@ func withSession(next http.Handler) http.Handler {
 		} else if strings.HasPrefix(r.URL.Path, paths.Root+"/") {
 			s = session{id: rand.Text() + rand.Text()}
 			http.SetCookie(w, &http.Cookie{
-				Name: sessionCookie, Value: s.id, Path: paths.Root + "/", HttpOnly: true, Secure: true, SameSite: http.SameSiteStrictMode,
+				Name: sessionCookie, Value: s.id, Path: "/", HttpOnly: true, Secure: true, SameSite: http.SameSiteStrictMode,
 			})
 		}
 		next.ServeHTTP(w, r.WithContext(context.WithValue(r.Context(), sessionKey{}, s)))
