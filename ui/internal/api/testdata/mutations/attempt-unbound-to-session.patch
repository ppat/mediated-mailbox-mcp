+++ b/ui/internal/api/attempt.go
@@ -10,7 +10,6 @@ import (
 	"time"
 
 	"github.com/ppat/mediated-mailbox-mcp/ui/internal/paths"
-	"github.com/ppat/mediated-mailbox-mcp/ui/internal/server"
 )
 
 // attemptCookie carries the session's one consent attempt, sealed by the server (ADR-0111). It is
@@ -65,7 +64,7 @@ func (k keys) sealAttempt(a attempt, sessionID string) (string, error) {
 	if _, err := rand.Read(nonce); err != nil {
 		return "", err
 	}
-	return base64.RawURLEncoding.EncodeToString(k.attempt.Seal(nonce, nonce, plain, []byte(sessionID))), nil
+	return base64.RawURLEncoding.EncodeToString(k.attempt.Seal(nonce, nonce, plain, nil)), nil
 }
 
