control: every route registered through the recording mux's Handle is compared with the contract document
removes: the recording mux embeds its ServeMux again, so its promoted Handle registers a route unrecorded
packages: ./ui/internal/api
tests: TestTheRecordingMuxEmbedsNothing
scheduled-count: no

diff --git a/ui/internal/api/server.go b/ui/internal/api/server.go
index 11aa9a4..a75a7a8 100644
--- a/ui/internal/api/server.go
+++ b/ui/internal/api/server.go
@@ -113,7 +113,7 @@ type recordingMux struct {
 	// whose line carries a //nolint:govet directive with a reason passes, because govet is an ordinary
 	// linter, and is left to review.
 	noCopy   noCopy
-	mux      *http.ServeMux
+	*http.ServeMux
 	patterns []string
 }
 
@@ -125,11 +125,11 @@ func (*noCopy) Unlock() {}
 
 func (m *recordingMux) Handle(pattern string, h http.Handler) {
 	m.patterns = append(m.patterns, pattern)
