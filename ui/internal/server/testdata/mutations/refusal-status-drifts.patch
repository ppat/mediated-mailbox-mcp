control: Every refusal is sent with the code and the status the error contract gives it
removes: a stale rule is answered as a bad request rather than a conflict
packages: ./ui/internal/server
tests: TestEveryCodeIsAnsweredWithItsStatus
scheduled-count: no

diff --git a/ui/internal/server/errors.go b/ui/internal/server/errors.go
--- a/ui/internal/server/errors.go
+++ b/ui/internal/server/errors.go
@@ -85,7 +85,7 @@ var statuses = map[refusal.Code]int{
 	refusal.NameTaken:            http.StatusConflict,
 	refusal.NotConnected:         http.StatusConflict,
 	refusal.StalePreview:         http.StatusConflict,
-	refusal.StaleRule:            http.StatusConflict,
+	refusal.StaleRule:            http.StatusBadRequest,
 }
 
 // Status returns the status a refusal of code is answered with, and a bad request for a code the table
