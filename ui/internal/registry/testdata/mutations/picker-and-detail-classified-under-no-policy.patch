control: The UI classifies every sender under the policy in force when it reads
removes: the sender picker's classes and the failure detail's rule are decided under no rule, so only a domain the classifier cannot read is restricted there and no rule is named
packages: ./ui/internal/api
tests: TestTheUIClassifiesEverySenderUnderThePolicyInForce
scheduled-count: no
integration: yes

diff --git a/ui/internal/registry/failures.go b/ui/internal/registry/failures.go
--- a/ui/internal/registry/failures.go
+++ b/ui/internal/registry/failures.go
@@ -194,7 +194,7 @@ func (fr failureReads) classes(ctx context.Context, q Queries) (senderClasses, e
 	if err != nil {
 		return senderClasses{}, err
 	}
-	c := senderClasses{normal: senders.Normal(), isNormal: map[string]bool{}, policy: Classifier(stored, fr.lookups)}
+	c := senderClasses{normal: senders.Normal(), isNormal: map[string]bool{}, policy: Classifier(stored[:0], fr.lookups)}
 	for _, d := range c.normal {
 		c.isNormal[d] = true
 	}
diff --git a/ui/internal/registry/policy.go b/ui/internal/registry/policy.go
--- a/ui/internal/registry/policy.go
+++ b/ui/internal/registry/policy.go
@@ -793,7 +793,7 @@ func senderRows(ctx context.Context, q Queries, r Read, l classify.Lookups) (any
 	if err != nil {
 		return nil, err
 	}
-	classifier := Classifier(stored, l)
+	classifier := Classifier(stored[:0], l)
 	for _, row := range rows {
 		verdict := rules.Classify(classifier, row.Domain)
 		by := verdict.Rule()
