removes: an aggregate statement is accepted for any declared dimension, groupable or not
packages: ./ui/internal/registry
tests: TestTheStatementSetCheckReportsEachMismatch
scheduled-count: no

diff --git a/ui/internal/registry/registry.go b/ui/internal/registry/registry.go
--- a/ui/internal/registry/registry.go
+++ b/ui/internal/registry/registry.go
@@ -119,7 +119,7 @@
 		}
 		slices.Sort(names)
 		for _, name := range names {
-			if dim, ok := d.Dimension(name); !ok || !dim.Groupable {
+			if _, ok := d.Dimension(name); !ok {
 				problems = append(problems, fmt.Sprintf("%s: an aggregate statement for %s, which is not a groupable dimension", d.Name, name))
 			}
 		}
