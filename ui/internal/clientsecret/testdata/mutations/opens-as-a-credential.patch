control: the UI's one opening part opens a client's secret and never an account's credential
removes: the opener opens a client's row bound to an account credential's purpose
packages: ./ui/internal/clientsecret
tests: TestTheOpenerOpensAClientsSecretAndNothingElse
scheduled-count: no
integration: yes

diff --git a/ui/internal/clientsecret/clientsecret.go b/ui/internal/clientsecret/clientsecret.go
index b56cff18..bbaf49ed 100644
--- a/ui/internal/clientsecret/clientsecret.go
+++ b/ui/internal/clientsecret/clientsecret.go
@@ -52,7 +52,7 @@ func (o *Opener) Secret(ctx context.Context, client string) (string, error) {
 		if r.ClientName != client {
 			continue
 		}
-		plain, err := o.ring.Open(r.SealedClientSecret, seal.ClientSecret(client))
+		plain, err := o.ring.Open(r.SealedClientSecret, seal.AccountCredential(client))
 		if err != nil {
 			return "", fmt.Errorf("clientsecret: opening the secret of %s: %w", client, err)
 		}
