control: The API server serves the accounts each account snapshot it reloads lists, and keeps them when a reload's read fails
removes: a reload loads the policy only when its accounts differ from the ones the last load was tried for, so a load that failed is never retried and a policy edit never reaches the metadata reads
packages: ./api/app
tests: TestAFailedPolicyLoadStillFollowsTheSnapshot TestEveryReloadLoadsThePolicy
scheduled-count: no
integration: yes

diff --git a/executioncontext/assembly/assembly.go b/executioncontext/assembly/assembly.go
index d74efe4..839cd83 100644
--- a/executioncontext/assembly/assembly.go
+++ b/executioncontext/assembly/assembly.go
@@ -15,6 +15,7 @@ import (
 	"errors"
 	"fmt"
 	"log/slog"
+	"slices"
 	"sync"
 	"sync/atomic"
 	"time"
@@ -75,6 +76,7 @@ type Context struct {
 	// reloading makes reloads take turns.
 	reloading sync.Mutex
 	latest    atomic.Pointer[Reloaded]
+	tried     []string
 
 	observersMu sync.Mutex
 	observers   []func(context.Context)
@@ -169,8 +171,11 @@ func (c *Context) Reload(ctx context.Context) error {
 	snapshot := c.loader.Snapshot()
 	targets := c.readTargets(ctx, snapshot)
 	var err error
-	if policyErr := c.loadPolicy(ctx, idsOf(snapshot)); policyErr != nil {
-		err = fmt.Errorf("%w: %w", ErrPolicyNotLoaded, policyErr)
+	if ids := idsOf(snapshot); !slices.Equal(ids, c.tried) {
+		c.tried = ids
+		if policyErr := c.loadPolicy(ctx, ids); policyErr != nil {
+			err = fmt.Errorf("%w: %w", ErrPolicyNotLoaded, policyErr)
+		}
 	}
 	c.latest.Store(&Reloaded{snapshot: snapshot, targets: targets, loaded: true, err: err})
 	c.observersMu.Lock()
