control: The API server serves the accounts each reload of its Session puts in force, and keeps them when a reload's read fails
removes: a reload loads the policy only when its accounts differ from the ones the last load was tried for, so a load that failed is never retried and a policy edit never reaches the metadata reads
packages: ./api/app
tests: TestAFailedPolicyLoadStillFollowsTheList TestEveryReloadLoadsThePolicy
scheduled-count: no
integration: yes

diff --git a/process/sessions/sessions.go b/process/sessions/sessions.go
index cdcb3768..d8532d6b 100644
--- a/process/sessions/sessions.go
+++ b/process/sessions/sessions.go
@@ -85,6 +85,7 @@ type Session struct {
 	// when they succeeded.
 	failed atomic.Pointer[error]
 
+	tried       []string
 	membersMu   sync.Mutex
 	connections Connections
 	after       []func()
@@ -216,7 +217,12 @@ func (s *Session) reload(ctx context.Context) error {
 	}
 	s.inForce.Store(&listed)
 	s.failed.Store(nil)
-	err = s.policies.Load(ctx, ids(listed))
+	if slices.Equal(ids(listed), s.tried) {
+		err = nil
+	} else {
+		s.tried = ids(listed)
+		err = s.policies.Load(ctx, ids(listed))
+	}
 	// A policy the read found invalid is the operator's to fix, and the accounts keep the policy they
 	// had, the one that restricts every sender before any was read, so it holds up neither the
 	// Session's readiness nor its reload's pace. A read of the policy that did not complete does.
