control: The API server's token is made from the OAuth client the account connects through and the account's stored credential, and from nothing else
removes: the re-read after a refusal makes the token with the client the refused one was made with
packages: ./api/app
tests: TestARereadAfterAMoveBuildsTheTokenFromTheNewClient
scheduled-count: no
integration: yes

diff --git a/process/connections/work.go b/process/connections/work.go
index e76d4abf..4deb7244 100644
--- a/process/connections/work.go
+++ b/process/connections/work.go
@@ -152,7 +152,7 @@ func (w *Work) again(ctx context.Context) (*provider.Token, error) {
 		w.token = rec.token
 		return rec.token, nil
 	}
-	token, err := c.adapters.NewToken(rec.provider, client, plaintext)
+	token, err := c.adapters.NewToken(rec.provider, w.client, plaintext)
 	if err != nil {
 		return nil, err
 	}
