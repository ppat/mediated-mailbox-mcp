control: The API server serves the accounts each account snapshot it reloads lists, and keeps them when a reload's read fails
removes: a reload listing no account keeps the accounts served before it
packages: ./api/app
tests: TestTheAPIServerServesTheAccountsEachReloadLists
scheduled-count: no
integration: yes


diff --git a/api/app/app.go b/api/app/app.go
index 7ad0edd..48913bb 100644
--- a/api/app/app.go
+++ b/api/app/app.go
@@ -415,7 +415,9 @@ func (s *serving) reload(ctx context.Context) error {
 // serve serves the accounts of the snapshot the execution context's latest reload left in force.
 func (s *serving) serve(context.Context) {
 	ids := idsOf(s.context.Snapshot())
-	s.registry.Serve(ids)
+	if len(ids) > 0 {
+		s.registry.Serve(ids)
+	}
 	s.logger.Info("accounts served", "accounts", len(ids))
 }
 
