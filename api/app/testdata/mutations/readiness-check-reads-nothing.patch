control: The API server is ready only while its bearer token file holds a token
removes: the readiness check passes without reading the token file, so an API server whose token file was emptied or removed stays ready
packages: ./api/app
tests: TestReadyOnlyWhileTheBearerTokenLoads
scheduled-count: no

diff --git a/api/app/app.go b/api/app/app.go
--- a/api/app/app.go
+++ b/api/app/app.go
@@ -262,7 +262,7 @@ func parts(served *serving, tokenFile string, logger *slog.Logger) (host.Parts,
 	return host.Parts{
 		Handler: handler,
 		Ready: []host.Check{{Name: "bearer token", Check: func(context.Context) error {
-			return tokenReadable(tokenFile)
+			return nil
 		}}},
 	}, nil
 }
