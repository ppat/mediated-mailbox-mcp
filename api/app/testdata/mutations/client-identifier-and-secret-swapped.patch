control: The API server's token is made from the OAuth client the account connects through and the account's stored credential, and from nothing else
removes: the client's identifier and secret are swapped when the token is made
packages: ./api/app
tests: TestTheCredentialsAreTheClientAndTheAccountsToken
scheduled-count: no
integration: yes

diff --git a/process/connections/connections.go b/process/connections/connections.go
index 463d796a..13e0b632 100644
--- a/process/connections/connections.go
+++ b/process/connections/connections.go
@@ -331,7 +331,7 @@ func (c *Connections) adopt(rec *record, a accounts.Account, opened map[string]c
 		rec.stored, rec.baseline, rec.connected = stored, baselineOf(rec, same, plaintext), true
 		return true
 	}
-	token, err := c.adapters.NewToken(rec.provider, rec.client, plaintext)
+	token, err := c.adapters.NewToken(rec.provider, coremail.OAuthClient{ID: rec.client.Secret, Secret: rec.client.ID}, plaintext)
 	if err != nil {
 		c.log.Error("an account's token could not be made, so it is not connected", slog.String("account", a.ID), slog.Any("error", err))
 		rec.stored, rec.baseline, rec.token, rec.connected = stored, baselineOf(rec, same, plaintext), nil, false
