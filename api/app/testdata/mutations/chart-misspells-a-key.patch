control: The chart renders the API server a file it starts with, holding every API server key the chart admits
removes: the chart writes the client surface's address under a key the API server does not read
packages: ./api/app
tests: TestTheChartRendersAFileTheAPIServerStartsWith
scheduled-count: no

diff --git a/packaging/chart/templates/_config.tpl b/packaging/chart/templates/_config.tpl
index 02c2add5..fb8f1287 100644
--- a/packaging/chart/templates/_config.tpl
+++ b/packaging/chart/templates/_config.tpl
@@ -47,10 +47,12 @@ so no key is written twice.
 {{- $_ := set $c "database" (include "mm.config.database" (list . $v.database) | fromYaml) }}
 {{- $_ := set $c "credential" (include "mm.config.credential" . | fromYaml) }}
 {{- $_ := set $c "listen" (printf ":%s" (include "mm.port.http" .)) }}
 {{- $_ := set $c "probe_listen" (printf ":%s" (include "mm.port.metrics" .)) }}
 {{- $_ := set $c "token_file" (printf "%s/bearer-token" (include "mm.secretsDir" .)) }}
+{{- $_ := set $c "listen_address" (get $c "listen") }}
+{{- $_ := unset $c "listen" }}
 {{- if .Values.secrets.apiTls.existingSecret }}
 {{- $_ := set $c "tls_cert" (printf "%s/tls/tls.crt" (include "mm.secretsDir" .)) }}
 {{- $_ := set $c "tls_key" (printf "%s/tls/tls.key" (include "mm.secretsDir" .)) }}
 {{- end }}
 {{- toYaml $c }}
