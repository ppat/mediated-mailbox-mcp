control: The client surface is served over TLS when the configuration names a key pair and over plain HTTP when it names none, with the key pair read from its mounted files
removes: the key pair is read once, when the configuration is built, so a rotated pair never serves
packages: ./api/app
tests: TestTheSurfaceIsServedOverTLSWhenGivenAKeyPair
scheduled-count: no

diff --git a/api/app/app.go b/api/app/app.go
index b19c6f2b..c0b8edc7 100644
--- a/api/app/app.go
+++ b/api/app/app.go
@@ -658,10 +658,10 @@ func tlsConfig(c Configuration) *tls.Config {
 		return nil
 	}
 	certFile, keyFile := c.TLSCert, c.TLSKey
+	pair, err := tls.LoadX509KeyPair(certFile, keyFile)
 	return &tls.Config{
 		MinVersion: tls.VersionTLS12,
 		GetCertificate: func(*tls.ClientHelloInfo) (*tls.Certificate, error) {
-			pair, err := tls.LoadX509KeyPair(certFile, keyFile)
 			if err != nil {
 				return nil, fmt.Errorf("loading the TLS key pair: %w", err)
 			}
