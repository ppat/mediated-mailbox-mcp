control: A deployable that opens credentials refuses to start unless its public key matches one of its private keys
removes: the keyring holds only the first private key named, so a public key matching a later one refuses the start
packages: ./api/app
tests: TestTheAPIServersPublicKeyMustMatchAPrivateKey/a_public_key_matching_the_second_of_two
scheduled-count: no
integration: yes

diff --git a/process/connections/connections.go b/process/connections/connections.go
index 72d60326..d0238066 100644
--- a/process/connections/connections.go
+++ b/process/connections/connections.go
@@ -133,7 +133,7 @@ func Of(ctx context.Context, p process.Capabilities, c config.HasConnections, s
 			return nil, nil, err
 		}
 		k := c.KeysPart()
-		keys, err := open.Load(k.PublicKeyFile, k.PrivateKeyFiles...)
+		keys, err := open.Load(k.PublicKeyFile, k.PrivateKeyFiles[0])
 		if err != nil {
 			return nil, nil, fmt.Errorf("loading the keyring: %w", err)
 		}
