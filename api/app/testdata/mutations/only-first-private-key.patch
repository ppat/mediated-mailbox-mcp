control: A deployable that opens credentials refuses to start unless its public key matches one of its private keys
removes: the keyring holds only the first private key named, so a public key matching a later one refuses the start
packages: ./api/app
tests: TestThePublicKeyMustMatchAPrivateKey/a_public_key_matching_the_second_of_two
scheduled-count: no


diff --git a/api/app/app.go b/api/app/app.go
index 843a78ed..3d62cef5 100644
--- a/api/app/app.go
+++ b/api/app/app.go
@@ -192,7 +192,7 @@ func fromConfiguration(ctx context.Context, env host.Env[Configuration]) (host.P
 	if err != nil {
 		return host.Parts{}, fmt.Errorf("validating the configuration: scanner: %w", err)
 	}
-	keys, err := open.Load(c.Credential.PublicKeyFile, c.Credential.PrivateKeyFiles...)
+	keys, err := open.Load(c.Credential.PublicKeyFile, c.Credential.PrivateKeyFiles[0])
 	if err != nil {
 		return host.Parts{}, fmt.Errorf("loading the keyring: %w", err)
 	}
