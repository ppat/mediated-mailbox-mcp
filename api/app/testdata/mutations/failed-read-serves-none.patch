control: The API server serves the accounts each account snapshot it reloads lists, and keeps them when a reload's read fails
removes: a reload whose read fails stops serving every account
packages: ./api/app
tests: TestTheAPIServerServesTheAccountsEachReloadLists
scheduled-count: no
integration: yes


diff --git a/api/app/app.go b/api/app/app.go
index 7ad0edd..6dc06bd 100644
--- a/api/app/app.go
+++ b/api/app/app.go
@@ -409,7 +409,11 @@ func newServing(start host.Starter, pool *pgxpool.Pool, ec *assembly.Context, me
 // keeps its active snapshot, so an account it read before keeps that policy, and an account it never
 // read gets the policy that restricts every sender (ADR-0041). The next reload loads the policy again.
 func (s *serving) reload(ctx context.Context) error {
-	return s.context.Reload(ctx)
+	err := s.context.Reload(ctx)
+	if err != nil && !errors.Is(err, assembly.ErrPolicyNotLoaded) {
+		s.registry.Serve(nil)
+	}
+	return err
 }
 
 // serve serves the accounts of the snapshot the execution context's latest reload left in force.
