control: The API server refuses a configuration it cannot serve with before anything is read or connected
removes: the root hands the host no check, so the API server starts with any configuration the library loads
packages: ./api/app
tests: TestAConfigurationTheAPIServerCannotServeWithRefusesTheStart
scheduled-count: no

diff --git a/api/app/app.go b/api/app/app.go
--- a/api/app/app.go
+++ b/api/app/app.go
@@ -100,7 +100,7 @@
 		Process:     func(c config.API) config.Process { return c.Process },
 		Operations:  func(c config.API) config.Operations { return c.Operations },
 		Serving:     func(c config.API) config.Serving { return c.Serving },
-		Validate:    config.API.Check,
+		Validate:    nil,
 		CheckSchema: processdatabase.CheckSchema,
 		Components: []host.Component[config.API]{{
 			Name: "api", Mount: Mount, RefuseEnvironment: RefuseEnvironment, Assemble: fromConfiguration,
