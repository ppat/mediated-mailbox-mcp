control: The API server's HTTP servers close an idle connection and cut off a request that has not arrived within their limits, and bound no answer
removes: the servers set no idle limit, so an idle keep-alive connection is held until the read limit
packages: ./api/app
tests: TestTheConnectionLimits TestTheSurfaceClosesIdleAndSlowConnections
scheduled-count: no

diff --git a/api/app/app.go b/api/app/app.go
--- a/api/app/app.go
+++ b/api/app/app.go
@@ -133,7 +133,6 @@ func newServer(h http.Handler, l limits, logger *slog.Logger) *http.Server {
 		Handler:           h,
 		ReadHeaderTimeout: l.header,
 		ReadTimeout:       l.read,
-		IdleTimeout:       l.idle,
 		ErrorLog:          logging.ServerErrorLog(logger),
 	}
 }
