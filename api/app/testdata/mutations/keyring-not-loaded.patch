control: A deployable that opens credentials refuses to start unless its public key matches one of its private keys
removes: the connections build no keyring from the key files, so a public key matching none of the private keys goes unnoticed
packages: ./api/app
tests: TestTheAPIServersPublicKeyMustMatchAPrivateKey/a_public_key_matching_no_private_key
scheduled-count: no
integration: yes

diff --git a/process/connections/connections.go b/process/connections/connections.go
index 463d796a..f1cdad93 100644
--- a/process/connections/connections.go
+++ b/process/connections/connections.go
@@ -133,7 +133,8 @@ func Of(ctx context.Context, p process.Capabilities, c config.HasConnections, s
 			return nil, nil, err
 		}
 		k := c.KeysPart()
-		keys, err := open.Load(k.PublicKeyFile, k.PrivateKeyFiles...)
+		keys, err := (*open.Keyring)(nil), error(nil)
+		_ = k
 		if err != nil {
 			return nil, nil, fmt.Errorf("loading the keyring: %w", err)
 		}
