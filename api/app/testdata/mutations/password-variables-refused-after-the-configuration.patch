control: The API server refuses to start while PGPASSWORD or PGSSLPASSWORD is set
removes: the refusal runs after the configuration is read, logged and validated, so a start whose environment sets a password variable reads its configuration first
packages: ./api/app
tests: TestAPasswordVariableIsRefusedBeforeTheConfigurationIsRead
scheduled-count: no

diff --git a/api/app/app.go b/api/app/app.go
index ed8233b5..e8fd91a7 100644
--- a/api/app/app.go
+++ b/api/app/app.go
@@ -171,9 +171,6 @@ func validate(c Configuration) error {
 // stderr is where the start banner goes, standard error in main.go, so standard output carries only
 // the logger's JSON records (ADR-0122).
 func Run(ctx context.Context, args, environ []string, stderr io.Writer, logger *slog.Logger, level *slog.LevelVar) error {
-	if err := refuseEnvironment(environ); err != nil {
-		return err
-	}
 	loaded, err := settings.Load(defaults(), args, environ)
 	var help *settings.HelpRequested
 	if errors.As(err, &help) {
@@ -193,6 +190,9 @@ func Run(ctx context.Context, args, environ []string, stderr io.Writer, logger *
 		logger.Info("configuration", "path", v.Path, "source", v.Source.String(), "value", v.Value)
 	}
 	lv, err := logging.ParseLevel(loaded.Config.LogLevel)
+	if err := refuseEnvironment(environ); err != nil {
+		return err
+	}
 	if err != nil {
 		return fmt.Errorf("validating the configuration: %w", err)
 	}
