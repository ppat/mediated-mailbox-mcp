control: Every request to the client surface passes the bearer check before either root
removes: the MCP root is served beside the bearer check rather than behind it
packages: ./api/app
tests: TestEveryRequestPassesTheBearerCheckFirst/the_MCP_root_without_a_token TestEveryRequestPassesTheBearerCheckFirst/the_MCP_root_with_a_wrong_token TestEveryRequestPassesTheBearerCheckFirst/an_empty_token_file_and_a_token
scheduled-count: no

diff --git a/api/app/app.go b/api/app/app.go
index 00212862..3483a074 100644
--- a/api/app/app.go
+++ b/api/app/app.go
@@ -584,9 +584,10 @@ func surface(registry service.Registry, tokenFile string, logger *slog.Logger) (
 		return nil, err
 	}
 	roots := http.NewServeMux()
-	roots.Handle("/api/", apiRoot)
+	roots.Handle("/api/", bearer(tokenFile, logger, apiRoot))
 	roots.Handle("/mcp", mcp.Handler(registry, version.Number, logger))
-	return noStore(logger, bearer(tokenFile, logger, roots)), nil
+	roots.Handle("/", bearer(tokenFile, logger, http.NotFoundHandler()))
+	return noStore(logger, roots), nil
 }
 
 // noStore marks every response uncacheable, before its handler runs, so a response its handler
