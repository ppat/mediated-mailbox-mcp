control: The API server refuses to start while MCPGODEBUG is set
removes: an MCPGODEBUG set to the empty string is taken as unset
packages: ./api/app
tests: TestMCPGODEBUGStopsTheStart
scheduled-count: no


diff --git a/api/app/app.go b/api/app/app.go
index 843a78ed..456fde45 100644
--- a/api/app/app.go
+++ b/api/app/app.go
@@ -522,7 +522,7 @@ func idsOf(snapshot *accountload.Snapshot) []string {
 // (ADR-0086).
 func RefuseEnvironment(environ []string) error {
 	for _, entry := range environ {
-		if name, _, _ := strings.Cut(entry, "="); name == "MCPGODEBUG" {
+		if name, value, _ := strings.Cut(entry, "="); name == "MCPGODEBUG" && value != "" {
 			return errors.New("MCPGODEBUG is set, and the API server runs the MCP SDK only as it ships (ADR-0086)")
 		}
 	}
