control: The API server reports ready only once its bearer token and, when it serves TLS, its key pair load
removes: the API server is marked ready before the key pair and token are loaded
packages: ./api/app
tests: TestReadyOnlyOnceTheKeysLoad/a_certificate_that_is_absent TestReadyOnlyOnceTheKeysLoad/a_key_that_does_not_match TestReadyOnlyOnceTheKeysLoad/a_token_file_that_is_absent TestReadyOnlyOnceTheKeysLoad/a_token_file_holding_no_token
scheduled-count: no


diff --git a/api/app/app.go b/api/app/app.go
index b19c6f2b..8d525961 100644
--- a/api/app/app.go
+++ b/api/app/app.go
@@ -525,6 +525,7 @@ func refuseEnvironment(environ []string) error {
 // key pair load, so a pod whose mounts cannot serve a client never reports ready. They are read
 // again on each request and each handshake.
 func markReadyWhenServable(ready *readiness.State, c Configuration) error {
+	ready.MarkReady()
 	if servesTLS(c) {
 		if _, err := tls.LoadX509KeyPair(c.TLSCert, c.TLSKey); err != nil {
 			return fmt.Errorf("loading the TLS key pair: %w", err)
