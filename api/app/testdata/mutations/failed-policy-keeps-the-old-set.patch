control: The API server serves the accounts each account snapshot it reloads lists, and keeps them when a reload's read fails
removes: a reload whose policy load fails returns before serving its snapshot, so an account it dropped stays served
packages: ./api/app
tests: TestAFailedPolicyLoadStillFollowsTheSnapshot
scheduled-count: no
integration: yes

diff --git a/executioncontext/assembly/assembly.go b/executioncontext/assembly/assembly.go
index d74efe4..f717588 100644
--- a/executioncontext/assembly/assembly.go
+++ b/executioncontext/assembly/assembly.go
@@ -170,7 +170,7 @@ func (c *Context) Reload(ctx context.Context) error {
 	targets := c.readTargets(ctx, snapshot)
 	var err error
 	if policyErr := c.loadPolicy(ctx, idsOf(snapshot)); policyErr != nil {
-		err = fmt.Errorf("%w: %w", ErrPolicyNotLoaded, policyErr)
+		return fmt.Errorf("%w: %w", ErrPolicyNotLoaded, policyErr)
 	}
 	c.latest.Store(&Reloaded{snapshot: snapshot, targets: targets, loaded: true, err: err})
 	c.observersMu.Lock()
