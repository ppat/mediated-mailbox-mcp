control: The API server refuses to start while PGPASSWORD or PGSSLPASSWORD is set
removes: the start never checks the environment for a database password
packages: ./api/app
tests: TestAPasswordInTheEnvironmentStopsTheStart
scheduled-count: no


diff --git a/api/app/app.go b/api/app/app.go
index b19c6f2b..a441be6b 100644
--- a/api/app/app.go
+++ b/api/app/app.go
@@ -518,7 +518,7 @@ func refuseEnvironment(environ []string) error {
 			return errors.New("MCPGODEBUG is set, and the API server runs the MCP SDK only as it ships (ADR-0086)")
 		}
 	}
-	return dbconnect.RefusePasswordVariables(environ)
+	return nil
 }
 
