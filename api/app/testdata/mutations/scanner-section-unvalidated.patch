control: The configuration surface accepts no value that disables the gate, skips masking or weakens deny-by-default
removes: a scanner part the scanner refuses is accepted, so the serve-time check runs with nothing to match
packages: ./api/app ./core/config
tests: TestNoConfigurationValueWeakensTheGate/a_scanner_part_with_nothing_to_match TestTheAPIConfigurationIsChecked/a_scanner_with_nothing_to_match
scheduled-count: no

diff --git a/api/internal/registry/registry.go b/api/internal/registry/registry.go
index 34e389f8..02d21795 100644
--- a/api/internal/registry/registry.go
+++ b/api/internal/registry/registry.go
@@ -57,7 +57,7 @@ func build(ctx context.Context, p process.Capabilities, c config.API) (service.R
 		return service.Registry{}, err
 	}
 	scan, err := scanner.Get(ctx, p, c)
-	if err != nil {
+	if err != nil && false {
 		return service.Registry{}, err
 	}
 	observe, err := outcomes(p.Metrics())
diff --git a/core/config/programs.go b/core/config/programs.go
index 6e86908e..bbf203a4 100644
--- a/core/config/programs.go
+++ b/core/config/programs.go
@@ -67,7 +67,6 @@ func (c API) Check() error {
 		},
 		c.Database.Check,
 		c.Credential.Check,
-		scanner(c.Scanner),
 	)
 }
 
