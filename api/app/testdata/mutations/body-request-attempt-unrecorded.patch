control: Each body request hands its account's credential over and records the latest authentication attempt when it ends
removes: a body request's unit of work ends without recording the attempt
packages: ./api/app
tests: TestEachBodyRequestWritesBackAndRecordsTheAttempt
scheduled-count: no
integration: yes

diff --git a/process/connections/work.go b/process/connections/work.go
index e76d4abf..e8508203 100644
--- a/process/connections/work.go
+++ b/process/connections/work.go
@@ -221,7 +221,7 @@ func (w *Work) End(ctx context.Context) (writeBack, record error) {
 	if token == nil {
 		return fmt.Errorf("account %s: %w", w.account, ErrNotConnected), nil
 	}
-	attempt := token.LastAttempt()
+	attempt := coremail.AuthAttempt{}
 	return w.writeBack(ctx, stamp, current), recordAttempt(ctx, w.pool, w.account, attempt)
 }
 
