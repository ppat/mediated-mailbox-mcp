control: A body request waits for its leases no longer than its deadline for them, and a wait cut off by it is the API server's failure
removes: a wait cut off by the deadline is wrapped as the provider's failure, so the rate controller's hold reads as the provider's
packages: ./api/app
tests: TestARequestWaitsForItsLeasesNoLongerThanItsDeadline
scheduled-count: no
integration: yes

diff --git a/api/app/app.go b/api/app/app.go
--- a/api/app/app.go
+++ b/api/app/app.go
@@ -927,7 +927,7 @@ func leased[T any](ctx context.Context, limiter *lease.Limiter, port mail.Port[c
 	cutOff := errors.Is(waiting.Err(), context.DeadlineExceeded) && ctx.Err() == nil
 	stopWaiting()
 	if err != nil && cutOff {
-		return zero, fmt.Errorf("leasing the call: no lease by the request's deadline for its leases: %w", err)
+		return zero, fmt.Errorf("leasing the call: no lease by the request's deadline for its leases: %w: %w", mail.ErrProvider, err)
 	}
 	if err != nil {
 		return zero, fmt.Errorf("leasing the call: %w", err)
