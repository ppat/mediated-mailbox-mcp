control: The API server's HTTP servers close an idle connection and cut off a request that has not arrived within their limits, and bound no answer
removes: the servers bound writing an answer by the read limit, which cuts off a request waiting for its leases
packages: ./api/app
tests: TestTheConnectionLimits
scheduled-count: no

diff --git a/api/app/app.go b/api/app/app.go
--- a/api/app/app.go
+++ b/api/app/app.go
@@ -134,6 +134,7 @@ func newServer(h http.Handler, l limits, logger *slog.Logger) *http.Server {
 		ReadHeaderTimeout: l.header,
 		ReadTimeout:       l.read,
 		IdleTimeout:       l.idle,
+		WriteTimeout:      l.read,
 		ErrorLog:          logging.ServerErrorLog(logger),
 	}
 }
