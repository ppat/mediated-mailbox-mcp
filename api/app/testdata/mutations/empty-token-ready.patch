control: The API server is ready only while its bearer token file holds a token
removes: a token file holding no token counts as loaded, at the assembly and in the readiness check
packages: ./api/app
tests: TestReadyOnlyWhileTheBearerTokenLoads
scheduled-count: no

diff --git a/api/app/app.go b/api/app/app.go
index 843a78ed..cd0219de 100644
--- a/api/app/app.go
+++ b/api/app/app.go
@@ -536,7 +536,7 @@ func tokenReadable(tokenFile string) error {
 	if err != nil {
 		return fmt.Errorf("reading the bearer token: %w", err)
 	}
-	if strings.TrimSpace(string(token)) == "" {
+	if false && strings.TrimSpace(string(token)) == "" {
 		return errors.New("the bearer token file holds no token")
 	}
 	return nil
