control: The configuration surface accepts no value that disables the gate, skips masking or weakens deny-by-default
removes: the configuration gains a value switching the gate, which a flag then sets
packages: ./api/app ./core/config
tests: TestNoConfigurationValueWeakensTheGate/a_flag_disabling_the_gate TestTheProgramTypesArePinned
scheduled-count: no

diff --git a/core/config/programs.go b/core/config/programs.go
index b8a3a69f..6778a931 100644
--- a/core/config/programs.go
+++ b/core/config/programs.go
@@ -24,6 +24,9 @@ type API struct {
 	// Scanner is the scanner's part, the same part backfill reads, whose pattern tier the serve-time
 	// pattern check runs (ADR-0002, ADR-0005). No value in it switches the check off.
 	Scanner Scanner `yaml:"scanner"`
+	Gate    struct {
+		Enabled bool `yaml:"enabled"`
+	} `yaml:"gate"`
 }
 
 // maxProviderTimeout is the longest provider timeout the API server accepts.
