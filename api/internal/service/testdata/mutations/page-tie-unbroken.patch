control: A listing's cursor continues only the listing, account and filter it came from, and paging serves every row once
removes: the message listing's next page starts after the last row's time alone, so a row sharing that time is skipped
packages: ./api/internal/service
tests: TestAListingPagesThroughEveryRowOnce
scheduled-count: no
integration: yes

diff --git a/db/messages/metadata.sql b/db/messages/metadata.sql
index 5894a432..d444cb00 100644
--- a/db/messages/metadata.sql
+++ b/db/messages/metadata.sql
@@ -32,7 +32,7 @@ WHERE
     m.account_id = current_setting('app.account')
     AND (
         @after_sent_at::timestamptz IS NULL
-        OR (m.sent_at, m.message_id) < (@after_sent_at::timestamptz, @after_message_id::text)
+        OR m.sent_at < @after_sent_at::timestamptz
     )
 ORDER BY m.sent_at DESC, m.message_id DESC
 LIMIT @page_size;
diff --git a/db/messages/metadata.sql.go b/db/messages/metadata.sql.go
index eb85deb9..8dee6f3a 100644
--- a/db/messages/metadata.sql.go
+++ b/db/messages/metadata.sql.go
@@ -152,7 +152,7 @@ WHERE
     m.account_id = current_setting('app.account')
     AND (
         $1::timestamptz IS NULL
-        OR (m.sent_at, m.message_id) < ($1::timestamptz, $2::text)
+        OR (m.sent_at < $1::timestamptz AND $2::text IS NOT NULL)
     )
 ORDER BY m.sent_at DESC, m.message_id DESC
 LIMIT $3
