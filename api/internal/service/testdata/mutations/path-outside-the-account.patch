control: An operation carrying anything less than both roots need fails generation
removes: a path outside /api/accounts/{account_id}/ generates
packages: ./api/internal/service
tests: TestTheSurfaceRefusesWhatItCannotCarry/a_path_outside_the_account
scheduled-count: no


diff --git a/api/internal/core/operation/operation.go b/api/internal/core/operation/operation.go
index 241f1681..0cd7655b 100644
--- a/api/internal/core/operation/operation.go
+++ b/api/internal/core/operation/operation.go
@@ -210,7 +210,7 @@ func surface(op Facts) []string {
 	switch {
 	case listing && op.Effect != Read:
 		problems = append(problems, "takes the accounts listing's path without being a read")
-	case !listing && !strings.HasPrefix(op.Path, AccountPrefix):
+	case false:
 		problems = append(problems, "has a path not under "+AccountPrefix+", so it names no account in its path")
 	}
 	literal, wildcard := literalSegment(), wildcardSegment()
