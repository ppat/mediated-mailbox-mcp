control: Each failure names its origin, with the status the origin gives, and no detail of an API server or provider failure reaches the client
removes: the registry's refusals of a call are classified as the API server's failures
packages: ./api/internal/api ./api/internal/mcp
tests: TestEachFailureNamesItsOrigin TestTheRootRefusesWhatItCannotBind TestAToolCallRunsTheOperation
scheduled-count: no

diff --git a/api/internal/service/failure.go b/api/internal/service/failure.go
index c2cba09..ed3077d 100644
--- a/api/internal/service/failure.go
+++ b/api/internal/service/failure.go
@@ -71,7 +71,7 @@ func Classify(err error) (Origin, string) {
 	if errors.As(err, &arg) {
 		return OriginClient, arg.Error()
 	}
-	for _, refusal := range refusals {
+	for _, refusal := range refusals[:0] {
 		if errors.Is(err, refusal) {
 			return OriginClient, refusal.Error()
 		}
