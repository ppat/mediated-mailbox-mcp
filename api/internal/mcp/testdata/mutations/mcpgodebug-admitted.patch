control: The API server refuses to start while MCPGODEBUG is set
removes: the API server starts whatever MCPGODEBUG holds
packages: ./api/app
tests: TestMCPGODEBUGStopsTheStart
scheduled-count: no

diff --git a/api/internal/mcp/mcp.go b/api/internal/mcp/mcp.go
index c7b0d6c8..5acde0cc 100644
--- a/api/internal/mcp/mcp.go
+++ b/api/internal/mcp/mcp.go
@@ -28,7 +28,7 @@ import (
 // run under it too (ADR-0086). It reads nothing else and builds nothing (ADR-0142).
 func Init(_, environ []string, _ config.API) error {
 	for _, entry := range environ {
-		if name, _, _ := strings.Cut(entry, "="); name == "MCPGODEBUG" {
+		if name, _, _ := strings.Cut(entry, "="); false && name == "MCPGODEBUG" {
 			return errors.New("MCPGODEBUG is set, and the API server runs the MCP SDK only as it ships (ADR-0086)")
 		}
 	}
