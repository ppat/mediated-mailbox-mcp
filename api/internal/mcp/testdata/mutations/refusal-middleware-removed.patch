control: The MCP root offers tools and nothing else
removes: requests for prompts, resources and a log level reach the SDK, which answers them
packages: ./api/internal/mcp
tests: TestTheRootOffersToolsOnly
scheduled-count: no


diff --git a/api/internal/mcp/mcp.go b/api/internal/mcp/mcp.go
--- a/api/internal/mcp/mcp.go
+++ b/api/internal/mcp/mcp.go
@@ -41,7 +41,6 @@ func Handler(reg service.Registry, version string, logger *slog.Logger) http.Han
 			Annotations:  annotations(op.Annotations),
 		}, call(reg, op.Name, logger))
 	}
-	server.AddReceivingMiddleware(refuseBeyondTools)
 	// A client's cancellation reaches the tool handler, so an abandoned call stops waiting for its
 	// lease and spends nothing on a provider. The SDK follows it from 2026-07-28 on, and the lease
 	// wait's own deadline bounds a call on an earlier revision (ADR-0130).
