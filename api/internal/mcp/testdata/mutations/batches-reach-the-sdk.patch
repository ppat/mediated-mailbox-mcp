control: The MCP root refuses a JSON-RPC batch before any of its calls runs, at every revision
removes: the root hands every request to the SDK, which runs a batch at a revision before 2025-06-18
packages: ./api/internal/mcp
tests: TestABatchIsRefusedAtEveryRevision
scheduled-count: no

diff --git a/api/internal/mcp/mcp.go b/api/internal/mcp/mcp.go
--- a/api/internal/mcp/mcp.go
+++ b/api/internal/mcp/mcp.go
@@ -45,7 +45,7 @@ func Handler(reg service.Registry, version string, logger *slog.Logger) http.Han
 	// A client's cancellation reaches the tool handler, so an abandoned call stops waiting for its
 	// lease and spends nothing on a provider. The SDK follows it from 2026-07-28 on, and the lease
 	// wait's own deadline bounds a call on an earlier revision (ADR-0130).
-	return refuseBatches(sdk.NewStreamableHTTPHandler(func(*http.Request) *sdk.Server { return server }, &sdk.StreamableHTTPOptions{
+	return http.Handler(sdk.NewStreamableHTTPHandler(func(*http.Request) *sdk.Server { return server }, &sdk.StreamableHTTPOptions{
 		Stateless:                    true,
 		JSONResponse:                 true,
 		Logger:                       logger,
