control: A body request has the policy loaded by a load that started after it arrived, sharing a load only with the requests waiting when it started
removes: a caller asking while a load runs is answered by that load
packages: ./api/internal/reload
tests: TestALoadRunningWhenACallerAsksDoesNotCount
scheduled-count: no

diff --git a/api/internal/reload/reload.go b/api/internal/reload/reload.go
index 4d4747c8..c06a5ef8 100644
--- a/api/internal/reload/reload.go
+++ b/api/internal/reload/reload.go
@@ -112,9 +112,11 @@ func (c *Coalesced) run(ctx context.Context) {
 			c.mu.Unlock()
 			return
 		}
-		c.next = nil
 		c.mu.Unlock()
 		r.err = c.load(ctx)
+		c.mu.Lock()
+		c.next = nil
+		c.mu.Unlock()
 		close(r.done)
 		r = nil
 	}
