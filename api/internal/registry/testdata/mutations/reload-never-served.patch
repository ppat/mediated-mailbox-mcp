@@ -97,7 +97,6 @@ func build(ctx context.Context, p process.Capabilities, c config.API) (service.R
 	logger := p.Logger()
 	s.AfterReload(func() {
 		ids := ids(s)
-		registry.Serve(ids)
 		logger.Info("accounts served", "accounts", len(ids))
 	})
 	return registry, nil
