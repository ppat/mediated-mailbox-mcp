control: The time a job waits for a slot of its kind's limit does not count toward its lateness
removes: the late rule counts the time a job waits for a slot, so a job queued behind its kind's long runs fires
packages: ./worker/internal/schedule
tests: TestAlertingRules
scheduled-count: no

diff --git a/packaging/chart/alerting-rules.yaml b/packaging/chart/alerting-rules.yaml
index f084d381..127a9a4b 100644
--- a/packaging/chart/alerting-rules.yaml
+++ b/packaging/chart/alerting-rules.yaml
@@ -149,11 +149,7 @@ groups:
   # on every label they share.
   - alert: MediatedMailboxJobLate
     expr: |
-      time() - mediated_mailbox_job_last_success_timestamp_seconds -
-      mediated_mailbox_job_slot_waited_seconds -
-      (time() - mediated_mailbox_job_slot_waiting_since_timestamp_seconds) *
-      (mediated_mailbox_job_slot_waiting_since_timestamp_seconds > bool 0)
-      > mediated_mailbox_job_late_after_seconds
+      time() - mediated_mailbox_job_last_success_timestamp_seconds > mediated_mailbox_job_late_after_seconds
     labels:
       severity: warning
     annotations:
