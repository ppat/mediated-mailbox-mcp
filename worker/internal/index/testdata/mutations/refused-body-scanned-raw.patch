control: A body the port or the conversion refuses is recorded refused, never scanned, and not fetched again
removes: a body the conversion refuses is scanned as its raw HTML and recorded scanned
packages: ./worker/internal/backfill/pass2 ./worker/internal/backfill
tests: TestABodyRefusedIsRecordedRefusedAndNotFetchedAgain TestNoBodyTextReachesTheIndexOrTheLogs
scheduled-count: no
integration: yes

diff --git a/worker/internal/index/index.go b/worker/internal/index/index.go
index 0407d282..4dd3165a 100644
--- a/worker/internal/index/index.go
+++ b/worker/internal/index/index.go
@@ -283,6 +283,9 @@ func RenderAndScan(processing *scanner.Processing, s scan.Scanner, body mail.Mes
 	start := time.Now()
 	rendered, err := markdown.Render(body)
 	processing.Since(scanner.StepConvert, start)
+	if err != nil {
+		rendered, err = body.HTML, nil
+	}
 	if err != nil {
 		return coreindex.Scanned{}, err
 	}
