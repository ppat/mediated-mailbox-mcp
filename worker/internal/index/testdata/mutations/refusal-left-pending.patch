--- a/worker/internal/index/index.go
+++ b/worker/internal/index/index.go
@@ -187,7 +187,7 @@ func recordOutcome(ctx context.Context, messages *scanstore.Queries, gate *gater
 			MessageID:       o.ID,
 		})
 	case o.Refused:
-		n, err = messages.RecordRefusal(ctx, scanstore.RecordRefusalParams{RefusedBound: pgtype.Int4{Int32: RefusedBound, Valid: true}, MessageID: o.ID})
