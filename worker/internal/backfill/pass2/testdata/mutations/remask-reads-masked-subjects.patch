control: A backfill run's start masks every stale subject stored unmasked again from the store, a batch at a time, with a masking event for each mask
removes: the run-start step masks the subjects stored masked again from their masked text too, so a subject whose masks hid what the new scanner reads is never fetched again
packages: ./worker/internal/backfill ./worker/internal/backfill/pass2
tests: TestTheRunStartMasksTheSubjectsStoredUnmaskedAgainFromTheStore TestAChangeOfScannerMasksAndScansAgain
scheduled-count: no
integration: yes

diff --git a/db/messages/ingest/ingest.sql b/db/messages/ingest/ingest.sql
index 2e264c23..9cf50cd9 100644
--- a/db/messages/ingest/ingest.sql
+++ b/db/messages/ingest/ingest.sql
@@ -124,13 +124,12 @@ LIMIT @batch_size;
 SELECT
     m.message_id,
     coalesce(m.subject, '')::text AS subject
 FROM messages AS m
 WHERE
     m.account_id = current_setting('app.account')
-    AND NOT m.subject_masked
     AND (
         m.subject_scanner_version IS DISTINCT FROM @scanner_version::int
         OR m.subject_scanner_revision IS DISTINCT FROM @scanner_revision::text
     )
     AND m.message_id > @after
 ORDER BY m.message_id
@@ -155,13 +154,12 @@ FROM (
         unnest(@subjects::text[]) AS subject,
         unnest(@subjects_masked::boolean[]) AS subject_masked
 ) AS r
 WHERE
     m.account_id = current_setting('app.account')
     AND m.message_id = r.message_id
-    AND NOT m.subject_masked
     AND (
         m.subject_scanner_version IS DISTINCT FROM @scanner_version::int
         OR m.subject_scanner_revision IS DISTINCT FROM @scanner_revision::text
     );
 
 -- name: RemaskSubject :execrows
