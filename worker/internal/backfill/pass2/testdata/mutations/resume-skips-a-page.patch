control: A killed second pass resumes from its last checkpointed page
removes: a resumed run counts one page more than its checkpoint
packages: ./worker/internal/backfill/pass2
tests: TestAKilledSecondPassResumesFromItsCheckpoint
scheduled-count: no
integration: yes

diff --git a/worker/internal/backfill/pass2/pass2.go b/worker/internal/backfill/pass2/pass2.go
index 855dbb6..3285d88 100644
--- a/worker/internal/backfill/pass2/pass2.go
+++ b/worker/internal/backfill/pass2/pass2.go
@@ -135,6 +135,9 @@ func Open(ctx context.Context, deps Deps, account string) (*Pass, error) {
 		return nil, fmt.Errorf("reading the account's second pass: %w", err)
 	}
 	start, over := core.Over(core.Begin(firstEnded, ended, latest), startOver)
+	if start.ResumedFrom != "" {
+		start.From.Checkpoint.Page++
+	}
 	if start.Skip {
 		return &Pass{deps: deps, account: account, done: true}, nil
 	}
