control: A verdict made under another scanner returns to pending, cleared, with its sender's prior hits counted again
removes: a backfill run leaves a verdict made under another scanner in force
packages: ./worker/internal/backfill ./worker/internal/backfill/pass2
tests: TestAChangeOfScannerMasksAndScansAgain
scheduled-count: no
integration: yes

diff --git a/worker/internal/backfill/pass2/postgres.go b/worker/internal/backfill/pass2/postgres.go
index 86c762e..fda9326 100644
--- a/worker/internal/backfill/pass2/postgres.go
+++ b/worker/internal/backfill/pass2/postgres.go
@@ -174,9 +174,8 @@ func (s *Postgres) Reopen(ctx context.Context, account string, stamp pass1core.S
 	var marked Reopened
 	err := tx.Run(ctx, s.db, account, func(t pgx.Tx) error {
 		marked = Reopened{}
-		domains, err := scan.New(t).RequeueStaleVerdicts(ctx, scan.RequeueStaleVerdictsParams{
-			AccountID: account, ScannerVersion: version(stamp.Version), ScannerRevision: stamp.Revision,
-		})
+		var domains []string
+		var err error
 		if err != nil {
 			return fmt.Errorf("returning the verdicts another scanner made to pending scan: %w", err)
 		}
