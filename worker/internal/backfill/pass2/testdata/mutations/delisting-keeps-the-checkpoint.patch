control: A removed rule returns its sender's messages to pending scan, and the pass starts over
removes: a run that marked messages keeps its checkpoint, so marked messages before it wait until the pass ends
packages: ./worker/internal/backfill/pass2
tests: TestARemovedRuleReturnsItsSendersMessagesToPendingScan TestAKilledSecondPassResumesFromItsCheckpoint
scheduled-count: no
integration: yes

diff --git a/worker/internal/backfill/pass2/pass2.go b/worker/internal/backfill/pass2/pass2.go
index e9237ee1..4840b2d4 100644
--- a/worker/internal/backfill/pass2/pass2.go
+++ b/worker/internal/backfill/pass2/pass2.go
@@ -203,7 +203,7 @@ func Open(ctx context.Context, deps Deps, account string) (pass *Pass, err error
 // the first page after the policy it holds differs by value from the active one, so a lift reaches
 // the messages skipped as restricted within one reload and one page (ADR-0119).
 func (p *Pass) compare(ctx context.Context, composed classify.Policy) error {
-	restart := core.Restart(p.at)
+	restart := p.at
 	marked, err := p.deps.Store.Delist(ctx, p.account, p.run, func(restricted []string) []string {
 		return index.Delisted(composed, restricted)
 	}, restart)
