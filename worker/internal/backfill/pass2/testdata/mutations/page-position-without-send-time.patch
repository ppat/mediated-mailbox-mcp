control: A killed second pass resumes from its last checkpointed page
removes: a page's position keeps the identifier of its last message and not its send time, so the next page reads from the Unix epoch, past every message in the walk, and the pass leaves the rest waiting
packages: ./worker/internal/backfill/pass2
tests: TestTheSecondPassReadsTheNewestWaitingMessagesFirst TestAKilledSecondPassResumesFromItsCheckpoint/resumed-after-every-page-among-messages-sent-at-one-instant
scheduled-count: no
integration: yes

diff --git a/worker/internal/backfill/pass2/pass2.go b/worker/internal/backfill/pass2/pass2.go
index e455c344..697744e3 100644
--- a/worker/internal/backfill/pass2/pass2.go
+++ b/worker/internal/backfill/pass2/pass2.go
@@ -233,7 +233,7 @@ func (p *Pass) Next(ctx context.Context) (step Step, err error) {
 	if err != nil {
 		return Step{}, err
 	}
-	page := core.Page{Outcomes: outcomes, Last: core.Position{SentAt: last.SentAt, ID: last.ID}}
+	page := core.Page{Outcomes: outcomes, Last: core.Position{ID: last.ID}}
 	at := core.Advance(p.at, page)
 	if err := p.deps.Store.Commit(ctx, p.account, p.run, page, items, at); err != nil {
 		return Step{}, p.failed(ctx, fmt.Errorf("making page %d durable: %w", number, err))
