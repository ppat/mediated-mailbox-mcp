control: A reopened first pass always leads to a run of the second pass
removes: the run-start step records the first pass as not ended in place of the second
packages: ./worker/internal/backfill
tests: TestAReopenedFirstPassLeadsToASecondPass
scheduled-count: no
integration: yes
diff --git a/worker/internal/backfill/pass2/postgres.go b/worker/internal/backfill/pass2/postgres.go
index 1d6d25fa..2a78b505 100644
--- a/worker/internal/backfill/pass2/postgres.go
+++ b/worker/internal/backfill/pass2/postgres.go
@@ -255,7 +255,7 @@ func (s *Postgres) Reopen(ctx context.Context, account string, stamp index.Stamp
 		if marked.Verdicts == 0 && marked.Refusals == 0 && marked.Skips == 0 && marked.Subjects == 0 && !stale {
 			return nil
 		}
-		if err := completion.New(t).ReopenBackfillSecond(ctx); err != nil {
