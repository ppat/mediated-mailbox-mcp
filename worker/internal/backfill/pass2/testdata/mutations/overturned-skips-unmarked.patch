@@ -207,6 +207,9 @@ func (s *Postgres) Reopen(ctx context.Context, account string, stamp pass1core.S
 		if err := completion.New(t).ReopenBackfillSecond(ctx, account); err != nil {
 			return fmt.Errorf("recording the pass as due again: %w", err)
 		}
+		if marked.Verdicts == 0 && !stale {
+			return completion.New(t).ClearSecondRestart(ctx, account)
+		}
 		return nil
 	})
