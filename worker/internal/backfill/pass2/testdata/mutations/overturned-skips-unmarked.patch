 		if marked.Verdicts == 0 && marked.Skips == 0 && marked.Subjects == 0 && !stale {
 			return nil
 		}
 		if err := completion.New(t).ReopenBackfillSecond(ctx); err != nil {
 			return fmt.Errorf("recording the pass as due again: %w", err)
 		}
