control: An overturned gate skip reopens the second pass, marked to start over
removes: the run-start step reopens the second pass for overturned skips without marking it to start over, so a stopped pass resumes past the skips returned before its checkpoint
packages: ./worker/internal/backfill ./worker/internal/backfill/pass2
tests: TestASkipReturnedBeforeAStoppedPassesCheckpointIsScanned
scheduled-count: no
integration: yes
diff --git a/worker/internal/backfill/pass2/postgres.go b/worker/internal/backfill/pass2/postgres.go
index 1d6d25fa..beabb071 100644
--- a/worker/internal/backfill/pass2/postgres.go
+++ b/worker/internal/backfill/pass2/postgres.go
@@ -258,6 +258,9 @@ func (s *Postgres) Reopen(ctx context.Context, account string, stamp index.Stamp
 		if err := completion.New(t).ReopenBackfillSecond(ctx); err != nil {
 			return fmt.Errorf("recording the pass as due again: %w", err)
 		}
+		if marked.Verdicts == 0 && !stale {
+			return completion.New(t).ClearSecondRestart(ctx)
+		}
 		return nil
 	})
 	return marked, err
