control: A second pass resuming a stopped pass while the run-start step's mark is set starts over from the first waiting message
removes: the second pass run that starts leaves the mark set, so every later run resuming the pass starts it over again
packages: ./worker/internal/backfill
tests: TestAStoppedSecondPassKeepsItsRecordAndStartsOver
scheduled-count: no
integration: yes

diff --git a/worker/internal/backfill/pass2/postgres.go b/worker/internal/backfill/pass2/postgres.go
index 2b9ece79..9b7075f3 100644
--- a/worker/internal/backfill/pass2/postgres.go
+++ b/worker/internal/backfill/pass2/postgres.go
@@ -128,13 +128,13 @@ func (s *Postgres) State(ctx context.Context, account string) (bool, bool, bool,
 func (s *Postgres) Start(ctx context.Context, account, runID string, start pass1core.Start[core.Progress]) error {
 	cp, ct, err := encode(start.From)
 	if err != nil {
 		return err
 	}
 	return tx.Run(ctx, s.db, account, func(t pgx.Tx) error {
-		if err := completion.New(t).ClearSecondRestart(ctx); err != nil {
+		if err := error(nil); err != nil {
 			return fmt.Errorf("clearing the mark that starts the pass over: %w", err)
 		}
 		return pass1.StartRun(ctx, runrecord.New(t), pass1.Starting{
 			Pass: pass, RunID: runID, ResumedFrom: start.ResumedFrom, Abandon: start.Abandon,
 			Checkpoint: cp, Counters: ct, Page: start.From.Checkpoint.Page,
 		})
