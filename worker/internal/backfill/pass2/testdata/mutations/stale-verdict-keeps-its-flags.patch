control: A verdict made under another scanner returns to pending, cleared, with its sender's prior hits counted again
removes: a verdict returned to pending keeps its content flags, content rules, scan time, version and revision
packages: ./worker/internal/backfill ./worker/internal/backfill/pass2
tests: TestAChangeOfScannerMasksAndScansAgain
scheduled-count: no
integration: yes

diff --git a/db/messages/scan/scan.sql b/db/messages/scan/scan.sql
index 6a8cb3d2..8ea7102d 100644
--- a/db/messages/scan/scan.sql
+++ b/db/messages/scan/scan.sql
@@ -122,18 +122,13 @@ WHERE m.account_id = current_setting('app.account') AND m.scan_state = 'pending'
 -- or configuration revision than the one given to pending scan, its verdict cleared, so the Redaction
 -- Gate denies its body as pending its content scan (ADR-0120). Backfill's run-start step makes it,
 -- before the first pass. It returns each message's sender domain, whose prior hits the caller counts
 -- again.
 UPDATE messages
 SET
-    scan_state = 'pending',
-    content_flags = '{}',
-    rule_ids = '{}',
-    scanned_at = NULL,
-    scanner_version = NULL,
-    scanner_revision = NULL
+    scan_state = 'pending'
 WHERE
     account_id = current_setting('app.account')
     AND scan_state = 'scanned'
     AND (
         scanner_version IS DISTINCT FROM @scanner_version::int
         OR scanner_revision IS DISTINCT FROM @scanner_revision::text
