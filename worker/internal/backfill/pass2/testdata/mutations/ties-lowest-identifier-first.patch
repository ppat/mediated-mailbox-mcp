control: Backfill's second pass reads the messages waiting for a scan newest first
removes: messages sent at the same instant are read lowest identifier first, against the keyset
packages: ./worker/internal/backfill/pass2
tests: TestTheSecondPassReadsTheNewestWaitingMessagesFirst TestAKilledSecondPassResumesFromItsCheckpoint/resumed-after-every-page-among-messages-sent-at-one-instant
scheduled-count: no
integration: yes

diff --git a/db/messages/scan/scan.sql b/db/messages/scan/scan.sql
index 6a8cb3d2..fb9bb009 100644
--- a/db/messages/scan/scan.sql
+++ b/db/messages/scan/scan.sql
@@ -42,13 +42,13 @@ SELECT
 FROM messages AS m
 LEFT JOIN senders AS s ON m.account_id = s.account_id AND m.from_domain = s.domain
 WHERE
     m.account_id = current_setting('app.account')
     AND m.scan_state = 'pending'
     AND (m.sent_at, m.message_id) < (@after_sent_at::timestamptz, @after_message_id::text)
-ORDER BY m.sent_at DESC, m.message_id DESC
+ORDER BY m.sent_at DESC, m.message_id ASC
 LIMIT @page_size;
 
 -- name: RecordVerdict :execrows
 -- Records a waiting message's scan verdict, its content flags, the identifiers of the content rules
 -- that fired, the scanner version and the configuration's revision (ADR-0009). The rules are the
 -- content rules alone. A message no longer waiting is left as it is and counts no row.
diff --git a/db/messages/scan/scan.sql.go b/db/messages/scan/scan.sql.go
index cb71bfe0..56adf947 100644
--- a/db/messages/scan/scan.sql.go
+++ b/db/messages/scan/scan.sql.go
@@ -245,13 +245,13 @@ SELECT
 FROM messages AS m
 LEFT JOIN senders AS s ON m.account_id = s.account_id AND m.from_domain = s.domain
 WHERE
     m.account_id = current_setting('app.account')
     AND m.scan_state = 'pending'
     AND (m.sent_at, m.message_id) < ($1::timestamptz, $2::text)
-ORDER BY m.sent_at DESC, m.message_id DESC
+ORDER BY m.sent_at DESC, m.message_id ASC
 LIMIT $3
 `
 
 type PendingPageNewestFirstParams struct {
 	AfterSentAt    pgtype.Timestamptz
 	AfterMessageID string
