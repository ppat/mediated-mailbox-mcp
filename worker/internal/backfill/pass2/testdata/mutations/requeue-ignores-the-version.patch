control: A verdict made under another scanner returns to pending, cleared, with its sender's prior hits counted again
removes: a verdict whose scanner version differs and whose revision matches stays in force
packages: ./worker/internal/backfill
tests: TestAChangeOfScannerVersionAloneMasksAndScansAgain
scheduled-count: no
integration: yes

diff --git a/db/messages/scan/scan.sql b/db/messages/scan/scan.sql
index 6a8cb3d2..e11532ba 100644
--- a/db/messages/scan/scan.sql
+++ b/db/messages/scan/scan.sql
@@ -132,13 +132,13 @@ SET
     scanner_version = NULL,
     scanner_revision = NULL
 WHERE
     account_id = current_setting('app.account')
     AND scan_state = 'scanned'
     AND (
-        scanner_version IS DISTINCT FROM @scanner_version::int
+        false AND scanner_version IS DISTINCT FROM @scanner_version::int
         OR scanner_revision IS DISTINCT FROM @scanner_revision::text
     )
 RETURNING from_domain;
 
 -- name: RequeueSignalledSkips :execrows
 -- Returns each of the account's messages the gate skipped whose subject is now masked to pending scan,
diff --git a/db/messages/scan/scan.sql.go b/db/messages/scan/scan.sql.go
index cb71bfe0..5eb8e12b 100644
--- a/db/messages/scan/scan.sql.go
+++ b/db/messages/scan/scan.sql.go
@@ -412,13 +412,13 @@ SET
     scanner_version = NULL,
     scanner_revision = NULL
 WHERE
     account_id = current_setting('app.account')
     AND scan_state = 'scanned'
     AND (
-        scanner_version IS DISTINCT FROM $1::int
+        false AND scanner_version IS DISTINCT FROM $1::int
         OR scanner_revision IS DISTINCT FROM $2::text
     )
 RETURNING from_domain
 `
 
