control: The run-start step writes to no run's record
removes: the run-start step records the stopped second pass run's progress as starting over, with a progress and a retry event, on that run's record
packages: ./worker/internal/backfill
tests: TestAStoppedSecondPassKeepsItsRecordAndStartsOver
scheduled-count: no
integration: yes

diff --git a/worker/internal/backfill/pass2/postgres.go b/worker/internal/backfill/pass2/postgres.go
index 2b9ece79..ab04e614 100644
--- a/worker/internal/backfill/pass2/postgres.go
+++ b/worker/internal/backfill/pass2/postgres.go
@@ -246,13 +246,29 @@ func (s *Postgres) Reopen(ctx context.Context, account string, stamp index.Stamp
 		if marked.Verdicts == 0 && marked.Skips == 0 && marked.Subjects == 0 && !stale {
 			return nil
 		}
 		if err := completion.New(t).ReopenBackfillSecond(ctx); err != nil {
 			return fmt.Errorf("recording the pass as due again: %w", err)
 		}
-		return nil
+		r := runrecord.New(t)
+		run, err := pass1.LatestRun(ctx, r, pass)
+		if err != nil || !run.Found || run.State == pass1core.Succeeded {
+			return err
+		}
+		at, err := decode(run.Checkpoint, run.Counters)
+		if err != nil {
+			return err
+		}
+		cp, ct, err := encode(core.Restart(at))
+		if err != nil {
+			return err
+		}
+		if err := pass1.RecordProgress(ctx, r, run.RunID, cp, ct, 0); err != nil {
+			return err
+		}
+		return pass1.RecordEvent(ctx, r, run.RunID, pass1.Event{Kind: "retry"})
 	})
 	return marked, err
 }
 
 // remaskStored masks again every stale subject the account stores unmasked, from the subject stored,
 // in the transaction messages and events run in, a batch at a time in the order of the messages'
