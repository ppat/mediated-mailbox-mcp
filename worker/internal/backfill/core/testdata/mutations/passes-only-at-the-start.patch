control: Backfill's due decision asks for the run-start step once for each job's life and for the passes while either has work
removes: the passes are due only at the job's first run, whatever recorded state says
packages: ./worker/internal/backfill/core
tests: TestBackfillsDueDecision TestBackfillsDueDecision/the_first_pass_not_ended TestBackfillsDueDecision/the_second_pass_not_ended TestBackfillsDueDecision/the_second_pass_marked_to_start_over
scheduled-count: no

diff --git a/worker/internal/backfill/core/core.go b/worker/internal/backfill/core/core.go
index ad3c5aee..d6478785 100644
--- a/worker/internal/backfill/core/core.go
+++ b/worker/internal/backfill/core/core.go
@@ -35,7 +35,7 @@ func (w Work) Any() bool { return w.Start || w.Passes }
 // not ended or the second is marked to start over, and the run-start step opens them too, since it
 // may reopen them.
 func Decide(s State, started bool) Work {
-	return Work{Start: !started, Passes: !started || !s.FirstEnded || !s.SecondEnded || s.Restart}
+	return Work{Start: !started, Passes: !started}
 }
 
 // Seed returns when the account's backfill job's latest success is counted from at the job's ensure,
