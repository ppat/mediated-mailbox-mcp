control: Every backfill run is recorded with its checkpoint, counters, timeline and failed items
removes: a page the provider throttles fails the run on its first attempt
packages: ./worker/internal/backfill/pass1/core ./worker/internal/backfill/pass1
tests: TestOnFailure TestOnFailure/a_first_throttle TestOnFailure/a_throttle_before_the_last_attempt TestOnFailure/a_throttle_on_a_resumed_token TestAThrottledPageIsRetriedAndRecorded
scheduled-count: no
integration: yes

diff --git a/worker/internal/backfill/pass1/core/core.go b/worker/internal/backfill/pass1/core/core.go
index e0edc919..960bdbb5 100644
--- a/worker/internal/backfill/pass1/core/core.go
+++ b/worker/internal/backfill/pass1/core/core.go
@@ -256,7 +256,7 @@ func OnFailure(f Attempt) Next {
 		return FailRun
 	case f.Class == index.Validation && f.ResumedToken && !f.Restarted:
 		return StartOver
-	case f.Class == index.Throttled && f.Attempts < MaxAttempts:
+	case f.Class == index.Throttled && f.Attempts < 1:
 		return Backoff
 	case f.Class == index.ProviderError && f.Attempts < MaxAttempts:
 		return Retry
