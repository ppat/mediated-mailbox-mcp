control: A killed backfill run resumes from its last checkpointed page, with at most one page of rework
removes: a resumed run counts one page more than its checkpoint, so it reports a page it never made durable
packages: ./worker/internal/backfill/pass1 ./worker/internal/backfill/pass1/core
tests: TestAKilledRunResumesFromItsCheckpoint
scheduled-count: no
integration: yes

diff --git a/worker/internal/backfill/pass1/pass1.go b/worker/internal/backfill/pass1/pass1.go
index f071ac1a..7c0ae853 100644
--- a/worker/internal/backfill/pass1/pass1.go
+++ b/worker/internal/backfill/pass1/pass1.go
@@ -175,6 +175,9 @@ func Open(ctx context.Context, deps Deps, account string) (*Pass, error) {
 		return nil, fmt.Errorf("reading the account's first pass: %w", err)
 	}
 	start := core.Under(runscore.Begin(ended, stale > 0, latest), latest, stamp, stale)
+	if start.ResumedFrom != "" {
+		start.From.Checkpoint.Page++
+	}
 	if start.Skip {
 		return &Pass{deps: deps, account: account, done: true}, nil
 	}
