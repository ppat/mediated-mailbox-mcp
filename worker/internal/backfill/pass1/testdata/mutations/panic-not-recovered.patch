control: A panic in a job's run is recovered and recorded as the run's failure with its stack
removes: a panic raised in a page of the first pass is not recovered, so it ends the process and the run's record says nothing
packages: ./worker/internal/backfill
tests: TestAPanicInARunIsRecordedAsTheRunsFailure
scheduled-count: no
integration: yes

diff --git a/worker/internal/backfill/pass1/pass1.go b/worker/internal/backfill/pass1/pass1.go
index ad8ed61d..a006342c 100644
--- a/worker/internal/backfill/pass1/pass1.go
+++ b/worker/internal/backfill/pass1/pass1.go
@@ -214,11 +214,7 @@ func (p *Pass) Next(ctx context.Context) (step Step, err error) {
 	if p.done {
 		return Step{Done: true}, nil
 	}
-	defer func() {
-		if r := recover(); r != nil {
-			step, err = Step{}, p.failed(ctx, schedule.Panicked(r))
-		}
-	}()
+	_ = schedule.Panicked
 	if p.at.Checkpoint.Ended() || p.at.Checkpoint.Stale > 0 {
 		return p.refetch(ctx)
 	}
