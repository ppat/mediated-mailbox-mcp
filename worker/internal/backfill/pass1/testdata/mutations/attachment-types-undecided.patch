control: Each message the first pass or a tick stores carries its attachment types
removes: the index's decision drops each message's attachment types
packages: ./core/index ./worker/internal/backfill/pass1 ./worker/internal/deltasync/tick
tests: TestDecide TestAPassStoresEachMessagesAttachmentTypes TestATickStoresTheAttachmentTypesOfWhatItAdds
scheduled-count: no
integration: yes

diff --git a/core/index/index.go b/core/index/index.go
index b9656deb..6bb4f603 100644
--- a/core/index/index.go
+++ b/core/index/index.go
@@ -114,7 +114,7 @@ func Decide(items []mail.MessageMetadata, p policy.Composed, s scan.Scanner, l c
 			Labels:          slices.Clone(m.Labels),
 			Flags:           m.Flags,
 			HasAttachments:  m.HasAttachments,
-			AttachmentTypes: slices.Clone(m.AttachmentTypes),
+			AttachmentTypes: nil,
 			ListID:          m.ListID,
 			SizeBytes:       m.SizeBytes,
 			AuthResults:     m.AuthResults,
