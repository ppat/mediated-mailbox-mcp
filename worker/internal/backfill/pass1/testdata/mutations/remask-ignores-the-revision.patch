control: A stale subject is masked again under the scanner in force, each mask recorded under it
removes: the first pass masks a stored subject again only when its scanner version differs, so a changed configuration revision leaves it as it was
packages: ./worker/internal/backfill ./worker/internal/backfill/pass1
tests: TestAChangeOfScannerMasksAndScansAgain
scheduled-count: no
integration: yes

diff --git a/db/messages/ingest/ingest.sql b/db/messages/ingest/ingest.sql
