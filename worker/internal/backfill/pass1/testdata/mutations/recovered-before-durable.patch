control: Every backfill run is recorded with its checkpoint, counters, timeline and failed items
removes: a page is recorded as recovered in a transaction of its own as soon as it arrives, before its commit
packages: ./worker/internal/backfill/pass1
tests: TestAPageIsRecordedRecoveredOnlyOnceDurable
scheduled-count: no
integration: yes

diff --git a/worker/internal/backfill/pass1/pass1.go b/worker/internal/backfill/pass1/pass1.go
index f071ac1a..30bb5aa1 100644
--- a/worker/internal/backfill/pass1/pass1.go
+++ b/worker/internal/backfill/pass1/pass1.go
@@ -372,6 +372,10 @@ func (p *Pass) fetch(ctx context.Context) (mail.Page[mail.MessageMetadata], *Fai
 				failure.Attempts++
 				failure.Last = p.deps.Now().UTC()
 				failure.Disposition = "recovered"
+				if err := p.deps.Store.Failure(ctx, p.account, p.run, *failure); err != nil {
+					return page, nil, err
+				}
+				return page, nil, nil
 			}
 			return page, failure, nil
 		}
