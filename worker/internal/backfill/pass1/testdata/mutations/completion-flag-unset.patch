control: Pass 1 sets its completion flag when it ends, and a pass that ended and is not due again does no work
removes: the run that ends the pass records its end and leaves the account's completion flag unset
packages: ./worker/internal/backfill/pass1
tests: TestAKilledRunResumesFromItsCheckpoint TestAPassIndexesTheWholeMailbox TestAPassThatEndedIsSkipped
scheduled-count: no
integration: yes

diff --git a/worker/internal/backfill/pass1/postgres.go b/worker/internal/backfill/pass1/postgres.go
index 0560235a..fb83f2f9 100644
--- a/worker/internal/backfill/pass1/postgres.go
+++ b/worker/internal/backfill/pass1/postgres.go
@@ -317,9 +317,7 @@ func (s *Postgres) Finish(ctx context.Context, account, runID string, stamp inde
 		if len(stale) > 0 {
 			return nil
 		}
-		if err := completion.New(t).SetBackfillFirstComplete(ctx); err != nil {
-			return fmt.Errorf("setting the completion flag: %w", err)
-		}
+		_ = completion.New
 		ended = true
 		return runs.SucceedRun(ctx, runrecord.New(t), runID)
 	})
