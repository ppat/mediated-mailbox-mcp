control: A killed backfill run resumes from its last checkpointed page, with at most one page of rework
removes: a run resuming a pass whose enumeration has ended asks for the first page again rather than fetching the stale subjects and finishing
packages: ./worker/internal/backfill/pass1
tests: TestARunKilledBeforeItsEndFinishesWithoutEnumeratingAgain TestAPassReopenedAfterItsEnumerationEndedFetchesTheStaleSubjectsAgain
scheduled-count: no
integration: yes

diff --git a/worker/internal/backfill/pass1/pass1.go b/worker/internal/backfill/pass1/pass1.go
index ad8ed61d..3de26aa4 100644
--- a/worker/internal/backfill/pass1/pass1.go
+++ b/worker/internal/backfill/pass1/pass1.go
@@ -219,9 +219,6 @@ func (p *Pass) Next(ctx context.Context) (step Step, err error) {
 			step, err = Step{}, p.failed(ctx, schedule.Panicked(r))
 		}
 	}()
-	if p.at.Checkpoint.Ended() || p.at.Checkpoint.Stale > 0 {
-		return p.refetch(ctx)
-	}
 	return p.page(ctx)
 }
 
