control: A first pass whose enumeration ended fetches again by identifier only the stale subjects, masks each from the subject the provider returns, and enumerates nothing when reopened
removes: the read of the subjects to fetch again ignores a scanner version that alone differs, so a subject masked under the earlier version is never fetched again and the pass ends with it stale
packages: ./worker/internal/backfill
tests: TestAChangeOfScannerVersionAloneMasksAndScansAgain
scheduled-count: no
integration: yes

diff --git a/db/messages/ingest/ingest.sql b/db/messages/ingest/ingest.sql
index 2e264c23..85b76419 100644
--- a/db/messages/ingest/ingest.sql
+++ b/db/messages/ingest/ingest.sql
@@ -109,7 +109,7 @@ FROM messages AS m
 WHERE
     m.account_id = current_setting('app.account')
     AND (
-        m.subject_scanner_version IS DISTINCT FROM @scanner_version::int
+        false AND m.subject_scanner_version IS DISTINCT FROM @scanner_version::int
         OR m.subject_scanner_revision IS DISTINCT FROM @scanner_revision::text
     )
 ORDER BY m.message_id
diff --git a/db/messages/ingest/ingest.sql.go b/db/messages/ingest/ingest.sql.go
