control: A call fetching subjects again that leaves every one of them stale fails the run
removes: a call that stored its subjects under the pair in force is taken as having moved nothing, so every call fetching subjects again fails the run, a change of scanner that masks nothing included
packages: ./worker/internal/backfill/pass1
tests: TestAPassReopenedAfterItsEnumerationEndedFetchesTheStaleSubjectsAgain TestASubjectWhoseMessageIsGoneIsMaskedWholeAndRecordedGone TestAFetchWhoseNewScannerMasksNothingCompletes
scheduled-count: no
integration: yes

diff --git a/worker/internal/backfill/pass1/pass1.go b/worker/internal/backfill/pass1/pass1.go
index b8216cf6..d380397c 100644
--- a/worker/internal/backfill/pass1/pass1.go
+++ b/worker/internal/backfill/pass1/pass1.go
@@ -269,7 +269,7 @@ func (p *Pass) refetch(ctx context.Context) (Step, error) {
 	// A call moves the pass when it stores a subject under the pair in force, masked or not, or when
 	// fewer subjects are left stale. One that moves nothing left every subject it asked for stale, so
 	// the next read would ask for the same ones and the pass would spend from the budget without end.
-	moved := at.Counters.Refetched > from.Counters.Refetched || at.Checkpoint.Stale < from.Checkpoint.Stale
+	moved := false
 	p.at = at
 	if !moved {
 		return Step{}, p.failed(ctx, fmt.Errorf("fetching %d subjects again left every one of them stale", len(stored)))
