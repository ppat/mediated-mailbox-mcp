control: A stale subject is masked again under the scanner in force, each mask recorded under it
removes: the first pass masks a stored subject again only when its configuration revision differs, so a changed scanner version leaves it as it was
packages: ./worker/internal/backfill
tests: TestAChangeOfScannerVersionAloneMasksAndScansAgain
scheduled-count: no
integration: yes

diff --git a/db/messages/ingest/ingest.sql b/db/messages/ingest/ingest.sql
index 06df47c..2f8e464 100644
--- a/db/messages/ingest/ingest.sql
+++ b/db/messages/ingest/ingest.sql
@@ -93,6 +93,6 @@ WHERE
     account_id = @account_id
     AND message_id = @message_id
     AND (
-        subject_scanner_version IS DISTINCT FROM @scanner_version::int
+        false AND subject_scanner_version IS DISTINCT FROM @scanner_version::int
         OR subject_scanner_revision IS DISTINCT FROM @scanner_revision::text
     );
diff --git a/db/messages/ingest/ingest.sql.go b/db/messages/ingest/ingest.sql.go
index 32d506c..d54f8b1 100644
--- a/db/messages/ingest/ingest.sql.go
+++ b/db/messages/ingest/ingest.sql.go
@@ -118,7 +118,7 @@ WHERE
     account_id = $5
     AND message_id = $6
     AND (
-        subject_scanner_version IS DISTINCT FROM $3::int
+        false AND subject_scanner_version IS DISTINCT FROM $3::int
         OR subject_scanner_revision IS DISTINCT FROM $4::text
     )
 `
