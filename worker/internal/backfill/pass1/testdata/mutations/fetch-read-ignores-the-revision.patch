control: A first pass whose enumeration ended fetches again by identifier only the stale subjects, masks each from the subject the provider returns, and enumerates nothing when reopened
removes: the read of the subjects to fetch again ignores a configuration revision that alone differs, so a subject masked under the earlier revision is never fetched again and the pass ends with it stale
packages: ./worker/internal/backfill ./worker/internal/backfill/pass1
tests: TestAChangeOfScannerMasksAndScansAgain TestASubjectWhoseMessageIsGoneIsMaskedWholeAndRecordedGone
scheduled-count: no
integration: yes

diff --git a/db/messages/ingest/ingest.sql b/db/messages/ingest/ingest.sql
index 2e264c23..3f413b1d 100644
--- a/db/messages/ingest/ingest.sql
+++ b/db/messages/ingest/ingest.sql
@@ -110,7 +110,7 @@ WHERE
     m.account_id = current_setting('app.account')
     AND (
         m.subject_scanner_version IS DISTINCT FROM @scanner_version::int
-        OR m.subject_scanner_revision IS DISTINCT FROM @scanner_revision::text
+        OR false AND m.subject_scanner_revision IS DISTINCT FROM @scanner_revision::text
     )
 ORDER BY m.message_id
 LIMIT @batch_size;
