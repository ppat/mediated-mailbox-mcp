control: The worker serves the health probe and backfill's reload-failure series on its metrics endpoint
removes: backfill's policy loader registers its reload-failure series on a registry of its own, off the metrics endpoint
packages: ./worker/app ./worker/internal/backfill
tests: TestTheProbesServeTheRunsSeries TestEverySeriesTheKindEmitsCarriesItsJobKind
scheduled-count: no
integration: yes

diff --git a/worker/internal/backfill/backfill.go b/worker/internal/backfill/backfill.go
index 15cc80e4..d9d3f787 100644
--- a/worker/internal/backfill/backfill.go
+++ b/worker/internal/backfill/backfill.go
@@ -243,7 +243,7 @@ func (b *Backfill) loadPolicy(ctx context.Context, accounts []string) error {
 		return nil
 	}
 	if b.policies == nil {
-		built, err := policyload.New(b.pool, accounts, b.registry, b.lookups)
+		built, err := policyload.New(b.pool, accounts, prometheus.NewRegistry(), b.lookups)
 		if err != nil {
 			return err
 		}
