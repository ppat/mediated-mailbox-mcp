control: A worker start logs no error before its Session loads, and is ready only once the Session's first load has woken each job kind's listing
removes: backfill's listing asked before the Session loads fails rather than answering not due, so a normal start logs an error
packages: ./worker/app
tests: TestAStartLogsNoErrorAndIsReadyOnlyOnceTheSessionLoads
scheduled-count: no
integration: yes

diff --git a/worker/internal/backfill/backfill.go b/worker/internal/backfill/backfill.go
--- a/worker/internal/backfill/backfill.go
+++ b/worker/internal/backfill/backfill.go
@@ -171,7 +171,13 @@ func build(p process.Capabilities, pool *pgxpool.Pool, s *sessions.Session, conn
 // dropped with the account's series (ADR-0090, ADR-0119).
 func (b *Backfill) plan() schedule.Plan {
 	return schedule.Plan{
-		Keys:    func(context.Context) ([]string, error) { return b.session.Workable() },
+		Keys: func(context.Context) ([]string, error) {
+			listed, err := b.session.Workable()
+			if errors.Is(err, sessions.ErrNotRead) {
+				return nil, errors.New("the Session has not loaded")
+			}
+			return listed, err
+		},
 		Recheck: b.interval,
 		Backoff: backoff,
 		Late:    lateReloads * b.interval,
