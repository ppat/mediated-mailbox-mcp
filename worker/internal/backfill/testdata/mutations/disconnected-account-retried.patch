control: A credential the provider refuses is read again from the account's row before the refusal is reported, and a replaced one is used for the call it refused
removes: an account whose row no longer holds a credential has the call made again with an empty one
packages: ./worker/internal/backfill
tests: TestARefusalOfTheStoredCredentialIsReported/the_account_disconnected
scheduled-count: no
integration: yes

diff --git a/executioncontext/session/session.go b/executioncontext/session/session.go
index bd3fc28..a5ae138 100644
--- a/executioncontext/session/session.go
+++ b/executioncontext/session/session.go
@@ -251,7 +251,7 @@ func Call[T any](ctx context.Context, s *Session, call func(context.Context, mai
 	refused := s.built
 	refused.Credential = s.source.Credential()
 	creds := credentials(reread)
-	if !reread.Connected() || same(creds, refused) {
+	if same(creds, refused) {
 		return out, err
 	}
 	source := s.connector.source(creds)
