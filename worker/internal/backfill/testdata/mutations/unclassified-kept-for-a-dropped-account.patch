control: An account's series go once the work that sets them ends
removes: backfill's unclassified series of an account stays once its job is dropped
packages: ./worker/app
tests: TestAnAccountsSeriesGoWithItsWork
scheduled-count: no
integration: yes

diff --git a/worker/internal/backfill/backfill.go b/worker/internal/backfill/backfill.go
index 0210ff03..dbbf9794 100644
--- a/worker/internal/backfill/backfill.go
+++ b/worker/internal/backfill/backfill.go
@@ -190,7 +190,6 @@ func (b *Backfill) plan() schedule.Plan {
 // so nothing sets them again.
 func (b *Backfill) dropped(account string) {
 	b.logger.Info("an account is no longer listed, so its backfill stops", "account", account)
-	b.first.Forget(account)
 	b.backlog.Forget(account)
 }
 
