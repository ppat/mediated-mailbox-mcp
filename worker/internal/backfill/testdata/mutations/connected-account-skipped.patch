control: A run serves only a connected account whose provider it has an adapter for and that connects through an OAuth client
removes: the connected accounts are skipped and the ones that are not connected are served
packages: ./worker/internal/backfill
tests: TestARunTakesItsAccountsFromTheDatabase
scheduled-count: no
integration: yes

diff --git a/executioncontext/session/session.go b/executioncontext/session/session.go
index f4fb328a..3192fd3e 100644
--- a/executioncontext/session/session.go
+++ b/executioncontext/session/session.go
@@ -129,7 +129,7 @@ func credentials(a accountload.Account) Credentials {
 func (h *Holder) Accounts(snapshot *accountload.Snapshot) []string {
 	var out []string
 	for _, a := range snapshot.Accounts() {
-		if !a.Connected() {
+		if a.Connected() {
 			h.config.Logger.Warn("an account is not connected, so it is skipped", "account", a.ID())
 			continue
 		}
