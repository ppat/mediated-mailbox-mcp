control: Each page of a run takes the active policy
removes: a run takes the account's policy once at its start, so a policy edit reaches it only at its next run
packages: ./worker/internal/backfill
tests: TestEachPageTakesTheActivePolicy
scheduled-count: no
integration: yes

diff --git a/worker/internal/backfill/backfill.go b/worker/internal/backfill/backfill.go
index b3ae520..f4f7b28 100644
--- a/worker/internal/backfill/backfill.go
+++ b/worker/internal/backfill/backfill.go
@@ -248,7 +248,8 @@ func (b *Backfill) job(account string) schedule.Job {
 // policyFor returns the account's policy in the active policy snapshot, which each page takes at its
 // entry (ADR-0041, ADR-0119).
 func (b *Backfill) policyFor(account string) func() classify.Policy {
-	return func() classify.Policy { return b.context.Policy(account) }
+	p := b.context.Policy(account)
+	return func() classify.Policy { return p }
 }
 
