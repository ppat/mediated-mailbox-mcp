control: Each page of a run takes the active policy
removes: a run takes the account's policy once, when its passes' dependencies are built, so a policy edit reaches it only at its next run
packages: ./worker/app
tests: TestEachPageTakesThePolicyInForce
scheduled-count: no
integration: yes

diff --git a/worker/internal/backfill/backfill.go b/worker/internal/backfill/backfill.go
--- a/worker/internal/backfill/backfill.go
+++ b/worker/internal/backfill/backfill.go
@@ -210,7 +210,8 @@ func (b *Backfill) job(account string) schedule.Job {
 // policyFor returns the account's policy in the policy the Session has in force, which each page
 // takes at its entry (ADR-0041, ADR-0119).
 func (b *Backfill) policyFor(account string) func() classify.Policy {
-	return func() classify.Policy { return b.session.Policy(account) }
+	policy := b.session.Policy(account)
+	return func() classify.Policy { return policy }
 }
 
 // run asks the account's due decision and does the work it names. The run-start step returns the
