control: A rotated refresh token is handed to the account snapshot library after every page, a page that failed included, and a failed write-back ends the pass in an error
removes: the hand-over hands over the source the run started with, so a source a re-read replaced is never handed over
packages: ./worker/internal/backfill
tests: TestARotationAfterARereadIsWrittenBack
scheduled-count: no
integration: yes

diff --git a/executioncontext/session/session.go b/executioncontext/session/session.go
index bd3fc28..6e8e130 100644
--- a/executioncontext/session/session.go
+++ b/executioncontext/session/session.go
@@ -184,7 +184,7 @@ func (h *Holder) Open(snapshot *accountload.Snapshot, account string) (*Session,
 	if err != nil {
 		return nil, err
 	}
-	return &Session{h: h, account: account, connector: connector, built: creds, adoption: a.Adoption(), source: source, port: port}, nil
+	return &Session{h: h, account: account, connector: connector, built: creds, adoption: a.Adoption(), source: source, opened: source, port: port}, nil
 }
 
 // source returns the account's source for creds, the one it holds when Hold is set and creds are the
@@ -228,6 +228,7 @@ type Session struct {
 	// the hand-over names so a credential someone else replaced since is never put back (ADR-0089).
 	adoption uint64
 	source   Source
+	opened   Source
 	port     mail.Port[context.Context]
 }
 
@@ -271,7 +272,7 @@ func Call[T any](ctx context.Context, s *Session, call func(context.Context, mai
 // It returns the hand-over's error and the recording's apart, for the caller to return or log. A
 // session may end several units of work, one after each.
 func (s *Session) End(ctx context.Context) (handOver, record error) {
-	_, handOver = s.h.config.Loader.HandOver(ctx, s.account, s.adoption, s.source.Credential())
+	_, handOver = s.h.config.Loader.HandOver(ctx, s.account, s.adoption, s.opened.Credential())
 	return handOver, recordAttempt(ctx, s.h.config.DB, s.account, s.source.LastAttempt())
 }
 
