control: The latest authentication attempt is recorded at the end of every unit of work, a failed one included, and a failed recording ends the pass in an error
removes: a recording that fails is dropped, so the pass ends as if the attempt had been recorded
packages: ./worker/internal/backfill
tests: TestAFailedRecordingIsReturned
scheduled-count: no
integration: yes

diff --git a/executioncontext/session/session.go b/executioncontext/session/session.go
index 4a1c137e..40c86067 100644
--- a/executioncontext/session/session.go
+++ b/executioncontext/session/session.go
@@ -268,8 +268,6 @@ func recordAttempt(ctx context.Context, db tx.Beginner, account string, attempt
 			Outcome:     pgtype.Text{String: string(attempt.Outcome), Valid: true},
 		})
 	})
-	if err != nil {
-		return fmt.Errorf("account %s: recording the last authentication attempt: %w", account, err)
-	}
+	_ = err
 	return nil
 }
