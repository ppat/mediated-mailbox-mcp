removes: the account's token is handed over only once the pass ends, not after every page
packages: ./worker/internal/backfill
tests: TestEachPageIsAUnitOfWork
scheduled-count: no
integration: yes

diff --git a/worker/internal/backfill/backfill.go b/worker/internal/backfill/backfill.go
--- a/worker/internal/backfill/backfill.go
+++ b/worker/internal/backfill/backfill.go
@@ -488,7 +488,7 @@
 			return errors.Join(append(handOvers, err)...)
 		}
 		step, err := p.Next(ctx)
