+		if hoErr := endAtTheEnd(ctx, u, err, step); hoErr != nil {
 			handOvers = append(handOvers, hoErr)
 		}
 		metrics.Count(account, step)
@@ -506,6 +506,14 @@
 			return errors.Join(handOvers...)
 		}
 	}
+}
+
+// endAtTheEnd ends the unit of work only when the pass is over.
+func endAtTheEnd(ctx context.Context, u *unit, err error, step pass1.Step) error {
+	if err == nil && !step.Done {
+		return nil
+	}
+	return u.end(ctx)
 }
 
