control: A rotated refresh token is handed to the account snapshot library after every page, a page that failed included, and a failed write-back ends the pass in an error
removes: the account's token is handed over only once the pass ends, not after every page
packages: ./worker/internal/backfill
tests: TestEachPageIsAUnitOfWork
scheduled-count: no
integration: yes
diff --git a/worker/internal/backfill/backfill.go b/worker/internal/backfill/backfill.go
index 0d1a5540..7993455c 100644
--- a/worker/internal/backfill/backfill.go
+++ b/worker/internal/backfill/backfill.go
@@ -540,40 +540,48 @@ func passAccount(ctx context.Context, deps pass1.Deps, account string, metrics *
 	logger.Info("the first pass runs", "run", p.Run(), "page", p.Progress().Checkpoint.Page)
 	var handOvers []error
 	for {
 		if err := ctx.Err(); err != nil {
 			return errors.Join(append(handOvers, err)...)
 		}
 		if err := u.open(); err != nil {
 			return errors.Join(append(handOvers, err)...)
 		}
 		step, err := p.Next(ctx)
-		if hoErr := u.end(ctx); hoErr != nil {
+		if hoErr := endAtTheEnd(ctx, u, err, step); hoErr != nil {
 			handOvers = append(handOvers, hoErr)
 		}
 		metrics.Count(account, step)
 		if err != nil {
 			logger.Error("the first pass failed", "run", p.Run(), "error", err)
 			return errors.Join(append(handOvers, err)...)
 		}
 		ask.Progressed()
 		at := p.Progress()
 		logger.Info("step made durable", "run", p.Run(), "page", at.Checkpoint.Page, "messages", at.Counters.Messages,
 			"refetched", at.Counters.Refetched, "stale", at.Checkpoint.Stale)
 		if step.Done {
 			logger.Info("the first pass ended", "run", p.Run(), "pages", at.Counters.Pages, "messages", at.Counters.Messages,
 				"refetched", at.Counters.Refetched)
 			return errors.Join(handOvers...)
 		}
 	}
 }
 
+// endAtTheEnd ends the unit of work only when the pass is over.
+func endAtTheEnd(ctx context.Context, u *unit, err error, step pass1.Step) error {
+	if err == nil && !step.Done {
+		return nil
+	}
+	return u.end(ctx)
+}
+
 // leasedBody returns the body fetch the second pass uses, port's body read under leases in the batch
 // class, a second call naming a part held apart (ADR-0025, ADR-0131).
 func leasedBody(limiter *lease.Limiter, port mail.Port[context.Context], account string) pass2.Body {
 	return func(ctx context.Context, id string) (mail.MessageBody, error) {
 		return lease.Body(ctx, limiter, port, account, ratecore.Batch, id)
 	}
 }
 
