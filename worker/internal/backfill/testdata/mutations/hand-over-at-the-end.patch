control: A rotated refresh token is handed to the account snapshot library after every page, a page that failed included, and a failed write-back ends the pass in an error
removes: the account's unit of work is ended only once the first pass ends or fails, not after every page
packages: ./worker/internal/backfill
tests: TestEachPageIsAUnitOfWork
scheduled-count: no
integration: yes

diff --git a/worker/internal/backfill/backfill.go b/worker/internal/backfill/backfill.go
--- a/worker/internal/backfill/backfill.go
+++ b/worker/internal/backfill/backfill.go
@@ -449,9 +449,9 @@ func passAccount(ctx context.Context, deps pass1.Deps, account string, metrics *
 		if err := u.open(); err != nil {
 			return errors.Join(append(handOvers, err)...)
 		}
 		step, err := p.Next(ctx)
-		if hoErr := u.end(ctx); hoErr != nil {
+		if hoErr := endAtTheEnd(ctx, u, err, step); hoErr != nil {
 			handOvers = append(handOvers, hoErr)
 		}
 		metrics.Count(account, step)
 		if err != nil {
@@ -469,8 +469,16 @@ func passAccount(ctx context.Context, deps pass1.Deps, account string, metrics *
 		}
 	}
 }
 
+// endAtTheEnd ends the unit of work only when the pass is over.
+func endAtTheEnd(ctx context.Context, u units, err error, step pass1.Step) error {
+	if err == nil && !step.Done {
+		return nil
+	}
+	return u.end(ctx)
+}
+
 // secondPassAccount runs the second pass over one account a page at a time. Each page opens the
 // account's unit of work first and ends it after, then sets the account's scan backlog, which is
 // removed once the pass ends, and a page made durable is the job's success. It logs counts and identifiers, never a body (ADR-0009). It
 // stops at a page boundary once ctx ends.
