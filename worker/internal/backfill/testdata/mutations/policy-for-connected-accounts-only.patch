control: Each reload loads the account snapshot, and a failed read keeps the previous one
removes: the policy is loaded only for the accounts the kind serves rather than every listed one
packages: ./worker/internal/backfill
tests: TestARunTakesItsAccountsFromTheDatabase
scheduled-count: no
integration: yes

diff --git a/executioncontext/assembly/assembly.go b/executioncontext/assembly/assembly.go
index d74efe4..78c70a2 100644
--- a/executioncontext/assembly/assembly.go
+++ b/executioncontext/assembly/assembly.go
@@ -169,7 +169,15 @@ func (c *Context) Reload(ctx context.Context) error {
 	snapshot := c.loader.Snapshot()
 	targets := c.readTargets(ctx, snapshot)
 	var err error
-	if policyErr := c.loadPolicy(ctx, idsOf(snapshot)); policyErr != nil {
+	if policyErr := c.loadPolicy(ctx, func() []string {
+		var connected []string
+		for _, a := range snapshot.Accounts() {
+			if a.Connected() {
+				connected = append(connected, a.ID())
+			}
+		}
+		return connected
+	}()); policyErr != nil {
 		err = fmt.Errorf("%w: %w", ErrPolicyNotLoaded, policyErr)
 	}
 	c.latest.Store(&Reloaded{snapshot: snapshot, targets: targets, loaded: true, err: err})
