control: The latest authentication attempt is recorded at the end of every unit of work, a failed one included, and a failed recording ends the pass in an error
removes: the end of a unit of work records the attempt but drops a recording that fails
packages: ./worker/internal/backfill
tests: TestTheRunsHandOverReturnsAFailedRecording
scheduled-count: no
integration: yes

diff --git a/worker/internal/backfill/backfill.go b/worker/internal/backfill/backfill.go
--- a/worker/internal/backfill/backfill.go
+++ b/worker/internal/backfill/backfill.go
@@ -364,9 +364,9 @@
 	if u.current == nil {
 		return nil
 	}
-	handOver, record := u.current.End(ctx)
+	handOver, _ := u.current.End(ctx)
 	u.current = nil
-	return errors.Join(handOver, record)
+	return handOver
 }
 
 // fetch returns the first pass's enumeration over the unit's session, under a lease (ADR-0025). A
