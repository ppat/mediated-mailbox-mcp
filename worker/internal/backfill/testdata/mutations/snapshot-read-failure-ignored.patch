control: Each reload loads the account snapshot, and a failed read keeps the previous one
removes: a failed read of the execution context's reload is ignored, so the kind goes on with the previous snapshot as if it were fresh and reports nothing
packages: ./worker/internal/backfill
tests: TestAFailedSnapshotReadKeepsThePreviousSnapshot
scheduled-count: no
integration: yes

diff --git a/worker/internal/backfill/backfill.go b/worker/internal/backfill/backfill.go
index d2e991c..28d6a43 100644
--- a/worker/internal/backfill/backfill.go
+++ b/worker/internal/backfill/backfill.go
@@ -198,8 +198,8 @@ func (b *Backfill) reload(ctx context.Context, _ schedule.Ask) error {
 		return schedule.ErrNotDue
 	}
 	policyErr := latest.Err()
-	if policyErr != nil && !errors.Is(policyErr, assembly.ErrPolicyNotLoaded) {
-		return policyErr
+	if !errors.Is(policyErr, assembly.ErrPolicyNotLoaded) {
+		policyErr = nil
 	}
 	snapshot := latest.Snapshot()
 	listed := b.sessions.Accounts(snapshot)
