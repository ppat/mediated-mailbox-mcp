control: Each account spends under the lowered target its state row sets, and a target outside its range stops the run
removes: the run builds its limiter without the targets its accounts' state rows set
packages: ./worker/internal/backfill
tests: TestTheLimiterSpendsUnderTheStoredTarget TestAStoredTargetAboveHalfTheCeilingStopsTheRun
scheduled-count: no
integration: yes

diff --git a/worker/internal/backfill/backfill.go b/worker/internal/backfill/backfill.go
--- a/worker/internal/backfill/backfill.go
+++ b/worker/internal/backfill/backfill.go
@@ -571,7 +571,8 @@
 	if err != nil {
 		return nil, err
 	}
-	limiter, err := lease.NewWithTargets(pool, gmail.Profile{}.BudgetPerSecond(), targets, metrics)
+	_ = targets
+	limiter, err := lease.NewWithTargets(pool, gmail.Profile{}.BudgetPerSecond(), nil, metrics)
 	if err != nil {
 		return nil, fmt.Errorf("building the rate limiter: %w", err)
 	}
