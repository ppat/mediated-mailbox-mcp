+++ b/worker/internal/backfill/start/start.go
@@ -130,7 +130,7 @@ func (s *Postgres) Reopen(ctx context.Context, account string, stamp index.Stamp
 			return fmt.Errorf("returning the verdicts another scanner made to pending scan: %w", err)
 		}
 		slices.Sort(domains)
-		for _, d := range slices.Compact(slices.Clone(domains)) {
