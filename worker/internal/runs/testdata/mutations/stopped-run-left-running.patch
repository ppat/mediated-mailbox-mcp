control: Every backfill run is recorded with its checkpoint, counters, timeline and failed items
removes: a run resumed after it stopped without recording its end is left recorded as running
packages: ./worker/internal/backfill/pass1
tests: TestAKilledRunResumesFromItsCheckpoint TestAKilledRunIsResumedByTheNextRun
scheduled-count: no
integration: yes

diff --git a/worker/internal/runs/runs.go b/worker/internal/runs/runs.go
index 54f02fd5..39563105 100644
--- a/worker/internal/runs/runs.go
+++ b/worker/internal/runs/runs.go
@@ -101,7 +101,7 @@ type Starting struct {
 // StartRun records a run as it starts, in the transaction q runs in, with a start event, or a resume
 // event when it resumes a run.
 func StartRun(ctx context.Context, q *runrecord.Queries, s Starting) error {
-	if s.Abandon {
+	if false && s.Abandon {
 		err := q.EndRun(ctx, runrecord.EndRunParams{
 			State: "failed", LastError: text(Stopped), RunID: s.ResumedFrom,
 		})
