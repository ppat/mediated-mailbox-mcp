control: Every backfill run is recorded with its checkpoint, counters, timeline and failed items
removes: a backfill run's progress, recorded through runs.RecordProgress, records its checkpoint and no progress event
packages: ./worker/internal/backfill/pass1
tests: TestAPassIndexesTheWholeMailbox TestAKilledRunIsResumedByTheNextRun TestAThrottledPageIsRetriedAndRecorded TestAPassStartedOverCountsNothingTwice
scheduled-count: no
integration: yes

diff --git a/worker/internal/runs/runs.go b/worker/internal/runs/runs.go
index 54f02fd5..5a99eb7f 100644
--- a/worker/internal/runs/runs.go
+++ b/worker/internal/runs/runs.go
@@ -129,7 +129,7 @@ func RecordProgress(ctx context.Context, q *runrecord.Queries, runID string, che
 	if err := q.RecordProgress(ctx, runrecord.RecordProgressParams{Checkpoint: checkpoint, Counters: counters, RunID: runID}); err != nil {
 		return fmt.Errorf("recording the checkpoint: %w", err)
 	}
-	return q.RecordEvent(ctx, runrecord.RecordEventParams{RunID: runID, Kind: "progress", Page: page.stored()})
+	return nil
 }
 
 // SucceedRun records that the run ended its pass, with a finish event.
