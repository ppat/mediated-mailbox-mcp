packages: ./worker/internal/runs/core ./worker/internal/backfill ./worker/internal/backfill/pass1 ./worker/internal/backfill/pass2
tests: TestBegin TestAChangeOfScannerMasksAndScansAgain
scheduled-count: no
integration: yes

diff --git a/worker/internal/runs/core/core.go b/worker/internal/runs/core/core.go
