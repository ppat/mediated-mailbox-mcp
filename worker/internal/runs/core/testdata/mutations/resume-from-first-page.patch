control: A killed backfill run resumes from its last checkpointed page, with at most one page of rework
removes: a resumed run starts from the first page, dropping the checkpoint and counters of the run it resumes
packages: ./worker/internal/backfill/pass1 ./worker/internal/runs/core
tests: TestAKilledRunResumesFromItsCheckpoint TestAKilledRunIsResumedByTheNextRun TestBegin
scheduled-count: no
integration: yes

diff --git a/worker/internal/runs/core/core.go b/worker/internal/runs/core/core.go
index 9745efe4..6d7bff0b 100644
--- a/worker/internal/runs/core/core.go
+++ b/worker/internal/runs/core/core.go
@@ -58,7 +58,7 @@ func Begin[P any](ended, due bool, latest Latest[P]) Start[P] {
 	case !latest.Found || latest.State == Succeeded:
 		return Start[P]{Reopen: ended}
 	default:
-		return Start[P]{Reopen: ended, ResumedFrom: latest.RunID, Abandon: latest.State == Running, From: latest.Progress}
+		return Start[P]{Reopen: ended, ResumedFrom: latest.RunID, Abandon: latest.State == Running}
 	}
 }
 
