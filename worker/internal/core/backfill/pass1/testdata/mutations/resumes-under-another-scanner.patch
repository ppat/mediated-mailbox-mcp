control: A run resuming an enumeration not yet ended that was made under another scanner starts it over from the first page
removes: a run resumes an enumeration not yet ended that was made under another scanner from its checkpoint
packages: ./worker/internal/core/backfill/pass1 ./worker/internal/backfill/pass1
tests: TestUnder TestAKilledRunResumesFromItsCheckpoint
scheduled-count: no
integration: yes

diff --git a/worker/internal/core/backfill/pass1/pass1.go b/worker/internal/core/backfill/pass1/pass1.go
index b786cf1e..ac6b3c60 100644
--- a/worker/internal/core/backfill/pass1/pass1.go
+++ b/worker/internal/core/backfill/pass1/pass1.go
@@ -144,7 +144,7 @@ func Under(start Start[Progress], latest Latest[Progress], s index.Stamp, stale
 		start.From = Progress{Checkpoint: Checkpoint{Page: ended.Page, Of: ended.Of}}
 	}
 	at := start.From.Checkpoint
-	over := !at.Ended() && at.Stamp != s && at.Page > 0
+	over := false && !at.Ended() && at.Stamp != s && at.Page > 0
 	if over {
 		start.From = Restart(start.From)
 	}
