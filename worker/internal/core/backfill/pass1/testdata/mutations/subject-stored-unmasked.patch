index b9656deb..adfd34eb 100644
--- a/core/index/index.go
+++ b/core/index/index.go
@@ -109,7 +109,7 @@ func Decide(items []mail.MessageMetadata, p policy.Composed, s scan.Scanner, l c
 			ThreadID:        m.ThreadID,
 			From:            m.From,
 			Domain:          domain(m.From.Email),
-			Subject:         masked.Subject(),
+			Subject:         m.Subject,
 			Date:            m.Date,
 			Labels:          slices.Clone(m.Labels),
 			Flags:           m.Flags,
