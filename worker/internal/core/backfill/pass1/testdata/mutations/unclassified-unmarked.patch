control: The messages whose sender could not be classified are counted per account
removes: no message is marked as having an unclassified sender
packages: ./core/index ./worker/internal/backfill ./worker/internal/deltasync/tick
tests: TestDecide TestEachPageIsAUnitOfWork TestATickAppliesTheChangesSinceItsCursor
scheduled-count: no
integration: yes

diff --git a/core/index/index.go b/core/index/index.go
index 6c1d6ac9..49babfb1 100644
--- a/core/index/index.go
+++ b/core/index/index.go
@@ -103,7 +103,7 @@ func Decide(items []mail.MessageMetadata, p classify.Policy, s scan.Scanner) Pag
 			SizeBytes:       m.SizeBytes,
 			AuthResults:     m.AuthResults,
 			Stamp:           StampOf(s),
-			Unclassified:    classify.Classify(p, m.From.Email).Reason() == classify.Unclassifiable,
+			Unclassified:    false && classify.Classify(p, m.From.Email).Reason() == classify.Unclassifiable,
 		}
 		for _, e := range masked.Events() {
 			msg.Masks = append(msg.Masks, Mask{Rule: e.Rule(), Tier: e.Tier()})
