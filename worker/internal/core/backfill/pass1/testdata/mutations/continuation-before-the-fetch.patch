control: A run resuming an enumeration not yet ended that was made under another scanner continues it from its checkpoint under the scanner in force
removes: a run records the stale subjects it has to fetch only once its enumeration has ended, so it continues an enumeration not yet ended before it fetches the subjects stored masked under another scanner
packages: ./worker/internal/core/backfill/pass1 ./worker/internal/backfill/pass1 ./worker/internal/backfill
tests: TestUnder TestAnEnumerationUnderWayContinuesUnderANewScanner TestAKilledRunResumesFromItsCheckpoint TestAChangeOfScannerContinuesAnEnumerationUnderWay
scheduled-count: no
integration: yes

diff --git a/worker/internal/core/backfill/pass1/pass1.go b/worker/internal/core/backfill/pass1/pass1.go
index 41e005f0..cc6cec2d 100644
--- a/worker/internal/core/backfill/pass1/pass1.go
+++ b/worker/internal/core/backfill/pass1/pass1.go
@@ -149,7 +149,10 @@ func Under(start Start[Progress], latest Latest[Progress], s index.Stamp, stale
 		start.From = Progress{Checkpoint: Checkpoint{Page: ended.Page, Of: ended.Of}}
 	}
 	start.From.Checkpoint.Stamp = s
-	start.From.Checkpoint.Stale = stale
+	start.From.Checkpoint.Stale = 0
+	if start.From.Checkpoint.Ended() {
+		start.From.Checkpoint.Stale = stale
+	}
 	return start
 }
 
