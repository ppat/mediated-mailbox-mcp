control: A run resuming an enumeration not yet ended that was made under another scanner continues it from its checkpoint under the scanner in force
removes: a run continuing an enumeration not yet ended that was made under another scanner drops the estimate of the pages the enumeration takes, so the card shows no estimate until the next page
packages: ./worker/internal/core/backfill/pass1 ./worker/internal/backfill/pass1
tests: TestUnder TestAnEnumerationUnderWayContinuesUnderANewScanner
scheduled-count: no
integration: yes

diff --git a/worker/internal/core/backfill/pass1/pass1.go b/worker/internal/core/backfill/pass1/pass1.go
index 41e005f0..59ddee7e 100644
--- a/worker/internal/core/backfill/pass1/pass1.go
+++ b/worker/internal/core/backfill/pass1/pass1.go
@@ -148,6 +148,9 @@ func Under(start Start[Progress], latest Latest[Progress], s index.Stamp, stale
 		ended := latest.Progress.Checkpoint
 		start.From = Progress{Checkpoint: Checkpoint{Page: ended.Page, Of: ended.Of}}
 	}
+	if at := start.From.Checkpoint; !at.Ended() && at.Stamp != s {
+		start.From.Checkpoint.Of = 0
+	}
 	start.From.Checkpoint.Stamp = s
 	start.From.Checkpoint.Stale = stale
 	return start
