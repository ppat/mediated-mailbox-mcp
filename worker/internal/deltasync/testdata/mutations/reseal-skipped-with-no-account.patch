control: A reload re-seals what was sealed to an old key, an OAuth client's secret included, whether or not any account is listed
removes: a listing that finds no account re-seals nothing and sets no key-scan series
packages: ./worker/app
tests: TestDeltaSyncsListingReSealsWhatWasOpenedWithAnOldKey
scheduled-count: no
integration: yes

diff --git a/worker/internal/deltasync/deltasync.go b/worker/internal/deltasync/deltasync.go
index 4ec4208c..296308b7 100644
--- a/worker/internal/deltasync/deltasync.go
+++ b/worker/internal/deltasync/deltasync.go
@@ -184,7 +184,9 @@ func (d *DeltaSync) list(ctx context.Context) ([]string, error) {
 	if err != nil {
 		return nil, err
 	}
-	d.keyScan.Set(d.conns.Reseal(ctx))
+	if len(listed) > 0 {
+		d.keyScan.Set(d.conns.Reseal(ctx))
+	}
 	return listed, nil
 }
 
