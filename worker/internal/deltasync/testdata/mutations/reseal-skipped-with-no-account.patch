control: A reload re-seals what was sealed to an old key, an OAuth client's secret included, whether or not any account is listed
removes: a reload that lists no account re-seals nothing and sets no key-scan series
packages: ./worker/internal/deltasync
tests: TestAReloadWithNoAccountReSealsAClientSecretOnAnOldKey
scheduled-count: no
integration: yes

diff --git a/worker/internal/deltasync/deltasync.go b/worker/internal/deltasync/deltasync.go
--- a/worker/internal/deltasync/deltasync.go
+++ b/worker/internal/deltasync/deltasync.go
@@ -197,8 +197,10 @@
 	if err := d.loader.Load(ctx); err != nil {
 		return fmt.Errorf("loading the accounts: %w", err)
 	}
-	d.loader.Reseal(ctx)
-	d.keyScan.Set(d.loader.ResealClients(ctx, reseal.Writer(d.config.Pool)))
+	if len(d.loader.Snapshot().Accounts()) > 0 {
+		d.loader.Reseal(ctx)
+		d.keyScan.Set(d.loader.ResealClients(ctx, reseal.Writer(d.config.Pool)))
+	}
 	snapshot := d.loader.Snapshot()
 	listed := d.sessions.Accounts(snapshot)
 	policyErr := d.loadPolicy(ctx, ids(snapshot))
