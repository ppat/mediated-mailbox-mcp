control: Delta sync runs until stopped and serves every series between ticks
removes: the rate limiter's series are registered on a registry the metrics endpoint does not serve
packages: ./worker/app ./worker/internal/deltasync
tests: TestTheProbesServeEverySeriesBetweenTicks TestEverySeriesTheKindEmitsCarriesItsJobKind
scheduled-count: no
integration: yes

diff --git a/worker/internal/deltasync/deltasync.go b/worker/internal/deltasync/deltasync.go
--- a/worker/internal/deltasync/deltasync.go
+++ b/worker/internal/deltasync/deltasync.go
@@ -169,7 +169,7 @@ func build(c Config, connectors map[string]session.Connector) (*DeltaSync, error
 	if err != nil {
 		return nil, err
 	}
-	leases, err := ratelimit.NewMetrics(c.Registry)
+	leases, err := ratelimit.NewMetrics(prometheus.NewRegistry())
 	if err != nil {
 		return nil, err
 	}
