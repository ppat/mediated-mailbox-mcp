control: An account's series go once the work that sets them ends
removes: delta sync's tick series of an account stay once its job is dropped
packages: ./worker/app
tests: TestAnAccountsSeriesGoWithItsWork
scheduled-count: no
integration: yes

diff --git a/worker/internal/deltasync/deltasync.go b/worker/internal/deltasync/deltasync.go
index 4ec4208c..d66733a4 100644
--- a/worker/internal/deltasync/deltasync.go
+++ b/worker/internal/deltasync/deltasync.go
@@ -192,7 +192,6 @@ func (d *DeltaSync) list(ctx context.Context) ([]string, error) {
 // returned, so nothing sets them again.
 func (d *DeltaSync) dropped(account string) {
 	d.logger.Info("an account is no longer listed, so its delta sync stops", "account", account)
-	d.ticks.Forget(account)
 }
 
 // job returns the account's job, asked on the sync interval's phase and holding the kind's limit. Its
