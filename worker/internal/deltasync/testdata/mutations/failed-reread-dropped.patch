control: A credential the provider refuses is read again from its row before the refusal is reported
removes: a failed read of the refused credential is dropped and the refusal returned alone
packages: ./worker/internal/deltasync
tests: TestAFailedReadOfTheRefusedCredentialIsReported
scheduled-count: no
integration: yes

diff --git a/executioncontext/session/session.go b/executioncontext/session/session.go
index bd3fc28..5a72fe6 100644
--- a/executioncontext/session/session.go
+++ b/executioncontext/session/session.go
@@ -246,7 +246,7 @@ func Call[T any](ctx context.Context, s *Session, call func(context.Context, mai
 	}
 	reread, rerr := s.h.config.Loader.Reread(ctx, s.account)
 	if rerr != nil {
-		return out, errors.Join(err, fmt.Errorf("reading the refused credential again: %w", rerr))
+		return out, err
 	}
 	refused := s.built
 	refused.Credential = s.source.Credential()
