control: Delta sync decides under backfill's gate thresholds and records backfill's scanner version and revision
removes: delta sync's gate decides under thresholds of its own
packages: ./worker/internal/deltasync
tests: TestATickDecidesUnderBackfillsThresholdsAndScanner
scheduled-count: no
integration: yes

diff --git a/worker/internal/deltasync/deltasync.go b/worker/internal/deltasync/deltasync.go
--- a/worker/internal/deltasync/deltasync.go
+++ b/worker/internal/deltasync/deltasync.go
@@ -282,7 +282,7 @@ func (d *DeltaSync) tickDeps(provider tick.Provider, policy classify.Policy) tic
 		Store:       tick.NewPostgres(d.pool),
 		Provider:    provider,
 		Policy:      policy,
-		Gate:        scangate.DefaultConfig(),
+		Gate:        scangate.Config{SmallBytes: 1, RecentAgeMillis: 1, LowVolume: 1, HighVolume: 1},
 		Scanner:     d.scanner,
 		Processing:  d.processing,
 		FirstWindow: d.firstWindow,
