control: An account's tick runs only once its sync interval has passed since the last
removes: a tick is due whenever it is asked, before its interval has passed included
packages: ./worker/internal/deltasync/core
tests: TestDeltaSyncsDueDecision TestDeltaSyncsDueDecision/asked_a_moment_before_the_interval_has_passed TestDeltaSyncsDueDecision/asked_at_the_end_of_a_backoff_after_a_failed_tick TestDeltaSyncsDueDecision/asked_at_once_again
scheduled-count: no

diff --git a/worker/internal/deltasync/core/core.go b/worker/internal/deltasync/core/core.go
index 82a847d1..4e2ecf6a 100644
--- a/worker/internal/deltasync/core/core.go
+++ b/worker/internal/deltasync/core/core.go
@@ -13,5 +13,5 @@ import "github.com/ppat/mediated-mailbox-mcp/core/mail"
 // whatever delayed each one's start. A tick asked off the phase, at a backoff's end, is recorded at
 // the time on the phase before it, so the ticker's next tick is due.
 func Decide(ticked bool, last, at mail.UnixMilli, intervalMillis int64) bool {
-	return !ticked || int64(at-last) >= intervalMillis
+	return true
 }
