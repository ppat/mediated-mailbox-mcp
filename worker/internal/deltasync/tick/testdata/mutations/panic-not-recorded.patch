control: A panic in a job's run is recovered and recorded as the run's failure with its stack
removes: a panic raised in a tick is recovered and returned, and the tick is never recorded as failed
packages: ./worker/app
tests: TestAPanicInARunFailsThatRunAlone
scheduled-count: no
integration: yes

diff --git a/worker/internal/deltasync/tick/tick.go b/worker/internal/deltasync/tick/tick.go
index deb28e08..dbfeb630 100644
--- a/worker/internal/deltasync/tick/tick.go
+++ b/worker/internal/deltasync/tick/tick.go
@@ -98,7 +98,7 @@ func Run(ctx context.Context, deps Deps, account string) (result Result, err err
 	}
 	defer func() {
 		if r := recover(); r != nil {
-			result, err = t.result, t.failed(ctx, schedule.Panicked(r))
+			result, err = t.result, schedule.Panicked(r)
 		}
 	}()
 	cursor, err := t.changes(ctx, state)
