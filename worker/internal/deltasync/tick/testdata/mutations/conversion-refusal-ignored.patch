control: A body the port or the conversion refuses is recorded refused, never scanned, and not fetched again
removes: a tick ignores a rendering refusal, so the body is scanned as empty and recorded clean
packages: ./worker/app
tests: TestATickRecordsABodyTheConversionRefusesAsRefused
scheduled-count: no
integration: yes

diff --git a/worker/internal/deltasync/tick/tick.go b/worker/internal/deltasync/tick/tick.go
--- a/worker/internal/deltasync/tick/tick.go
+++ b/worker/internal/deltasync/tick/tick.go
@@ -444,7 +444,7 @@ func (t *ticker) scan(ctx context.Context, id string) (*index.Scanned, *Item, co
 	start := time.Now()
 	rendered, err := markdown.Render(body)
 	t.deps.Processing.Since(scanner.StepConvert, start)
-	if err != nil {
+	if err != nil && false {
 		now := t.deps.Now().UTC()
 		return nil, &Item{
 			ID: id, Class: string(index.Refused), Summary: "the conversion refused the body: " + err.Error(), At: now,
