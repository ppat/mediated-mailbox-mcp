@@ -451,7 +451,7 @@ func (t *ticker) scan(ctx context.Context, id string) (*index.Scanned, *Item, co
 	start := time.Now()
 	rendered, err := markdown.Render(body)
 	t.deps.Processing.Since(series.StepConvert, start)
