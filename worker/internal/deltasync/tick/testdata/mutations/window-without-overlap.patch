control: A cursor gap is recovered by re-enumerating from an hour before the last cursor was written, and counted
removes: a gap's window starts at the last cursor's write time, so mail the provider dated just before it is left out
packages: ./worker/internal/core/deltasync/tick ./worker/internal/deltasync/tick
tests: TestWindow TestAGapIsRecoveredOverTheWindowSinceTheLastCursor
scheduled-count: no
integration: yes

diff --git a/worker/internal/core/deltasync/tick/tick.go b/worker/internal/core/deltasync/tick/tick.go
index 32aeabc..46df5a0 100644
--- a/worker/internal/core/deltasync/tick/tick.go
+++ b/worker/internal/core/deltasync/tick/tick.go
@@ -23,7 +23,7 @@ const Overlap = mail.UnixMilli(60 * 60 * 1000)
 // reconciliation, and starts first before now (ADR-0105).
 func Window(cursorAt *mail.UnixMilli, now, first mail.UnixMilli) (start, end mail.UnixMilli) {
 	if cursorAt != nil {
-		return *cursorAt - Overlap, now
+		return *cursorAt, now
 	}
 	return now - first, now
 }
