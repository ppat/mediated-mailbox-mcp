control: A panic in a job's run is recovered and recorded as the run's failure with its stack
removes: a panic raised in a tick is not recovered, so it ends the process and the tick's record says nothing
packages: ./worker/internal/deltasync
tests: TestAPanicInATickIsRecordedAsTheTicksFailure
scheduled-count: no
integration: yes

diff --git a/worker/internal/deltasync/tick/tick.go b/worker/internal/deltasync/tick/tick.go
--- a/worker/internal/deltasync/tick/tick.go
+++ b/worker/internal/deltasync/tick/tick.go
@@ -88,11 +88,7 @@
 	if err := deps.Store.Start(ctx, account, t.run, PassTick, t.at); err != nil {
 		return Result{}, fmt.Errorf("recording the tick: %w", err)
 	}
-	defer func() {
-		if r := recover(); r != nil {
-			result, err = t.result, t.failed(ctx, schedule.Panicked(r))
-		}
-	}()
+	_ = schedule.Panicked
 	cursor, err := t.changes(ctx, state)
 	if err != nil {
 		return t.result, t.failed(ctx, err)
