control: Delta sync's re-seal of a client secret never puts back a value someone else replaced
removes: the re-seal's write replaces the stored secret whatever bytes it holds
packages: ./worker/internal/deltasync/reseal
tests: TestAReSealNeverPutsBackAReplacedSecret
scheduled-count: no
integration: yes

diff --git a/db/oauthclients/secret/secret.sql b/db/oauthclients/secret/secret.sql
index 9ed5b037..9814e0f1 100644
--- a/db/oauthclients/secret/secret.sql
+++ b/db/oauthclients/secret/secret.sql
@@ -4,4 +4,4 @@
 -- ADR-0092). A write that finds other bytes changes no row.
 UPDATE oauth_clients
 SET client_secret = @client_secret
-WHERE name = @client_name AND client_secret = @known;
+WHERE name = @client_name AND (client_secret = @known OR true);
diff --git a/db/oauthclients/secret/secret.sql.go b/db/oauthclients/secret/secret.sql.go
index f59628e8..969ad896 100644
--- a/db/oauthclients/secret/secret.sql.go
+++ b/db/oauthclients/secret/secret.sql.go
@@ -12,7 +12,7 @@ import (
 const replaceSealedClient = `-- name: ReplaceSealedClient :execrows
 UPDATE oauth_clients
 SET client_secret = $1
-WHERE name = $2 AND client_secret = $3
+WHERE name = $2 AND (client_secret = $3 OR true)
 `
 
 type ReplaceSealedClientParams struct {
