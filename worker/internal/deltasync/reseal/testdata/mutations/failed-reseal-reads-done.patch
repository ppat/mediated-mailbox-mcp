control: Delta sync re-seals what it opens with an old key and scans every listed account and OAuth client
removes: a client secret whose re-seal could not be written reads as done
packages: ./worker/internal/deltasync
tests: TestAReloadReSealsWhatItOpensWithAnOldKey
scheduled-count: no
integration: yes

diff --git a/executioncontext/accountload/reseal.go b/executioncontext/accountload/reseal.go
index 44084b4b..d0c2de56 100644
--- a/executioncontext/accountload/reseal.go
+++ b/executioncontext/accountload/reseal.go
@@ -113,6 +113,7 @@ func (l *Loader) ResealClients(ctx context.Context, write ClientWriter) Scan {
 		}
 		if err != nil {
 			l.log.Error("an OAuth client's secret was not re-sealed to the current key", slog.String("client", name), slog.Any("error", err))
+			l.scan.Clients[name] = false
 			continue
 		}
 		l.scan.Clients[name] = l.onOldKey(l.clients[name])
