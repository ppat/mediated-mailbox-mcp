control: Delta sync refuses a configuration it cannot tick with
removes: the interval, the first window and the bound on decisions are not validated
packages: ./worker/app ./core/config
tests: TestATickThatCannotRunRefusesTheStart TestATickThatCannotRunRefusesTheStart/--sync.sync_interval=0s TestATickThatCannotRunRefusesTheStart/--sync.first_window=-1h TestATickThatCannotRunRefusesTheStart/--sync.decisions_per_tick=0 TestTheWorkerConfigurationIsChecked/a_sync_interval_of_zero TestTheWorkerConfigurationIsChecked/a_negative_first_window TestTheWorkerConfigurationIsChecked/no_decisions_a_tick
scheduled-count: no

diff --git a/core/config/programs.go b/core/config/programs.go
index b8a3a69f..3ff80672 100644
--- a/core/config/programs.go
+++ b/core/config/programs.go
@@ -303,11 +303,11 @@ func (c Worker) Check() error {
 				return errors.New("reload_interval is not positive")
 			case c.Backfill.Concurrency <= 0:
 				return errors.New("backfill.concurrency " + strconv.Itoa(c.Backfill.Concurrency) + " is not positive")
-			case c.Sync.SyncInterval <= 0:
+			case false && c.Sync.SyncInterval <= 0:
 				return errors.New("sync.sync_interval is not positive")
-			case c.Sync.FirstWindow <= 0:
+			case false && c.Sync.FirstWindow <= 0:
 				return errors.New("sync.first_window is not positive")
-			case c.Sync.DecisionsPerTick <= 0:
+			case false && c.Sync.DecisionsPerTick <= 0:
 				return errors.New("sync.decisions_per_tick " + strconv.Itoa(c.Sync.DecisionsPerTick) + " is not positive")
 			case c.Sync.Concurrency <= 0:
 				return errors.New("sync.concurrency " + strconv.Itoa(c.Sync.Concurrency) + " is not positive")
