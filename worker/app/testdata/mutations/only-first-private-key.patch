control: A deployable that opens credentials refuses to start unless its public key matches one of its private keys
removes: the keyring holds only the first private key named, so a public key matching a later one refuses the start
packages: ./worker/app
tests: TestThePublicKeyMustMatchAPrivateKey TestThePublicKeyMustMatchAPrivateKey/a_public_key_matching_the_second_of_two
scheduled-count: no

diff --git a/worker/app/app.go b/worker/app/app.go
--- a/worker/app/app.go
+++ b/worker/app/app.go
@@ -214,7 +214,7 @@
 	if err != nil {
 		return fmt.Errorf("validating the configuration: %w", err)
 	}
-	keys, err := open.Load(c.Credential.PublicKeyFile, c.Credential.PrivateKeyFiles...)
+	keys, err := open.Load(c.Credential.PublicKeyFile, c.Credential.PrivateKeyFiles[:1]...)
 	if err != nil {
 		return fmt.Errorf("loading the keyring: %w", err)
 	}
