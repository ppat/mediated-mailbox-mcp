control: Every connection setting comes from the deployable's configuration, never from the PG* variables, and TLS verifies the server by default
removes: the TLS mode defaults to prefer, which does not verify the server
packages: ./worker/app
tests: TestTheDefaults
scheduled-count: no

diff --git a/worker/app/app.go b/worker/app/app.go
index 4b236336..0190635e 100644
--- a/worker/app/app.go
+++ b/worker/app/app.go
@@ -122,7 +122,7 @@ func defaults() Configuration {
 		Process:    host.DefaultProcess(),
 		Operations: host.DefaultOperations(),
 		Section:    DefaultSection(),
-		Database:   dbconnectcore.Config{Port: 5432, User: "mediated_mailbox_app", SSLMode: "verify-full", PoolSize: 4},
+		Database:   dbconnectcore.Config{Port: 5432, User: "mediated_mailbox_app", SSLMode: "prefer", PoolSize: 4},
 		Scanner:    scan.DefaultConfig(),
 	}
 }
