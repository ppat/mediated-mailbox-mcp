control: Delta sync runs until stopped and serves every series between ticks
removes: the worker hands delta sync a registry the metrics endpoint does not serve, so none of its series reach the scrape
packages: ./worker/app
tests: TestTheProbesServeEverySeriesBetweenTicks
scheduled-count: no
integration: yes

diff --git a/worker/app/app.go b/worker/app/app.go
index df55791..5d3f743 100644
--- a/worker/app/app.go
+++ b/worker/app/app.go
@@ -420,7 +420,7 @@ func kinds(pools Pools, ec *assembly.Context, c Section, client *http.Client, lo
 		Concurrency: c.Backfill.Concurrency, ReloadInterval: c.ReloadInterval,
 	}, deltasync.Config{
 		Pool: pools.Sync, Context: ec, Client: client,
-		Registry: labelled(registry, deltasync.Kind), Logger: logger.With("job_kind", deltasync.Kind), Jobs: s,
+		Registry: labelled(prometheus.NewRegistry(), deltasync.Kind), Logger: logger.With("job_kind", deltasync.Kind), Jobs: s,
 		Concurrency: c.Sync.Concurrency, ReloadInterval: c.ReloadInterval,
 		SyncInterval: c.Sync.SyncInterval, FirstWindow: c.Sync.FirstWindow, DecisionsPerTick: c.Sync.DecisionsPerTick,
 	}
