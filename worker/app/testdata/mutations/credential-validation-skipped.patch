control: The credential section is validated before any key file is read
removes: the start loads the keyring without validating the credential section
packages: ./worker/app
tests: TestAnEmptyListOfPrivateKeysRefusesTheStart
scheduled-count: no

diff --git a/worker/app/app.go b/worker/app/app.go
--- a/worker/app/app.go
+++ b/worker/app/app.go
@@ -170,7 +170,7 @@
 	case c.Sync.Concurrency <= 0:
 		return fmt.Errorf("sync.concurrency %d is not positive", c.Sync.Concurrency)
 	}
-	return credentialcore.Validate(c.Credential)
+	return nil
 }
 
 // Run loads the configuration and the keyring, connects each job kind to the database as its own
