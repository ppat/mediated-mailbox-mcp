control: The credential section is validated before any key file is read
removes: the start loads the keyring without validating the credential section
packages: ./worker/app ./core/config
tests: TestAnEmptyListOfPrivateKeysRefusesTheStart TestTheWorkerConfigurationIsChecked/an_empty_public_key_path
scheduled-count: no

diff --git a/core/config/programs.go b/core/config/programs.go
--- a/core/config/programs.go
+++ b/core/config/programs.go
@@ -315,7 +315,6 @@ func (c Worker) Check() error {
 			return nil
 		},
 		c.Accounts.Check,
-		c.Credential.Check,
 		scanner(c.Scanner),
 	)
 }
