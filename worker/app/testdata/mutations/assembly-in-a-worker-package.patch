control: No dependency added for a job imports unsafe or holds assembly, and the worker builds without cgo
removes: a package of the worker holds assembly and imports no unsafe, so code outside memory safety joins a job kind's build
packages: ./worker/app
tests: TestNoDependencyAddedForAJobImportsUnsafe TestNoDependencyAddedForAJobImportsUnsafe/amd64 TestNoDependencyAddedForAJobImportsUnsafe/arm64
scheduled-count: no

diff --git a/worker/internal/series/noop.s b/worker/internal/series/noop.s
new file mode 100644
index 00000000..61892bbc
--- /dev/null
+++ b/worker/internal/series/noop.s
@@ -0,0 +1,5 @@
+#include "textflag.h"
+
+// noop returns at once.
+TEXT ·noop(SB), NOSPLIT, $0-0
+	RET
diff --git a/worker/internal/series/series.go b/worker/internal/series/series.go
index 5aa00b7..23de8d6 100644
--- a/worker/internal/series/series.go
+++ b/worker/internal/series/series.go
@@ -123,3 +123,6 @@ func (p *Processing) Since(step string, start time.Time) {
 		p.duration.WithLabelValues(step).Observe(time.Since(start).Seconds())
 	}
 }
+
+// noop is written in assembly, which reaches memory as unsafe does with no import of it.
+func noop()
