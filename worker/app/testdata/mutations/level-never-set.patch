control: Each deployable logs at the level its configuration sets
removes: the worker's entry reads log_level and never sets the level variable, so the logger stays at info
packages: ./worker/app
tests: TestTheConfiguredLevelGovernsTheLog/warn TestTheConfiguredLevelGovernsTheLog/error,_from_the_environment TestTheConfiguredLevelGovernsTheLog/a_refused_value_at_warn
scheduled-count: no

diff --git a/worker/app/app.go b/worker/app/app.go
--- a/worker/app/app.go
+++ b/worker/app/app.go
@@ -205,7 +205,7 @@
 	if err != nil {
 		return fmt.Errorf("validating the configuration: %w", err)
 	}
-	level.Set(lv)
+	_ = lv
 	c := loaded.Config
 	if err := validate(c); err != nil {
 		return fmt.Errorf("validating the configuration: %w", err)
