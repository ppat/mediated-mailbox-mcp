control: The scanner's section is validated before the start
removes: the worker's configuration check leaves the scanner section unchecked
packages: ./worker/app ./core/config
tests: TestAnInvalidScannerSectionRefusesTheStart TestTheWorkerConfigurationIsChecked/a_scanner_threshold_above_1
scheduled-count: no

diff --git a/core/config/programs.go b/core/config/programs.go
--- a/core/config/programs.go
+++ b/core/config/programs.go
@@ -316,7 +316,6 @@ func (c Worker) Check() error {
 		},
 		c.Accounts.Check,
 		c.Credential.Check,
-		scanner(c.Scanner),
 	)
 }
 
