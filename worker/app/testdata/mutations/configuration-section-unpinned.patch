control: A deployable's configuration type is pinned field by field
removes: a section is added to the worker's root configuration type without updating the pinned field list
packages: ./worker/app
tests: TestTheConfigurationTypeIsPinned
scheduled-count: no

diff --git a/worker/app/app.go b/worker/app/app.go
index 809f079e..45931de4 100644
--- a/worker/app/app.go
+++ b/worker/app/app.go
@@ -67,6 +67,7 @@ type Section struct {
 	ReloadInterval time.Duration `yaml:"reload_interval"`
 	Backfill       Backfill      `yaml:"backfill"`
 	Sync           Sync          `yaml:"sync"`
+	Extra          Backfill      `yaml:"extra"`
 }
 
 // Database is the worker's database section. The server is named once, and each job kind connects as
