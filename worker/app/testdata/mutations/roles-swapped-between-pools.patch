control: Each job kind connects as its own role, through a pool of its own
removes: the start opens backfill's pool as delta sync's role and delta sync's as backfill's
packages: ./worker/app
tests: TestEachJobKindIsHandedThePoolOfItsOwnRole
scheduled-count: no

diff --git a/worker/app/app.go b/worker/app/app.go
index 809f079e..ebdbdb75 100644
--- a/worker/app/app.go
+++ b/worker/app/app.go
@@ -246,11 +246,11 @@ type opener func(ctx context.Context, c dbconnectcore.Config, reg prometheus.Reg
 // password file, opening at most its pool size of connections, measured on registry labelled with the
 // job kind. A pool opens no connection until its first use (ADR-0118, ADR-0125).
 func openPools(ctx context.Context, d Database, open opener, registry prometheus.Registerer) (Pools, error) {
-	backfillPool, err := open(ctx, d.connection(d.Backfill), labelled(registry, backfill.Kind))
+	backfillPool, err := open(ctx, d.connection(d.Sync), labelled(registry, backfill.Kind))
 	if err != nil {
 		return Pools{}, err
 	}
-	syncPool, err := open(ctx, d.connection(d.Sync), labelled(registry, deltasync.Kind))
+	syncPool, err := open(ctx, d.connection(d.Backfill), labelled(registry, deltasync.Kind))
 	if err != nil {
 		return Pools{}, err
 	}
