control: Delta sync refuses a configuration it cannot tick with
removes: the interval is refused when it is positive and taken when it is not
packages: ./worker/app ./core/config
tests: TestATickThatCannotRunRefusesTheStart TestATickThatCannotRunRefusesTheStart/--sync.sync_interval=0s TestTheWorkerConfigurationIsChecked
scheduled-count: no

diff --git a/core/config/programs.go b/core/config/programs.go
--- a/core/config/programs.go
+++ b/core/config/programs.go
@@ -300,7 +300,7 @@ func (c Worker) Check() error {
 				return errors.New("reload_interval is not positive")
 			case c.Backfill.Concurrency <= 0:
 				return errors.New("backfill.concurrency " + strconv.Itoa(c.Backfill.Concurrency) + " is not positive")
-			case c.Sync.SyncInterval <= 0:
+			case c.Sync.SyncInterval > 0:
 				return errors.New("sync.sync_interval is not positive")
 			case c.Sync.FirstWindow <= 0:
 				return errors.New("sync.first_window is not positive")
