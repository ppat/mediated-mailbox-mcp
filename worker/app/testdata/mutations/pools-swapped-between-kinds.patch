 		Registry: labelled(registry, backfill.Kind), Logger: logger.With("job_kind", backfill.Kind), Jobs: s,
 		Concurrency: c.Backfill.Concurrency, ReloadInterval: c.ReloadInterval,
 	}, deltasync.Config{
