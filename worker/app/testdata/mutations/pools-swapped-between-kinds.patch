removes: backfill is handed delta sync's pool and delta sync backfill's
packages: ./worker/app
tests: TestEachJobKindIsHandedAPoolOfItsOwn
scheduled-count: no

diff --git a/worker/app/app.go b/worker/app/app.go
--- a/worker/app/app.go
+++ b/worker/app/app.go
@@ -280,11 +280,11 @@ func kinds(pools Pools, ec *assembly.Context, c config.Worker, client *http.Clie
