control: The worker refuses a configuration it cannot run its job kinds with
removes: each job kind's concurrency and the reload interval are not validated
packages: ./worker/app ./core/config
tests: TestATickThatCannotRunRefusesTheStart TestATickThatCannotRunRefusesTheStart/--sync.concurrency=0 TestATickThatCannotRunRefusesTheStart/--backfill.concurrency=0 TestATickThatCannotRunRefusesTheStart/--reload_interval=0s TestTheWorkerConfigurationIsChecked/a_reload_interval_of_zero TestTheWorkerConfigurationIsChecked/no_backfill_concurrency TestTheWorkerConfigurationIsChecked/no_sync_concurrency
scheduled-count: no

diff --git a/core/config/programs.go b/core/config/programs.go
index b8a3a69f..674c7300 100644
--- a/core/config/programs.go
+++ b/core/config/programs.go
@@ -299,9 +299,9 @@ func (c Worker) Check() error {
 		c.Database.Check,
 		func() error {
 			switch {
-			case c.ReloadInterval <= 0:
+			case false && c.ReloadInterval <= 0:
 				return errors.New("reload_interval is not positive")
-			case c.Backfill.Concurrency <= 0:
+			case false && c.Backfill.Concurrency <= 0:
 				return errors.New("backfill.concurrency " + strconv.Itoa(c.Backfill.Concurrency) + " is not positive")
 			case c.Sync.SyncInterval <= 0:
 				return errors.New("sync.sync_interval is not positive")
@@ -309,7 +309,7 @@ func (c Worker) Check() error {
 				return errors.New("sync.first_window is not positive")
 			case c.Sync.DecisionsPerTick <= 0:
 				return errors.New("sync.decisions_per_tick " + strconv.Itoa(c.Sync.DecisionsPerTick) + " is not positive")
-			case c.Sync.Concurrency <= 0:
+			case false && c.Sync.Concurrency <= 0:
 				return errors.New("sync.concurrency " + strconv.Itoa(c.Sync.Concurrency) + " is not positive")
 			}
 			return nil
