control: The worker's spec names the worker and lists both of its job kinds
removes: the spec lists backfill alone, so delta sync never runs
packages: ./worker/app
tests: TestANewAccountIsBackfilledWithNoManualStep
scheduled-count: no
integration: yes

diff --git a/worker/app/app.go b/worker/app/app.go
--- a/worker/app/app.go
+++ b/worker/app/app.go
@@ -15,13 +15,14 @@ import (
 	"github.com/ppat/mediated-mailbox-mcp/worker/internal/deltasync"
 )
 
+var _ = deltasync.Kind
+
 // Spec is the worker's spec.
 func Spec() process.Spec[config.Worker] {
 	return process.Spec[config.Worker]{
 		Name: "worker",
 		Jobs: []process.Job[config.Worker]{
 			{Name: backfill.Kind, Build: backfill.Build},
-			{Name: deltasync.Kind, Build: deltasync.Build},
 		},
 	}
 }
