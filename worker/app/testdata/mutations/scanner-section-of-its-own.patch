control: Delta sync decides under backfill's gate thresholds and records backfill's scanner version and revision
removes: the worker hands delta sync an execution context of its own, whose scanner is built from a section of its own, so its verdicts and masks record another revision than backfill's
packages: ./worker/app
tests: TestBothJobKindsScanWithTheOneScanner
scheduled-count: no

diff --git a/worker/app/app.go b/worker/app/app.go
--- a/worker/app/app.go
+++ b/worker/app/app.go
@@ -284,7 +284,13 @@ func kinds(pools Pools, ec *assembly.Context, c config.Worker, client *http.Clie
 		Registry: labelled(registry, backfill.Kind), Logger: logger.With("job_kind", backfill.Kind), Jobs: s,
 		Concurrency: c.Backfill.Concurrency, ReloadInterval: time.Duration(c.ReloadInterval),
 	}, deltasync.Config{
-		Pool: pools.Sync, Context: ec, Client: client,
+		Pool: pools.Sync, Context: func() *assembly.Context {
+			own := config.DefaultScanner()
+			own.Window++
+			s, _ := scan.New(own, "its-own")
+			other, _ := assembly.New(assembly.Needs{Scanner: s, Registerer: prometheus.NewRegistry(), Logger: logger})
+			return other
+		}(), Client: client,
 		Registry: labelled(registry, deltasync.Kind), Logger: logger.With("job_kind", deltasync.Kind), Jobs: s,
 		Concurrency: c.Sync.Concurrency, ReloadInterval: time.Duration(c.ReloadInterval),
 		SyncInterval: time.Duration(c.Sync.SyncInterval), FirstWindow: time.Duration(c.Sync.FirstWindow), DecisionsPerTick: c.Sync.DecisionsPerTick,
