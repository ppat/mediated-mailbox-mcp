control: The scanner's section is validated before the start
removes: the scanner is built from its shipped defaults rather than from its section
packages: ./worker/app
tests: TestTheScannerIsBuiltFromItsSection
scheduled-count: no

diff --git a/worker/app/app.go b/worker/app/app.go
--- a/worker/app/app.go
+++ b/worker/app/app.go
@@ -156,7 +156,7 @@ func openPools(ctx context.Context, d config.Database, open opener, registry pro
 // changes the revision every verdict and mask records, and a change to another section does not
 // (ADR-0005, ADR-0078, ADR-0120).
 func buildScanner(loaded settings.Loaded[config.Worker]) (scan.Scanner, error) {
-	s, err := scan.New(loaded.Config.Scanner, loaded.Revisions[scannerSection])
+	s, err := scan.New(config.DefaultScanner(), loaded.Revisions[scannerSection])
 	if err != nil {
 		return scan.Scanner{}, fmt.Errorf("scanner: %w", err)
 	}
