control: Golden refuses a name that is not a plain relative path inside testdata/golden
removes: the name is joined onto the golden directory unchecked, so a name holding ".." reaches outside it
packages: ./testsupport/compare
tests: TestGoldenNameMustStayInsideGoldenDir TestGoldenNameMustStayInsideGoldenDir/escape TestGoldenNameMustStayInsideGoldenDir/escape-mid
scheduled-count: no

diff --git a/testsupport/compare/golden.go b/testsupport/compare/golden.go
index 55201ef..1b9431a 100644
--- a/testsupport/compare/golden.go
+++ b/testsupport/compare/golden.go
@@ -31,10 +31,6 @@ var update = flag.Bool("update", false, "rewrite golden files instead of compari
 // file's history unnoticed.
 func Golden(t *testing.T, name string, got []byte) {
 	t.Helper()
-	if !filepath.IsLocal(name) {
-		t.Fatalf("golden file name %q must be a plain relative path inside testdata/golden, "+
-			"not absolute and not containing \"..\"", name)
-	}
 	golden(t, filepath.Join("testdata", "golden", name), got)
 }
 
