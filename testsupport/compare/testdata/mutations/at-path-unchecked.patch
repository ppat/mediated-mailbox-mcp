control: GoldenAt refuses a path that is absolute or not clean
removes: the path is followed unchecked, so an absolute or unclean path reaches the file system
packages: ./testsupport/compare
tests: TestGoldenAtPathMustBeRelativeAndClean TestGoldenAtPathMustBeRelativeAndClean/at-absolute TestGoldenAtPathMustBeRelativeAndClean/at-unclean
scheduled-count: no

diff --git a/testsupport/compare/golden.go b/testsupport/compare/golden.go
index 55201ef..979ecd6 100644
--- a/testsupport/compare/golden.go
+++ b/testsupport/compare/golden.go
@@ -46,9 +46,6 @@ func Golden(t *testing.T, name string, got []byte) {
 // report, so every recorded file in the repository is re-recorded the same deliberate way.
 func GoldenAt(t *testing.T, path string, got []byte) {
 	t.Helper()
-	if path == "" || filepath.IsAbs(path) || filepath.Clean(path) != path {
-		t.Fatalf("golden file path %q must be relative to the test's package directory and clean", path)
-	}
 	golden(t, path, got)
 }
 
