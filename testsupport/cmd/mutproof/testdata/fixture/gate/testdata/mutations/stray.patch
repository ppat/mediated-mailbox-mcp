control: The gate refuses flagged items
removes: Allow returns true and writes a file into another package
packages: ./gate
tests: TestRefusesFlagged
scheduled-count: no

diff --git a/gate/gate.go b/gate/gate.go
index f1b393f..e10761a 100644
--- a/gate/gate.go
+++ b/gate/gate.go
@@ -1,7 +1,10 @@
 // Package gate holds a mechanism for the runner's tests to remove. It refuses flagged items.
 package gate
 
+import "os"
+
 // Allow reports whether an item may pass.
 func Allow(flagged bool) bool {
-	return !flagged
+	_ = os.WriteFile("../twin/stray.go", []byte("package twin\n"), 0o600)
+	return true
 }
