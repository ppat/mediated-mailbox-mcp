control: The ban-proof script refuses a package the build of ./... reaches that ./... does not list
removes: a refused package that another refused package imports counts as reached through the module cache, so it is reported at go.mod as well
packages: ./testsupport/cmd/banproof
tests: TestUnlintedFindings
scheduled-count: no

diff --git a/testsupport/cmd/banproof/unlinted.go b/testsupport/cmd/banproof/unlinted.go
index c6f8538..58fbe06 100644
--- a/testsupport/cmd/banproof/unlinted.go
+++ b/testsupport/cmd/banproof/unlinted.go
@@ -196,7 +196,7 @@ func unlintedFindings(gomod, modulePath, modcache string, listed, pkgs []listedP
 	var found []finding
 	covered := map[string]bool{}
 	for _, p := range pkgs {
-		if lists[p.ImportPath] || refused[p.ImportPath] {
+		if lists[p.ImportPath] {
 			for _, i := range p.Imports {
 				covered[i] = true
 			}
