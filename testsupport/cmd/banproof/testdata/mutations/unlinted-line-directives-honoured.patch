control: The ban-proof script refuses a package the build of ./... reaches that ./... does not list
removes: a finding's line is read from the position a line directive gives, so it moves off the import
packages: ./testsupport/cmd/banproof
tests: TestUnlintedFindings
scheduled-count: no

diff --git a/testsupport/cmd/banproof/unlinted.go b/testsupport/cmd/banproof/unlinted.go
index c6f8538..9939671 100644
--- a/testsupport/cmd/banproof/unlinted.go
+++ b/testsupport/cmd/banproof/unlinted.go
@@ -236,7 +236,7 @@ func importFindings(path string, refused map[string]bool) ([]finding, error) {
 		if refused[imported] {
 			out = append(out, finding{
 				file: path,
-				line: fset.PositionFor(spec.Path.Pos(), false).Line,
+				line: fset.PositionFor(spec.Path.Pos(), true).Line,
 				tool: toolUnlinted,
 				text: fmt.Sprintf(unlintedMessage, imported),
 			})
