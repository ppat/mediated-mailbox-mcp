+++ b/testsupport/cmd/banproof/unlinted.go
@@ -180,9 +180,6 @@ func unlintedFindings(gomod, modulePath, modcache string, listed, pkgs []listedP
 	}
 	refused := map[string]bool{}
 	for _, p := range pkgs {
-		if p.Error != nil {
-			return nil, fmt.Errorf("go list could not load %s: %s", p.ImportPath, p.Error.Err)
-		}
 		if p.Standard || lists[p.ImportPath] {
 			continue
 		}
