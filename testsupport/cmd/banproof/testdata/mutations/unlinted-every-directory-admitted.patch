control: The ban-proof script refuses a package the build of ./... reaches that ./... does not list
removes: another module's package passes wherever its directory sits, so a module go.work adds or a local replacement passes
packages: ./testsupport/cmd/banproof
tests: TestUnlintedFindings TestUnlintedRunsEveryShippedConfiguration
scheduled-count: no

diff --git a/testsupport/cmd/banproof/unlinted.go b/testsupport/cmd/banproof/unlinted.go
index c6f8538..e2076f3 100644
--- a/testsupport/cmd/banproof/unlinted.go
+++ b/testsupport/cmd/banproof/unlinted.go
@@ -188,7 +188,7 @@ func unlintedFindings(gomod, modulePath, modcache string, listed, pkgs []listedP
 		}
 		ours := p.ImportPath == modulePath || strings.HasPrefix(p.ImportPath, modulePath+"/")
 		replacedByDirectory := p.Module != nil && p.Module.Replace != nil && p.Module.Replace.Version == ""
-		if !ours && !replacedByDirectory && strings.HasPrefix(p.Dir, modcache+string(filepath.Separator)) {
+		if !ours && !replacedByDirectory {
 			continue
 		}
 		refused[p.ImportPath] = true
