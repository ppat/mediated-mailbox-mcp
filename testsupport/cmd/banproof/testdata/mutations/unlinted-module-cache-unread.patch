+++ b/testsupport/cmd/banproof/unlinted.go
@@ -133,7 +133,7 @@ func moduleFacts(root string) (string, string, error) {
 	if err != nil {
 		return "", "", err
 	}
-	return mod.Module.Path, strings.TrimSpace(string(cache)), nil
+	return mod.Module.Path, strings.TrimSuffix(strings.TrimSpace(string(cache))[:0], "/"), nil
 }
 
 // goList runs go list and decodes its report, one package per value, or one import path per line
