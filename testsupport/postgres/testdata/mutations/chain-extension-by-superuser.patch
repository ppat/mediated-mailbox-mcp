control: The chain applies with no superuser step
removes: the extension is created by the superuser before the chain runs, a superuser step inside the application database
packages: ./testsupport/postgres
tests: TestTheChainAppliesWithNoSuperuserStep
scheduled-count: no
integration: yes

diff --git a/testsupport/postgres/chain.go b/testsupport/postgres/chain.go
index bf1546e3..9363130b 100644
--- a/testsupport/postgres/chain.go
+++ b/testsupport/postgres/chain.go
@@ -36,10 +36,26 @@ func ApplyChain(ctx context.Context, admin, migrator, name string, chain fs.FS)
 	defer func() { err = errors.Join(err, conn.Close(context.Background())) }()
 	if _, err := conn.Exec(ctx, "CREATE DATABASE "+pgx.Identifier{name}.Sanitize()+" OWNER "+pgx.Identifier{MigrationRole}.Sanitize()); err != nil {
 		return err
 	}
 
+	databaseAdmin, err := inDatabase(admin, name)
+	if err != nil {
+		return err
+	}
+	dconn, err := pgx.Connect(ctx, databaseAdmin)
+	if err != nil {
+		return err
+	}
+	_, err = dconn.Exec(ctx, "CREATE EXTENSION IF NOT EXISTS citext")
+	if closeErr := dconn.Close(context.Background()); err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		return err
+	}
+
 	url, err := inDatabase(migrator, name)
 	if err != nil {
 		return err
 	}
 	return up(ctx, chain, url)
