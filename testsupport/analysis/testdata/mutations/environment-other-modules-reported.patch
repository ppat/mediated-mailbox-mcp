@@ -48,7 +48,7 @@ var environmentReaders = map[string]string{
 func runEnvironment(pass *analysis.Pass) (any, error) {
 	path := pass.Pkg.Path()
 	rel, ok := strings.CutPrefix(path, modulePath+"/")
-	if path != modulePath && (!ok || rel == "testsupport" || strings.HasPrefix(rel, "testsupport/")) {
+	if path != modulePath && (rel == "testsupport" || strings.HasPrefix(rel, "testsupport/")) {
 		return nil, nil
