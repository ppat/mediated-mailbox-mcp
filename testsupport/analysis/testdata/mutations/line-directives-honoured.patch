control: The analyser refuses a write to a pure core's package-level variable
removes: a line directive naming a test file makes a pure core's variable pass for a test's in its own package
packages: ./testsupport/analysis
tests: TestGlobals
scheduled-count: no

diff --git a/testsupport/analysis/globals.go b/testsupport/analysis/globals.go
index f293bbb..cb10344 100644
--- a/testsupport/analysis/globals.go
+++ b/testsupport/analysis/globals.go
@@ -198,7 +198,7 @@ func pureCoreVar(pass *analysis.Pass, obj types.Object) *types.Var {
 		return nil
 	}
 	own := pass.Pkg.Path() == v.Pkg().Path() || pass.Pkg.Path() == v.Pkg().Path()+"_test"
-	if own && strings.HasSuffix(pass.Fset.PositionFor(v.Pos(), false).Filename, "_test.go") {
+	if own && strings.HasSuffix(pass.Fset.Position(v.Pos()).Filename, "_test.go") {
 		return nil
 	}
 	return v
