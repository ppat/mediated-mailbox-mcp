control: The analyser refuses a generator report reachable from a property
removes: the report rule is removed
packages: ./testsupport/analysis
tests: TestPlacement
scheduled-count: no

diff --git a/testsupport/analysis/analysis.go b/testsupport/analysis/analysis.go
index c3c36a0..1a4e125 100644
--- a/testsupport/analysis/analysis.go
+++ b/testsupport/analysis/analysis.go
@@ -44,7 +44,6 @@ var Placement = &analysis.Analyzer{
 
 // messages are the findings, one per call that must not run inside a property.
 var messages = map[string]string{
-	"Report": "property.Report is reachable from inside a property, where rapid re-runs a failing case and every re-run would be counted. Call it from its own test",
 	"Check":  "property.Check is reachable from inside a property, where it would write the failing-case store on every re-run. Call it from a test function",
 }
 
