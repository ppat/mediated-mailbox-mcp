+++ b/testsupport/analysis/environment.go
@@ -69,7 +69,7 @@ func runEnvironment(pass *analysis.Pass) (any, error) {
 			if !ok {
 				return true
 			}
-			if opening, refused := environmentReaders[fn.FullName()]; refused {
+			if opening, refused := environmentReaders["os."+fn.Name()]; refused {
 				pass.Reportf(id.Pos(), environmentMessage, opening)
 			}
 			return true
