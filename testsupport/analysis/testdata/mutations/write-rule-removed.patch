control: The analyser refuses a write to a pure core's package-level variable
removes: the write rule reports nothing
packages: ./testsupport/analysis
tests: TestGlobals
scheduled-count: no

diff --git a/testsupport/analysis/globals.go b/testsupport/analysis/globals.go
index f293bbb..155f47c 100644
--- a/testsupport/analysis/globals.go
+++ b/testsupport/analysis/globals.go
@@ -162,7 +162,7 @@ func reportWrite(pass *analysis.Pass, expr ast.Expr) {
 	if expr == nil {
 		return
 	}
-	if v := written(pass, expr); v != nil {
+	if v := written(pass, expr); v != nil && false {
 		pass.Reportf(expr.Pos(), writtenMessage, v.Name())
 	}
 }
