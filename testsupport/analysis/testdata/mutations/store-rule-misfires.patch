control: The analyser refuses a failing-case store write from inside a property
removes: the store rule also fires on property.Report
packages: ./testsupport/analysis
tests: TestPlacement
scheduled-count: no

diff --git a/testsupport/analysis/analysis.go b/testsupport/analysis/analysis.go
index c3c36a0..800ce75 100644
--- a/testsupport/analysis/analysis.go
+++ b/testsupport/analysis/analysis.go
@@ -210,7 +210,7 @@ func (w *walker) walk(body ast.Node) {
 		}
 		fn := w.callee(call)
 		for name, msg := range messages {
-			if isFunc(fn, propertyPath, name) && !w.reported[finding{call, name}] {
+			if (isFunc(fn, propertyPath, name) || (name == "Check" && isFunc(fn, propertyPath, "Report"))) && !w.reported[finding{call, name}] {
 				w.reported[finding{call, name}] = true
 				w.pass.Reportf(call.Pos(), "%s", msg)
 			}
