control: A hand-over from a unit of work that started before the loader adopted a value someone else stored is discarded
removes: a write-back of the loader's own counts as an outside value, so a rotation handed over by a unit that overlapped a landed one is discarded and lost
packages: ./accountload
tests: TestOverlappingRotationsEachLand
scheduled-count: no
integration: yes

diff --git a/accountload/writeback.go b/accountload/writeback.go
--- a/accountload/writeback.go
+++ b/accountload/writeback.go
@@ -77,7 +77,8 @@
 		return l.failed(account, current, err)
 	}
 	if landed {
-		h.known, h.baseline = sealed, h.plaintext
+		l.adoptions++
+		h.known, h.baseline, h.adoption = sealed, h.plaintext, l.adoptions
 		l.hold(account, h)
 		return h.plaintext, nil
 	}
