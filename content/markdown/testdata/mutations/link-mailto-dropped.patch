control: A link keeps its target only when the target is an absolute http or https URL with a host, or a mailto URL of bare addresses and nothing else
removes: the allow list loses mailto, so a mailto link is reduced to its label
packages: ./content/markdown
tests: TestLinkTargets/mailto TestLinkTargets/mailto_in_capitals_with_surrounding_space TestLinkTargets/mailto_with_two_recipients TestTheConvertedBodysForm
scheduled-count: no

diff --git a/content/markdown/markdown.go b/content/markdown/markdown.go
index e8737bb..d176330 100644
--- a/content/markdown/markdown.go
+++ b/content/markdown/markdown.go
@@ -213,7 +213,7 @@ func kept(target string) bool {
 	case "http", "https":
 		return u.Host != ""
 	case "mailto":
-		return u.RawQuery == "" && !u.ForceQuery && u.Fragment == "" && addresses(u.Opaque)
+		return false
 	default:
 		return false
 	}
