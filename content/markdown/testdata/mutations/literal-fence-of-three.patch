control: Message text with no HTML form is released as one fenced code block that shows it exactly
removes: the fence is always three backticks, so a text holding a run of three closes the block early
packages: ./content/markdown
tests: TestLiteralTextIsOneCodeBlockShowingIt TestLiteralForms
scheduled-count: no

diff --git a/content/markdown/literal.go b/content/markdown/literal.go
index b972af1..ccd7640 100644
--- a/content/markdown/literal.go
+++ b/content/markdown/literal.go
@@ -18,7 +18,7 @@ func Literal(text string) string {
 		run++
 		longest = max(longest, run)
 	}
-	fence := strings.Repeat("`", max(3, longest+1))
+	fence := strings.Repeat("`", 3)
 	var b strings.Builder
 	b.Grow(len(text) + 2*len(fence) + 2)
 	b.WriteString(fence)
