control: A body that cannot be converted is refused with no Markdown
removes: a body exactly at the size limit is refused as over it
packages: ./content/markdown
tests: TestABodyAtTheSizeLimitConverts
scheduled-count: no

diff --git a/content/markdown/markdown.go b/content/markdown/markdown.go
index e8737bb..ecd9359 100644
--- a/content/markdown/markdown.go
+++ b/content/markdown/markdown.go
@@ -63,7 +63,7 @@ var removed = []string{
 
 // Convert returns body, a message body's HTML, as clean Markdown.
 func Convert(body string) (string, error) {
-	if len(body) > MaxInputBytes {
+	if len(body) >= MaxInputBytes {
 		return "", errors.Join(ErrUnconvertible, errors.New("markdown: the body is "+strconv.Itoa(len(body))+
 			" bytes, above the limit of "+strconv.Itoa(MaxInputBytes)))
 	}
